@model NewsPortal.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu Admin";
}

<style>
    .pwd-card {
        max-width: 480px;
        margin: 10px auto 30px;
        background: #ffffff;
        border: 1px solid #e6e7ec;
        border-radius: 8px;
        padding: 26px 28px;
    }

    .pwd-title {
        margin: 0 0 6px;
        font-size: 22px;
        font-weight: 850;
    }

    .pwd-sub {
        margin: 0 0 20px;
        font-size: 13px;
        color: #6b7280;
    }

    .pwd-field {
        margin-bottom: 16px;
    }

    .pwd-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .pwd-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cfd3dc;
        border-radius: 6px;
        font-size: 14px;
    }

    .pwd-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 4px;
    }

    .pwd-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .pwd-btn-save {
        background: #b91c32;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 10px 18px;
        font-weight: 700;
        cursor: pointer;
    }

    .pwd-btn-cancel {
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 10px 16px;
        font-weight: 600;
    }
</style>

<div class="pwd-card">
    <h2 class="pwd-title">Đổi mật khẩu Quản trị viên</h2>
    <p class="pwd-sub">Mật khẩu mới sẽ được mã hóa SHA-256 trước khi lưu vào cơ sở dữ liệu.</p>

    @using (Html.BeginForm("ChangePassword", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { style = "color:#dc2626; margin-bottom:12px; font-size:13px;" })

        <div class="pwd-field">
            @Html.LabelFor(m => m.CurrentPassword, new { @class = "pwd-label" })
            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "pwd-input", placeholder = "Nhập mật khẩu đang sử dụng..." })
            @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "pwd-error" })
        </div>

        <div class="pwd-field">
            @Html.LabelFor(m => m.NewPassword, new { @class = "pwd-label" })
            @Html.PasswordFor(m => m.NewPassword, new { @class = "pwd-input", placeholder = "Tối thiểu 6 ký tự..." })
            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "pwd-error" })
        </div>

        <div class="pwd-field">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "pwd-label" })
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "pwd-input", placeholder = "Nhập lại mật khẩu mới..." })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "pwd-error" })
        </div>

        <div class="pwd-actions">
            <button type="submit" class="pwd-btn-save">Cập nhật mật khẩu</button>
            <a class="pwd-btn-cancel" href="@Url.Action("Index", "Admin")">Hủy</a>
        </div>
    }
</div>
