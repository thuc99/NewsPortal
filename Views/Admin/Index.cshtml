@model NewsPortal.Models.AdminDashboardViewModel
@using System.Collections.Generic
@{
    ViewBag.Title = "Bảng điều khiển Admin";
    int pendingCount = ViewBag.PendingArticles == null ? 0 : (int)ViewBag.PendingArticles;
    int rejectedCount = ViewBag.RejectedArticles == null ? 0 : (int)ViewBag.RejectedArticles;
    int archivedCount = ViewBag.ArchivedArticles == null ? 0 : (int)ViewBag.ArchivedArticles;
    var rejectionReasons = ViewBag.RejectionReasons as Dictionary<int, string> ?? new Dictionary<int, string>();
    var categoryStats = ViewBag.CategoryStats as List<NewsPortal.Models.AdminCategoryStatusStat>
        ?? new List<NewsPortal.Models.AdminCategoryStatusStat>();
    int totalForBar = Model.TotalArticles > 0 ? Model.TotalArticles : 1;
    var articleRatingStats = ViewBag.ArticleRatingStats as List<NewsPortal.Models.AdminArticleRatingStat>
        ?? new List<NewsPortal.Models.AdminArticleRatingStat>();
    int totalRatings = ViewBag.TotalRatings == null ? 0 : (int)ViewBag.TotalRatings;
    double overallAvgRating = ViewBag.OverallAverageRating == null ? 0 : (double)ViewBag.OverallAverageRating;
    int[] starCounts = ViewBag.StarCounts as int[] ?? new int[6];
    int totalRatingsForBar = totalRatings > 0 ? totalRatings : 1;
}

@section styles {
    <style>
        .adm-banner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            padding: 24px 28px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--red-dark), var(--red));
            color: #fff;
            margin-bottom: 20px;
        }

            .adm-banner h1 {
                margin: 4px 0 0;
                font-size: 24px;
            }

        .adm-sub {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: .85;
        }

        .adm-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .adm-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 15px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid transparent;
            cursor: pointer;
            transition: .2s;
            text-decoration: none !important;
        }

        .adm-btn-white {
            background: #fff;
            color: var(--red-dark) !important;
        }

            .adm-btn-white:hover {
                background: #ffe4e6;
            }

        .adm-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }

        .adm-card {
            background: #fff;
            border: 1px solid var(--line);
            border-left: 4px solid var(--red);
            border-radius: 12px;
            padding: 18px 20px;
        }

        .adm-card-pending {
            border-left-color: #2563eb;
        }

        .adm-card-label {
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .adm-card-val {
            font-size: 30px;
            font-weight: 800;
            margin: 4px 0;
            color: var(--ink);
        }

        .adm-card-foot {
            font-size: 13px;
            color: var(--muted);
        }

        .adm-wf-pills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .adm-wf-pill {
            padding: 6px 13px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: var(--soft);
            color: var(--ink) !important;
            font-size: 12.5px;
            font-weight: 700;
            text-decoration: none !important;
        }

            .adm-wf-pill.active, .adm-wf-pill:hover {
                background: #fff1f2;
                border-color: var(--red);
                color: var(--red) !important;
            }

        .adm-panel {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 20px;
        }

        .adm-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .adm-filter {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .adm-filter input, .adm-filter select {
                height: 38px;
                padding: 0 12px;
                border: 1px solid var(--line);
                border-radius: 7px;
                font-size: 13px;
            }

        .adm-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

            .adm-table th {
                text-align: left;
                padding: 11px 10px;
                background: var(--soft);
                border-bottom: 2px solid var(--line);
                font-size: 12px;
                text-transform: uppercase;
                color: var(--muted);
            }

            .adm-table td {
                padding: 12px 10px;
                border-bottom: 1px solid var(--line);
                vertical-align: middle;
            }

        .badge-status {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .badge-pub {
            background: #dcfce7;
            color: #166534;
        }

        .badge-draft {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-pending {
            background: #dbeafe;
            color: #1e40af;
        }

        .badge-rejected {
            background: #fee2e2;
            color: #b91c1c;
        }

        .badge-archived {
            background: #f1f5f9;
            color: #475569;
        }

        .btn-mini {
            display: inline-block;
            padding: 5px 10px;
            margin: 1px;
            border-radius: 6px;
            border: 1px solid var(--line);
            background: #fff;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none !important;
            color: var(--ink);
        }

            .btn-mini:hover {
                border-color: var(--red);
                color: var(--red);
            }

        .btn-approve {
            background: #dcfce7;
            border-color: #86efac;
            color: #166534 !important;
        }

            .btn-approve:hover {
                background: #bbf7d0;
                border-color: #16a34a;
                color: #14532d !important;
            }

        .btn-reject {
            background: #fff7ed;
            border-color: #fed7aa;
            color: #c2410c !important;
        }

            .btn-reject:hover {
                background: #ffedd5;
                border-color: #ea580c;
                color: #9a3412 !important;
            }

        .btn-archive {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #475569 !important;
        }

        .adm-alert {
            padding: 12px 16px;
            border-radius: 8px;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 600;
        }

        .adm-alert-err {
            padding: 12px 16px;
            border-radius: 8px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 600;
        }

        .reject-reason-note {
            margin-top: 6px;
            padding: 6px 9px;
            border-radius: 6px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            font-size: 12px;
            font-weight: 500;
            line-height: 1.45;
            white-space: normal;
        }

        .reject-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .55);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

            .reject-modal-overlay.is-open {
                display: flex;
            }

        .reject-modal-card {
            width: 100%;
            max-width: 480px;
            background: #fff;
            border-radius: 12px;
            padding: 22px 24px;
            box-shadow: 0 20px 45px rgba(15, 23, 42, .25);
        }

            .reject-modal-card h4 {
                margin: 0 0 6px;
                font-size: 18px;
                color: #b91c1c;
            }

        .reject-modal-title {
            margin: 0 0 14px;
            font-size: 13.5px;
            color: var(--muted);
            line-height: 1.5;
        }

        .reject-modal-card textarea {
            width: 100%;
            min-height: 105px;
            padding: 10px 12px;
            border: 1.5px solid var(--line);
            border-radius: 8px;
            font: inherit;
            font-size: 14px;
            box-sizing: border-box;
            resize: vertical;
        }

            .reject-modal-card textarea:focus {
                outline: none;
                border-color: var(--red);
            }

        .reject-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 14px;
        }

        .stats-bar-wrap {
            margin: 12px 0 18px;
        }

        .stats-bar {
            display: flex;
            height: 12px;
            border-radius: 999px;
            overflow: hidden;
            background: #f1f5f9;
        }

        .stats-seg-pub {
            background: #16a34a;
        }

        .stats-seg-pending {
            background: #2563eb;
        }

        .stats-seg-draft {
            background: #f59e0b;
        }

        .stats-seg-rejected {
            background: #dc2626;
        }

        .stats-seg-archived {
            background: #94a3b8;
        }

        .stats-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 10px;
            font-size: 13px;
            color: var(--ink);
        }

        .stats-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .stats-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            display: inline-block;
        }

        .stats-num {
            text-align: center;
            font-weight: 600;
        }

        .adm-table tfoot td {
            padding: 11px 10px;
            background: var(--soft);
            border-top: 2px solid var(--line);
            font-weight: 700;
        }

        .rating-overview {
            display: grid;
            grid-template-columns: 200px 1fr;
            gap: 20px;
            align-items: center;
            margin: 12px 0 18px;
            padding: 16px 18px;
            border-radius: 10px;
            background: #fffbeb;
            border: 1px solid #fde68a;
        }

        .rating-score-box {
            text-align: center;
        }

        .rating-score-big {
            font-size: 34px;
            font-weight: 800;
            color: #b45309;
            line-height: 1.1;
        }

        .rating-stars-gold {
            color: #f59e0b;
            font-size: 16px;
            letter-spacing: 1px;
            margin: 4px 0;
        }

        .rating-bars {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .rating-bar-row {
            display: grid;
            grid-template-columns: 52px 1fr 48px;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: var(--ink);
        }

        .rating-track {
            height: 9px;
            border-radius: 999px;
            background: #fef3c7;
            overflow: hidden;
        }

        .rating-fill {
            height: 100%;
            border-radius: 999px;
            background: #f59e0b;
        }

        @@media (max-width: 680px) {
            .rating-overview {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="adm-banner">
    <div>
        <div class="adm-sub"><i class="fa-solid fa-shield-halved"></i> Hệ thống Quản trị TinNhanh</div>
        <h1>Xin chào, @Session["Admin"]!</h1>
    </div>
    <div class="adm-actions">
        <a class="adm-btn adm-btn-white" href="@Url.Action("Index", "Home")">
            <i class="fa-solid fa-house"></i> Quay về trang chủ
        </a>
        <a class="adm-btn adm-btn-white" href="@Url.RouteUrl("AdminArticles", new { action = "Index" })">
            Quản lý tất cả bài viết
        </a>
    </div>
</div>

@if (TempData["AdminMessage"] != null)
{
    <div class="adm-alert">
        <i class="fa-solid fa-circle-check"></i> @TempData["AdminMessage"]
    </div>
}
@if (TempData["AdminError"] != null)
{
    <div class="adm-alert-err">
        <i class="fa-solid fa-triangle-exclamation"></i> @TempData["AdminError"]
    </div>
}

<div class="adm-stats">
    <div class="adm-card">
        <div class="adm-card-label">Tổng số bài viết</div>
        <div class="adm-card-val">@Model.TotalArticles</div>
        <div class="adm-card-foot">
            Đã đăng: <strong>@Model.PublishedArticles</strong> &bull;
            Chờ duyệt: <strong>@pendingCount</strong> &bull;
            Lưu trữ: <strong>@archivedCount</strong>
        </div>
    </div>

    <div class="adm-card adm-card-pending">
        <div class="adm-card-label">Hàng đợi duyệt bài</div>
        <div class="adm-card-val">@pendingCount</div>
        <div class="adm-card-foot">
            <a href="@Url.Action("Index", "Admin", new { status = "Pending" })">Chờ duyệt: <strong>@pendingCount</strong></a> &bull;
            Từ chối: <strong>@rejectedCount</strong>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card-label">Danh mục &amp; Tác giả</div>
        <div class="adm-card-val">@Model.TotalCategories / @Model.TotalAuthors</div>
        <div class="adm-card-foot">
            <a href="@Url.RouteUrl("AdminCategories", new { action = "Index" })">Danh mục</a> &bull;
            <a href="@Url.RouteUrl("AdminAuthors", new { action = "Index" , returnUrl = Request.RawUrl})">Tác giả</a> &bull;
            Lượt đọc: <strong>@Model.TotalViews</strong>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card-label">Tài khoản quản trị</div>
        <div class="adm-card-val">@Model.TotalUsers</div>
        <div class="adm-card-foot">
            <a href="@Url.Action("Users", "Admin")">Quản lý tài khoản &rarr;</a>
        </div>
    </div>
</div>

<div class="adm-panel" style="margin-bottom:20px;">
    <div class="adm-toolbar" style="margin-bottom:8px;">
        <h3 style="margin:0;"><i class="fa-solid fa-chart-column" style="color:var(--red);"></i> Thống kê bài viết theo danh mục và trạng thái</h3>
    </div>

    <div class="stats-bar-wrap">
        <div class="stats-bar" title="Tỷ lệ bài viết theo trạng thái">
            @if (Model.PublishedArticles > 0)
            {
                <div class="stats-seg-pub" style="width:@((Model.PublishedArticles * 100.0 / totalForBar).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));"></div>
            }
            @if (pendingCount > 0)
            {
                <div class="stats-seg-pending" style="width:@((pendingCount * 100.0 / totalForBar).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));"></div>
            }
            @if (Model.DraftArticles > 0)
            {
                <div class="stats-seg-draft" style="width:@((Model.DraftArticles * 100.0 / totalForBar).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));"></div>
            }
            @if (rejectedCount > 0)
            {
                <div class="stats-seg-rejected" style="width:@((rejectedCount * 100.0 / totalForBar).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));"></div>
            }
            @if (archivedCount > 0)
            {
                <div class="stats-seg-archived" style="width:@((archivedCount * 100.0 / totalForBar).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));"></div>
            }
        </div>
        <div class="stats-legend">
            <span class="stats-legend-item"><span class="stats-dot stats-seg-pub"></span>Đã xuất bản: <strong>@Model.PublishedArticles</strong></span>
            <span class="stats-legend-item"><span class="stats-dot stats-seg-pending"></span>Chờ duyệt: <strong>@pendingCount</strong></span>
            <span class="stats-legend-item"><span class="stats-dot stats-seg-draft"></span>Bản nháp: <strong>@Model.DraftArticles</strong></span>
            <span class="stats-legend-item"><span class="stats-dot stats-seg-rejected"></span>Bị từ chối: <strong>@rejectedCount</strong></span>
            <span class="stats-legend-item"><span class="stats-dot stats-seg-archived"></span>Đã lưu trữ: <strong>@archivedCount</strong></span>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="adm-table">
            <thead>
                <tr>
                    <th>Danh mục</th>
                    <th style="text-align:center;">Tổng bài</th>
                    <th style="text-align:center;">Đã xuất bản</th>
                    <th style="text-align:center;">Chờ duyệt</th>
                    <th style="text-align:center;">Bản nháp</th>
                    <th style="text-align:center;">Bị từ chối</th>
                    <th style="text-align:center;">Lưu trữ</th>
                    <th style="text-align:center;">Lượt xem</th>
                </tr>
            </thead>
            <tbody>
                @if (categoryStats.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="text-align:center; color:var(--muted); padding:20px;">Chưa có dữ liệu danh mục.</td>
                    </tr>
                }
                else
                {
                    foreach (var stat in categoryStats)
                    {
                        <tr>
                            <td style="font-weight:700;">
                                <a href="@Url.RouteUrl("AdminArticles", new { action = "Index", categoryId = stat.CategoryID })">@stat.CategoryName</a>
                            </td>
                            <td class="stats-num">@stat.TotalArticles</td>
                            <td class="stats-num" style="color:#166534;">@stat.PublishedCount</td>
                            <td class="stats-num" style="color:#1e40af;">@stat.PendingCount</td>
                            <td class="stats-num" style="color:#92400e;">@stat.DraftCount</td>
                            <td class="stats-num" style="color:#b91c1c;">@stat.RejectedCount</td>
                            <td class="stats-num" style="color:#475569;">@stat.ArchivedCount</td>
                            <td class="stats-num">@stat.TotalViews</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>Tổng cộng</td>
                    <td class="stats-num">@Model.TotalArticles</td>
                    <td class="stats-num" style="color:#166534;">@Model.PublishedArticles</td>
                    <td class="stats-num" style="color:#1e40af;">@pendingCount</td>
                    <td class="stats-num" style="color:#92400e;">@Model.DraftArticles</td>
                    <td class="stats-num" style="color:#b91c1c;">@rejectedCount</td>
                    <td class="stats-num" style="color:#475569;">@archivedCount</td>
                    <td class="stats-num">@Model.TotalViews</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="adm-panel" style="margin-bottom:20px;">
    <div class="adm-toolbar" style="margin-bottom:8px;">
        <h3 style="margin:0;"><i class="fa-solid fa-star" style="color:#f59e0b;"></i> Thống kê đánh giá bài viết</h3>
    </div>

    <div class="rating-overview">
        <div class="rating-score-box">
            <div class="rating-score-big">@overallAvgRating.ToString("0.0") <span style="font-size:16px; color:var(--muted);">/ 5</span></div>
            <div class="rating-stars-gold">
                @for (int s = 1; s <= 5; s++)
                {
                    @(s <= (int)Math.Round(overallAvgRating) ? "★" : "☆")
                }
            </div>
            <div style="font-size:13px; color:var(--muted);">Tổng cộng <strong>@totalRatings</strong> lượt đánh giá</div>
        </div>

        <div class="rating-bars">
            @for (int star = 5; star >= 1; star--)
            {
                int count = starCounts.Length > star ? starCounts[star] : 0;
                double pct = count * 100.0 / totalRatingsForBar;
                <div class="rating-bar-row">
                    <span style="font-weight:700;">@star ★</span>
                    <div class="rating-track">
                        <div class="rating-fill" style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);"></div>
                    </div>
                    <span style="text-align:right; color:var(--muted); font-weight:600;">@count</span>
                </div>
            }
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="adm-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tiêu đề bài viết</th>
                    <th>Danh mục</th>
                    <th style="text-align:center;">Điểm trung bình</th>
                    <th style="text-align:center;">Lượt đánh giá</th>
                    <th style="text-align:center;">5 sao</th>
                    <th style="text-align:center;">1–2 sao</th>
                </tr>
            </thead>
            <tbody>
                @if (articleRatingStats.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align:center; color:var(--muted); padding:20px;">Chưa có bài viết nào được đánh giá.</td>
                    </tr>
                }
                else
                {
                    foreach (var r in articleRatingStats)
                    {
                        <tr>
                            <td>#@r.ArticleID</td>
                            <td style="font-weight:700;">
                                <a href="@Url.RouteUrl("AdminArticles", new { action = "Details", id = r.ArticleID })">@r.Title</a>
                            </td>
                            <td>@r.CategoryName</td>
                            <td class="stats-num" style="color:#b45309;">
                                @r.AverageRating.ToString("0.0") <span style="color:#f59e0b;">★</span>
                            </td>
                            <td class="stats-num">@r.RatingCount</td>
                            <td class="stats-num" style="color:#166534;">@r.FiveStarCount</td>
                            <td class="stats-num" style="color:#b91c1c;">@r.LowStarCount</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="adm-panel">
    <div class="adm-toolbar">
        <h3 style="margin:0;"><i class="fa-solid fa-list-check" style="color:var(--red);"></i> Kiểm duyệt &amp; Xuất bản bài viết</h3>

        <form method="get" action="@Url.Action("Index", "Admin")" class="adm-filter">
            <input type="text" name="search" value="@Model.SearchQuery" placeholder="Tìm theo tiêu đề..." />
            <select name="status">
                <option value="" @(Model.StatusFilter == "" ? "selected" : "")>Tất cả trạng thái</option>
                <option value="Pending" @(Model.StatusFilter == "Pending" ? "selected" : "")>Pending - Chờ duyệt (@pendingCount)</option>
                <option value="Published" @(Model.StatusFilter == "Published" ? "selected" : "")>Published - Đã xuất bản (@Model.PublishedArticles)</option>
                <option value="Rejected" @(Model.StatusFilter == "Rejected" ? "selected" : "")>Rejected - Bị từ chối (@rejectedCount)</option>
                <option value="Archived" @(Model.StatusFilter == "Archived" ? "selected" : "")>Archived - Đã lưu trữ (@archivedCount)</option>
            </select>
            <button type="submit" class="search-button">Lọc</button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.StatusFilter))
            {
                <a href="@Url.Action("Index", "Admin")" class="search-reset">Xóa lọc</a>
            }
        </form>
    </div>

    <div class="adm-wf-pills">
        <a class="adm-wf-pill @(Model.StatusFilter == "" ? "active" : "")" href="@Url.Action("Index", "Admin")">Tất cả (@Model.TotalArticles)</a>
        <a class="adm-wf-pill @(Model.StatusFilter == "Pending" ? "active" : "")" href="@Url.Action("Index", "Admin", new { status = "Pending" })">Chờ duyệt (@pendingCount)</a>
        <a class="adm-wf-pill @(Model.StatusFilter == "Published" ? "active" : "")" href="@Url.Action("Index", "Admin", new { status = "Published" })">Đã xuất bản (@Model.PublishedArticles)</a>
        <a class="adm-wf-pill @(Model.StatusFilter == "Rejected" ? "active" : "")" href="@Url.Action("Index", "Admin", new { status = "Rejected" })">Bị từ chối (@rejectedCount)</a>
        <a class="adm-wf-pill @(Model.StatusFilter == "Archived" ? "active" : "")" href="@Url.Action("Index", "Admin", new { status = "Archived" })">Đã lưu trữ (@archivedCount)</a>
    </div>

    <div style="overflow-x:auto;">
        <table class="adm-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tiêu đề</th>
                    <th>Danh mục</th>
                    <th>Tác giả</th>
                    <th>Lượt xem</th>
                    <th>Trạng thái</th>
                    <th>Ngày đăng</th>
                    <th style="text-align:right;">Thao tác kiểm duyệt</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Articles.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="text-align:center; color:var(--muted); padding:28px;">
                            Không tìm thấy bài viết nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Articles)
                    {
                        <tr>
                            <td>#@item.ArticleID</td>
                            <td style="font-weight:700; max-width:300px;">
                                <a href="@Url.RouteUrl("AdminArticles", new { action = "Details", id = item.ArticleID })">@item.Title</a>
                                @if (item.Status == "Rejected" && rejectionReasons.ContainsKey(item.ArticleID))
                                {
                                    <div class="reject-reason-note">
                                        <strong>Lý do từ chối:</strong> @rejectionReasons[item.ArticleID]
                                    </div>
                                }
                            </td>
                            <td>@item.CategoryName</td>
                            <td>@item.AuthorName</td>
                            <td>@item.ViewCount</td>
                            <td>
                                @if (item.Status == "Published")
                                {
                                    <span class="badge-status badge-pub">Đã xuất bản (Published)</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge-status badge-pending">Chờ duyệt (Pending)</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge-status badge-rejected">Bị từ chối (Rejected)</span>
                                }
                                else if (item.Status == "Archived")
                                {
                                    <span class="badge-status badge-archived">Đã lưu trữ (Archived)</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-draft">Bản nháp (Draft)</span>
                                }
                            </td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:right; white-space:nowrap;">
                                @if (item.Status == "Pending")
                                {
                                    using (Html.BeginForm("UpdateArticleStatus", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ArticleID" />
                                        <input type="hidden" name="newStatus" value="Published" />
                                        <input type="hidden" name="search" value="@Model.SearchQuery" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn-mini btn-approve">Duyệt đăng</button>
                                    }
                                    <button type="button"
                                            class="btn-mini btn-reject js-open-reject-modal"
                                            data-article-id="@item.ArticleID"
                                            data-article-title="@item.Title">
                                        Từ chối
                                    </button>
                                }
                                else if (item.Status == "Published")
                                {
                                    using (Html.BeginForm("UpdateArticleStatus", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ArticleID" />
                                        <input type="hidden" name="newStatus" value="Archived" />
                                        <input type="hidden" name="search" value="@Model.SearchQuery" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn-mini btn-archive">Lưu trữ</button>
                                    }
                                    <button type="button"
                                            class="btn-mini btn-reject js-open-reject-modal"
                                            data-article-id="@item.ArticleID"
                                            data-article-title="@item.Title">
                                        Trả lại
                                    </button>
                                }
                                else if (item.Status == "Archived")
                                {
                                    using (Html.BeginForm("UpdateArticleStatus", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ArticleID" />
                                        <input type="hidden" name="newStatus" value="Published" />
                                        <input type="hidden" name="search" value="@Model.SearchQuery" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn-mini btn-approve">Xuất bản lại</button>
                                    }
                                    using (Html.BeginForm("UpdateArticleStatus", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ArticleID" />
                                        <input type="hidden" name="newStatus" value="Draft" />
                                        <input type="hidden" name="search" value="@Model.SearchQuery" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn-mini">Về nháp</button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("UpdateArticleStatus", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ArticleID" />
                                        <input type="hidden" name="newStatus" value="Published" />
                                        <input type="hidden" name="search" value="@Model.SearchQuery" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn-mini btn-approve">Duyệt đăng</button>
                                    }
                                    using (Html.BeginForm("UpdateArticleStatus", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ArticleID" />
                                        <input type="hidden" name="newStatus" value="Archived" />
                                        <input type="hidden" name="search" value="@Model.SearchQuery" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn-mini btn-archive">Lưu trữ</button>
                                    }
                                }
                                <a class="btn-mini" href="@Url.RouteUrl("AdminArticles", new { action = "Edit", id = item.ArticleID })">Sửa</a>
                                <a class="btn-mini" style="color:var(--red);" href="@Url.RouteUrl("AdminArticles", new { action = "Delete", id = item.ArticleID })">Xóa</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div id="rejectModal" class="reject-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="rejectModalHeading">
    <div class="reject-modal-card">
        <h4 id="rejectModalHeading">Từ chối bài viết</h4>
        <p id="rejectModalArticleTitle" class="reject-modal-title"></p>
        @using (Html.BeginForm("UpdateArticleStatus", "Admin", FormMethod.Post, new { id = "rejectModalForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="rejectArticleId" value="" />
            <input type="hidden" name="newStatus" value="Rejected" />
            <input type="hidden" name="search" value="@Model.SearchQuery" />
            <input type="hidden" name="status" value="@Model.StatusFilter" />
            <label for="rejectReasonInput" style="display:block; font-weight:700; font-size:13px; margin-bottom:6px;">
                Lý do từ chối <span style="color:#b91c1c;">*</span>
            </label>
            <textarea id="rejectReasonInput"
                      name="rejectionReason"
                      maxlength="500"
                      required
                      placeholder="Nhập lý do từ chối để người viết biết cần chỉnh sửa nội dung gì..."></textarea>
            <div style="font-size:12px; color:var(--muted); margin-top:4px;">Tối đa 500 ký tự. Lý do sẽ hiển thị cho người viết khi sửa bài.</div>
            <div class="reject-modal-actions">
                <button type="button" id="rejectModalCancel" class="btn-mini">Hủy</button>
                <button type="submit" class="btn-mini btn-reject">Xác nhận từ chối</button>
            </div>
        }
    </div>
</div>

<script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("rejectModal");
            const articleIdInput = document.getElementById("rejectArticleId");
            const articleTitleText = document.getElementById("rejectModalArticleTitle");
            const reasonInput = document.getElementById("rejectReasonInput");
            const cancelBtn = document.getElementById("rejectModalCancel");

            if (!modal || !(articleIdInput instanceof HTMLInputElement) || !(reasonInput instanceof HTMLTextAreaElement)) {
                return;
            }

            function closeRejectModal() {
                modal.classList.remove("is-open");
                articleIdInput.value = "";
                reasonInput.value = "";
            }

            document.querySelectorAll(".js-open-reject-modal").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const id = btn.getAttribute("data-article-id") || "";
                    const title = btn.getAttribute("data-article-title") || "";

                    articleIdInput.value = id;
                    if (articleTitleText) {
                        articleTitleText.textContent = "Bài viết: " + title;
                    }
                    reasonInput.value = "";
                    modal.classList.add("is-open");
                    reasonInput.focus();
                });
            });

            if (cancelBtn) {
                cancelBtn.addEventListener("click", closeRejectModal);
            }

            modal.addEventListener("click", function (e) {
                if (e.target === modal) {
                    closeRejectModal();
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && modal.classList.contains("is-open")) {
                    closeRejectModal();
                }
            });
        });
</script>
