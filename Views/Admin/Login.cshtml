@model NewsPortal.Models.AdminLoginViewModel

@{
    ViewBag.Title = "Đăng nhập Quản trị (Admin)";
}

<style>
    .login-wrapper {
        max-width: 460px;
        margin: 18px auto 30px;
        background: #ffffff;
        border: 1px solid #e6e7ec;
        border-radius: 8px;
        box-shadow: 0 12px 32px rgba(20, 23, 31, 0.07);
        overflow: hidden;
    }

    .login-banner {
        background: linear-gradient(135deg, #6e1423, #b91c32 65%, #d63b52);
        color: #ffffff;
        padding: 26px 28px 22px;
    }

    .login-badge {
        display: inline-block;
        background: rgba(255, 255, 255, 0.18);
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 99px;
        margin-bottom: 10px;
    }

    .login-title {
        margin: 0;
        font-size: 24px;
        font-weight: 850;
        letter-spacing: -0.5px;
    }

    .login-subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.88);
    }

    .login-body {
        padding: 26px 28px 28px;
    }

    .login-alert {
        padding: 11px 14px;
        border-radius: 6px;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .login-alert-success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .login-alert-error {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .login-field {
        margin-bottom: 16px;
    }

    .login-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #20232a;
        margin-bottom: 6px;
    }

    .login-input {
        width: 100%;
        padding: 10px 13px;
        font-size: 14px;
        border: 1px solid #cfd3dc;
        border-radius: 6px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .login-input:focus {
        border-color: #b91c32;
        box-shadow: 0 0 0 3px rgba(185, 28, 50, 0.12);
    }

    .password-row {
        position: relative;
        display: flex;
        align-items: center;
    }

    .password-row .login-input {
        padding-right: 72px;
    }

    .toggle-pwd-btn {
        position: absolute;
        right: 8px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 11px;
        font-weight: 700;
        color: #4b5563;
        cursor: pointer;
    }

    .toggle-pwd-btn:hover {
        background: #e5e7eb;
        color: #111827;
    }

    .field-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 4px;
    }

    .validation-summary-errors {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 6px;
        padding: 10px 14px;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 18px;
    }

    .remember-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        font-size: 13px;
        color: #4b5563;
    }

    .remember-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        user-select: none;
    }

    .login-submit {
        width: 100%;
        background: #b91c32;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 11px 16px;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.3px;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .login-submit:hover {
        background: #861b2b;
    }

    .login-footer-box {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px dashed #e5e7eb;
        font-size: 12px;
        color: #6b7280;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .back-home-link {
        color: #b91c32;
        font-weight: 700;
    }
</style>

<div class="login-wrapper">
    <div class="login-banner">
        <span class="login-badge">Khu vực Quản trị</span>
        <h1 class="login-title">Đăng nhập Admin</h1>
        <p class="login-subtitle">Đăng nhập để quản lý bài viết, danh mục và tác giả trên NewsPortal.</p>
    </div>

    <div class="login-body">
        @if (TempData["Success"] != null)
        {
            <div class="login-alert login-alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="login-alert login-alert-error">@TempData["Error"]</div>
        }

        @using (Html.BeginForm("Login", "Admin", FormMethod.Post, new { autocomplete = "on" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)

            @Html.ValidationSummary(true, "")

            <div class="login-field">
                @Html.LabelFor(m => m.UsernameOrEmail, new { @class = "login-label" })
                @Html.TextBoxFor(m => m.UsernameOrEmail, new
                {
                    @class = "login-input",
                    placeholder = "Nhập username (vd: admin) hoặc email...",
                    autofocus = "autofocus"
                })
                @Html.ValidationMessageFor(m => m.UsernameOrEmail, "", new { @class = "field-error" })
            </div>

            <div class="login-field">
                @Html.LabelFor(m => m.Password, new { @class = "login-label" })
                <div class="password-row">
                    @Html.PasswordFor(m => m.Password, new
                    {
                        @class = "login-input",
                        id = "adminPasswordInput",
                        placeholder = "Nhập mật khẩu quản trị..."
                    })
                    <button type="button" class="toggle-pwd-btn" onclick="toggleAdminPassword()" id="togglePwdBtn">
                        Hiện
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
            </div>

            <div class="remember-row">
                <label class="remember-label">
                    @Html.CheckBoxFor(m => m.RememberMe)
                    <span>Ghi nhớ phiên đăng nhập</span>
                </label>
            </div>

            <button type="submit" class="login-submit">
                ĐĂNG NHẬP HỆ THỐNG →
            </button>
        }

        <div class="login-footer-box">
            <span>Tài khoản mặc định: <strong>admin</strong> / <strong>admin123</strong></span>
            <a class="back-home-link" href="@Url.Action("Index", "Home")">← Về trang chủ</a>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function toggleAdminPassword() {
            var pwdInput = document.getElementById("adminPasswordInput");
            var btn = document.getElementById("togglePwdBtn");
            if (!pwdInput) return;
            if (pwdInput.type === "password") {
                pwdInput.type = "text";
                btn.textContent = "Ẩn";
            } else {
                pwdInput.type = "password";
                btn.textContent = "Hiện";
            }
        }
    </script>
}
