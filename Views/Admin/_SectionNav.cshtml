@{
    string currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
    string baseStyle = "display:inline-flex; align-items:center; gap:7px; padding:9px 14px; border:1px solid #e9e9ed; border-radius:8px; background:#f6f7f9; color:#20232a; font-size:13px; font-weight:700; white-space:nowrap;";
    string activeStyle = "display:inline-flex; align-items:center; gap:7px; padding:9px 14px; border:1px solid #b91c32; border-radius:8px; background:#fff1f2; color:#b91c32; font-size:13px; font-weight:700; white-space:nowrap;";
}
<nav style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:22px;">
    <a href="@Url.Action("Index", "Admin")" style="@(currentAction == "Index" ? activeStyle : baseStyle)">
        <i class="fa-solid fa-gauge-high"></i> Tổng quan
    </a>
    <a href="@Url.Action("Articles", "Admin")" style="@(currentAction == "Articles" ? activeStyle : baseStyle)">
        <i class="fa-solid fa-newspaper"></i> Quản lý Bài viết
    </a>
    <a href="@Url.Action("Categories", "Admin")" style="@(currentAction == "Categories" ? activeStyle : baseStyle)">
        <i class="fa-solid fa-folder-tree"></i> Quản lý Danh mục
    </a>
    <a href="@Url.Action("Authors", "Admin")" style="@(currentAction == "Authors" ? activeStyle : baseStyle)">
        <i class="fa-solid fa-pen-nib"></i> Quản lý Tác giả
    </a>
    <a href="@Url.Action("Users", "Admin")" style="@(currentAction == "Users" ? activeStyle : baseStyle)">
        <i class="fa-solid fa-users-gear"></i> Tài khoản Hệ thống
    </a>

    <a href="@Url.Action("Comments", "Admin")" style="@(currentAction == "Comments" ? activeStyle : baseStyle)">
        <i class="fa-solid fa-comments"></i> Kiểm duyệt Bình luận
    </a>
</nav>
