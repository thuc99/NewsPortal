@model IEnumerable<NewsPortal.Models.AdminUserRow>
@{
    ViewBag.Title = "Quản lý Tài khoản - Admin";
    string currentSearch = ViewBag.Search as string ?? "";
    string currentRoleFilter = ViewBag.RoleFilter as string ?? "";
    string currentActiveFilter = ViewBag.ActiveFilter as string ?? "";
    int currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
    bool isAdminUser = Session["Admin"] != null || string.Equals(System.Convert.ToString(Session["Role"]), "Admin", System.StringComparison.OrdinalIgnoreCase);

}

@section styles {
    <style>
        .pagination {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin: 22px 0 0;
        }

        .pagination-direction {
            min-width: 64px;
            text-align: center;
        }

        .pagination-direction.disabled {
            padding: 7px 11px;
            background: #f8fafc;
            color: #a0a5ae;
        }

        .pagination a {
            padding: 7px 11px;
            border-radius: 6px;
            background: #f1f5f9;
            color: #334155;
            text-decoration: none;
        }

        .pagination a.active {
            background: var(--red);
            color: #fff;
        }

        .admin-page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 22px;
        }

            .admin-page-heading > div > a {
                color: var(--red);
                font-size: 13px;
                font-weight: 700;
            }

            .admin-page-heading h2 {
                margin: 6px 0 0;
                color: var(--admin-ink);
                font-size: 24px;
                font-weight: 700;
                line-height: 1.2;
            }

        .usr-admin-panel {
            padding: 20px;
            overflow: hidden;
        }

        .usr-box {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .usr-create-panel {
            display: none;
            margin-bottom: 18px;
            padding: 16px 0 18px;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
        }

            .usr-create-panel.is-open {
                display: block;
            }

        .usr-create-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 14px;
            align-items: end;
        }

        .usr-field label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 5px;
            color: var(--ink);
        }

        .usr-field input,
        .usr-field select {
            width: 100%;
            height: 40px;
            padding: 0 12px;
            border: 1px solid var(--line);
            border-radius: 8px;
            font-size: 13.5px;
            background: #fff;
        }

        .usr-search {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

            .usr-search input[type="search"] {
                flex: 1 1 260px;
                min-width: 220px;
                height: 40px;
                padding: 0 12px;
                border: 1px solid var(--line);
                border-radius: 8px;
                font-size: 13px;
            }

            .usr-search select {
                height: 40px;
                padding: 0 10px;
                border: 1px solid var(--line);
                border-radius: 8px;
                font-size: 13px;
                background: #fff;
            }

            .usr-search .search-button,
            .usr-search .filter-reset,
            .btn-toggle-create {
                height: 40px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                padding: 0 15px;
                border-radius: 8px;
                font-size: 13px;
                font-weight: 700;
                white-space: nowrap;
                cursor: pointer;
                text-decoration: none;
            }

            .usr-search .search-button {
                min-width: 95px;
            }

            .usr-search .search-button,
            .btn-toggle-create {
                border: 0;
                background: var(--red);
                color: #fff !important;
            }

                .usr-search .search-button:hover,
                .btn-toggle-create:hover {
                    background: var(--red-dark);
                }

            .usr-search .filter-reset {
                border: 1px solid var(--line);
                background: var(--soft);
                color: var(--ink);
            }

        .usr-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13.5px;
        }

            .usr-table th {
                text-align: left;
                padding: 11px 10px;
                background: var(--soft);
                border-bottom: 2px solid var(--line);
                font-size: 12px;
                text-transform: uppercase;
                color: var(--muted);
                white-space: nowrap;
            }

            .usr-table td {
                padding: 12px 10px;
                border-bottom: 1px solid var(--line);
                vertical-align: middle;
            }

        .role-form {
            display: flex;
            gap: 6px;
            align-items: center;
        }

            .role-form select {
                height: 34px;
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                padding: 0 8px;
                font-size: 13px;
                font-weight: 600;
                background: #fff;
            }

            .role-form button {
                height: 34px;
                padding: 0 12px;
                border: 1px solid var(--red);
                border-radius: 6px;
                background: var(--red);
                color: #fff;
                cursor: pointer;
                font-size: 12.5px;
                font-weight: 700;
                transition: background .18s ease;
            }

                .role-form button:hover {
                    background: var(--red-dark);
                }

        .btn-status-toggle {
            height: 34px;
            padding: 0 11px;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: #fff;
            cursor: pointer;
            font-size: 12.5px;
            font-weight: 600;
        }

            .btn-status-toggle:hover {
                border-color: var(--red);
                color: var(--red);
            }

        .msg-ok {
            padding: 12px 16px;
            border-radius: 8px;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .msg-err {
            padding: 12px 16px;
            border-radius: 8px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .usr-table-wrap {
            overflow-x: auto;
        }

        .usr-table-wrap h3 {
            margin: 0 0 16px;
        }

        @@media (max-width: 560px) {
            .usr-admin-panel {
                padding: 14px;
            }

            .usr-search input[type="search"] {
                flex-basis: 100%;
                min-width: 0;
            }
        }
    </style>
}

<div class="admin-page-heading">
            <div>
                @if (isAdminUser)
                {
                    <a href="@Url.Action("Index", "Admin")">&larr; Quay lại Bảng điều khiển Admin</a>
                }
                <h2>Quản lý Tài khoản</h2>
            </div>
            <button type="button" id="toggleCreateUserBtn" class="btn-toggle-create">
                <i class="fa-solid fa-user-plus"></i> Tạo tài khoản mới
            </button>
        </div>

<div class="usr-box usr-admin-panel">

@if (TempData["AdminMessage"] != null)
{
    <div class="msg-ok"><i class="fa-solid fa-circle-check"></i> @TempData["AdminMessage"]</div>
}
@if (TempData["AdminError"] != null)
{
    <div class="msg-err"><i class="fa-solid fa-triangle-exclamation"></i> @TempData["AdminError"]</div>
}

<div id="createUserPanel" class="usr-create-panel">
    <h3 style="margin:0 0 14px;"><i class="fa-solid fa-user-plus" style="color:var(--red);"></i> Tạo tài khoản mới</h3>
    @using (Html.BeginForm("CreateUser", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="usr-create-grid">
            <div class="usr-field">
                <label for="newUsername">Tên đăng nhập *</label>
                <input type="text" id="newUsername" name="username" required minlength="3" maxlength="30" placeholder="Ví dụ: tacgia01" />
            </div>
            <div class="usr-field">
                <label for="newFullName">Họ và tên *</label>
                <input type="text" id="newFullName" name="fullName" required minlength="2" maxlength="100" placeholder="Nhập họ tên đầy đủ..." />
            </div>
            <div class="usr-field">
                <label for="newEmail">Email *</label>
                <input type="email" id="newEmail" name="email" required maxlength="256" placeholder="ten@email.com" />
            </div>
            <div class="usr-field">
                <label for="newPassword">Mật khẩu *</label>
                <input type="password" id="newPassword" name="password" required minlength="6" maxlength="64" placeholder="Tối thiểu 6 ký tự" />
            </div>
            <div class="usr-field">
                <label for="newRole">Cấp bậc vai trò *</label>
                <select id="newRole" name="role">
                    <option value="Reader" selected>Độc giả</option>
                    <option value="Author">Tác giả</option>
                    <option value="Editor">Biên tập viên</option>
                    <option value="Admin">Quản trị viên</option>
                </select>
            </div>
            <div class="usr-field">
                <button type="submit" class="btn-toggle-create" style="width:100%;">
                    <i class="fa-solid fa-check"></i> Lưu tài khoản
                </button>
            </div>
        </div>
        <div style="margin-top:10px; font-size:12.5px; color:var(--muted);">
            Lưu ý: Khi tạo hoặc chuyển tài khoản sang cấp <strong>Tác giả</strong>, hệ thống sẽ tự động khởi tạo/liên kết hồ sơ trong mục <strong>Quản lý Tác giả</strong>.
        </div>
    }
</div>

<div class="usr-table-wrap">
    <h3><i class="fa-solid fa-users" style="color:var(--red);"></i> Danh sách tài khoản</h3>

    <form method="get" action="@Url.RouteUrl("Admin", new { action = "Users" })" class="usr-search">
        <input type="search" name="search" value="@currentSearch" placeholder="Tìm tên đăng nhập, họ tên, email, điện thoại..." />

        <select name="roleFilter">
            <option value="" @(currentRoleFilter == "" ? "selected" : "")>Tất cả cấp bậc (4 cấp)</option>
            <option value="Admin" @(currentRoleFilter == "Admin" ? "selected" : "")>Quản trị viên</option>
            <option value="Editor" @(currentRoleFilter == "Editor" ? "selected" : "")>Biên tập viên</option>
            <option value="Author" @(currentRoleFilter == "Author" ? "selected" : "")>Tác giả</option>
            <option value="Reader" @(currentRoleFilter == "Reader" ? "selected" : "")>Độc giả</option>
        </select>

        <select name="activeFilter">
            <option value="" @(currentActiveFilter == "" ? "selected" : "")>Mọi trạng thái</option>
            <option value="active" @(currentActiveFilter == "active" ? "selected" : "")>Đang hoạt động</option>
            <option value="locked" @(currentActiveFilter == "locked" ? "selected" : "")>Đã khóa</option>
        </select>

        <button type="submit" class="search-button">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(currentSearch) || !string.IsNullOrWhiteSpace(currentRoleFilter) || !string.IsNullOrWhiteSpace(currentActiveFilter))
        {
            <a href="@Url.RouteUrl("Admin", new { action = "Users" })" class="filter-reset">Xóa</a>
        }
    </form>

    <table class="usr-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tài khoản</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Điện thoại</th>
                <th>Giới tính / Ngày sinh</th>
                <th>Cấp bậc</th>
                <th>Ngày tạo</th>
                <th>Trạng thái</th>
                <th style="text-align:right;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var u in Model)
                {
                    bool isAdminRole = string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase);
                    bool isEditorRole = string.Equals(u.Role, "Editor", StringComparison.OrdinalIgnoreCase);
                    bool isAuthorRole = string.Equals(u.Role, "Author", StringComparison.OrdinalIgnoreCase);
                    bool isReaderRole = !isAdminRole && !isEditorRole && !isAuthorRole;

                    string roleText = isAdminRole ? "Quản trị viên"
                        : (isEditorRole ? "Biên tập viên"
                        : (isAuthorRole ? "Tác giả" : "Độc giả"));

                    <tr>
                        <td>#@u.UserID</td>
                        <td style="font-weight:700;">@u.Username</td>
                        <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "---" : u.FullName)</td>
                        <td>@(string.IsNullOrWhiteSpace(u.Email) ? "---" : u.Email)</td>
                        <td>@(string.IsNullOrWhiteSpace(u.Phone) ? "---" : u.Phone)</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(u.Gender) ? "---" : u.Gender)
                            @if (u.BirthDate.HasValue)
                            {
                                <div style="font-size:12px; color:var(--muted);">@u.BirthDate.Value.ToString("dd/MM/yyyy")</div>
                            }
                        </td>
                        <td>
                            @if (u.CanChangeRole)
                            {
                                using (Html.BeginForm("UpdateUserRole", "Admin", FormMethod.Post, new { @class = "role-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.UserID" />
                                    <input type="hidden" name="search" value="@currentSearch" />
                                    <input type="hidden" name="roleFilter" value="@currentRoleFilter" />
                                    <input type="hidden" name="activeFilter" value="@currentActiveFilter" />
                                    <select name="role" aria-label="Chọn cấp bậc cho @u.Username">
                                        <option value="Admin" @(isAdminRole ? "selected" : "")>Quản trị viên</option>
                                        <option value="Editor" @(isEditorRole ? "selected" : "")>Biên tập viên</option>
                                        <option value="Author" @(isAuthorRole ? "selected" : "")>Tác giả</option>
                                        <option value="Reader" @(isReaderRole ? "selected" : "")>Độc giả</option>
                                    </select>
                                    <button type="submit">Lưu</button>
                                }
                            }
                            else
                            {
                                @roleText
                                <div style="font-size:12px; color:var(--muted);">Tài khoản bảo vệ</div>
                            }
                        </td>
                        <td>@u.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span style="color:#16a34a; font-weight:700;">Hoạt động</span>
                            }
                            else
                            {
                                <span style="color:#dc2626; font-weight:700;">Đã khóa</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            @if (u.CanToggleStatus)
                            {
                                using (Html.BeginForm("ToggleUserActive", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.UserID" />
                                    <input type="hidden" name="search" value="@currentSearch" />
                                    <input type="hidden" name="roleFilter" value="@currentRoleFilter" />
                                    <input type="hidden" name="activeFilter" value="@currentActiveFilter" />
                                    <button type="submit" class="btn-status-toggle">
                                        @(u.IsActive ? "Khóa" : "Mở khóa")
                                    </button>
                                }
                            }
                            else
                            {
                                <span style="color:var(--muted); font-size:12px;">Mặc định</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" style="text-align:center; color:var(--muted); padding:26px;">
                        Không tìm thấy tài khoản nào phù hợp với bộ lọc hiện tại.
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (totalPages > 1)
    {
        <nav class="pagination" aria-label="Phân trang tài khoản">
            @if (currentPage > 1)
            {
                <a class="pagination-direction" href="@Url.RouteUrl("Admin", new { action = "Users", search = currentSearch, roleFilter = currentRoleFilter, activeFilter = currentActiveFilter, page = currentPage - 1 })">Trước</a>
            }
            else
            {
                <span class="pagination-direction disabled">Trước</span>
            }
            @for (int pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <a class="@(pageNumber == currentPage ? "active" : "")" href="@Url.RouteUrl("Admin", new { action = "Users", search = currentSearch, roleFilter = currentRoleFilter, activeFilter = currentActiveFilter, page = pageNumber })">@pageNumber</a>
            }
            @if (currentPage < totalPages)
            {
                <a class="pagination-direction" href="@Url.RouteUrl("Admin", new { action = "Users", search = currentSearch, roleFilter = currentRoleFilter, activeFilter = currentActiveFilter, page = currentPage + 1 })">Sau</a>
            }
            else
            {
                <span class="pagination-direction disabled">Sau</span>
            }
        </nav>
    }
</div>
</div>

@section scripts {
    <script>
        (function () {
            var btn = document.getElementById("toggleCreateUserBtn");
            var panel = document.getElementById("createUserPanel");
            if (!btn || !panel) return;
            btn.addEventListener("click", function () {
                panel.classList.toggle("is-open");
            });
        })();
    </script>
}
