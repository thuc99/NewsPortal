@model IEnumerable<NewsPortal.Models.AdminUserRow>
@{
    ViewBag.Title = "Quản lý Tài khoản - Admin";
}

@section styles {
    <style>
        .usr-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .usr-grid {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 20px;
            align-items: start;
        }

        .usr-box {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 20px;
        }

        .usr-field {
            margin-bottom: 14px;
        }

            .usr-field label {
                display: block;
                font-size: 13px;
                font-weight: 700;
                margin-bottom: 5px;
            }

            .usr-field input, .usr-field select {
                width: 100%;
                height: 40px;
                padding: 0 12px;
                border: 1px solid var(--line);
                border-radius: 8px;
                font-size: 13px;
            }

        .usr-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .usr-search {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
            max-width: 620px;
        }

        .usr-search input {
            flex: 1 1 320px;
            width: 320px;
            max-width: 100%;
            min-width: 0;
            height: 40px;
            padding: 0 12px;
            border: 1px solid var(--line);
            border-radius: 8px;
            font-size: 13px;
        }

        .usr-search .search-button,
        .usr-search .filter-reset {
            flex: 0 0 auto;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 14px;
            white-space: nowrap;
        }

        .usr-search .search-button {
            border: 0;
            border-radius: 8px;
            background: var(--red);
            color: #fff;
            font-weight: 700;
            cursor: pointer;
        }

        .usr-search .filter-reset {
            border-radius: 8px;
            background: var(--soft);
            color: var(--ink);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

            .usr-table th {
                text-align: left;
                padding: 11px 10px;
                background: var(--soft);
                border-bottom: 2px solid var(--line);
                font-size: 12px;
                text-transform: uppercase;
                color: var(--muted);
            }

            .usr-table td {
                padding: 12px 10px;
                border-bottom: 1px solid var(--line);
            }

        .msg-ok {
            padding: 11px 15px;
            border-radius: 8px;
            background: #ecfdf5;
            color: #065f46;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .msg-err {
            padding: 11px 15px;
            border-radius: 8px;
            background: #fef2f2;
            color: #b91c1c;
            margin-bottom: 16px;
            font-weight: 600;
        }

        @@media (max-width: 900px) {
            .usr-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 520px) {
            .usr-search { flex-wrap: wrap; }
            .usr-search input { flex-basis: 100%; width: 100%; }
        }
    </style>
}

<div class="usr-head">
    <div>
        <a href="@Url.Action("Index", "Admin")" style="color:var(--red); font-weight:700; font-size:13px;">
            &larr; Quay lại Bảng điều khiển Admin
        </a>
        <h2 style="margin:6px 0 0;">Quản lý Tài khoản Hệ thống</h2>
    </div>
</div>

@if (TempData["AdminMessage"] != null)
{
    <div class="msg-ok"><i class="fa-solid fa-circle-check"></i> @TempData["AdminMessage"]</div>
}
@if (TempData["AdminError"] != null)
{
    <div class="msg-err"><i class="fa-solid fa-triangle-exclamation"></i> @TempData["AdminError"]</div>
}

<div class="usr-grid">
    <div class="usr-box">
        <h3 style="margin-top:0;"><i class="fa-solid fa-user-plus" style="color:var(--red);"></i> Thêm tài khoản mới</h3>
        @using (Html.BeginForm("CreateUser", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="usr-field">
                <label>Tên đăng nhập *</label>
                <input type="text" name="username" required placeholder="Ví dụ: bientap01" />
            </div>
            <div class="usr-field">
                <label>Mật khẩu *</label>
                <input type="password" name="password" required placeholder="Nhập mật khẩu" />
            </div>
            <div class="usr-field">
                <label>Họ và tên *</label>
                <input type="text" name="fullName" required placeholder="Nguyễn Văn A" />
            </div>
            <div class="usr-field">
                <label>Email *</label>
                <input type="email" name="email" required maxlength="256" placeholder="email@newsportal.vn" />
            </div>
            <div class="usr-field">
                <label>Vai trò</label>
                <select name="role">
                    <option value="User">User</option>
                    <option value="Editor">Editor</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <button type="submit" class="search-button" style="width:100%; height:42px;">
                Tạo tài khoản
            </button>
        }
    </div>

    <div class="usr-box" style="overflow-x:auto;">
        <h3 style="margin-top:0;"><i class="fa-solid fa-users" style="color:var(--red);"></i> Danh sách tài khoản</h3>
        <form method="get" action="@Url.RouteUrl("Admin", new { action = "Users" })" class="usr-search">
            <input type="search" name="search" value="@(ViewBag.Search ?? "")" placeholder="Tìm tên đăng nhập, họ tên, email hoặc vai trò..." />
            <button type="submit" class="search-button">Tìm kiếm</button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a href="@Url.RouteUrl("Admin", new { action = "Users" })" class="filter-reset">Xóa</a>
            }
        </form>
        <table class="usr-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tài khoản</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.UserID</td>
                            <td style="font-weight:700;">@u.Username</td>
                            <td>@u.FullName</td>
                            <td>@(string.IsNullOrEmpty(u.Email) ? "---" : u.Email)</td>
                            <td>
                                @if (u.CanChangeRole)
                                {
                                    using (Html.BeginForm("UpdateUserRole", "Admin", FormMethod.Post, new { style = "display:flex; gap:5px; align-items:center;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.UserID" />
                                        <select name="role" style="height:32px; border:1px solid var(--line); border-radius:6px;">
                                            <option value="Admin" @(string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Admin</option>
                                            <option value="Editor" @(string.Equals(u.Role, "Editor", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Editor</option>
                                            <option value="User" @(string.Equals(u.Role, "User", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>User</option>
                                        </select>
                                        <button type="submit" style="padding:5px 8px; border:1px solid var(--line); border-radius:6px; background:#fff; cursor:pointer;">Lưu</button>
                                    }
                                }
                                else
                                {
                                    <strong>@u.Role</strong>
                                }
                            </td>
                            <td>@u.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span style="color:#16a34a; font-weight:700;">Hoạt động</span>
                                }
                                else
                                {
                                    <span style="color:#dc2626; font-weight:700;">Đã khóa</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                @if (u.CanToggleStatus)
                                {
                                    using (Html.BeginForm("ToggleUserActive", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.UserID" />
                                        <button type="submit" style="padding:5px 10px; border:1px solid var(--line); border-radius:6px; background:#fff; cursor:pointer; font-weight:600;">
                                            @(u.IsActive ? "Khóa" : "Mở khóa")
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span style="color:var(--muted); font-size:12px;">Mặc định</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" style="text-align:center; color:var(--muted); padding:24px;">Không tìm thấy tài khoản phù hợp.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>