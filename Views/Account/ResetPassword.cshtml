@{
    ViewBag.Title = "Đặt lại mật khẩu mới - TinNhanh";
}

<style>
    .auth-wrap {
        min-height: 62vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 16px;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border: 1px solid #eceff3;
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
        padding: 36px 32px;
    }

    .auth-title {
        margin: 0 0 6px;
        text-align: center;
        font-size: 26px;
        font-weight: 800;
        color: #111827;
    }

    .auth-subtitle {
        margin: 0 0 22px;
        text-align: center;
        font-size: 13.5px;
        color: #6b7280;
    }

    .auth-group {
        margin-bottom: 18px;
    }

    .auth-confirm-error {
        display: none;
        color: #b91c1c;
        font-size: 13px;
        margin-top: 7px;
    }

    .auth-input-box.is-invalid {
        border-color: #dc2626;
        background: #fff;
    }

    .auth-label {
        display: block;
        font-size: 13.5px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 7px;
    }

    .auth-input-box {
        display: flex;
        align-items: center;
        background: #edf2f7;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0 14px;
        height: 46px;
        transition: border-color .2s, background .2s;
    }

        .auth-input-box:focus-within {
            background: #fff;
            border-color: #c4161c;
        }

        .auth-input-box i {
            color: #94a3b8;
            font-size: 15px;
            margin-right: 10px;
        }

        .auth-input-box input {
            flex: 1;
            border: 0;
            background: transparent;
            outline: none;
            font-size: 14px;
            color: #111827;
        }

    .auth-btn-red {
        width: 100%;
        height: 46px;
        border: 0;
        border-radius: 8px;
        background: #c4161c;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 4px;
    }

        .auth-btn-red:hover {
            background: #a31217;
        }

    .auth-alert-ok {
        padding: 11px 14px;
        border-radius: 8px;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .auth-alert-err {
        padding: 11px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 18px;
    }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <h2 class="auth-title">Đặt lại mật khẩu mới</h2>
        <p class="auth-subtitle">Thiết lập mật khẩu mới cho tài khoản <strong>@ViewBag.Email</strong></p>

        <div class="auth-alert-ok">
            <i class="fa-solid fa-shield-check"></i> Đã xác thực OTP thành công. Vui lòng tạo mật khẩu mới.
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="auth-alert-err">
                <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="auth-group">
                <label class="auth-label" for="newPassword">Mật khẩu mới</label>
                <div class="auth-input-box" id="new-password-box">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password" id="newPassword" name="newPassword" minlength="6" maxlength="64" autocomplete="new-password" placeholder="Nhập mật khẩu mới (từ 6 ký tự)" autofocus required />
                </div>
            </div>

            <div class="auth-group">
                <label class="auth-label" for="confirmPassword">Xác nhận mật khẩu mới</label>
                <div class="auth-input-box" id="confirm-password-box">
                    <i class="fa-solid fa-shield-halved"></i>
                    <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" maxlength="64" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" required />
                </div>
                <div class="auth-confirm-error" id="confirm-password-error" aria-live="polite">Mật khẩu xác nhận không khớp với mật khẩu mới.</div>
            </div>

<script>
    (function () {
        var form = document.querySelector('.auth-card form');
        var password = document.getElementById('newPassword');
        var confirmation = document.getElementById('confirmPassword');
        var confirmationBox = document.getElementById('confirm-password-box');
        var error = document.getElementById('confirm-password-error');
        if (!form || !password || !confirmation || !confirmationBox || !error) return;

        function validateConfirmation() {
            var mismatch = confirmation.value.length > 0 && password.value !== confirmation.value;
            confirmation.setCustomValidity(mismatch ? 'Mật khẩu xác nhận không khớp.' : '');
            confirmationBox.classList.toggle('is-invalid', mismatch);
            error.style.display = mismatch ? 'block' : 'none';
            return !mismatch;
        }

        password.addEventListener('input', validateConfirmation);
        confirmation.addEventListener('input', validateConfirmation);
        form.addEventListener('submit', function (event) {
            if (!validateConfirmation()) {
                event.preventDefault();
                confirmation.focus();
            }
        });
    }());
</script>

            <button type="submit" class="auth-btn-red">
                Lưu mật khẩu mới <i class="fa-solid fa-check"></i>
            </button>
        }
    </div>
</div>