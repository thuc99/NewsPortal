
@{
    ViewBag.Title = "Đăng nhập";
}

<style>
    .login-wrapper {
        width: min(460px, calc(100% - 32px));
        margin: 45px auto;
        padding: 36px 32px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        color: #1e293b;
    }

    .login-heading {
        text-align: center;
        margin-bottom: 26px;
    }

        .login-heading h2 {
            margin: 0 0 8px;
            font-size: 26px;
            font-weight: 800;
            color: #0f172a;
        }

        .login-heading p {
            margin: 0;
            font-size: 14px;
            color: #64748b;
        }

    .login-group {
        margin-bottom: 18px;
    }

        .login-group label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
            margin-bottom: 7px;
        }

    .login-input-wrap {
        position: relative;
    }

        .login-input-wrap .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 14px;
        }

        .login-input-wrap input {
            width: 100%;
            height: 46px;
            padding: 0 42px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            font-size: 14px;
            color: #1e293b;
            background: #f8fafc;
            outline: none;
            box-sizing: border-box;
            transition: .2s;
        }

            .login-input-wrap input:focus {
                border-color: #b91c1c;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(185, 28, 28, .1);
            }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px;
        font-size: 14px;
    }

        .toggle-password:hover {
            color: #475569;
        }

    .btn-login {
        width: 100%;
        height: 48px;
        margin-top: 6px;
        border: none;
        border-radius: 10px;
        background: #b91c1c;
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .btn-login:hover {
            background: #991b1b;
        }

    .login-error {
        padding: 10px 14px;
        margin-bottom: 18px;
        border-radius: 8px;
        background: #fee2e2;
        color: #b91c1c;
        font-size: 13px;
        font-weight: 600;
    }

    .login-success {
        padding: 10px 14px;
        margin-bottom: 18px;
        border-radius: 8px;
        background: #dcfce7;
        color: #166534;
        font-size: 13px;
        font-weight: 600;
    }

    .login-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 14px;
        color: #64748b;
    }

        .login-footer a {
            color: #b91c1c;
            font-weight: 700;
            text-decoration: none;
        }

            .login-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-wrapper">
    <div class="login-heading">
        <h2>Đăng nhập</h2>
        <p>Vui lòng nhập thông tin tài khoản của bạn</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="login-success">
            <i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i>
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="login-error">
            <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i>
            @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="login-group">
            <label for="username">Tên đăng nhập</label>
            <div class="login-input-wrap">
                <i class="fa-solid fa-user input-icon"></i>
                <input type="text"
                       id="username"
                       name="username"
                       placeholder="Nhập tên đăng nhập"
                       autocomplete="username"
                       required />
            </div>
        </div>

        <div class="login-group">
            <label for="password">Mật khẩu</label>
            <div class="login-input-wrap">
                <i class="fa-solid fa-lock input-icon"></i>
                <input type="password"
                       id="password"
                       name="password"
                       placeholder="Nhập mật khẩu"
                       autocomplete="current-password"
                       required />

                <button type="button"
                        class="toggle-password"
                        onclick="togglePassword()"
                        aria-label="Hiện hoặc ẩn mật khẩu">
                    <i class="fa-solid fa-eye" id="eyeIcon"></i>
                </button>
            </div>
        </div>

        <button type="submit" class="btn-login">
            ĐĂNG NHẬP
            <i class="fa-solid fa-arrow-right-to-bracket" style="margin-left: 7px;"></i>
        </button>
    }

    <div class="login-footer">
        Chưa có tài khoản?
        <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
    </div>
</div>

<script>
    function togglePassword() {
        var password = document.getElementById("password");
        var icon = document.getElementById("eyeIcon");

        if (password.type === "password") {
            password.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            password.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }
</script>