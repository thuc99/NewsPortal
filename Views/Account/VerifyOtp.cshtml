@{
    ViewBag.Title = "Xác thực mã OTP - TinNhanh";
}

<style>
    .auth-wrap {
        min-height: 62vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 16px;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border: 1px solid #eceff3;
        border-radius: 14px;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
        padding: 36px 32px;
    }

    .auth-title {
        margin: 0 0 6px;
        text-align: center;
        font-size: 26px;
        font-weight: 800;
        color: #111827;
    }

    .auth-subtitle {
        margin: 0 0 22px;
        text-align: center;
        font-size: 13.5px;
        color: #6b7280;
    }

    .auth-group {
        margin-bottom: 20px;
    }

    .auth-label {
        display: block;
        font-size: 13.5px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .auth-input-box {
        display: flex;
        align-items: center;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0 14px;
        height: 46px;
    }

        .auth-input-box i {
            color: #94a3b8;
            font-size: 15px;
            margin-right: 10px;
        }

        .auth-input-box input {
            flex: 1;
            border: 0;
            background: transparent;
            outline: none;
            font-size: 14px;
            color: #334155;
            font-weight: 600;
        }

    /* Khung 6 ô OTP chống lặp số 100% trên mọi bộ gõ */
    .otp-container {
        position: relative;
        width: 100%;
        height: 54px;
    }

    .otp-visual-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .otp-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 54px;
        font-size: 22px;
        font-weight: 800;
        color: #111827;
        background: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 10px;
        transition: all 0.15s ease;
        user-select: none;
    }

        .otp-cell.filled {
            background: #ffffff;
            border-color: #94a3b8;
        }

        .otp-cell.active {
            background: #ffffff;
            border-color: #c4161c;
            box-shadow: 0 0 0 3px rgba(196, 22, 28, 0.12);
        }

    /* 1 input duy nhất nằm phủ lên trên, không bao giờ nhảy focus */
    .otp-real-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: text;
        z-index: 2;
        border: 0;
        background: transparent;
        font-size: 22px;
    }

    .auth-btn-red {
        width: 100%;
        height: 48px;
        border: 0;
        border-radius: 10px;
        background: #c4161c;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 6px;
        transition: background .2s;
    }

        .auth-btn-red:hover {
            background: #a31217;
        }

    .auth-alert-info {
        padding: 11px 14px;
        border-radius: 8px;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 18px;
        line-height: 1.5;
    }

    .auth-alert-err {
        padding: 11px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .auth-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 13.5px;
        color: #6b7280;
    }

        .auth-footer a {
            color: #c4161c;
            font-weight: 700;
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <h2 class="auth-title">Xác thực mã OTP</h2>
        <p class="auth-subtitle">Nhập mã xác thực 6 số đã được gửi về email của bạn</p>

        @if (ViewBag.Info != null)
        {
            <div class="auth-alert-info">
                <i class="fa-solid fa-circle-check"></i> @ViewBag.Info
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="auth-alert-err">
                <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("VerifyOtp", "Account", FormMethod.Post, new { id = "otpForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="auth-group">
                <label class="auth-label" for="email">Email nhận mã</label>
                <div class="auth-input-box">
                    <i class="fa-solid fa-envelope"></i>
                    <input type="email" id="email" name="email" value="@(ViewBag.Email ?? "")" readonly />
                </div>
            </div>

            <div class="auth-group">
                <label class="auth-label" for="otpCode">Mã xác thực OTP (6 số)</label>
                <div class="otp-container">
                    <input type="text"
                           id="otpCode"
                           name="otpCode"
                           class="otp-real-input"
                           maxlength="6"
                           inputmode="numeric"
                           pattern="[0-9]{6}"
                           autocomplete="one-time-code"
                           autofocus
                           required />

                    <div class="otp-visual-grid" id="otpGrid">
                        <div class="otp-cell"></div>
                        <div class="otp-cell"></div>
                        <div class="otp-cell"></div>
                        <div class="otp-cell"></div>
                        <div class="otp-cell"></div>
                        <div class="otp-cell"></div>
                    </div>
                </div>
            </div>

            <button type="submit" class="auth-btn-red">
                Xác nhận mã OTP <i class="fa-solid fa-arrow-right"></i>
            </button>
        }

        <div class="auth-footer">
            Chưa nhận được mã? <a href="@Url.Action("ForgotPassword", "Account")">Gửi lại mã OTP</a>
        </div>
    </div>
</div>

<script>
    (function () {
        var realInput = document.getElementById('otpCode');
        var cells = document.querySelectorAll('#otpGrid .otp-cell');
        var form = document.getElementById('otpForm');

        function renderCells() {
            var clean = (realInput.value || '').replace(/\D/g, '').slice(0, 6);
            if (realInput.value !== clean) {
                realInput.value = clean;
            }

            var isFocused = (document.activeElement === realInput);
            var activeIdx = Math.min(clean.length, 5);

            cells.forEach(function (cell, idx) {
                var ch = clean.charAt(idx);
                cell.textContent = ch;
                cell.classList.toggle('filled', !!ch);
                cell.classList.toggle('active', isFocused && idx === activeIdx);
            });
        }

        realInput.addEventListener('input', renderCells);
        realInput.addEventListener('focus', renderCells);
        realInput.addEventListener('blur', renderCells);
        realInput.addEventListener('keyup', renderCells);

        form.addEventListener('submit', function (e) {
            renderCells();
            if (realInput.value.length !== 6) {
                e.preventDefault();
                realInput.focus();
            }
        });

        renderCells();
    })();
</script>
