@{
    ViewBag.Title = "Xác thực mã OTP - TinNhanh";
}

<style>
    .auth-wrap {
        min-height: 62vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 16px;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border: 1px solid #eceff3;
        border-radius: 14px;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
        padding: 36px 32px;
    }

    .auth-title {
        margin: 0 0 6px;
        text-align: center;
        font-size: 26px;
        font-weight: 800;
        color: #111827;
    }

    .auth-subtitle {
        margin: 0 0 22px;
        text-align: center;
        font-size: 13.5px;
        color: #6b7280;
    }

    .auth-group {
        margin-bottom: 20px;
    }

    .auth-label {
        display: block;
        font-size: 13.5px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .auth-input-box {
        display: flex;
        align-items: center;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0 14px;
        height: 46px;
    }

        .auth-input-box i {
            color: #94a3b8;
            font-size: 15px;
            margin-right: 10px;
        }

        .auth-input-box input {
            flex: 1;
            border: 0;
            background: transparent;
            outline: none;
            font-size: 14px;
            color: #334155;
            font-weight: 600;
        }

    /* 6 ô nhập OTP hiện đại */
    .otp-boxes {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
    }

    .otp-digit {
        width: 100%;
        height: 54px;
        text-align: center;
        font-size: 22px;
        font-weight: 800;
        color: #111827;
        background: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 10px;
        outline: none;
        transition: all 0.18s ease;
    }

        .otp-digit:focus {
            background: #ffffff;
            border-color: #c4161c;
            box-shadow: 0 0 0 3px rgba(196, 22, 28, 0.12);
        }

        .otp-digit.has-value {
            background: #ffffff;
            border-color: #94a3b8;
        }

    .auth-btn-red {
        width: 100%;
        height: 48px;
        border: 0;
        border-radius: 10px;
        background: #c4161c;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 6px;
        transition: background .2s;
    }

        .auth-btn-red:hover {
            background: #a31217;
        }

    .auth-alert-info {
        padding: 11px 14px;
        border-radius: 8px;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 18px;
        line-height: 1.5;
    }

    .auth-alert-err {
        padding: 11px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .auth-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 13.5px;
        color: #6b7280;
    }

        .auth-footer a {
            color: #c4161c;
            font-weight: 700;
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <h2 class="auth-title">Xác thực mã OTP</h2>
        <p class="auth-subtitle">Nhập mã xác thực 6 số đã được gửi về email của bạn</p>

        @if (ViewBag.Info != null)
        {
            <div class="auth-alert-info">
                <i class="fa-solid fa-circle-check"></i> @ViewBag.Info
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="auth-alert-err">
                <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("VerifyOtp", "Account", FormMethod.Post, new { id = "otpForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="auth-group">
                <label class="auth-label" for="email">Email nhận mã</label>
                <div class="auth-input-box">
                    <i class="fa-solid fa-envelope"></i>
                    <input type="email" id="email" name="email" value="@(ViewBag.Email ?? "")" readonly />
                </div>
            </div>

            <div class="auth-group">
                <label class="auth-label">Mã xác thực OTP (6 số)</label>
                <input type="hidden" id="otpCode" name="otpCode" />

                <div class="otp-boxes" id="otpBoxes">
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" autofocus />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                    <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                </div>
            </div>

            <button type="submit" class="auth-btn-red">
                Xác nhận mã OTP <i class="fa-solid fa-arrow-right"></i>
            </button>
        }

        <div class="auth-footer">
            Chưa nhận được mã? <a href="@Url.Action("ForgotPassword", "Account")">Gửi lại mã OTP</a>
        </div>
    </div>
</div>

<script>
    (function () {
        var inputs = document.querySelectorAll('.otp-digit');
        var hiddenInput = document.getElementById('otpCode');
        var form = document.getElementById('otpForm');

        function syncOtpValue() {
            var code = '';
            inputs.forEach(function (inp) {
                code += inp.value;
                if (inp.value) {
                    inp.classList.add('has-value');
                } else {
                    inp.classList.remove('has-value');
                }
            });
            hiddenInput.value = code;
        }

        inputs.forEach(function (input, idx) {
            // Chặn trực tiếp phím số 0-9 ở keydown để bộ gõ tiếng Việt (VIE) không nhân đôi ký tự
            input.addEventListener('keydown', function (e) {
                if (e.ctrlKey || e.metaKey || e.altKey) return;

                if (/^[0-9]$/.test(e.key)) {
                    e.preventDefault();
                    input.value = e.key;
                    syncOtpValue();

                    if (idx < inputs.length - 1) {
                        inputs[idx + 1].focus();
                    }
                    return;
                }

                if (e.key === 'Backspace' || e.key === 'Delete') {
                    e.preventDefault();
                    if (input.value) {
                        input.value = '';
                        syncOtpValue();
                    } else if (idx > 0) {
                        inputs[idx - 1].value = '';
                        inputs[idx - 1].focus();
                        syncOtpValue();
                    }
                } else if (e.key === 'ArrowLeft' && idx > 0) {
                    e.preventDefault();
                    inputs[idx - 1].focus();
                } else if (e.key === 'ArrowRight' && idx < inputs.length - 1) {
                    e.preventDefault();
                    inputs[idx + 1].focus();
                }
            });

            // Dự phòng cho thao tác tự điền (Autofill) hoặc bàn phím ảo
            input.addEventListener('input', function (e) {
                var val = (e.target.value || '').replace(/\D/g, '');
                if (!val) {
                    e.target.value = '';
                    syncOtpValue();
                    return;
                }

                if (val.length > 1) {
                    for (var i = 0; i < val.length && (idx + i) < inputs.length; i++) {
                        inputs[idx + i].value = val[i];
                    }
                    syncOtpValue();
                    var targetIdx = Math.min(idx + val.length, inputs.length - 1);
                    inputs[targetIdx].focus();
                } else {
                    e.target.value = val;
                    syncOtpValue();
                    if (idx < inputs.length - 1) {
                        inputs[idx + 1].focus();
                    }
                }
            });

            // Hỗ trợ dán (Ctrl + V) cả 6 số cùng lúc
            input.addEventListener('paste', function (e) {
                e.preventDefault();
                var pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
                if (!pasted) return;

                for (var i = 0; i < inputs.length; i++) {
                    inputs[i].value = pasted[i] || '';
                }
                syncOtpValue();

                var nextFocus = Math.min(pasted.length, inputs.length - 1);
                inputs[nextFocus].focus();
            });
        });

        form.addEventListener('submit', function (e) {
            syncOtpValue();
            if (hiddenInput.value.length !== 6) {
                e.preventDefault();
                for (var i = 0; i < inputs.length; i++) {
                    if (!inputs[i].value) {
                        inputs[i].focus();
                        break;
                    }
                }
            }
        });
    })();
</script>