@{
    ViewBag.Title = "Quên mật khẩu - TinNhanh";
}

<style>
    .auth-wrap {
        min-height: 62vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 16px;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border: 1px solid #eceff3;
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
        padding: 36px 32px;
    }

    .auth-title {
        margin: 0 0 6px;
        text-align: center;
        font-size: 26px;
        font-weight: 800;
        color: #111827;
    }

    .auth-subtitle {
        margin: 0 0 24px;
        text-align: center;
        font-size: 13.5px;
        color: #6b7280;
        line-height: 1.5;
    }

    .auth-group {
        margin-bottom: 18px;
    }

    .auth-label {
        display: block;
        font-size: 13.5px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 7px;
    }

    .auth-input-box {
        display: flex;
        align-items: center;
        background: #edf2f7;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0 14px;
        height: 46px;
        transition: border-color .2s, background .2s;
    }

        .auth-input-box:focus-within {
            background: #fff;
            border-color: #c4161c;
        }

        .auth-input-box i {
            color: #94a3b8;
            font-size: 15px;
            margin-right: 10px;
        }

        .auth-input-box input {
            flex: 1;
            border: 0;
            background: transparent;
            outline: none;
            font-size: 14px;
            color: #111827;
        }

    .auth-btn-red {
        width: 100%;
        height: 46px;
        border: 0;
        border-radius: 8px;
        background: #c4161c;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background .2s;
    }

        .auth-btn-red:hover {
            background: #a31217;
        }

    .auth-alert-err {
        padding: 11px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .auth-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 13.5px;
        color: #6b7280;
    }

        .auth-footer a {
            color: #c4161c;
            font-weight: 700;
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <h2 class="auth-title">Quên mật khẩu</h2>
        <p class="auth-subtitle">Nhập email đã đăng ký để nhận mã xác thực OTP 6 số</p>

        @if (ViewBag.Error != null)
        {
            <div class="auth-alert-err">
                <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="auth-group">
                <label class="auth-label" for="email">Email đăng ký</label>
                <div class="auth-input-box">
                    <i class="fa-solid fa-envelope"></i>
                    <input type="email" id="email" name="email" value="@(ViewBag.Email ?? "")" placeholder="example@gmail.com" required />
                </div>
            </div>

            <button type="submit" class="auth-btn-red">
                Gửi mã xác thực <i class="fa-solid fa-paper-plane"></i>
            </button>
        }

        <div class="auth-footer">
            Đã nhớ lại mật khẩu? <a href="@Url.Action("Login", "Account")">Quay lại đăng nhập</a>
        </div>
    </div>
</div>