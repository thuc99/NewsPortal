@model NewsPortal.Models.ChangePasswordViewModel
@{ ViewBag.Title = "Đổi mật khẩu"; }

<div class="np-profile-wrap">
    @Html.Action("Sidebar", "Profile", new { activeTab = "ChangePassword" })

    <section class="np-content-card">
        <h1 class="np-section-title">Đổi mật khẩu</h1>

        @if (TempData["Success"] != null)
        {<div class="np-alert-ok">@TempData["Success"]</div>}
        @if (TempData["Error"] != null)
        {<div class="np-alert-err">@TempData["Error"]</div>}

        @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post, new { style = "max-width: 460px;" }))
        {
            @Html.AntiForgeryToken()
            <div style="margin-bottom: 16px;">
                <label class="np-label" for="CurrentPassword">Mật khẩu hiện tại</label>
                @Html.PasswordFor(m => m.CurrentPassword, new { @class = "np-input", placeholder = "Nhập mật khẩu hiện tại" })
                @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "np-field-err" })
            </div>
            <div style="margin-bottom: 16px;">
                <label class="np-label" for="NewPassword">Mật khẩu mới</label>
                @Html.PasswordFor(m => m.NewPassword, new { @class = "np-input", placeholder = "Từ 6 đến 64 ký tự" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "np-field-err" })
            </div>
            <div style="margin-bottom: 22px;">
                <label class="np-label" for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "np-input", placeholder = "Nhập lại mật khẩu mới" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "np-field-err" })
            </div>
            <button type="submit" class="np-btn-primary">Cập nhật mật khẩu</button>
        }
    </section>
</div>
