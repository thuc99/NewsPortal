@model List<NewsPortal.Models.UserCommentItemViewModel>
@{ ViewBag.Title = "Hoạt động bình luận"; }

<div class="np-profile-wrap">
    @Html.Action("Sidebar", "Profile", new { activeTab = "Comments" })

    <section class="np-content-card">
        <h1 class="np-section-title">Hoạt động bình luận (@Model.Count)</h1>

        @if (Model.Count == 0)
        {
            <p style="color:#6b7280;">Bạn chưa có bình luận nào trên hệ thống.</p>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:14px;">
                @foreach (var item in Model)
                {
                    <div style="border:1px solid #e5e7eb; border-radius:10px; padding:14px 16px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px 12px; margin-bottom:6px;">
                            <a href="@Url.Action("Details", "Articles", new { id = item.ArticleId })"
                               style="font-weight:700; color:#b91c1c; text-decoration:none;">
                                @item.ArticleTitle
                            </a>
                            <div style="display:flex; align-items:center; flex-wrap:wrap; gap:8px;">
                                @if (item.Status == "Hidden")
                                {
                                    <span style="padding:3px 9px; border-radius:999px; background:#fff1f2; color:#be123c; font-size:12px; font-weight:700;">
                                        Đã ẩn do spam
                                    </span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span style="padding:3px 9px; border-radius:999px; background:#ecfdf5; color:#047857; font-size:12px; font-weight:700;">
                                        Đang hiển thị
                                    </span>
                                }
                                else
                                {
                                    <span style="padding:3px 9px; border-radius:999px; background:#fffbeb; color:#b45309; font-size:12px; font-weight:700;">
                                        Chờ duyệt
                                    </span>
                                }
                                <span style="font-size:12px; color:#6b7280;">
                                    @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                </span>
                            </div>
                        </div>
                        <p style="margin:0; color:#1f2937; font-size:14px;">@item.Content</p>
                    </div>
                }
            </div>
        }
    </section>
</div>  