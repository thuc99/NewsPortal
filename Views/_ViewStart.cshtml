@{
    string requestPath = Request.AppRelativeCurrentExecutionFilePath ?? string.Empty;
    bool isAdminPage = requestPath.Equals("~/Admin", StringComparison.OrdinalIgnoreCase) ||
        requestPath.StartsWith("~/Admin/", StringComparison.OrdinalIgnoreCase);
    Layout = isAdminPage
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}
