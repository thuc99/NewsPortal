
@model IEnumerable<NewsPortal.Models.Articles>
@using System
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Trang chủ";

    var articles = (Model ?? Enumerable.Empty<NewsPortal.Models.Articles>())
        .Where(a => a.Status == "Published")
        .OrderByDescending(a => a.CreatedDate)
        .ToList();
    var popularKeywords = ViewBag.PopularKeywords as IEnumerable<string>
    ?? Enumerable.Empty<string>();
    var featuredGridArticles = ViewBag.FeaturedGridArticles as IEnumerable<NewsPortal.Models.Articles>
        ?? Enumerable.Empty<NewsPortal.Models.Articles>();

    var featured = ViewBag.FeaturedArticle as NewsPortal.Models.Articles;

    var latestArticles = ViewBag.LatestArticles as IEnumerable<NewsPortal.Models.Articles>
        ?? new List<NewsPortal.Models.Articles>();

    var breakingNews = ViewBag.BreakingNews as IEnumerable<NewsPortal.Models.Articles>
        ?? Enumerable.Empty<NewsPortal.Models.Articles>();

    var topViewedArticles = ViewBag.TopViewedArticles
        as IEnumerable<Tuple<NewsPortal.Models.Articles, int>>
        ?? Enumerable.Empty<Tuple<NewsPortal.Models.Articles, int>>();

    var remaining = articles;
    var currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
}

<style>


/* THANH TU KHOA PHO BIEN */
.popular-keywords {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
    margin: 28px 0 24px;
    padding: 16px 20px;
    background: #fff;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    overflow: hidden;
}

    .popular-keywords-heading {
        flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 8px 0 0;
    color: #252830;
    font-size: 15px;
    font-weight: 900;
    white-space: nowrap;
    position: relative;
    z-index: 1;
    background: #fff;
}

.popular-keywords-heading i {
    color: #b91c32;
    font-size: 18px;
}

.popular-keyword {
    display: inline-block;
    padding: 8px 13px;
    border: 1px solid #f0d5da;
    border-radius: 20px;
    background: #fff7f8;
    color: #b91c32;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: .2s ease;
    flex: 0 0 auto;
}

.popular-keywords-scroller {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
}

.popular-keywords-track {
    display: flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    flex: 0 0 auto;
    animation: popularKeywordsScroll 28s linear infinite;
}

.popular-keywords:hover .popular-keywords-track {
    animation-play-state: paused;
}

@@keyframes popularKeywordsScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
}

.popular-keyword:hover {
    background: #b91c32;
    border-color: #b91c32;
    color: #fff;
    text-decoration: none;
    transform: translateY(-2px);
}

.featured-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    margin: 0 0 30px;
}

.featured-grid-card {
    min-width: 0;
    padding: 8px;
}

.featured-grid-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    margin-bottom: 10px;
    overflow: hidden;
    background: #f1f5f9;
}

.featured-grid-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .2s ease;
}

.featured-grid-card:hover .featured-grid-image img {
    transform: scale(1.04);
}

.featured-grid-title {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
}

.featured-grid-title a {
    color: #252830;
    text-decoration: none;
}

.featured-grid-title a:hover {
    color: #b91c32;
}

@@media (max-width: 600px) {
    .popular-keywords {
        padding: 13px;
        gap: 8px;
    }

    .popular-keywords-heading {
        margin-right: 4px;
    }

    .popular-keywords-scroller {
        flex: 1 1 0;
    }

    .popular-keywords-track {
        gap: 8px;
    }

    .popular-keyword {
        padding: 7px 11px;
        font-size: 12px;
    }

    .featured-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }
}

    .home-page {
        width: min(1160px, calc(100% - 32px));
        margin: 0 auto;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #252830;
        margin-bottom: 22px;
        padding-bottom: 10px;
    }

    .section-title {
        font-size: 21px;
        font-weight: 800;
        margin: 0;
    }

        .section-title:before {
            content: "";
            display: inline-block;
            width: 5px;
            height: 23px;
            background: #b91c32;
            margin-right: 10px;
            vertical-align: -5px;
        }

    .result-count {
        color: #737985;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        gap: clamp(16px, 2vw, 25px);
        margin-bottom: 40px;
    }

    .hero-main,
    .hero-sidebar {
        min-width: 0;
    }

        .hero-grid.without-featured {
            grid-template-columns: 1fr;
        }

    .featured-card, .latest-panel, .news-card {
        background: white;
        border: 1px solid #e9e9ed;
        border-radius: 6px;
        overflow: hidden;
    }

    .featured-visual {
        min-height: 260px;
        position: relative;
        display: flex;
        align-items: flex-end;
        padding: 25px;
        background: #571323;
        overflow: hidden;
    }

        .featured-visual img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: .8;
        }

        .featured-visual:after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(0deg, rgba(20,10,15,.8), transparent);
        }

    .featured-label {
        position: relative;
        z-index: 1;
        padding: 4px 9px;
        background: white;
        color: #a51f33;
        font-size: 10px;
        font-weight: 900;
    }

    .featured-body {
        padding: 23px;
    }

    .featured-title {
        font-size: clamp(22px, 3vw, 30px);
        line-height: 1.35;
        margin: 0 0 12px;
    }

    .featured-summary, .news-summary {
        color: #656a75;
        line-height: 1.7;
    }

    .read-more {
        display: inline-block;
        margin-top: 12px;
        color: #b91c32;
        font-weight: 700;
    }

    .latest-panel {
        padding: 20px;
        align-self: start;
    }

    .latest-heading {
        font-size: 15px;
        font-weight: 800;
        border-bottom: 1px solid #e9e9ed;
        padding-bottom: 12px;
    }

    .latest-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 0;
        border-bottom: 1px solid #ededf0;
    }

    .latest-thumb {
        flex: 0 0 76px;
        width: 76px;
        height: 58px;
        object-fit: cover;
        background: #f1f5f9;
    }

    .latest-copy {
        min-width: 0;
    }

    .latest-title {
        display: block;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .article-meta {
        color: #858995;
        font-size: 12px;
    }

    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .news-card {
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .news-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 24px rgba(20,20,30,.08);
        }

    .news-card-visual {
        height: 145px;
        background: #f5dce1;
        overflow: hidden;
    }

        .news-card-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .news-card-body {
        padding: 17px;
    }

    .news-tag {
        color: #b91c32;
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .news-card-title {
        font-size: 17px;
        line-height: 1.45;
        margin: 8px 0;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 28px 0;
    }

        .pagination a {
            padding: 7px 11px;
            border-radius: 6px;
            background: #f1f5f9;
            color: #334155;
            text-decoration: none;
        }

            .pagination a.active {
                background: #b91c32;
                color: white;
            }

    .pagination-direction {
        min-width: 64px;
        text-align: center;
    }

        .pagination-direction.disabled {
            padding: 7px 11px;
            color: #a0a5ae;
            background: #f8fafc;
        }

    .empty-state {
        padding: 35px;
        border: 1px dashed #d7d8de;
        color: #737985;
        text-align: center;
    }

    /* THANH TIN NONG */
    .breaking-news {
        display: flex;
        align-items: center;
        width: 100%;
        height: 44px;
        margin: 24px 0 22px;
        background: #fff;
        border: 1px solid #e9e9ed;
        border-radius: 6px;
        overflow: hidden;
        box-sizing: border-box;
    }

    .breaking-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 100%;
        padding: 0 12px 0 16px;
        flex-shrink: 0;
        background: transparent;
        color: #b91c32;
        font-size: 13px;
        font-weight: 900;
        z-index: 2;
        white-space: nowrap;
    }

    .breaking-label .fa-fire {
        color: #e85b22;
        transform-origin: center bottom;
        animation: breakingFireAnimation .8s ease-in-out infinite alternate;
    }

    .breaking-track-wrapper {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
    }

    .breaking-track {
        display: inline-flex;
        align-items: center;
        width: max-content;
        animation: breakingScroll 35s linear infinite;
    }

        .breaking-track:hover {
            animation-play-state: paused;
        }

    .breaking-item {
        display: inline-flex;
        align-items: center;
        padding: 0 20px;
        color: #252830;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

        .breaking-item:before {
            content: "●";
            color: #b91c32;
            margin-right: 10px;
            font-size: 10px;
        }

        .breaking-item:hover {
            color: #b91c32;
            text-decoration: none;
        }

    @@keyframes breakingScroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    @@keyframes breakingFireAnimation {
        from { transform: scale(.9) rotate(-5deg); filter: brightness(.9); }
        to { transform: scale(1.15) rotate(5deg); filter: brightness(1.25); }
    }

    /* THOI TIET */
    .weather-feature {
        width: 100%;
        margin: 18px 0 0;
        padding: 13px 16px;
        background: linear-gradient(120deg, #eaf5ff 0%, #cfe7ff 55%, #fff3df 100%);
    }

    .weather-feature-heading {
        margin: 0 0 6px;
        color: #4f7fe0;
        font-size: 18px;
        font-weight: 800;
    }

    .weather-feature-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 9px;
        border-top: 1px solid rgba(255,255,255,.8);
    }

    .weather-feature-copy {
        min-width: 0;
    }

    .weather-feature-title {
        margin: 0 0 9px;
        color: #252830;
        font-size: 15px;
        line-height: 1.35;
    }

    .weather-city-forecasts {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .weather-city-chip {
        padding: 5px 6px;
        background: rgba(255,255,255,.88);
        color: #4f7fe0;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .weather-feature-art {
        display: flex;
        flex: 0 0 78px;
        min-height: 64px;
        align-items: center;
        justify-content: center;
        background: linear-gradient(145deg, rgba(63,143,210,.25), rgba(255,255,255,.65));
        color: #4f7fe0;
    }

        .weather-feature-art i {
            font-size: 30px;
        }

    .weather-feature-status {
        margin-top: 6px;
        color: #64748b;
        font-size: 10px;
    }

    /* GIA VANG */
    .gold-feature {
        width: 100%;
        margin: 14px 0 0;
        padding: 15px 16px;
        box-sizing: border-box;
        background: #fffaf0;
        border: 1px solid #f0dfb8;
    }

    .gold-feature-heading {
        margin: 0 0 12px;
        color: #9a6814;
        font-size: 18px;
        font-weight: 800;
    }

    .gold-feature-name {
        margin-bottom: 10px;
        color: #555;
        font-size: 13px;
        font-weight: 700;
    }

    .gold-price-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        padding: 10px 0;
        border-top: 1px solid #f0e6d2;
    }

    .gold-price-label {
        color: #666;
        font-size: 12px;
    }

    .gold-price-value {
        color: #292929;
        font-size: 14px;
        font-weight: 800;
        text-align: right;
    }

    .gold-change {
        display: block;
        margin-top: 4px;
        font-size: 11px;
        font-weight: 700;
    }

    .gold-up {
        color: #16a34a;
    }

    .gold-down {
        color: #dc2626;
    }

    .gold-no-change {
        color: #888;
    }

    .gold-feature-status {
        margin-top: 10px;
        color: #777;
        font-size: 10px;
        line-height: 1.5;
    }

    .gold-feature-source {
        display: block;
        margin-top: 4px;
        color: #9a6814;
        font-size: 10px;
        text-decoration: underline;
    }







    /* TIN DOC NHIEU TRONG TUAN */
    .top-viewed-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .top-viewed-heading {
        font-size: 21px;
        font-weight: 800;
        color: #222;
        margin: 0 0 20px;
        padding-bottom: 13px;
        border-bottom: 2px solid #b91c32;
    }

        .top-viewed-heading i {
            color: #b91c32 !important;
            margin-right: 7px;
        }

    /* CÁC TIN */
    .top-viewed-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 13px 10px;
        border-bottom: 1px solid #eee;
        border-radius: 9px;
        transition: transform .25s ease, box-shadow .25s ease;
        box-sizing: border-box;
        min-width: 0;
    }

        .top-viewed-item:last-child {
            border-bottom: none;
        }

        /* HIỆU ỨNG BONG BÓNG - KHÔNG PHÓNG TO KHUNG */
        .top-viewed-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 16px rgba(0,0,0,.09);
            background: #fff;
            z-index: 2;
        }

    /* SỐ THỨ TỰ */
    .top-viewed-number {
        flex: 0 0 32px;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e5e7eb;
        color: #555;
        font-size: 17px;
        font-weight: 800;
        border-radius: 5px;
        transition: transform .25s ease;
    }

    .top-viewed-item:first-of-type .top-viewed-number {
        background: #b91c32;
        color: #fff;
    }

    .top-viewed-item:hover .top-viewed-number {
        transform: scale(1.08);
    }

    /* ẢNH */
    .top-viewed-item > a {
        display: block;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 6px;
    }

    .top-viewed-thumb {
        width: 105px;
        height: 75px;
        object-fit: cover;
        border-radius: 6px;
        display: block;
        transition: transform .3s ease;
    }

    .top-viewed-item:hover .top-viewed-thumb {
        transform: scale(1.03);
    }

    /* NỘI DUNG */
    .top-viewed-copy {
        flex: 1;
        min-width: 0;
    }

    .top-viewed-title {
        display: block;
        color: #222;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.45;
        text-decoration: none;
        overflow-wrap: anywhere;
        transition: color .2s ease;
    }

        .top-viewed-title:hover,
        .top-viewed-item:hover .top-viewed-title {
            color: #b91c32;
            text-decoration: none;
        }

    .top-viewed-count {
        display: block;
        margin-top: 7px;
        color: #888;
        font-size: 12px;
    }

        .top-viewed-count i {
            color: #b91c32;
            margin-right: 4px;
        }

    /* TIN ĐẦU TIÊN - ẢNH LỚN, CHỮ CÙNG CHIỀU RỘNG */
    .top-viewed-item:first-of-type {
        display: block;
        padding: 0 0 18px;
        width: 100%;
        box-sizing: border-box;
    }

        .top-viewed-item:first-of-type .top-viewed-number {
            margin-bottom: 10px;
        }

        .top-viewed-item:first-of-type > a {
            display: block;
            width: 100%;
            margin: 0 0 12px;
            overflow: hidden;
            border-radius: 8px;
        }

        .top-viewed-item:first-of-type .top-viewed-thumb {
            display: block;
            width: 100%;
            max-width: 100%;
            height: 190px;
            object-fit: cover;
            border-radius: 8px;
        }

        .top-viewed-item:first-of-type .top-viewed-copy {
            display: block;
            width: 100%;
            box-sizing: border-box;
        }

        .top-viewed-item:first-of-type .top-viewed-title {
            font-size: 19px;
            font-weight: 800;
            line-height: 1.4;
        }

        .top-viewed-item:first-of-type .top-viewed-count {
            margin-top: 9px;
        }


        /* TẠO KHOẢNG CÁCH CHO CHỮ TIN ĐẦU TIÊN */
        .top-viewed-item:first-of-type .top-viewed-copy {
            padding: 0 8px 5px;
            box-sizing: border-box;
        }

        .top-viewed-item:first-of-type .top-viewed-title {
            padding: 3px 0;
            line-height: 1.5;
        }

        .top-viewed-item:first-of-type .top-viewed-count {
            padding-top: 3px;
        }

    /* CÁC TIN SAU */
    .top-viewed-item:not(:first-of-type) .top-viewed-thumb {
        width: 100px;
        height: 72px;
    }

    .top-viewed-empty {
        color: #888;
        font-size: 14px;
        padding: 15px 0;
    }

    /* ĐIỆN THOẠI */
    @@media (max-width: 600px) {
        .top-viewed-panel {
            padding: 15px;
        }

        .top-viewed-item:first-of-type .top-viewed-thumb {
            height: 170px;
        }

        .top-viewed-item:first-of-type .top-viewed-title {
            font-size: 17px;
        }

        .top-viewed-item:not(:first-of-type) .top-viewed-thumb {
            width: 85px;
            height: 65px;
        }
    }


    @@media (max-width: 900px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }

        .hero-sidebar {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 16px;
        }

        .news-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 760px) {
        .featured-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }
    }

    @@media (max-width: 600px) {
        .home-page {
            width: calc(100% - 24px);
        }

        .section-heading {
            margin-bottom: 16px;
        }

        .section-title {
            font-size: 19px;
        }

        .hero-grid {
            gap: 20px;
            margin-bottom: 28px;
        }

        .hero-sidebar {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .latest-panel {
            width: 100%;
            box-sizing: border-box;
            padding: 14px;
        }

        .featured-visual {
            min-height: 210px;
            padding: 16px;
        }

        .featured-body {
            padding: 16px;
        }

        .featured-title {
            font-size: 22px;
        }

        .popular-keywords {
            margin: 18px 0;
            padding: 12px;
        }

        .featured-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .featured-grid-card {
            padding: 4px;
        }

        .featured-grid-title {
            font-size: 14px;
        }

        .weather-feature {
            padding: 13px 16px;
        }

        .weather-feature-title {
            font-size: 15px;
        }

        .weather-feature-art {
            display: none;
        }

        .weather-city-forecasts {
            gap: 5px;
        }

        .weather-city-chip {
            font-size: 10px;
        }

        .breaking-news {
            height: 40px;
        }

        .breaking-label {
            padding: 0 10px;
            font-size: 11px;
        }

        .breaking-item {
            padding: 0 18px;
            font-size: 12px;
        }
    }

    @@media (max-width: 480px) {
        .news-grid {
            grid-template-columns: 1fr;
        }

        .featured-grid {
            grid-template-columns: 1fr;
        }

        .breaking-label {
            padding: 0 8px;
            gap: 5px;
            font-size: 10px;
        }

        .breaking-item {
            padding: 0 12px;
            font-size: 11px;
        }

        .pagination {
            flex-wrap: wrap;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .breaking-track,
        .breaking-label .fa-fire,
        .popular-keywords-track {
            animation: none;
        }
    }
</style>

<div class="home-page">

    <!-- THANH TIN NONG CHAY NGANG -->
    @if (breakingNews.Any())
    {
        <div class="breaking-news">
            <div class="breaking-label">
                <i class="fa-solid fa-fire" aria-hidden="true"></i>
                TIN NÓNG
            </div>

            <div class="breaking-track-wrapper">
                <div class="breaking-track">
                    @foreach (var item in breakingNews)
                    {
                        <a class="breaking-item"
                           href="@Url.Action("View", "Articles", new { id = item.ArticleID })">
                            @item.Title
                        </a>
                    }

                    @foreach (var item in breakingNews)
                    {
                        <a class="breaking-item"
                           href="@Url.Action("View", "Articles", new { id = item.ArticleID })"
                           aria-hidden="true"
                           tabindex="-1">
                            @item.Title
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <section class="hero-grid @(featured == null ? "without-featured" : "")">

        <div class="hero-main">

            @if (featured != null)
            {
                <article class="featured-card">
                    <a class="featured-visual article-link"
                       href="@Url.Action("View", "Articles", new { id = featured.ArticleID })">

                        @if (!string.IsNullOrWhiteSpace(featured.ImageUrl))
                        {
                            <img src="@featured.ImageUrl" alt="@featured.Title" />
                        }

                        <span class="featured-label">TIN NỔI BẬT</span>
                    </a>

                    <div class="featured-body">
                        <h1 class="featured-title">
                            <a href="@Url.Action("View", "Articles", new { id = featured.ArticleID })">
                                @featured.Title
                            </a>
                        </h1>

                        <a class="article-link"
                           href="@Url.Action("View", "Articles", new { id = featured.ArticleID })">
                            <p class="featured-summary">@featured.Summary</p>
                        </a>

                        <div class="article-meta">
                            @featured.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        @Html.ActionLink("Đọc tiếp", "View", "Articles",
                                 new { id = featured.ArticleID },
                                 new { @class = "read-more" })
                    </div>
                </article>
             }

            @if (popularKeywords.Any())
            {
                <section class="popular-keywords">
                    <h3 class="popular-keywords-heading">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                        Tiêu điểm
                    </h3>
                    <div class="popular-keywords-scroller">
                        <div class="popular-keywords-track">
                            @foreach (var keyword in popularKeywords)
                            {
                                <a class="popular-keyword" href="@Url.Action("Keyword", "Articles", new { keyword = keyword })">
                                    @keyword
                                </a>
                            }
                            @foreach (var keyword in popularKeywords)
                            {
                                <a class="popular-keyword" href="@Url.Action("Keyword", "Articles", new { keyword = keyword })" aria-hidden="true" tabindex="-1">
                                    @keyword
                                </a>
                            }
                        </div>
                    </div>
                </section>
            }

            @if (featuredGridArticles.Any())
            {
                <section class="featured-grid" aria-label="Tin tiêu điểm">
                    @foreach (var item in featuredGridArticles)
                    {
                        <article class="featured-grid-card">
                            <a class="featured-grid-image" href="@Url.Action("View", "Articles", new { id = item.ArticleID })">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Title" />
                                }
                            </a>
                            <h3 class="featured-grid-title">
                                <a href="@Url.Action("View", "Articles", new { id = item.ArticleID })">@item.Title</a>
                            </h3>
                        </article>
                    }
                </section>
            }

        </div>

        <aside class="hero-sidebar">
            <div class="latest-panel">
                <div class="section-heading">
                    <h2 class="section-title">Tin mới</h2>
                </div>

                @foreach (var item in latestArticles)
                {
                    <div class="latest-item">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <a href="@Url.Action("View", "Articles", new { id = item.ArticleID })">
                                <img class="latest-thumb"
                                     src="@item.ImageUrl"
                                     alt="@item.Title" />
                            </a>
                        }

                        <div class="latest-copy">
                            @Html.ActionLink(item.Title, "View", "Articles",
                                     new { id = item.ArticleID },
                                     new { @class = "latest-title" })

                            <span class="article-meta">
                                @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                    </div>
                }
            </div>

            <!-- THOI TIET -->
            <section class="weather-feature" aria-label="Dự báo thời tiết hôm nay">
                <h2 class="weather-feature-heading">Thời tiết</h2>

                <div class="weather-feature-content">
                    <div class="weather-feature-copy">
                        <h3 class="weather-feature-title" id="home-weather-title">
                            Cập nhật dự báo thời tiết hôm nay
                        </h3>

                        <div class="weather-city-forecasts" aria-live="polite">
                            <span class="weather-city-chip" id="home-weather-hcm">TP. HCM —</span>
                            <span class="weather-city-chip" id="home-weather-hanoi">Hà Nội —</span>
                            <span class="weather-city-chip" id="home-weather-danang">Đà Nẵng —</span>
                        </div>

                        <div class="weather-feature-status" id="home-weather-status">
                            Đang tải dữ liệu dự báo…
                        </div>
                    </div>

                    <div class="weather-feature-art" aria-hidden="true">
                        <i class="fa-solid fa-cloud-sun" id="home-weather-icon"></i>
                    </div>
                </div>
            </section>

            <!-- GIA VANG -->
            <section class="gold-feature" aria-label="Giá vàng hôm nay">
                <h2 class="gold-feature-heading">
                    <i class="fa-solid fa-coins"></i> Giá vàng
                </h2>

                <div class="gold-feature-name">Vàng miếng SJC 9999</div>

                <div class="gold-price-row">
                    <div class="gold-price-label">Mua vào</div>
                    <div class="gold-price-value">
                        <span id="gold-buy">Đang tải...</span>
                        <span id="gold-buy-change" class="gold-change"></span>
                    </div>
                </div>

                <div class="gold-price-row">
                    <div class="gold-price-label">Bán ra</div>
                    <div class="gold-price-value">
                        <span id="gold-sell">Đang tải...</span>
                        <span id="gold-sell-change" class="gold-change"></span>
                    </div>
                </div>

                <div class="gold-feature-status" id="gold-status">
                    Đang tải dữ liệu giá vàng...
                </div>

                <a class="gold-feature-source"
                   href="https://www.vang.today/vi/api"
                   target="_blank" rel="noopener noreferrer">
                    Nguồn dữ liệu: Vang.today
                </a>
            </section>

        </aside>
    </section>

    <div class="section-heading" id="other-articles">
        <h2 class="section-title">Các bài viết khác</h2>
    </div>

    @if (remaining.Any())
    {
        <section class="news-grid">
            @foreach (var item in remaining)
            {
                <article class="news-card">
                    <a class="news-card-visual article-link"
                       href="@Url.Action("View", "Articles", new { id = item.ArticleID })">

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" />
                        }
                    </a>

                    <div class="news-card-body">
                        <div class="news-tag">
                            @(item.Categories == null ? "TIN TỨC" : item.Categories.CategoryName)
                        </div>

                        <h3 class="news-card-title">
                            <a href="@Url.Action("View", "Articles", new { id = item.ArticleID })">
                                @item.Title
                            </a>
                        </h3>

                        <a class="article-link"
                           href="@Url.Action("View", "Articles", new { id = item.ArticleID })">
                            <p class="news-summary">@item.Summary</p>
                        </a>

                        @Html.ActionLink("Đọc tiếp", "View", "Articles",
                                 new { id = item.ArticleID },
                                 new { @class = "read-more" })
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="empty-state">Chưa có bài viết đã xuất bản.</div>
    }

    @if (totalPages > 1)
    {
        <nav class="pagination">
            @if (currentPage > 1)
            {
                <a class="pagination-direction"
                   href="@(Url.Action("Index", "Home", new { searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage - 1 }) + "#other-articles")">
                    Trước
                </a>
            }
            else
            {
                <span class="pagination-direction disabled">Trước</span>
            }

            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <a class="@(pageNumber == currentPage ? "active" : "")"
                   href="@(Url.Action("Index", "Home", new { searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = pageNumber }) + "#other-articles")">
                    @pageNumber
                </a>
            }

            @if (currentPage < totalPages)
            {
                <a class="pagination-direction"
                   href="@(Url.Action("Index", "Home", new { searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage + 1 }) + "#other-articles")">
                    Sau
                </a>
            }
            else
            {
                <span class="pagination-direction disabled">Sau</span>
            }
        </nav>
    }
</div>

<!-- SCRIPT THOI TIET -->
<script>
    (function () {
        var cities = [
            { name: 'TP. HCM', latitude: 10.8231, longitude: 106.6297, element: 'home-weather-hcm' },
            { name: 'Hà Nội', latitude: 21.0278, longitude: 105.8342, element: 'home-weather-hanoi' },
            { name: 'Đà Nẵng', latitude: 16.0544, longitude: 108.2022, element: 'home-weather-danang' }
        ];

        var title = document.getElementById('home-weather-title');
        var status = document.getElementById('home-weather-status');
        var icon = document.getElementById('home-weather-icon');
        var currentWeatherCode = 0;

        function conditionFor() {
            var code = currentWeatherCode;

            if (code === 0) return { text: 'Trời quang', icon: 'fa-sun' };
            if (code <= 2) return { text: 'Có nắng, mây', icon: 'fa-cloud-sun' };
            if (code === 3) return { text: 'Nhiều mây', icon: 'fa-cloud' };
            if (code === 45 || code === 48) return { text: 'Sương mù', icon: 'fa-smog' };
            if (code <= 57) return { text: 'Mưa phùn', icon: 'fa-cloud-rain' };
            if (code <= 67 || (code >= 80 && code <= 82)) return { text: 'Có mưa', icon: 'fa-cloud-showers-heavy' };
            if (code >= 95) return { text: 'Có dông', icon: 'fa-cloud-bolt' };

            return { text: 'Dự báo hôm nay', icon: 'fa-cloud' };
        }

        Promise.all(cities.map(function (city) {
            var url = 'https://api.open-meteo.com/v1/forecast?latitude=' + city.latitude +
                '&longitude=' + city.longitude +
                '&daily=temperature_2m_max,temperature_2m_min,weather_code&timezone=auto&forecast_days=1';

            return fetch(url)
                .then(function (response) {
                    if (!response.ok) throw new Error('Weather request failed');
                    return response.json();
                })
                .then(function (data) {
                    if (!data.daily || !data.daily.temperature_2m_min || !data.daily.temperature_2m_max) {
                        throw new Error('Weather data unavailable');
                    }

                    var min = Math.round(data.daily.temperature_2m_min[0]);
                    var max = Math.round(data.daily.temperature_2m_max[0]);
                    var chip = document.getElementById(city.element);

                    if (chip) {
                        chip.textContent = city.name + ' ' + min + '° - ' + max + '°C';
                    }

                    return {
                        city: city,
                        conditionCode: data.daily.weather_code[0]
                    };
                });
        }))
            .then(function (forecasts) {
                currentWeatherCode = Number(forecasts[0].conditionCode);

                var condition = conditionFor();

                if (title) {
                    title.textContent = condition.text + ' tại ' + forecasts[0].city.name + ' hôm nay';
                }

                if (icon) {
                    icon.className = 'fa-solid ' + condition.icon;
                }

                if (status) {
                    status.textContent = 'Dự báo nhiệt độ trong ngày · Dữ liệu Open-Meteo';
                }
            })
            .catch(function () {
                if (status) {
                    status.textContent = 'Không thể tải dữ liệu dự báo lúc này.';
                }

                cities.forEach(function (city) {
                    var chip = document.getElementById(city.element);

                    if (chip && chip.textContent.indexOf('—') !== -1) {
                        chip.textContent = city.name + ' —';
                    }
                });
            });
    })();
</script>

<!-- SCRIPT GIA VANG -->
<script>
    (function () {
        var apiUrl = 'https://www.vang.today/api/prices?type=SJL1L10';

        var buyElement = document.getElementById('gold-buy');
        var sellElement = document.getElementById('gold-sell');
        var buyChangeElement = document.getElementById('gold-buy-change');
        var sellChangeElement = document.getElementById('gold-sell-change');
        var statusElement = document.getElementById('gold-status');

        function formatPrice(value) {
            return Number(value).toLocaleString('vi-VN') + ' đ';
        }

        function showChange(element, value) {
            var change = Number(value || 0);

            if (change > 0) {
                element.textContent = '▲ Tăng ' + formatPrice(change);
                element.className = 'gold-change gold-up';
            } else if (change < 0) {
                element.textContent = '▼ Giảm ' + formatPrice(Math.abs(change));
                element.className = 'gold-change gold-down';
            } else {
                element.textContent = '— Không thay đổi';
                element.className = 'gold-change gold-no-change';
            }
        }

        function loadGoldPrice() {
            fetch(apiUrl, { cache: 'no-store' })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Không thể kết nối API giá vàng');
                    }

                    return response.json();
                })
                .then(function (result) {
                    if (!result.success || result.buy == null || result.sell == null) {
                        throw new Error('Không có dữ liệu giá vàng');
                    }

                    buyElement.textContent = formatPrice(result.buy);
                    sellElement.textContent = formatPrice(result.sell);

                    showChange(buyChangeElement, result.change_buy);
                    showChange(sellChangeElement, result.change_sell);

                    statusElement.textContent =
                        'Cập nhật: ' + (result.time || '--:--') +
                        ' · ' + (result.date || '') +
                        ' · Đơn vị: đồng/lượng';
                })
                .catch(function (error) {
                    console.error('Lỗi giá vàng:', error);
                    statusElement.textContent = 'Không thể tải giá vàng.';
                });
        }

        loadGoldPrice();
        setInterval(loadGoldPrice, 5 * 60 * 1000);
    })();
</script>
