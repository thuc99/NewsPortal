@model IEnumerable<NewsPortal.Models.Articles>
@using System
@using System.Linq

@{
    ViewBag.Title = "Trang chủ";
    var articles = (Model ?? Enumerable.Empty<NewsPortal.Models.Articles>())
        .Where(a => a.Status == "Published")
        .OrderByDescending(a => a.CreatedDate)
        .ToList();
    var featured = articles.FirstOrDefault();
    var remaining = featured == null
        ? new System.Collections.Generic.List<NewsPortal.Models.Articles>()
        : articles.Skip(1).ToList();
    var currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
}

<style>
    .home-page { max-width: 1160px; margin: 0 auto; }
    .section-heading { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #252830; margin-bottom: 22px; padding-bottom: 10px; }
    .section-title { font-size: 21px; font-weight: 800; margin: 0; }
    .section-title:before { content: ""; display: inline-block; width: 5px; height: 23px; background: #b91c32; margin-right: 10px; vertical-align: -5px; }
    .result-count { color: #737985; font-size: 13px; margin-bottom: 18px; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(240px, 1fr); gap: 25px; margin-bottom: 40px; }
    .featured-card, .latest-panel, .news-card { background: white; border: 1px solid #e9e9ed; border-radius: 6px; overflow: hidden; }
    .featured-visual { min-height: 260px; position: relative; display: flex; align-items: flex-end; padding: 25px; background: #571323; overflow: hidden; }
    .featured-visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .8; }
    .featured-visual:after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(20,10,15,.8), transparent); }
    .featured-label { position: relative; z-index: 1; padding: 4px 9px; background: white; color: #a51f33; font-size: 10px; font-weight: 900; }
    .featured-body { padding: 23px; }
    .featured-title { font-size: clamp(22px, 3vw, 30px); line-height: 1.35; margin: 0 0 12px; }
    .featured-summary, .news-summary { color: #656a75; line-height: 1.7; }
    .read-more { display: inline-block; margin-top: 12px; color: #b91c32; font-weight: 700; }
    .latest-panel { padding: 20px; align-self: start; }
    .latest-heading { font-size: 15px; font-weight: 800; border-bottom: 1px solid #e9e9ed; padding-bottom: 12px; }
    .latest-item { padding: 14px 0; border-bottom: 1px solid #ededf0; }
    .latest-number { color: #b91c32; font-weight: 900; }
    .latest-title { display: block; font-weight: 700; margin: 4px 0; }
    .article-meta { color: #858995; font-size: 12px; }
    .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
    .news-card { transition: transform .18s ease, box-shadow .18s ease; }
    .news-card:hover { transform: translateY(-3px); box-shadow: 0 9px 24px rgba(20,20,30,.08); }
    .news-card-visual { height: 145px; background: #f5dce1; overflow: hidden; }
    .news-card-visual img { width: 100%; height: 100%; object-fit: cover; }
    .news-card-body { padding: 17px; }
    .news-tag { color: #b91c32; font-size: 10px; font-weight: 900; text-transform: uppercase; }
    .news-card-title { font-size: 17px; line-height: 1.45; margin: 8px 0; }
    .pagination { display: flex; justify-content: center; gap: 6px; margin: 28px 0; }
    .pagination a { padding: 7px 11px; border-radius: 6px; background: #f1f5f9; color: #334155; text-decoration: none; }
    .pagination a.active { background: #b91c32; color: white; }
    .empty-state { padding: 35px; border: 1px dashed #d7d8de; color: #737985; text-align: center; }
    .weather-widget { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 22px 0 28px; min-height: 166px; padding: 26px 30px; border: 1px solid #e1e5eb; border-radius: 14px; background: #fff; box-shadow: 0 12px 30px rgba(30, 41, 59, .06); }
    .weather-label { margin: 0 0 6px; color: #172033; font-size: 25px; font-weight: 800; }
    .weather-location, .weather-date { color: #64748b; }
    .weather-date { font-size: 13px; }
    .weather-temperature { color: #c51f3a; font-size: 42px; font-weight: 900; white-space: nowrap; }
    .weather-widget-icon { margin-left: 5px; font-size: 38px; vertical-align: middle; }
    .latest-panel { margin-bottom: 0; }
    .article-link { display: block; }
    .article-link:hover { color: inherit; }
    @@media (max-width: 760px) { .hero-grid { grid-template-columns: 1fr; } .news-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 480px) { .news-grid { grid-template-columns: 1fr; } .weather-widget { align-items: flex-start; flex-direction: column; } }
</style>

<div class="home-page">
    <div class="section-heading">
        <h2 class="section-title">Tin mới nhất</h2>
    </div>

    @if (featured != null)
    {
        <section class="hero-grid">
            <article class="featured-card">
                <a class="featured-visual article-link" href="@Url.Action("View", "Articles", new { id = featured.ArticleID })">
                    @if (!string.IsNullOrWhiteSpace(featured.ImageUrl))
                    {
                        <img src="@featured.ImageUrl" alt="@featured.Title" />
                    }
                    <span class="featured-label">TIN NỔI BẬT</span>
                </a>
                <div class="featured-body">
                    <h1 class="featured-title"><a href="@Url.Action("View", "Articles", new { id = featured.ArticleID })">@featured.Title</a></h1>
                    <a class="article-link" href="@Url.Action("View", "Articles", new { id = featured.ArticleID })"><p class="featured-summary">@featured.Summary</p></a>
                    <div class="article-meta">@featured.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                    @Html.ActionLink("Đọc tiếp", "View", "Articles", new { id = featured.ArticleID }, new { @class = "read-more" })
                </div>
            </article>

            <aside>
                <div class="latest-panel">
                    <h3 class="latest-heading">TIN MỚI NHẤT</h3>
                    @foreach (var item in articles.Take(4))
                    {
                        <div class="latest-item">
                            <span class="latest-number">@item.CreatedDate.ToString("dd")</span>
                            @Html.ActionLink(item.Title, "View", "Articles", new { id = item.ArticleID }, new { @class = "latest-title" })
                            <span class="article-meta">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>

                <section class="weather-widget" aria-label="Thời tiết hôm nay">
                    <div>
                        <h2 class="weather-label">Thời tiết hôm nay</h2>
                        <div class="weather-location" id="home-weather-location">TP. Hồ Chí Minh · Đang cập nhật...</div>
                        <div class="weather-date" id="home-weather-date"></div>
                    </div>
                    <div class="weather-temperature"><span id="home-weather-temperature">--°C</span> <i class="weather-widget-icon fa-regular fa-sun" id="home-weather-icon" aria-hidden="true"></i></div>
                </section>
            </aside>
        </section>

        <div class="section-heading">
            <h2 class="section-title">Các bài viết khác</h2>
        </div>

        if (remaining.Any())
        {
            <section class="news-grid">
                @foreach (var item in remaining)
                {
                    <article class="news-card">
                        <a class="news-card-visual article-link" href="@Url.Action("View", "Articles", new { id = item.ArticleID })">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" />
                            }
                        </a>
                        <div class="news-card-body">
                            <div class="news-tag">@(item.Categories == null ? "TIN TỨC" : item.Categories.CategoryName)</div>
                            <h3 class="news-card-title"><a href="@Url.Action("View", "Articles", new { id = item.ArticleID })">@item.Title</a></h3>
                            <a class="article-link" href="@Url.Action("View", "Articles", new { id = item.ArticleID })"><p class="news-summary">@item.Summary</p></a>
                            @Html.ActionLink("Đọc tiếp", "View", "Articles", new { id = item.ArticleID }, new { @class = "read-more" })
                        </div>

                    </article>
                }
            </section>
        }
    }
    else
    {
        <div class="empty-state">Chưa có bài viết đã xuất bản.</div>
    }

    @if (totalPages > 1)
    {
        <nav class="pagination">
            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <a class="@(pageNumber == currentPage ? "active" : "")"
                   href="@Url.Action("Index", "Home", new { searchString = ViewBag.SearchString, page = pageNumber })">@pageNumber</a>
            }
        </nav>
    }
</div>

<script>
    (function () {
        var city = { name: 'TP. Hồ Chí Minh', latitude: 10.8231, longitude: 106.6297 };
        try {
            var savedCity = localStorage.getItem('newsPortalWeatherCity');
            if (savedCity === 'Da Nang') city = { name: 'Đà Nẵng', latitude: 16.0544, longitude: 108.2022 };
            else if (savedCity === 'Hanoi') city = { name: 'Hà Nội', latitude: 21.0278, longitude: 105.8342 };
            else if (savedCity === 'Can Tho') city = { name: 'Cần Thơ', latitude: 10.0452, longitude: 105.7469 };
            else if (savedCity === 'Hai Phong') city = { name: 'Hải Phòng', latitude: 20.8449, longitude: 106.6881 };
            else if (savedCity === 'Nha Trang') city = { name: 'Nha Trang', latitude: 12.2388, longitude: 109.1967 };
        } catch (ignore) { }

        var today = new Date();
        var dateElement = document.getElementById('home-weather-date');
        var locationElement = document.getElementById('home-weather-location');
        if (dateElement) dateElement.textContent = today.toLocaleDateString('vi-VN', {
            weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric'
        });
        if (locationElement) locationElement.textContent = city.name + ' · Đang cập nhật...';

        fetch('https://api.open-meteo.com/v1/forecast?latitude=' + city.latitude + '&longitude=' + city.longitude + '&current=temperature_2m,weather_code&timezone=auto')
            .then(function (response) {
                if (!response.ok) throw new Error('Weather request failed');
                return response.json();
            })
            .then(function (data) {
                var current = data.current;
                var code = current.weather_code;
                var conditionText = 'Thời tiết hiện tại';
                var conditionIcon = 'fa-cloud';
                if (code === 0) { conditionText = 'Trời quang'; conditionIcon = 'fa-sun'; }
                else if (code === 1) { conditionText = 'Ít mây'; conditionIcon = 'fa-cloud-sun'; }
                else if (code === 2) { conditionText = 'Có mây'; conditionIcon = 'fa-cloud-sun'; }
                else if (code === 3) { conditionText = 'Nhiều mây'; conditionIcon = 'fa-cloud'; }
                else if (code === 45 || code === 48) { conditionText = 'Sương mù'; conditionIcon = 'fa-smog'; }
                else if (code >= 51 && code <= 57) { conditionText = 'Mưa phùn'; conditionIcon = 'fa-cloud-rain'; }
                else if (code >= 61 && code <= 67) { conditionText = 'Mưa'; conditionIcon = 'fa-cloud-rain'; }
                else if (code >= 80 && code <= 82) { conditionText = 'Mưa rào'; conditionIcon = 'fa-cloud-showers-heavy'; }
                else if (code >= 95) { conditionText = 'Có dông'; conditionIcon = 'fa-cloud-bolt'; }

                var weatherLocation = document.getElementById('home-weather-location');
                var weatherTemperature = document.getElementById('home-weather-temperature');
                if (weatherLocation) weatherLocation.textContent = city.name + ' · ' + conditionText;
                if (weatherTemperature) weatherTemperature.textContent = Math.round(current.temperature_2m) + '°C';
                var icon = document.getElementById('home-weather-icon');
                if (icon) icon.className = 'weather-widget-icon fa-solid ' + conditionIcon;
            })
            .catch(function () {
                var weatherLocation = document.getElementById('home-weather-location');
                if (weatherLocation) weatherLocation.textContent = city.name + ' · Chưa thể cập nhật';
            });
    }());
</script>
