        }

    .author-suggestions {
        margin-top: 14px;
    }

    .author-suggestions-title {
        margin: 0 0 8px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .author-suggestion {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px dotted #d1d5db;
    }

    .author-suggestion-avatar {
        flex-basis: 36px;
        width: 36px;
        height: 36px;
        font-size: 15px;
    }

    .author-suggestion-label {
        margin-bottom: 0;
    }

    .author-suggestion a {
        color: #374151;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

        .author-suggestion a:hover {
            color: #b91c32;
        }

    .author-articles-title {
        margin: 0 0 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--red, #b91c1c);
        color: #1f2937;
        font-family: inherit !important;
        font-size: 22px;
        font-weight: 700;
    }

        .author-articles-title span {
            font-size: 13px;
            font-weight: 500;
            color: #64748b;
        }

    .author-article-month {
        margin: 16px 0 12px;
        padding: 7px 10px;
        background: #f3f4f6;
        color: var(--red, #b91c1c);
        font-size: 13px;
        font-weight: 700;
    }

    .author-article-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px 16px;
    }

    .author-article-card {
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        .author-article-card img, .author-article-no-image {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 10;
            object-fit: cover;
            background: #e5e7eb;
        }

    .author-article-body {
        padding-top: 8px;
    }

    .author-article-category {
        color: var(--red, #b91c1c);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .author-article-title {
        margin: 4px 0 8px;
        font-family: inherit;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.4;
    }

    .author-article-date {
        color: #94a3b8;
        font-size: 12px;
    }

    .author-profile-empty {
        padding: 30px 0;
        color: #94a3b8;
    }

    @@media (max-width: 900px) {
        .author-profile-layout {
            grid-template-columns: 230px minmax(0, 1fr);
            gap: 18px;
        }

        .author-article-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .author-profile-layout {
            grid-template-columns: 1fr;
            margin: 18px auto;
        }

        .author-suggestions {
            display: none;
        }

        .author-article-grid {
            gap: 18px 12px;
        }

        .management-page {
            width: calc(100% - 24px);
            margin-top: 22px;
        }

        .admin-author-page .admin-list-panel {
            padding: 14px;
        }

        .management-table th,
        .management-table td {
            padding: 11px 9px;
        }

        .management-table {
            min-width: 540px;
            font-size: 13px;
        }

        .management-header h2 {
            font-size: 24px;
        }

        .btn-add {
            width: 100%;
            text-align: center;
        }

        .admin-search {
            flex-wrap: wrap;
        }

            .admin-search input {
                flex-basis: 100%;
                width: 100%;
            }
    }

    @@media (max-width: 420px) {
        .author-article-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (hasSelectedAuthor)
{
    if (isAdminManagement)
    {
        <div style="max-width: 1160px; margin: 20px auto -12px;">
            <a href="@Url.Content("~/Admin/Author/Index")" style="display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 8px 18px; background: #e2e8f0; color: #334155; border: 0; border-radius: 8px !important; text-decoration: none; font-weight: 700; font-size: 14px; line-height: 1.3;">
                &larr; Quay lại Quản lý Tác giả
            </a>
        </div>
    }

    <div class="author-profile-layout">
        <aside class="author-profile-sidebar">
            <section class="author-profile-box">
                <div class="author-profile-head">
                    @{
                        string selectedAvatar = ResolveAuthorImg(Url, selectedAuthor.Images);
                    }
                    <span class="author-profile-avatar">
                        @if (!string.IsNullOrEmpty(selectedAvatar))
                        {
                            <img src="@selectedAvatar" alt="@selectedAuthor.AuthorName" />
                        }
                        else
                        {
                            @(string.IsNullOrWhiteSpace(selectedAuthor.AuthorName) ? "?" : selectedAuthor.AuthorName.Trim().Substring(0, 1).ToUpper())
                        }
                    </span>
                    <div>
                        <span class="author-profile-label">Tác giả</span>
                        <h1 class="author-profile-name">@selectedAuthor.AuthorName</h1>
                        @if (!string.IsNullOrWhiteSpace(selectedAuthor.Email))
                        {
                            <span class="author-profile-email">@selectedAuthor.Email</span>
                        }
                    </div>
                </div>
                <p class="author-profile-count">
                    @(isAdminManagement ? (articleCount + " bài viết trên hệ thống") : (articleCount + " bài viết đã xuất bản"))
                </p>
                @if (!string.IsNullOrWhiteSpace(selectedAuthor.Email))
                {
                    <a class="author-email-link" href="mailto:@selectedAuthor.Email">Gửi Email cho tác giả</a>
                }
                @if (isAdminManagement)
                {
                    <a class="author-email-link" style="margin-top: 8px; background: #1d4ed8;" href="@Url.RouteUrl("AdminAuthors", new { action = "Edit", id = selectedAuthor.AuthorID })">
                        Chỉnh sửa thông tin tác giả
                    </a>
                }
            </section>

            @if (suggestedAuthors.Any())
            {
                <section class="author-suggestions">
                    <h2 class="author-suggestions-title">@(isAdminManagement ? "Tác giả khác" : "Có thể bạn quan tâm")</h2>
                    @foreach (var suggested in suggestedAuthors)
                    {
                        string suggestedAvatar = ResolveAuthorImg(Url, suggested.Images);
                        var suggestedUrl = isAdminManagement
                            ? Url.RouteUrl("AdminAuthors", new { action = "Index", id = suggested.AuthorID })
                            : Url.RouteUrl("PublicAuthor", new { action = "Index", id = suggested.AuthorID });

                        <div class="author-suggestion">
                            <span class="author-suggestion-avatar">
                                @if (!string.IsNullOrEmpty(suggestedAvatar))
                                {
                                    <img src="@suggestedAvatar" alt="@suggested.AuthorName" />
                                }
                                else
                                {
                                    @(string.IsNullOrWhiteSpace(suggested.AuthorName) ? "?" : suggested.AuthorName.Trim().Substring(0, 1).ToUpper())
                                }
                            </span>
                            <div>
                                <span class="author-suggestion-label">Tác giả</span>
                                <a href="@suggestedUrl">@suggested.AuthorName</a>
                            </div>
                        </div>
                    }
                </section>
            }
        </aside>

        <section class="author-articles">
            <h2 class="author-articles-title">
                @if (isAdminManagement)
                {
                    <text>Danh sách bài viết của tác giả <span>(@articleCount bài)</span></text>
                }
                else
                {
                    <text>Bài viết đã xuất bản <span>(@articleCount bài)</span></text>
                }
            </h2>
            @if (!articles.Any())
            {
                <div class="author-profile-empty">Tác giả này hiện chưa có bài viết nào.</div>
            }
            else
            {
                foreach (var monthGroup in articles.GroupBy(a => new { a.CreatedDate.Year, a.CreatedDate.Month }))
                {
                    <h3 class="author-article-month">Tháng @monthGroup.Key.Month, @monthGroup.Key.Year</h3>
                    <div class="author-article-grid">
                        @foreach (var article in monthGroup)
                        {
                            var articleUrl = isAdminManagement
                                ? Url.RouteUrl("AdminArticles", new { action = "View", id = article.ArticleID })
                                : Url.Action("View", "Articles", new { id = article.ArticleID });
                            string artImg = null;
                            if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                            {
                                artImg = article.ImageUrl.StartsWith("~")
                                    ? Url.Content(article.ImageUrl)
                                    : article.ImageUrl;
                            }
                            <article class="author-article-card">
                                <a href="@articleUrl">
                                    @if (!string.IsNullOrWhiteSpace(artImg))
                                    {
                                        <img src="@artImg" alt="@article.Title" />
                                    }
                                    else
                                    {
                                        <div class="author-article-no-image"></div>
                                    }
                                </a>
                                <div class="author-article-body">
                                    @if (categoryNames.ContainsKey(article.CategoryID))
                                    {
                                        <div class="author-article-category">@categoryNames[article.CategoryID]</div>
                                    }
                                    <h3 class="author-article-title"><a href="@articleUrl">@article.Title</a></h3>
                                    <div class="author-article-date">
                                        @article.CreatedDate.ToString("dd/MM/yyyy")
                                        @if (isAdminManagement)
                                        {
                                            <text> &bull; <strong>[@article.Status]</strong></text>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </section>
    </div>
}
else
{
    string searchFormAction = isAdminManagement
        ? Url.RouteUrl("AdminAuthors", new { action = "Index" })
        : Url.RouteUrl("PublicAuthor", new { action = "Index" });

    <div class="management-page @(isAdminManagement ? "admin-author-page" : "")">
        @if (isAdminManagement)
        {
            <div class="admin-page-heading">
                <div>
                    @if (isAdminUser)
                    {
                        <a href="@Url.Action("Index", "Admin")">&larr; Quay lại Bảng điều khiển Admin</a>
                    }
                    <h2>Quản lý Tác giả</h2>
                </div>
            </div>
        }
        else
        {
            <div class="management-header">
                <div>
                    <h2>Đội ngũ tác giả</h2>
                    <p class="management-subtitle">Khám phá các tác giả và cây bút đóng góp bài viết trên TinNhanh.</p>
                </div>
            </div>
        }

        <div class="admin-list-panel @(isAdminManagement ? "is-admin" : "")">

        @if (TempData["Success"] != null)
        {
            <div style="padding: 14px 18px; margin-bottom: 18px; border-radius: 10px !important; background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; font-weight: 600;">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div style="padding: 14px 18px; margin-bottom: 18px; border-radius: 10px !important; background: #fee2e2; border: 1px solid #fecaca; color: #b91c1c; font-weight: 600;">
                @TempData["Error"]
            </div>
        }

        <form method="get" action="@searchFormAction" class="admin-search">
            <input type="search" name="search" value="@(ViewBag.Search ?? "")" placeholder="Tìm theo tên tác giả hoặc email..." />
            <button type="submit">Tìm kiếm</button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a href="@searchFormAction">Xóa</a>
            }
        </form>

        <div class="management-card">
            <table class="management-table">
                <thead>
                    <tr>
                        <th>Tác giả</th>
                        <th>Email liên hệ</th>
                        <th style="text-align:center;">Số bài viết</th>
                        @if (isAdminManagement)
                        {
                            <th style="text-align:right; width: 160px;">Hồ sơ</th>
                        }
                        else
                        {
                            <th style="text-align:right; width: 160px;">Hồ sơ</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string itemAvatar = ResolveAuthorImg(Url, item.Images);
                            int countForAuthor = articleCounts.ContainsKey(item.AuthorID) ? articleCounts[item.AuthorID] : 0;
                            string profileUrl = isAdminManagement
                                ? Url.RouteUrl("AdminAuthors", new { action = "Index", id = item.AuthorID })
                                : Url.RouteUrl("PublicAuthor", new { action = "Index", id = item.AuthorID });

                            <tr>
                                <td>
                                    <div class="author-cell-wrap">
                                        <span class="author-avatar">
                                            @if (!string.IsNullOrEmpty(itemAvatar))
                                            {
                                                <img src="@itemAvatar" alt="@item.AuthorName" />
                                            }
                                            else
                                            {
                                                @(string.IsNullOrWhiteSpace(item.AuthorName)
                                                    ? "?"
                                                    : item.AuthorName.Trim().Substring(0, 1).ToUpper())
                                            }
                                        </span>
                                        <strong>
                                            <a href="@profileUrl" class="name-link">@item.AuthorName</a>
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="author-email">
                                        @(string.IsNullOrWhiteSpace(item.Email) ? "---" : item.Email)
                                    </span>
                                </td>

                                <td style="text-align:center;">
                                    <span class="author-count-pill">@countForAuthor</span>
                                </td>

                                @if (isAdminManagement)
                                {
                                    <td style="text-align:right;">
                                        <a href="@profileUrl" class="action-link action-edit">Xem bài viết &rarr;</a>
                                    </td>
                                }
                                else
                                {
                                    <td style="text-align:right;">
                                        <a href="@profileUrl" class="action-link action-edit">Xem bài viết &rarr;</a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
            <td colspan="4" class="empty-message">
                                @(string.IsNullOrWhiteSpace(ViewBag.Search as string)
                                    ? "Hiện chưa có tác giả nào trong hệ thống."
                                    : "Không tìm thấy tác giả nào khớp với từ khóa '" + ViewBag.Search + "'.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (isAdminManagement && totalPages > 1)
        {
            <nav class="pagination" aria-label="Phân trang tác giả">
                @if (currentPage > 1)
                {
                    <a class="pagination-direction" href="@(Url.RouteUrl("AdminAuthors", new { action = "Index", search = searchQuery, page = currentPage - 1 }))">Trước</a>
                }
                else
                {
                    <span class="pagination-direction disabled">Trước</span>
                }
                @for (int pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                {
                    <a class="@(pageNumber == currentPage ? "active" : "")" href="@Url.RouteUrl("AdminAuthors", new { action = "Index", search = searchQuery, page = pageNumber })">@pageNumber</a>
                }
                @if (currentPage < totalPages)
                {
                    <a class="pagination-direction" href="@(Url.RouteUrl("AdminAuthors", new { action = "Index", search = searchQuery, page = currentPage + 1 }))">Sau</a>
                }
                else
                {
                    <span class="pagination-direction disabled">Sau</span>
                }
            </nav>
        }
    </div>
    </div>
}
