        }

    .action-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 0 11px;
        margin: 2px;
        border: 1px solid transparent;
        border-radius: 7px !important;
        text-decoration: none !important;
        font-size: 12.5px;
        font-weight: 700;
        transition: background .18s ease, border-color .18s ease, transform .18s ease;
    }

    .action-view {
        color: #0f766e !important;
        border-color: #99f6e4;
        background: #f0fdfa;
    }

        .action-view:hover {
            background: #ccfbf1;
        }

    .action-edit {
        color: #1d4ed8 !important;
        border-color: #dbeafe;
        background: #eff6ff;
    }

        .action-edit:hover {
            border-color: #bfdbfe;
            background: #dbeafe;
            transform: translateY(-1px);
        }

    .action-delete {
        color: #b91c32 !important;
        border-color: #fecdd3;
        background: #fff1f2;
    }

        .action-delete:hover {
            border-color: #fda4af;
            background: #ffe4e6;
            transform: translateY(-1px);
        }

    .empty-message {
        text-align: center;
        padding: 35px !important;
        color: #64748b;
    }

    .author-profile-layout {
        display: grid;
        grid-template-columns: minmax(240px, 310px) minmax(0, 1fr);
        gap: 24px;
        max-width: 1160px;
        margin: 28px auto 36px;
        color: #20232a;
    }

    .author-profile-sidebar, .author-profile-box, .author-suggestions, .author-articles {
        min-width: 0;
    }

    .author-profile-box, .author-suggestions {
        padding: 18px;
        border: 1px solid #e5e7eb;
        border-radius: 8px !important;
        background: #fff;
    }

    .author-profile-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .author-profile-avatar, .author-suggestion-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 56px;
        width: 56px;
        height: 56px;
        border-radius: 50% !important;
        background: #e2e8f0;
        color: #475569;
        font-weight: 700;
        font-size: 22px;
        overflow: hidden;
    }

        .author-avatar img, .author-profile-avatar img, .author-suggestion-avatar img {
            width: 100% !important;
            height: 100% !important;
            max-width: 100% !important;
            max-height: 100% !important;
            object-fit: cover !important;
            border-radius: 50% !important;
            display: block !important;
        }

    .author-profile-label, .author-suggestion-label {
        display: block;
        margin: 0 0 4px;
        color: #64748b;
        font-size: 12px;
    }

    .author-profile-name {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.35;
    }

    .author-profile-email {
        display: block;
        margin-top: 3px;
        color: #64748b;
        font-size: 12px;
