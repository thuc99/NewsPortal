@model IEnumerable<NewsPortal.Models.Author>
@using System.Linq
@using System.Collections.Generic
@using NewsPortal.Models

@{
    var selectedAuthor = ViewBag.SelectedAuthor as Author;
    bool hasSelectedAuthor = selectedAuthor != null && ViewBag.ShowAuthorProfile == true;
    bool isAdminManagement = ViewBag.IsAdminManagement == true;
    var articles = ViewBag.Articles as List<Articles> ?? new List<Articles>();
    var categoryNames = ViewBag.CategoryNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var suggestedAuthors = ViewBag.SuggestedAuthors as List<Author> ?? new List<Author>();
    var articleCounts = ViewBag.ArticleCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var linkedUsernames = ViewBag.LinkedUsernames as Dictionary<int, string> ?? new Dictionary<int, string>();
    int articleCount = ViewBag.ArticleCount == null ? articles.Count : (int)ViewBag.ArticleCount;
    int currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
    string searchQuery = ViewBag.Search as string ?? "";
    bool isAdminUser = Session["Admin"] != null || string.Equals(System.Convert.ToString(Session["Role"]), "Admin", System.StringComparison.OrdinalIgnoreCase);
    ViewBag.Title = hasSelectedAuthor ? selectedAuthor.AuthorName : (isAdminManagement ? "Quản lý tác giả" : "Đội ngũ tác giả");
}

@functions {
    public static string ResolveAuthorImg(UrlHelper url, string rawPath)
    {
        if (string.IsNullOrWhiteSpace(rawPath)) return null;
        rawPath = rawPath.Trim();
        if (rawPath.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase) ||
            rawPath.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase) ||
            rawPath.StartsWith("/"))
        {
            return rawPath;
        }
        if (rawPath.StartsWith("~"))
        {
            return url.Content(rawPath);
        }
        return url.Content("~/Content/Images/Authors/" + rawPath.TrimStart('/'));
    }
}

<style>
    .management-page {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 32px auto;
        padding: 0;
        color: #1e293b;
    }

    .admin-author-page {
        width: 100%;
        max-width: none;
        margin: 0 auto;
    }

    .admin-page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 22px;
    }

        .admin-page-heading > div > a {
            color: #b91c32;
            font-size: 13px;
            font-weight: 700;
        }

        .admin-page-heading h2 {
            margin: 6px 0 0;
            color: #172033;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.2;
        }

    .admin-list-panel.is-admin {
        padding: 22px;
        border: 1px solid #e9e9ed;
        border-radius: 12px;
        background: #fff;
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

        .management-header h2 {
            font-size: 28px;
            font-weight: 750;
            line-height: 1.3;
            margin: 0 0 6px;
        }

    .management-subtitle {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .management-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px !important;
        overflow-x: auto;
    }

    .admin-author-page .management-card {
        border: 0;
        border-radius: 0 !important;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 22px 0;
    }

    .pagination-direction {
        min-width: 64px;
        text-align: center;
    }

    .pagination-direction.disabled {
        padding: 7px 11px;
        background: #f8fafc;
        color: #a0a5ae;
    }

    .pagination a {
        padding: 7px 11px;
