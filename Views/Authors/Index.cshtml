@model IEnumerable<NewsPortal.Models.Author>
@{ ViewBag.Title = "Quản lý tác giả"; }

<h2>Quản lý tác giả</h2>

@if (TempData["Success"] != null)
{<div class="alert alert-success">@TempData["Success"]</div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger">@TempData["Error"]</div>}

<p>@Html.ActionLink("+ Thêm tác giả", "Create", null, new { @class = "btn btn-primary" })</p>

@using (Html.BeginForm("Index", "Authors", FormMethod.Get))
{
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên hoặc email..." class="form-control" style="width:250px; display:inline-block" />
    <button type="submit" class="btn btn-default">Tìm</button>
}
<br />

<table class="table table-striped">
    <tr><th>#</th><th>Tên tác giả</th><th>Email</th><th></th></tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AuthorID</td>
            <td>@item.AuthorName</td>
            <td>@item.Email</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.AuthorID }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.AuthorID })
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="4" class="text-center text-muted">Không có tác giả nào.</td></tr>
    }
</table>