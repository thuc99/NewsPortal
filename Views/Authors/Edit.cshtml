
@model NewsPortal.Models.Author

@{
    ViewBag.Title = "Chỉnh sửa tác giả";
}

<style>
    .form-page {
        max-width: 760px;
        margin: 35px auto;
        padding: 0 18px;
    }

    .form-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(15,23,42,.05);
    }

    .form-page h2 {
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
    }

    .form-sub {
        color: #64748b;
        margin-bottom: 25px;
    }

    .field {
        margin-bottom: 20px;
    }

        .field label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }

        .field input {
            width: 100%;
            padding: 11px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            box-sizing: border-box;
        }

            .field input:focus {
                outline: none;
                border-color: #b91c1c;
            }

            .field input[readonly] {
                background: #f1f5f9;
                color: #64748b;
            }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn-save, .btn-back {
        padding: 10px 17px;
        border-radius: 8px;
        text-decoration: none;
        border: 0;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-save {
        background: #b91c1c;
        color: white;
    }

    .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

    .text-danger, .validation-summary-errors {
        color: #b91c1c;
        font-size: 13px;
    }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>Chỉnh sửa tác giả</h2>
        <p class="form-sub">Cập nhật thông tin tác giả.</p>

        @using (Html.BeginForm("Edit", "Authors", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AuthorID)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="field">
                @Html.LabelFor(m => m.AuthorID, "Mã tác giả")
                @Html.TextBoxFor(m => m.AuthorID, new { @readonly = "readonly" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.AuthorName, "Tên tác giả")
                @Html.TextBoxFor(m => m.AuthorName, new
                {
                    placeholder = "Nhập họ tên tác giả..."
                })
                @Html.ValidationMessageFor(m => m.AuthorName, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Email, "Địa chỉ email")
                @Html.TextBoxFor(m => m.Email, new
                {
                    type = "email",
                    placeholder = "example@email.com"
                })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Lưu thay đổi</button>
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn-back" })
            </div>
        }
    </div>
</div>
