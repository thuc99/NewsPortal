@model NewsPortal.Models.Author

@{
    ViewBag.Title = "Chỉnh sửa tác giả";
    string currentImgUrl = null;
    if (!string.IsNullOrWhiteSpace(Model.Images))
    {
        string raw = Model.Images.Trim();
        if (raw.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase) ||
            raw.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase) ||
            raw.StartsWith("/"))
        {
            currentImgUrl = raw;
        }
        else if (raw.StartsWith("~"))
        {
            currentImgUrl = Url.Content(raw);
        }
        else
        {
            currentImgUrl = Url.Content("~/Content/Images/Authors/" + raw.TrimStart('/'));
        }
    }
    string linkedUsername = ViewBag.LinkedUsername as string;
    string linkedRole = ViewBag.LinkedRole as string;
}

<style>
    body {
        background: #f8fafc;
    }

    .form-page {
        width: min(850px, calc(100% - 32px));
        margin: 35px auto;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 32px 36px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
    }

    .form-page h2 {
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
        margin: 0 0 8px;
    }

    .form-sub {
        color: #64748b;
        margin: 0 0 24px;
    }

    .linked-info {
        padding: 12px 15px;
        border-radius: 8px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        font-size: 13.5px;
        margin-bottom: 22px;
    }

    .field {
        margin-bottom: 22px;
    }

        .field label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }

        .field input:not([type="file"]):not([type="checkbox"]) {
            width: 100%;
            padding: 12px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 14px;
            background: #fff;
        }

        .field input:focus {
            outline: none;
            border-color: #b91c1c;
            box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.08);
        }

        .field input[readonly] {
            background: #f1f5f9;
            color: #64748b;
        }

    .image-upload {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        background: #fff;
        padding: 24px 20px;
        text-align: center;
        transition: .2s;
    }

        .image-upload:hover {
            border-color: #b91c1c;
            background: #fffafa;
        }

        .image-upload input[type="file"] {
            display: none;
        }

    .upload-icon {
        color: #b91c1c;
        margin-bottom: 10px;
    }

        .upload-icon svg {
            width: 40px;
            height: 40px;
        }

    .choose-image-btn {
        display: inline-block;
        background: #b91c1c;
        color: #fff !important;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .choose-image-btn:hover {
            background: #991b1b;
        }

    .upload-description {
        color: #64748b;
        font-size: 13px;
        margin: 10px 0 0;
    }

    .file-name {
        color: #475569;
        font-size: 13px;
        margin-top: 10px;
        overflow-wrap: anywhere;
    }

    .image-preview {
        margin-top: 16px;
        display: none;
    }

        .image-preview img {
            width: 140px;
            height: 140px;
            object-fit: cover;
            border: 2px solid #e2e8f0;
            border-radius: 50%;
            background: #fff;
        }

    .current-image {
        margin-bottom: 16px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        text-align: center;
    }

        .current-image img {
            display: block;
            width: 130px;
            height: 130px;
            object-fit: cover;
            margin: 10px auto;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            background: #fff;
        }

        .current-image p {
            color: #475569;
            font-size: 13px;
            font-weight: 600;
            margin: 0;
        }

    .remove-image-check {
        display: inline-flex !important;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        font-size: 13.5px;
        color: #b91c1c !important;
        cursor: pointer;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 28px;
    }

    .btn-save, .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 8px 18px !important;
        border-radius: 8px;
        text-decoration: none;
        border: 0;
        cursor: pointer;
        font-weight: 700;
        font-size: 14px !important;
        line-height: 1.3;
        text-align: center;
        transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .btn-save {
        background: #b91c1c;
        color: white;
    }

        .btn-save:hover {
            background: #991b1b;
        }

    .btn-back {
        background: #e2e8f0;
        color: #334155 !important;
    }

        .btn-back:hover {
            background: #cbd5e1;
        }

    .text-danger, .validation-summary-errors {
        color: #b91c1c;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    @@media (max-width: 650px) {
        .form-page {
            width: calc(100% - 24px);
            margin-top: 22px;
        }

        .form-card {
            padding: 24px 18px;
        }

        .form-actions {
            flex-wrap: wrap;
        }

        .btn-save, .btn-back {
            flex: 1 1 140px;
        }
    }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>Chỉnh sửa tác giả</h2>
        <p class="form-sub">Cập nhật họ tên, email và ảnh đại diện của tác giả.</p>

        @if (TempData["Success"] != null)
        {
            <div style="padding: 12px 16px; margin-bottom: 18px; border-radius: 8px; background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; font-weight: 600;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="padding: 12px 16px; margin-bottom: 18px; border-radius: 8px; background: #fee2e2; border: 1px solid #fecaca; color: #b91c1c; font-weight: 600;">
                @TempData["Error"]
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(linkedUsername))
        {
            <div class="linked-info">
                Đang liên kết với tài khoản hệ thống: <strong>@linkedUsername</strong> (Cấp bậc: <strong>@linkedRole</strong>). Khi lưu họ tên và email tại đây, tài khoản liên kết sẽ được cập nhật đồng bộ.
            </div>
        }

        <form action="@Url.RouteUrl("AdminAuthors", new { action = "Edit", id = Model.AuthorID })"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AuthorID)
            @Html.HiddenFor(m => m.UserId)

            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="field">
                @Html.LabelFor(m => m.AuthorID, "Mã tác giả")
                @Html.TextBoxFor(m => m.AuthorID, new { @readonly = "readonly" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.AuthorName, "Tên tác giả *")
                @Html.TextBoxFor(m => m.AuthorName, new
                {
                    placeholder = "Nhập họ tên tác giả...",
                    maxlength = "150",
                    required = "required"
                })
                @Html.ValidationMessageFor(m => m.AuthorName, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Email, "Địa chỉ email *")
                @Html.TextBoxFor(m => m.Email, new
                {
                    type = "email",
                    placeholder = "tacgia@email.com",
                    maxlength = "150",
                    required = "required"
                })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                <label>Ảnh đại diện tác giả</label>

                @if (!string.IsNullOrEmpty(currentImgUrl))
                {
                    <div class="current-image" id="currentImage">
                        <p>Ảnh đại diện hiện tại:</p>
                        <img src="@currentImgUrl" alt="@Model.AuthorName" />
                        <label class="remove-image-check">
                            <input type="checkbox" name="removeImage" id="removeImageCheckbox" value="true" />
                            <span>Xóa ảnh đại diện riêng hiện tại khi lưu</span>
                        </label>
                    </div>
                }

                <div class="image-upload">
                    <div class="upload-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 16V4" />
                            <path d="M7 9l5-5 5 5" />
                            <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
                        </svg>
                    </div>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           accept=".jpg,.jpeg,.png,.gif,.webp" />

                    <label for="imageFile" class="choose-image-btn">
                        Chọn ảnh mới từ máy tính
                    </label>

                    <p class="upload-description">
                        Hỗ trợ JPG, JPEG, PNG, GIF, WEBP (tối đa 5 MB)
                    </p>

                    @Html.ValidationMessage("Images", "", new { @class = "text-danger" })

                    <div class="file-name" id="fileName">
                        Chưa chọn ảnh mới
                    </div>

                    <div class="image-preview" id="imagePreview">
                        <img id="previewImage" src="" alt="Ảnh xem trước" />
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Lưu thay đổi</button>
                @Html.RouteLink("Quay lại danh sách", "AdminAuthors", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var imageInput = document.getElementById("imageFile");
        var fileName = document.getElementById("fileName");
        var imagePreview = document.getElementById("imagePreview");
        var previewImage = document.getElementById("previewImage");
        var currentImage = document.getElementById("currentImage");
        var removeCheckbox = document.getElementById("removeImageCheckbox");

        if (!imageInput || !fileName || !imagePreview || !previewImage) return;

        var currentObjectUrl = null;

        imageInput.addEventListener("change", function () {
            var file = this.files && this.files[0];

            if (!file) {
                fileName.textContent = "Chưa chọn ảnh mới";
                imagePreview.style.display = "none";
                previewImage.src = "";
                if (currentImage) currentImage.style.display = "block";
                if (currentObjectUrl) {
                    URL.revokeObjectURL(currentObjectUrl);
                    currentObjectUrl = null;
                }
                return;
            }

            if (!file.type.startsWith("image/")) {
                alert("Vui lòng chọn một tệp hình ảnh hợp lệ.");
                this.value = "";
                fileName.textContent = "Chưa chọn ảnh mới";
                imagePreview.style.display = "none";
                return;
            }

            fileName.textContent = "Ảnh mới đã chọn: " + file.name;
            if (removeCheckbox) removeCheckbox.checked = false;

            if (currentObjectUrl) {
                URL.revokeObjectURL(currentObjectUrl);
            }

            currentObjectUrl = URL.createObjectURL(file);
            previewImage.src = currentObjectUrl;
            imagePreview.style.display = "block";

            if (currentImage) {
                currentImage.style.display = "none";
            }
        });
    });
</script>
