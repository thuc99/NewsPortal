@model NewsPortal.Models.Author

@{
    ViewBag.Title = Model.AuthorName;
    bool isAdmin = Session["Admin"] != null;
    var articles = ViewBag.Articles as List<NewsPortal.Models.Articles>
                   ?? new List<NewsPortal.Models.Articles>();
    var categoryNames = ViewBag.CategoryNames as Dictionary<int, string>
                        ?? new Dictionary<int, string>();
}

@section styles {
    <style>
        .dt-back {
            display: inline-block;
            margin-bottom: 14px;
            color: #64748b;
            font-size: 14px;
            text-decoration: none;
        }

            .dt-back:hover {
                color: var(--red, #c0192f);
            }

        .dt-head {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }

        .dt-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #dbeafe;
            color: #1d4ed8;
            font-weight: 700;
            font-size: 26px;
        }

        .dt-title {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
        }

        .dt-sub {
            color: #64748b;
            margin: 4px 0 0;
            font-size: 14px;
        }

        .dt-edit {
            margin-left: 10px;
            font-size: 13px;
            color: var(--red, #c0192f);
            text-decoration: none;
            font-weight: 700;
        }

        .dt-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .dt-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

            .dt-card img {
                width: 100%;
                aspect-ratio: 4 / 3;
                object-fit: cover;
                display: block;
            }

        .dt-noimg {
            width: 100%;
            aspect-ratio: 4 / 3;
            background: #fee2e2;
        }

        .dt-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
        }

        .dt-cat {
            color: var(--red, #c0192f);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .dt-card h3 {
            margin: 0;
            font-size: 17px;
            line-height: 1.4;
        }

            .dt-card h3 a {
                color: inherit;
                text-decoration: none;
            }

                .dt-card h3 a:hover {
                    color: var(--red, #c0192f);
                }

        .dt-sum {
            color: #64748b;
            font-size: 14px;
        }

        .dt-meta {
            margin-top: auto;
            color: #94a3b8;
            font-size: 12px;
        }

        .dt-more {
            color: var(--red, #c0192f);
            font-weight: 700;
            font-size: 14px;
            text-decoration: none;
        }

        .dt-empty {
            color: #94a3b8;
            padding: 30px 0;
        }
    </style>
}

<a class="dt-back" href="@Url.Action("Index", "Authors")">« Tất cả tác giả</a>

<div class="dt-head">
    <span class="dt-avatar">
        @(string.IsNullOrWhiteSpace(Model.AuthorName)
            ? "?"
            : Model.AuthorName.Trim().Substring(0, 1).ToUpper())
    </span>
    <div>
        <h1 class="dt-title">
            @Model.AuthorName
            @if (isAdmin)
            {
                <a class="dt-edit" href="@Url.Action("Edit", "Authors", new { id = Model.AuthorID })">Sửa</a>
            }
        </h1>
        <p class="dt-sub">@Model.Email · @articles.Count bài viết</p>
    </div>
</div>

@if (!articles.Any())
{
    <div class="dt-empty">Tác giả này chưa có bài viết nào.</div>
}
else
{
    <div class="dt-grid">
        @foreach (var a in articles)
        {
            <div class="dt-card">
                @if (!string.IsNullOrWhiteSpace(a.ImageUrl))
                {
                    <img src="@a.ImageUrl" alt="" />
                }
                else
                {
                    <div class="dt-noimg"></div>
                }
                <div class="dt-body">
                    @if (categoryNames.ContainsKey(a.CategoryID))
                    {
                        <div class="dt-cat">@categoryNames[a.CategoryID]</div>
                    }
                    <h3><a href="@Url.Action("Details", "Articles", new { id = a.ArticleID })">@a.Title</a></h3>
                    <div class="dt-sum">@a.Summary</div>
                    <div class="dt-meta">@a.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                    <a class="dt-more" href="@Url.Action("Details", "Articles", new { id = a.ArticleID })">Đọc tiếp</a>
                </div>
            </div>
        }
    </div>
}