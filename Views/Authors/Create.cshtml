@model NewsPortal.Models.Author
@{ ViewBag.Title = "Thêm tác giả"; }

<h2>Thêm tác giả</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.AuthorName)
        @Html.TextBoxFor(m => m.AuthorName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.AuthorName, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-success">Lưu</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
}