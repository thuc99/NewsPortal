
@model NewsPortal.Models.Author

@{
    ViewBag.Title = "Thêm tác giả";
}

<style>
    .form-page {
        width: min(760px, calc(100% - 32px));
        max-width: 760px;
        margin: 35px auto;
        padding: 0;
    }

    .form-card {
        background: white;
        border: 0;
        border-radius: 0;
        padding: 28px 0;
        box-shadow: none;
    }

    .form-page h2 {
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
    }

    .form-sub {
        color: #64748b;
        margin-bottom: 25px;
    }

    .field {
        margin-bottom: 20px;
    }

        .field label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }

        .field input {
            width: 100%;
            padding: 11px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            box-sizing: border-box;
        }

            .field input:focus {
                outline: none;
                border-color: #b91c1c;
                box-shadow: 0 0 0 3px rgba(185,28,28,.1);
            }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn-save, .btn-back {
        padding: 10px 17px;
        border-radius: 8px;
        text-decoration: none;
        border: 0;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-save {
        background: #b91c1c;
        color: white;
    }

    .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

    .text-danger, .validation-summary-errors {
        color: #b91c1c;
        font-size: 13px;
    }

    @@media (max-width: 650px) {
        .form-page { width: calc(100% - 24px); margin-top: 22px; }
        .form-actions { flex-wrap: wrap; }
        .btn-save, .btn-back { flex: 1 1 160px; text-align: center; }
    }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>Thêm tác giả</h2>
        <p class="form-sub">Thêm thông tin tác giả mới vào NewsPortal.</p>

        @using (Html.BeginForm("Create", "Authors", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="field">
                @Html.LabelFor(m => m.AuthorName, "Tên tác giả")
                @Html.TextBoxFor(m => m.AuthorName, new
                {
                    placeholder = "Nhập họ tên tác giả...",
                    required = "required"
                })
                @Html.ValidationMessageFor(m => m.AuthorName, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Email, "Địa chỉ email")
                @Html.TextBoxFor(m => m.Email, new
                {
                    type = "email",
                    placeholder = "example@email.com",
                    required = "required"
                })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Lưu tác giả</button>
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn-back" })
            </div>
        }
    </div>
</div>
