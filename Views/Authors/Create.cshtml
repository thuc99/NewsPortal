@model NewsPortal.Models.Author

@{
    ViewBag.Title = "Thêm tác giả";
}

<style>
    .form-page {
        width: min(850px, calc(100% - 32px));
        max-width: 850px;
        margin: 36px auto;
    }

    .form-card {
        background: #ffffff;
        padding: 36px 42px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06);
    }

    .form-page h2 {
        font-size: 28px;
        font-weight: 750;
        color: #1e293b;
        margin: 0 0 8px;
    }

    .form-sub {
        color: #64748b;
        font-size: 14.5px;
        margin-bottom: 28px;
    }

    .field {
        margin-bottom: 22px;
    }

        .field label {
            display: block;
            font-weight: 650;
            margin-bottom: 8px;
            color: #334155;
            font-size: 14.5px;
        }

        .field input:not([type="file"]) {
            display: block;
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            box-sizing: border-box;
            font-size: 14.5px;
            background: #ffffff;
            transition: all 0.2s ease;
        }

            .field input:focus {
                outline: none;
                border-color: #b91c1c;
                box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.10);
            }

    .image-upload {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 22px 20px;
        background: #fafcff;
    }

        .image-upload input[type="file"] {
            display: none;
        }

    .choose-image-btn {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: fit-content !important;
        padding: 10px 16px;
        background: #b91c1c;
        color: #ffffff !important;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        margin: 0;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .choose-image-btn:hover {
            background: #991b1b;
            color: #ffffff !important;
            transform: translateY(-1px);
        }

        .choose-image-btn svg {
            width: 17px;
            height: 17px;
            flex-shrink: 0;
        }

    .image-preview {
        display: none;
        margin-top: 16px;
        width: 140px;
        height: 140px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #e2e8f0;
    }

    .image-note {
        color: #64748b;
        font-size: 13px;
        margin: 10px 0 0;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-save, .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 24px;
        border-radius: 9px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-size: 14.5px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .btn-save {
        background: #b91c1c;
        color: #ffffff;
    }

        .btn-save:hover {
            background: #991b1b;
            color: #ffffff;
        }

    .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

        .btn-back:hover {
            background: #cbd5e1;
            color: #1e293b;
        }

    .text-danger,
    .validation-summary-errors {
        color: #b91c1c;
        font-size: 13px;
        margin-top: 5px;
        display: block;
    }

        .validation-summary-errors ul {
            padding-left: 20px;
            margin: 0 0 16px;
        }

    @@media (max-width: 650px) {
        .form-page {
            width: calc(100% - 24px);
            margin: 22px auto;
        }

        .form-card {
            padding: 24px 18px;
        }

        .form-actions {
            flex-wrap: wrap;
        }

        .btn-save, .btn-back {
            flex: 1 1 140px;
        }
    }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>Thêm tác giả mới</h2>
        <p class="form-sub">
            Nhập thông tin tác giả mới vào hệ thống. Nếu email trùng với tài khoản có sẵn, hệ thống sẽ tự động liên kết.
        </p>

        <form action="@Url.RouteUrl("AdminAuthors", new { action = "Create" })"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="field">
                @Html.LabelFor(m => m.AuthorName, "Tên tác giả *")
                @Html.TextBoxFor(m => m.AuthorName, new
                {
                    placeholder = "Nhập họ tên hoặc bút danh tác giả...",
                    maxlength = "150",
                    required = "required"
                })
                @Html.ValidationMessageFor(m => m.AuthorName, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Email, "Địa chỉ email *")
                @Html.TextBoxFor(m => m.Email, new
                {
                    type = "email",
                    placeholder = "tacgia@email.com",
                    maxlength = "150",
                    required = "required"
                })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                <label>Ảnh đại diện tác giả (tùy chọn)</label>
                <div class="image-upload">
                    <label for="imageFile" class="choose-image-btn">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <path d="m21 15-5-5L5 21"></path>
                        </svg>
                        Chọn ảnh từ máy tính
                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           accept=".jpg,.jpeg,.png,.gif,.webp" />

                    <p class="image-note" id="selectedFileNote">
                        Hỗ trợ JPG, JPEG, PNG, GIF, WEBP. Dung lượng tối đa 5 MB.
                    </p>

                    @Html.ValidationMessage("Images", "", new { @class = "text-danger" })

                    <img id="imagePreview"
                         class="image-preview"
                         alt="Ảnh xem trước" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Lưu tác giả</button>
                @Html.RouteLink("Quay lại danh sách", "AdminAuthors", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var imageInput = document.getElementById("imageFile");
        var preview = document.getElementById("imagePreview");
        var fileNote = document.getElementById("selectedFileNote");

        if (!imageInput || !preview) return;

        imageInput.addEventListener("change", function () {
            var file = this.files && this.files[0];

            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = "block";
                if (fileNote) fileNote.textContent = "Đã chọn ảnh: " + file.name;
            } else {
                preview.removeAttribute("src");
                preview.style.display = "none";
                if (fileNote) fileNote.textContent = "Hỗ trợ JPG, JPEG, PNG, GIF, WEBP. Dung lượng tối đa 5 MB.";
            }
        });
    });
</script>
