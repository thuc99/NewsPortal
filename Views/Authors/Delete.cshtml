@model NewsPortal.Models.Author

@{
    ViewBag.Title = "Xóa tác giả";
    int articleCount = ViewBag.ArticleCount == null ? 0 : (int)ViewBag.ArticleCount;
    string linkedUsername = ViewBag.LinkedUsername as string;

    string avatarUrl = null;
    if (!string.IsNullOrWhiteSpace(Model.Images))
    {
        string raw = Model.Images.Trim();
        avatarUrl = (raw.StartsWith("http", System.StringComparison.OrdinalIgnoreCase) || raw.StartsWith("/"))
            ? raw
            : (raw.StartsWith("~") ? Url.Content(raw) : Url.Content("~/Content/Images/Authors/" + raw.TrimStart('/')));
    }
}

<style>
    .delete-page {
        width: min(720px, calc(100% - 32px));
        max-width: 720px;
        margin: 38px auto;
    }

    .delete-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 30px 34px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
    }

        .delete-card h2 {
            color: #b91c1c;
            font-size: 26px;
            font-weight: 750;
            margin: 0 0 12px;
        }

    .delete-warning {
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        padding: 14px 16px;
        margin: 16px 0 20px;
        line-height: 1.55;
    }

    .delete-blocked {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 14px 16px;
        margin: 16px 0 20px;
        line-height: 1.55;
    }

    .delete-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 8px;
    }

    .delete-avatar {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #dbeafe;
        color: #1d4ed8;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 700;
        overflow: hidden;
        flex-shrink: 0;
    }

        .delete-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .delete-info {
        padding: 11px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 14.5px;
    }

    .delete-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
        flex-wrap: wrap;
    }

    .btn-delete, .btn-back, .btn-articles {
        border: 0;
        min-height: 42px;
        padding: 0 19px;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .btn-delete {
        background: #b91c1c;
        color: white;
    }

        .btn-delete:hover {
            background: #991b1b;
        }

    .btn-articles {
        background: #1d4ed8;
        color: #fff !important;
    }

    .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

        .btn-back:hover {
            background: #cbd5e1;
        }

    @@media (max-width: 650px) {
        .delete-page { width: calc(100% - 24px); margin-top: 22px; }
        .delete-card { padding: 22px 18px; }
        .btn-delete, .btn-back, .btn-articles { flex: 1 1 150px; }
    }
</style>

<div class="delete-page">
    <div class="delete-card">
        <h2>Xóa tác giả</h2>

        @if (articleCount > 0)
        {
            <div class="delete-blocked">
                <strong>Chưa thể xóa tác giả này!</strong><br />
                Tác giả <strong>@Model.AuthorName</strong> hiện đang có <strong>@articleCount bài viết</strong> trên hệ thống. Vui lòng chuyển tác giả hoặc xóa các bài viết liên quan trước khi xóa hồ sơ tác giả.
            </div>
        }
        else
        {
            <div class="delete-warning">
                Bạn có chắc chắn muốn xóa vĩnh viễn hồ sơ tác giả này không? Thao tác này không thể hoàn tác.
                @if (!string.IsNullOrWhiteSpace(linkedUsername))
                {
                    <div style="margin-top:6px;">
                        Tài khoản liên kết <strong>@linkedUsername</strong> sẽ được chuyển về cấp bậc <strong>Độc giả (Reader)</strong> (không bị xóa tài khoản).
                    </div>
                }
            </div>
        }

        <div class="delete-head">
            <span class="delete-avatar">
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img src="@avatarUrl" alt="@Model.AuthorName" />
                }
                else
                {
                    @(string.IsNullOrWhiteSpace(Model.AuthorName) ? "?" : Model.AuthorName.Trim().Substring(0, 1).ToUpper())
                }
            </span>
            <div>
                <div style="font-size:18px; font-weight:700; color:#1e293b;">@Model.AuthorName</div>
                <div style="font-size:13.5px; color:#64748b;">@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa có email" : Model.Email)</div>
            </div>
        </div>

        <div class="delete-info">
            <strong>Mã tác giả:</strong> #@Model.AuthorID
        </div>
        <div class="delete-info">
            <strong>Số bài viết liên kết:</strong> @articleCount bài viết
        </div>
        @if (!string.IsNullOrWhiteSpace(linkedUsername))
        {
            <div class="delete-info">
                <strong>Tài khoản liên kết:</strong> @linkedUsername
            </div>
        }

        <form action="@Url.RouteUrl("AdminAuthors", new { action = "Delete", id = Model.AuthorID })" method="post">
            @Html.AntiForgeryToken()

            <div class="delete-actions">
                @if (articleCount == 0)
                {
                    <button type="submit" class="btn-delete">Xác nhận xóa tác giả</button>
                }
                else
                {
                    <a class="btn-articles" href="@Url.RouteUrl("AdminArticles", new { action = "Index", authorId = Model.AuthorID })">
                        Xem @articleCount bài viết của tác giả
                    </a>
                }
                @Html.RouteLink("Quay lại danh sách", "AdminAuthors", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>
