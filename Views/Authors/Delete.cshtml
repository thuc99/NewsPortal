
@model NewsPortal.Models.Author

@{
    ViewBag.Title = "Xóa tác giả";
}

<style>
    .delete-page {
        width: min(700px, calc(100% - 32px));
        max-width: 700px;
        margin: 40px auto;
        padding: 0;
    }

    .delete-card {
        background: white;
        border: 0;
        border-radius: 0;
        padding: 0 0 30px;
    }

        .delete-card h2 {
            color: #b91c1c;
            font-size: 26px;
            font-weight: 750;
        }

    .delete-warning {
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        padding: 14px;
        margin: 20px 0;
    }

    .delete-info {
        padding: 12px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .delete-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn-delete, .btn-back {
        border: 0;
        padding: 10px 17px;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-delete {
        background: #b91c1c;
        color: white;
    }

    .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

    @@media (max-width: 650px) {
        .delete-page { width: calc(100% - 24px); margin-top: 22px; }
        .delete-actions { flex-wrap: wrap; }
        .btn-delete, .btn-back { flex: 1 1 160px; text-align: center; }
    }
</style>

<div class="delete-page">
    <div class="delete-card">
        <h2>Xóa tác giả</h2>

        <div class="delete-warning">
            Bạn có chắc chắn muốn xóa tác giả này không?
            Nếu tác giả vẫn còn bài viết, hệ thống sẽ từ chối thao tác.
        </div>

        <div class="delete-info">
            <strong>Mã tác giả:</strong> @Model.AuthorID
        </div>
        <div class="delete-info">
            <strong>Tên tác giả:</strong> @Model.AuthorName
        </div>
        <div class="delete-info">
            <strong>Email:</strong> @Model.Email
        </div>

        <form action="@Url.RouteUrl("AdminAuthors", new { action = "Delete", id = Model.AuthorID })" method="post">
            @Html.AntiForgeryToken()

            <div class="delete-actions">
                <button type="submit" class="btn-delete">Xác nhận xóa</button>
                @Html.RouteLink("Hủy", "AdminAuthors", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>
