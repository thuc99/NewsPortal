
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TinNhanh</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    @{
        string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        string currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
        bool isFavoritesPage = currentController == "Articles" && currentAction == "Favorites";
    }

    <style>
        :root {
            --red: #b91c32;
            --red-dark: #861b2b;
            --ink: #20232a;
            --muted: #737985;
            --line: #e9e9ed;
            --paper: #ffffff;
            --soft: #f6f7f9;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: "Segoe UI", Arial, sans-serif;
            line-height: 1.65;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

            a:hover {
                color: var(--red);
            }

        .top-strip {
            background: var(--red-dark);
            color: white;
            font-size: 12px;
            padding: 7px 0;
        }

        .container {
            width: min(1160px, calc(100% - 32px));
            margin: auto;
        }

        .top-inner {
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }

        .masthead {
            padding: 25px 0;
            border-bottom: 1px solid var(--line);
        }

        .brand-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .brand {
            position: relative;
            display: inline-block;
            padding-bottom: 5px;
            font-size: 40px;
            font-weight: 900;
            letter-spacing: -2.5px;
            line-height: 1.2;
            color: #20232a;
            animation: brand-pop .8s ease-out both;
        }

            .brand::first-letter {
                color: #20232a;
            }

        .brand-red {
            color: #a51f33;
        }

        .brand::after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 4px;
            border-radius: 5px;
            background: #b91c32;
            transform-origin: left center;
            animation: brand-underline .9s .25s ease-out both;
        }

        @@keyframes brand-pop {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes brand-underline {
            from {
                transform: scaleX(0);
            }

            to {
                transform: scaleX(1);
            }
        }

        .brand-caption {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
        }

        .brand-note {
            color: var(--muted);
            font-size: 13px;
            text-align: right;
        }

        /* THANH ĐIỀU HƯỚNG */

        .navbar {
            background: white;
            border-bottom: 1px solid var(--line);
            position: relative;
            z-index: 2;
        }

        .nav-inner {
            display: flex;
            align-items: center;
            gap: 18px;
            min-height: 53px;
            width: min(1160px, calc(100% - 32px));
            margin: auto;
            flex-wrap: nowrap;
        }

        .nav-link {
            display: inline-flex;
            align-items: center;
            min-height: 53px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 3px solid transparent;
            padding-top: 3px;
            white-space: nowrap;
        }

            .nav-link:hover {
                color: var(--red);
                border-bottom-color: var(--red);
            }

            .nav-link.active {
                color: var(--red);
                border-bottom-color: var(--red);
            }

        /* TÌM KIẾM */

        .search-form {
            display: flex;
            align-items: center;
            margin-left: auto;
            gap: 7px;
        }

        .search-input {
            width: 180px;
            height: 36px;
            padding: 0 12px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            outline: none;
            font-size: 13px;
            transition: border-color .2s;
        }

            .search-input:focus {
                border-color: var(--red);
            }

        .search-button {
            height: 36px;
            padding: 0 13px;
            background: var(--red);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s;
            white-space: nowrap;
        }

            .search-button:hover {
                background: var(--red-dark);
            }

        .search-reset {
            display: inline-block;
            padding: 0 8px;
            height: 36px;
            line-height: 36px;
            color: var(--red);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: color .2s;
        }

            .search-reset:hover {
                color: var(--red-dark);
            }

        /* TÀI KHOẢN */

        .admin-area {
            margin-left: 0;
            flex-shrink: 0;
        }

        .account-area {
            position: relative;
            margin-left: 4px;
            flex-shrink: 0;
        }

        .user-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: 0;
            border-radius: 50%;
            background: #f1f5f9;
            color: #20232a;
            cursor: pointer;
            transition: .2s ease;
        }

            .user-toggle:hover,
            .account-area.open .user-toggle {
                background: var(--red);
                color: white;
                transform: translateY(-1px);
            }

            .user-toggle svg {
                width: 21px;
                height: 21px;
            }

        .account-menu {
            position: absolute;
            top: calc(100% + 9px);
            right: 0;
            z-index: 20;
            display: none;
            min-width: 170px;
            padding: 8px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: white;
            box-shadow: 0 12px 28px rgba(30, 41, 59, .15);
        }

        .account-area.open .account-menu {
            display: block;
        }

        .account-menu-link {
            display: block;
            padding: 9px 11px;
            border-radius: 6px;
            color: #475569 !important;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
        }

            .account-menu-link:hover,
            .account-menu-link.favorite-active {
                background: #fff1f2;
                color: var(--red) !important;
            }

        main {
            min-height: 60vh;
        }

        .page-content {
            padding: 32px 0 55px;
        }

        /* FOOTER */

        .site-footer {
            background: #1d2027;
            color: #d8d9de;
            padding: 35px 0 20px;
            margin-top: 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 35px;
        }

        .footer-brand {
            color: white;
            font-size: 23px;
            font-weight: 900;
        }

            .footer-brand span {
                color: #ef6477;
            }

        .footer-text {
            color: #b9bbc4;
            font-size: 13px;
            max-width: 520px;
        }

        .footer-heading {
            color: white;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: 13px;
        }

        .footer-bottom {
            border-top: 1px solid #383b43;
            margin-top: 25px;
            padding-top: 15px;
            color: #a8abb4;
            font-size: 12px;
        }

        /* CỬA SỔ ĐĂNG NHẬP */

        .login-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: rgba(15, 23, 42, .35);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

            .login-overlay.show {
                display: flex;
            }

        .login-modal {
            position: relative;
            width: 100%;
            max-width: 850px;
            display: grid;
            grid-template-columns: .9fr 1.1fr;
            overflow: hidden;
            border-radius: 18px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 20px 60px rgba(0, 0, 0, .2);
            animation: loginAppear .25s ease;
        }

        @@keyframes loginAppear {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .login-close {
            position: absolute;
            z-index: 2;
            right: 15px;
            top: 10px;
            width: 35px;
            height: 35px;
            border: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, .8);
            color: #475569;
            font-size: 25px;
            cursor: pointer;
        }

            .login-close:hover {
                background: #fee2e2;
                color: #b91c1c;
            }

        .login-banner {
            padding: 45px 35px;
            color: white;
            background: linear-gradient(145deg, #991b1b, #450a0a);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-brand {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 55px;
        }

            .login-brand i {
                margin-right: 8px;
            }

        .login-banner h2 {
            font-size: 30px;
            line-height: 1.3;
            margin: 0 0 15px;
        }

        .login-banner p {
            color: rgba(255, 255, 255, .8);
            line-height: 1.7;
            font-size: 14px;
        }

        .login-form-section {
            padding: 55px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-form-section h2 {
                font-size: 28px;
                color: #0f172a;
                margin: 0 0 8px;
            }

            .login-form-section > p {
                color: #64748b;
                font-size: 14px;
                margin: 0 0 28px;
            }

        .login-group {
            margin-bottom: 20px;
        }

            .login-group label {
                display: block;
                margin-bottom: 8px;
                color: #334155;
                font-size: 13px;
                font-weight: 700;
            }

            .login-group input {
                width: 100%;
                height: 48px;
                padding: 0 14px;
                border: 1px solid #cbd5e1;
                border-radius: 9px;
                outline: none;
                background: #f8fafc;
            }

                .login-group input:focus {
                    border-color: #b91c1c;
                    box-shadow: 0 0 0 3px rgba(185, 28, 28, .1);
                }

        .login-submit {
            width: 100%;
            height: 49px;
            border: 0;
            border-radius: 9px;
            background: #b91c1c;
            color: white;
            font-weight: 700;
            cursor: pointer;
            margin-top: 5px;
        }

            .login-submit:hover {
                background: #991b1b;
            }

        .login-error {
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            background: #fef2f2;
            color: #b91c1c;
            font-size: 13px;
        }

        /* RESPONSIVE */

        @@media (max-width: 1100px) {
            .nav-inner {
                gap: 14px;
            }

            .nav-link {
                font-size: 12px;
            }

            .search-input {
                width: 155px;
            }
        }

        @@media (max-width: 900px) {
            .nav-inner {
                gap: 18px;
                flex-wrap: wrap;
                padding-top: 8px;
            }

            .search-form {
                width: 100%;
                margin-left: 0;
                padding-bottom: 12px;
                order: 3;
            }

            .search-input {
                width: 100%;
                flex: 1;
            }

            .account-area {
                margin-left: auto;
            }
        }

        @@media (max-width: 650px) {
            .container {
                width: calc(100% - 24px);
            }

            .masthead {
                padding: 18px 0;
            }

            .brand-row,
            .top-inner {
                align-items: flex-start;
                flex-direction: column;
            }

            .brand {
                font-size: 27px;
            }

            .brand-note {
                display: none;
            }

            .nav-inner {
                gap: 18px;
                padding-top: 5px;
            }

            .nav-link {
                min-height: 42px;
                font-size: 11px;
            }

            .search-form {
                width: 100%;
                margin: 5px 0 12px;
                flex-wrap: wrap;
            }

            .search-input {
                flex: 1;
                width: auto;
                min-width: 0;
            }

            .search-button,
            .search-reset {
                flex: 0 0 auto;
            }

            .footer-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .top-inner {
                flex-direction: column;
                gap: 0;
            }

            .login-modal {
                max-width: 420px;
                grid-template-columns: 1fr;
                max-height: 90vh;
                overflow-y: auto;
            }

            .login-banner {
                padding: 25px;
            }

            .login-brand {
                margin-bottom: 20px;
            }

            .login-banner h2 {
                font-size: 24px;
            }

            .login-form-section {
                padding: 30px 25px;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>

<body>
    <!-- THANH THÔNG TIN PHÍA TRÊN -->
    <div class="top-strip">
        <div class="container top-inner">
            <span>TIN TỨC • CÔNG NGHỆ • ĐỜI SỐNG</span>
            <span>Cập nhật thông tin mỗi ngày</span>
        </div>
    </div>

    <!-- LOGO -->
    <header class="masthead">
        <div class="container brand-row">
            <div>
                <a class="brand" href="@Url.Action("Index", "Home")">
                    Tin<span class="brand-red">Nhanh</span>
                </a>

                <div class="brand-caption">
                    Thông tin mới · Góc nhìn đa chiều
                </div>
            </div>

            <div class="brand-note">
                Cập nhật kiến thức<br />
                Kết nối thông tin
            </div>
        </div>
    </header>

    <!-- THANH ĐIỀU HƯỚNG -->
    <nav class="navbar">
        <div class="container nav-inner">

            <a class="nav-link @(currentController == "Home" && !isFavoritesPage ? "active" : "")"
               href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            <a class="nav-link @(currentController == "Articles" && !isFavoritesPage ? "active" : "")"
               href="@Url.Action("Index", "Articles")">
                Tin tức
            </a>

            <a class="nav-link @(currentController == "Categories" ? "active" : "")"
               href="@Url.Action("Index", "Categories")">
                Danh mục
            </a>

            <a class="nav-link @(currentController == "Authors" ? "active" : "")"
               href="@Url.Action("Index", "Authors")">
                Tác giả
            </a>

            <!-- TÌM KIẾM -->
            <form action="@Url.Action("Index", "Articles")"
                  method="get"
                  class="search-form">

                <input type="search"
                       name="searchString"
                       class="search-input"
                       placeholder="Tìm kiếm bài viết..." />

                <button type="submit" class="search-button">
                    Tìm kiếm
                </button>
            </form>

            <!-- TÀI KHOẢN -->
            <div class="account-area" id="account-area">

                <button type="button"
                        class="user-toggle"
                        id="user-toggle"
                        aria-label="Mở menu tài khoản"
                        aria-expanded="false">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">

                        <circle cx="12" cy="8" r="3.5"></circle>
                        <path d="M5 20c.8-3.1 3.2-5 7-5s6.2 1.9 7 5"></path>
                    </svg>
                </button>

                <div class="account-menu" id="account-menu">

                    @if (Session["Admin"] == null)
                    {
                        <a href="#"
                           class="account-menu-link"
                           onclick="openLogin(); return false;">
                            Đăng nhập
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Logout", "Account")"
                           class="account-menu-link">
                            Đăng xuất
                        </a>
                    }

                    <a href="@Url.Action("Favorites", "Articles")"
                       class="account-menu-link @(isFavoritesPage ? "favorite-active" : "")">
                        ♡ Yêu thích
                    </a>

                </div>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG TRANG -->
    <main>
        <div class="container page-content">
            @RenderBody()
        </div>
    </main>

    <!-- CỬA SỔ ĐĂNG NHẬP DÙNG CHUNG -->
    @if (Session["Admin"] == null)
    {
        <div id="loginModal" class="login-overlay">
            <div class="login-modal">

                <button type="button"
                        class="login-close"
                        onclick="closeLogin()">
                    &times;
                </button>

                <div class="login-banner">
                    <div class="login-brand">
                        <i class="fa-solid fa-newspaper"></i>
                        TinNhanh
                    </div>

                    <h2>Chào mừng<br />quay trở lại!</h2>

                    <p>
                        Đăng nhập để quản lý bài viết, tác giả
                        và danh mục tin tức.
                    </p>
                </div>

                <div class="login-form-section">
                    <h2>Đăng nhập</h2>
                    <p>Vui lòng nhập thông tin tài khoản.</p>

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="login-group">
                            <label for="loginUsername">Tên đăng nhập</label>

                            <input type="text"
                                   id="loginUsername"
                                   name="username"
                                   placeholder="Nhập tên đăng nhập"
                                   autocomplete="username"
                                   required />
                        </div>

                        <div class="login-group">
                            <label for="loginPassword">Mật khẩu</label>

                            <input type="password"
                                   id="loginPassword"
                                   name="password"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password"
                                   required />
                        </div>

                        <button type="submit" class="login-submit">
                            ĐĂNG NHẬP
                            <i class="fa-solid fa-arrow-right-to-bracket"
                               style="margin-left:7px;"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">

                <div>
                    <div class="footer-brand">
                        Tin<span>Nhanh</span>
                    </div>

                    <p class="footer-text">
                        TinNhanh là website tổng hợp và chia sẻ tin tức,
                        mang đến nội dung dễ đọc, rõ ràng và thuận tiện cho người dùng.
                    </p>
                </div>

                <div>
                    <div class="footer-heading">LIÊN KẾT</div>

                    <div class="footer-links">
                        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                        <a href="@Url.Action("Index", "Articles")">Tin tức</a>
                        <a href="@Url.Action("Index", "Categories")">Danh mục</a>
                        <a href="@Url.Action("Index", "Authors")">Tác giả</a>
                    </div>
                </div>

            </div>

            <div class="footer-bottom">
                © @DateTime.Now.Year TinNhanh. Website phục vụ mục đích học tập.
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT TÀI KHOẢN -->
    <script>
        (function () {
            var accountArea = document.getElementById('account-area');
            var userToggle = document.getElementById('user-toggle');

            if (!accountArea || !userToggle) return;

            userToggle.addEventListener('click', function (event) {
                event.stopPropagation();

                var isOpen = accountArea.classList.toggle('open');

                userToggle.setAttribute(
                    'aria-expanded',
                    isOpen ? 'true' : 'false'
                );
            });

            document.addEventListener('click', function (event) {
                if (!accountArea.contains(event.target)) {
                    accountArea.classList.remove('open');
                    userToggle.setAttribute('aria-expanded', 'false');
                }
            });
        }());

        // MỞ CỬA SỔ ĐĂNG NHẬP
        function openLogin() {
            var modal = document.getElementById("loginModal");

            if (modal) {
                var accountArea = document.getElementById("account-area");

                if (accountArea) {
                    accountArea.classList.remove("open");

                    var toggle = document.getElementById("user-toggle");

                    if (toggle) {
                        toggle.setAttribute("aria-expanded", "false");
                    }
                }

                modal.classList.add("show");
                document.body.style.overflow = "hidden";
            }
        }

        // ĐÓNG CỬA SỔ ĐĂNG NHẬP
        function closeLogin() {
            var modal = document.getElementById("loginModal");

            if (modal) {
                modal.classList.remove("show");
                document.body.style.overflow = "";
            }
        }

        // ĐÓNG KHI NHẤN BÊN NGOÀI HOẶC PHÍM ESC
        document.addEventListener("DOMContentLoaded", function () {
            var modal = document.getElementById("loginModal");

            if (modal) {
                modal.addEventListener("click", function (event) {
                    if (event.target === modal) {
                        closeLogin();
                    }
                });

                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        closeLogin();
                    }
                });
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
