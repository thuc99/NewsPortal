<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TinNhanh</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/chatbot.css")" />

    @{
        string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        string currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
        bool isFavoritesPage = currentController == "Articles" && currentAction == "Favorites";
        bool isArticlesPage = currentController == "Articles" && !isFavoritesPage;
        bool isCategoriesPage = currentController == "Categories";
        bool isAuthorsPage = currentController == "Authors";
    }

    <style>
        :root {
            --red: #b91c32;
            --red-dark: #861b2b;
            --ink: #20232a;
            --muted: #737985;
            --line: #e9e9ed;
            --paper: #ffffff;
            --soft: #f6f7f9;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: "Segoe UI", Arial, sans-serif;
            line-height: 1.65;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

            a:hover {
                color: var(--red);
            }

        .top-strip {
            background: var(--red-dark);
            color: white;
            font-size: 12px;
            padding: 7px 0;
        }

        .container {
            width: min(1160px, calc(100% - 32px));
            margin: auto;
        }

        .top-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .weather-strip {
            position: relative;
            background: transparent;
            margin-right: auto;
        }

        .weather-strip-inner {
            position: relative;
            display: flex;
            min-height: 34px;
            align-items: center;
            justify-content: flex-start;
        }

        .weather-summary {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 2px 0;
            border: 0;
            background: transparent;
            color: #fff;
            font: inherit;
            cursor: pointer;
            white-space: nowrap;
        }

        .weather-summary:hover,
        .weather-summary[aria-expanded="true"] {
            color: #fff;
        }

        .weather-summary-date {
            padding-right: 12px;
            border-right: 1px solid rgba(255, 255, 255, .45);
            color: rgba(255, 255, 255, .9);
            white-space: nowrap;
        }

        .weather-summary-city {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
        }

        .top-inner > span {
            font-size: 12px;
            white-space: nowrap;
        }

        .weather-summary-temp {
            font-weight: 700;
            white-space: nowrap;
        }

        .weather-summary-icon {
            color: rgba(255, 255, 255, .9);
            font-size: 20px;
        }

        .weather-panel {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            z-index: 50;
            display: none;
            width: min(390px, calc(100vw - 28px));
            padding: 20px;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            background: #fff;
            box-shadow: 0 16px 40px rgba(15, 23, 42, .16);
        }

        .weather-strip.is-open .weather-panel {
            display: block;
        }

        .weather-city-select {
            width: 100%;
            min-height: 44px;
            padding: 0 12px;
            border: 1px solid #d7dce3;
            border-radius: 8px;
            background: #fff;
            color: #334155;
            font: inherit;
        }

        .weather-current {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 0 12px;
        }

        .weather-temperature {
            color: #079bd3;
            font-size: 62px;
            font-weight: 300;
            letter-spacing: -3px;
            line-height: 1;
        }

        .weather-condition-icon {
            color: #079bd3;
            font-size: 42px;
        }

        .weather-condition-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0 10px;
            border-bottom: 1px solid #e5e7eb;
            color: #334155;
            font-size: 14px;
            font-weight: 650;
        }

        .weather-detail-row {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            border-bottom: 1px solid #e5e7eb;
            color: #64748b;
        }

        .weather-detail-row:last-child {
            border-bottom: 0;
        }

        .weather-detail-row strong {
            color: #334155;
            font-weight: 600;
        }

        .weather-status {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 12px;
        }

        .masthead {
            padding: 25px 0;
            border-bottom: 1px solid var(--line);
        }

        .brand-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .brand-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-left: auto;
        }

        .brand {
            position: relative;
            display: inline-block;
            padding-bottom: 5px;
            font-size: 40px;
            font-weight: 900;
            letter-spacing: -2.5px;
            line-height: 1.2;
            color: #20232a;
            animation: brand-pop .8s ease-out both;
        }

            .brand::first-letter {
                color: #20232a;
            }

        .brand-red {
            color: #a51f33;
        }

        .brand::after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 4px;
            border-radius: 5px;
            background: #b91c32;
            transform-origin: left center;
            animation: brand-underline .9s .25s ease-out both;
        }

        @@keyframes brand-pop {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes brand-underline {
            from {
                transform: scaleX(0);
            }

            to {
                transform: scaleX(1);
            }
        }

        .brand-caption {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
        }

        /* THANH ĐIỀU HƯỚNG */

        .navbar {
            background: white;
            border-bottom: 1px solid var(--line);
            position: relative;
            z-index: 2;
        }

        .nav-inner {
            display: flex;
            align-items: center;
            gap: 18px;
            min-height: 53px;
            width: min(1160px, calc(100% - 32px));
            margin: auto;
            flex-wrap: nowrap;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 18px;
            min-width: 0;
        }

        .nav-link {
            display: inline-flex;
            align-items: center;
            min-height: 53px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 3px solid transparent;
            padding-top: 3px;
            white-space: nowrap;
        }

            .nav-link:hover {
                color: var(--red);
                border-bottom-color: var(--red);
            }

            .nav-link.active {
                color: var(--red);
                border-bottom-color: var(--red);
            }

            .nav-link.active:hover {
                color: var(--red);
                border-bottom-color: var(--red);
            }

        .nav-dropdown {
            position: relative;
            align-self: stretch;
            margin-left: auto;
        }

        .hamburger-toggle {
            display: flex;
            width: 44px;
            height: 44px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            margin-top: 4px;
            border: 0;
            border-radius: 6px;
            background: transparent;
            color: #20232a;
            cursor: pointer;
            transition: background .2s ease, color .2s ease;
        }

        .hamburger-toggle:hover,
        .nav-dropdown.open .hamburger-toggle {
            background: #fff1f2;
            color: var(--red);
        }

        .hamburger-toggle span {
            width: 22px;
            height: 2px;
            border-radius: 2px;
            background: currentColor;
            transition: transform .25s ease, opacity .2s ease;
        }

        .nav-dropdown.open .hamburger-toggle span:first-child {
            transform: translateY(7px) rotate(45deg);
        }

        .nav-dropdown.open .hamburger-toggle span:nth-child(2) {
            opacity: 0;
        }

        .nav-dropdown.open .hamburger-toggle span:last-child {
            transform: translateY(-7px) rotate(-45deg);
        }

        .nav-dropdown-menu {
            position: absolute;
            top: calc(100% + 5px);
            right: 0;
            z-index: 25;
            visibility: hidden;
            opacity: 0;
            min-width: 190px;
            padding: 8px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 10px 24px rgba(30, 41, 59, .12);
            transform: translateY(-8px);
            transition: opacity .2s ease, transform .2s ease, visibility .2s;
        }

        .nav-dropdown.open .nav-dropdown-menu {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }

        .nav-dropdown-link {
            display: block;
            padding: 9px 11px;
            border-radius: 5px;
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .nav-dropdown-link:hover,
        .nav-dropdown-link.active {
            background: #fff1f2;
            color: var(--red);
        }

        /* TÌM KIẾM */

        .search-form {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .search-input {
            width: 180px;
            height: 36px;
            padding: 0 12px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            outline: none;
            font-size: 13px;
            transition: border-color .2s;
        }

            .search-input:focus {
                border-color: var(--red);
            }

        .search-button {
            height: 36px;
            padding: 0 13px;
            background: var(--red);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s;
            white-space: nowrap;
        }

            .search-button:hover {
                background: var(--red-dark);
            }

        .search-reset {
            display: inline-block;
            padding: 0 8px;
            height: 36px;
            line-height: 36px;
            color: var(--red);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: color .2s;
        }

            .search-reset:hover {
                color: var(--red-dark);
            }

        /* TÀI KHOẢN */

        .admin-area {
            margin-left: 0;
            flex-shrink: 0;
        }

        .account-area {
            position: relative;
            margin-left: 4px;
            flex-shrink: 0;
        }

        .user-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: 0;
            border-radius: 50%;
            background: #f1f5f9;
            color: #20232a;
            cursor: pointer;
            transition: .2s ease;
        }

            .user-toggle:hover,
            .account-area.open .user-toggle {
                background: var(--red);
                color: white;
                transform: translateY(-1px);
            }

            .user-toggle svg {
                width: 21px;
                height: 21px;
            }

        .account-menu {
            position: absolute;
            top: calc(100% + 9px);
            right: 0;
            z-index: 20;
            display: none;
            min-width: 170px;
            padding: 8px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: white;
            box-shadow: 0 12px 28px rgba(30, 41, 59, .15);
        }

        .account-area.open .account-menu {
            display: block;
        }

        .account-menu-link {
            display: block;
            padding: 9px 11px;
            border-radius: 6px;
            color: #475569 !important;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
        }

        .account-menu-divider {
            height: 1px;
            margin: 6px 4px;
            background: var(--line);
        }

            .account-menu-link:hover,
            .account-menu-link.favorite-active {
                background: #fff1f2;
                color: var(--red) !important;
            }

        main {
            min-height: 60vh;
        }

        .page-content {
            padding: 32px 0 55px;
        }

        .back-to-top {
            position: fixed;
            right: max(28px, env(safe-area-inset-right));
            bottom: max(28px, env(safe-area-inset-bottom));
            z-index: 1000;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-width: 56px;
            min-height: 56px;
            padding: 0 18px;
            border: 2px solid #fff;
            border-radius: 50%;
            background: #b91c32;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: .04em;
            line-height: 1;
            box-shadow: 0 4px 16px rgba(15, 23, 42, .3);
            transition: background .2s, transform .2s, box-shadow .2s;
        }

        .news-chat-open .back-to-top {
            visibility: hidden;
            pointer-events: none;
        }

            .back-to-top:hover {
                background: #861b2b;
                color: #fff;
                transform: translateY(-3px);
                box-shadow: 0 7px 20px rgba(15, 23, 42, .35);
            }

            .back-to-top svg {
                width: 18px;
                height: 18px;
            }

        /* FOOTER */

        .site-footer {
            background: #1d2027;
            color: #d8d9de;
            padding: 35px 0 20px;
            margin-top: 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 35px;
        }

        .footer-brand {
            color: white;
            font-size: 23px;
            font-weight: 900;
        }

            .footer-brand span {
                color: #ef6477;
            }

        .footer-text {
            color: #b9bbc4;
            font-size: 13px;
            max-width: 520px;
        }

        .footer-heading {
            color: white;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: 13px;
        }

        .footer-bottom {
            border-top: 1px solid #383b43;
            margin-top: 25px;
            padding-top: 15px;
            color: #a8abb4;
            font-size: 12px;
        }

        /* CỬA SỔ ĐĂNG NHẬP */

        .login-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: rgba(15, 23, 42, .35);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

            .login-overlay.show {
                display: flex;
            }

        .login-modal {
            position: relative;
            width: 100%;
            max-width: 850px;
            display: grid;
            grid-template-columns: .9fr 1.1fr;
            overflow: hidden;
            border-radius: 18px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 20px 60px rgba(0, 0, 0, .2);
            animation: loginAppear .25s ease;
        }

        @@keyframes loginAppear {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .login-close {
            position: absolute;
            z-index: 2;
            right: 15px;
            top: 10px;
            width: 35px;
            height: 35px;
            border: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, .8);
            color: #475569;
            font-size: 25px;
            cursor: pointer;
        }

            .login-close:hover {
                background: #fee2e2;
                color: #b91c1c;
            }

        .login-banner {
            padding: 45px 35px;
            color: white;
            background: linear-gradient(145deg, #991b1b, #450a0a);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-brand {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 55px;
        }

            .login-brand i {
                margin-right: 8px;
            }

        .login-banner h2 {
            font-size: 30px;
            line-height: 1.3;
            margin: 0 0 15px;
        }

        .login-banner p {
            color: rgba(255, 255, 255, .8);
            line-height: 1.7;
            font-size: 14px;
        }

        .login-form-section {
            padding: 55px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-form-section h2 {
                font-size: 28px;
                color: #0f172a;
                margin: 0 0 8px;
            }

            .login-form-section > p {
                color: #64748b;
                font-size: 14px;
                margin: 0 0 28px;
            }

        .login-group {
            margin-bottom: 20px;
        }

            .login-group label {
                display: block;
                margin-bottom: 8px;
                color: #334155;
                font-size: 13px;
                font-weight: 700;
            }

            .login-group input {
                width: 100%;
                height: 48px;
                padding: 0 14px;
                border: 1px solid #cbd5e1;
                border-radius: 9px;
                outline: none;
                background: #f8fafc;
            }

                .login-group input:focus {
                    border-color: #b91c1c;
                    box-shadow: 0 0 0 3px rgba(185, 28, 28, .1);
                }

        .login-submit {
            width: 100%;
            height: 49px;
            border: 0;
            border-radius: 9px;
            background: #b91c1c;
            color: white;
            font-weight: 700;
            cursor: pointer;
            margin-top: 5px;
        }

            .login-submit:hover {
                background: #991b1b;
            }

        .login-error {
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            background: #fef2f2;
            color: #b91c1c;
            font-size: 13px;
        }

        /* RESPONSIVE */

        @@media (max-width: 1100px) {
            .nav-inner {
                gap: 14px;
            }

            .nav-link {
                font-size: 12px;
            }

            .search-input {
                width: 155px;
            }
        }

        @@media (max-width: 900px) {
            .nav-inner {
                gap: 12px;
            }

            .nav-links {
                flex: 1;
                gap: 4px 12px;
                flex-wrap: wrap;
                align-content: center;
                padding: 3px 0;
            }

            .nav-links .nav-link {
                min-height: 36px;
                padding-top: 0;
            }

            .nav-dropdown {
                flex: 0 0 auto;
                align-self: flex-start;
            }

            .brand-actions {
                gap: 8px;
            }

            .search-input {
                width: 145px;
            }
        }

        @@media (max-width: 650px) {
            .container {
                width: calc(100% - 24px);
            }

            .masthead {
                padding: 18px 0;
            }

            .brand-row {
                align-items: center;
                flex-wrap: wrap;
                gap: 12px;
            }

            .top-inner { align-items: flex-start; flex-direction: column; }

            .brand {
                font-size: 27px;
            }

            .brand-actions {
                width: 100%;
                margin-left: 0;
            }

            .nav-inner {
                min-height: 48px;
                align-items: flex-start;
                gap: 4px;
                padding-top: 0;
            }

            .nav-links { gap: 2px 10px; }

            .nav-link {
                min-height: 48px;
                font-size: 11px;
            }

            .hamburger-toggle {
                margin-top: 2px;
            }

            .search-input {
                flex: 1;
                width: auto;
                min-width: 0;
            }

            .search-form { flex: 1; min-width: 0; }
            .search-button { padding: 0 10px; }

            .footer-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .top-strip { padding: 5px 0; }

            .top-inner {
                justify-content: center;
                gap: 0;
            }

            .top-inner > span { display: none; }

            .weather-strip { margin-right: 0; }

            .weather-strip-inner { min-height: 30px; }

            .weather-summary {
                gap: 8px;
                padding: 2px 0;
                font-size: 11px;
            }

            .weather-summary-icon { font-size: 16px; }

            .weather-summary-date {
                padding-right: 9px;
            }

            .weather-panel {
                right: 50%;
                transform: translateX(50%);
                padding: 16px;
            }

            .login-modal {
                max-width: 420px;
                grid-template-columns: 1fr;
                max-height: 90vh;
                overflow-y: auto;
            }

            .login-banner {
                padding: 25px;
            }

            .login-brand {
                margin-bottom: 20px;
            }

            .login-banner h2 {
                font-size: 24px;
            }

            .login-form-section {
                padding: 30px 25px;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>

<body>
    <!-- THANH THÔNG TIN PHÍA TRÊN -->
    <div class="top-strip">
        <div class="container top-inner">
            <div class="weather-strip" id="weather-strip">
                <div class="weather-strip-inner">
                    <button type="button" class="weather-summary" id="weather-toggle" aria-expanded="false" aria-controls="weather-panel">
                        <span class="weather-summary-date" id="weather-date">Đang tải ngày…</span>
                        <span class="weather-summary-city"><span id="weather-city-summary">Hồ Chí Minh</span><i class="fa-solid fa-chevron-down" style="font-size:10px" aria-hidden="true"></i></span>
                        <span class="weather-summary-temp" id="weather-temp-summary">--°C</span>
                        <i class="weather-summary-icon fa-solid fa-cloud" id="weather-icon-summary" aria-hidden="true"></i>
                    </button>

                    <section class="weather-panel" id="weather-panel" aria-label="Thông tin thời tiết" aria-hidden="true">
                        <select class="weather-city-select" id="weather-city-select" aria-label="Chọn thành phố">
                            <option value="Ho Chi Minh City">Hồ Chí Minh</option>
                            <option value="Da Nang">Đà Nẵng</option>
                            <option value="Hanoi">Hà Nội</option>
                            <option value="Can Tho">Cần Thơ</option>
                            <option value="Hai Phong">Hải Phòng</option>
                            <option value="Nha Trang">Nha Trang</option>
                        </select>
                        <div class="weather-current">
                            <span class="weather-temperature" id="weather-temp">--°</span>
                            <i class="weather-condition-icon fa-solid fa-cloud" id="weather-icon" aria-hidden="true"></i>
                        </div>
                        <div class="weather-condition-row">
                            <span id="weather-date-full">Đang cập nhật…</span>
                            <span id="weather-condition">Thời tiết</span>
                        </div>
                        <div class="weather-detail-row"><span>Nhiệt độ</span><strong id="weather-range">--° - --°</strong></div>
                        <div class="weather-detail-row"><span>Độ ẩm</span><strong id="weather-humidity">--%</strong></div>
                        <p class="weather-status" id="weather-status" role="status" aria-live="polite">Đang tải dữ liệu thời tiết…</p>
                    </section>
                </div>
            </div>
            <span>Cập nhật thông tin mỗi ngày</span>
        </div>
