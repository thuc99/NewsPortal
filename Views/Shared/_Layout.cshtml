
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - NewsPortal</title>
    <style>
        :root {
            --red: #b91c32;
            --red-dark: #861b2b;
            --ink: #20232a;
            --muted: #737985;
            --line: #e9e9ed;
            --paper: #ffffff;
            --soft: #f6f7f9;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: "Segoe UI", Arial, sans-serif;
            line-height: 1.65;
        }

        a { color: inherit; text-decoration: none; }
        a:hover { color: var(--red); }

        .top-strip {
            background: var(--red-dark);
            color: white;
            font-size: 12px;
            padding: 7px 0;
        }

        .container {
            width: min(1160px, calc(100% - 36px));
            margin: auto;
        }

        .top-inner {
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }

        .masthead {
            padding: 25px 0;
            border-bottom: 1px solid var(--line);
        }

        .brand-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .brand {
            font-size: 34px;
            font-weight: 900;
            letter-spacing: -1.5px;
            line-height: 1.2;
        }

        .brand span { color: var(--red); }

        .brand-caption {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
        }

        .brand-note {
            color: var(--muted);
            font-size: 13px;
            text-align: right;
        }

        .navbar {
            background: white;
            border-bottom: 1px solid var(--line);
            position: relative;
            z-index: 2;
        }

        .nav-inner {
            display: flex;
            align-items: center;
            gap: 30px;
            min-height: 53px;
            flex-wrap: wrap;
        }

        .nav-link {
            display: inline-flex;
            align-items: center;
            min-height: 53px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 3px solid transparent;
            padding-top: 3px;
        }

        .nav-link:hover {
            color: var(--red);
            border-bottom-color: var(--red);
        }

        .nav-home { color: var(--red); }

        main { min-height: 60vh; }

        .page-content { padding: 32px 0 55px; }

        .site-footer {
            background: #1d2027;
            color: #d8d9de;
            padding: 35px 0 20px;
            margin-top: 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 35px;
        }

        .footer-brand {
            color: white;
            font-size: 23px;
            font-weight: 900;
        }

        .footer-brand span { color: #ef6477; }

        .footer-text {
            color: #b9bbc4;
            font-size: 13px;
            max-width: 520px;
        }

        .footer-heading {
            color: white;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: 13px;
        }

        .footer-bottom {
            border-top: 1px solid #383b43;
            margin-top: 25px;
            padding-top: 15px;
            color: #a8abb4;
            font-size: 12px;
        }

        @@media (max-width: 650px) {
            .brand { font-size: 27px; }
            .brand-note { display: none; }
            .nav-inner { gap: 18px; }
            .nav-link { font-size: 11px; }
            .footer-grid { grid-template-columns: 1fr; gap: 20px; }
            .top-inner { flex-direction: column; gap: 0; }
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>
    <div class="top-strip">
        <div class="container top-inner">
            <span>TIN TỨC • CÔNG NGHỆ • ĐỜI SỐNG</span>
            <span>Cập nhật thông tin mỗi ngày</span>
        </div>
    </div>

    <header class="masthead">
        <div class="container brand-row">
            <div>
                <a class="brand" href="@Url.Action("Index", "Home")">
                    NEWS<span>PORTAL</span>
                </a>
                <div class="brand-caption">
                    Thông tin mới · Góc nhìn đa chiều
                </div>
            </div>
            <div class="brand-note">
                Cập nhật kiến thức<br />
                Kết nối thông tin
            </div>
        </div>
    </header>

    <nav class="navbar">
        <div class="container nav-inner">
            <a class="nav-link nav-home"
               href="@Url.Action("Index", "Home")">Trang chủ</a>
            <a class="nav-link"
               href="@Url.Action("Index", "Articles")">Tin tức</a>
            <a class="nav-link"
               href="@Url.Action("Index", "Categories")">Danh mục</a>
            <a class="nav-link"
               href="@Url.Action("Index", "Authors")">Tác giả</a>
        </div>
    </nav>

    <main>
        <div class="container page-content">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">NEWS<span>PORTAL</span></div>
                    <p class="footer-text">
                        NewsPortal là website tổng hợp và chia sẻ tin tức,
                        mang đến nội dung dễ đọc, rõ ràng và thuận tiện cho người dùng.
                    </p>
                </div>
                <div>
                    <div class="footer-heading">LIÊN KẾT</div>
                    <div class="footer-links">
                        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                        <a href="@Url.Action("Index", "Articles")">Tin tức</a>
                        <a href="@Url.Action("Index", "Categories")">Danh mục</a>
                        <a href="@Url.Action("Index", "Authors")">Tác giả</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                © @DateTime.Now.Year NewsPortal. Website phục vụ mục đích học tập.
            </div>
        </div>
    </footer>

    @RenderSection("scripts", required: false)
</body>
</html>
