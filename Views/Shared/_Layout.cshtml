<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TinNhanh</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    @{
        string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        string currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
        bool isFavoritesPage = currentController == "Articles" && currentAction == "Favorites";
        bool isArticlesPage = currentController == "Articles" && !isFavoritesPage;
        bool isCategoriesPage = currentController == "Categories";
        bool isAuthorsPage = currentController == "Authors";
    }

    <style>
        :root {
            --red: #b91c32;
            --red-dark: #861b2b;
            --ink: #20232a;
            --muted: #737985;
            --line: #e9e9ed;
            --paper: #ffffff;
            --soft: #f6f7f9;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: "Segoe UI", Arial, sans-serif;
            line-height: 1.65;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

            a:hover {
                color: var(--red);
            }

        .top-strip {
            background: var(--red-dark);
            color: white;
            font-size: 12px;
            padding: 7px 0;
        }

        .container {
            width: min(1160px, calc(100% - 32px));
            margin: auto;
        }

        .top-inner {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
        }

        .weather-strip {
            position: relative;
            background: transparent;
            margin-right: auto;
        }

        .weather-strip-inner {
            position: relative;
            display: flex;
            min-height: 34px;
            align-items: center;
            justify-content: flex-start;
        }

        .weather-summary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 2px 0;
            border: 0;
            background: transparent;
            color: #fff;
            font: inherit;
            cursor: pointer;
        }

        .weather-summary:hover,
        .weather-summary[aria-expanded="true"] {
            color: #fff;
        }

        .weather-summary-date {
            padding-right: 12px;
            border-right: 1px solid rgba(255, 255, 255, .45);
            color: rgba(255, 255, 255, .9);
        }

        .weather-summary-city {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .weather-summary-temp {
            font-weight: 700;
            white-space: nowrap;
        }

        .weather-summary-icon {
            color: rgba(255, 255, 255, .9);
            font-size: 20px;
        }

        .weather-panel {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            z-index: 50;
            display: none;
            width: min(390px, calc(100vw - 28px));
            padding: 20px;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            background: #fff;
            box-shadow: 0 16px 40px rgba(15, 23, 42, .16);
        }

        .weather-strip.is-open .weather-panel {
            display: block;
        }

        .weather-city-select {
            width: 100%;
            min-height: 44px;
            padding: 0 12px;
            border: 1px solid #d7dce3;
            border-radius: 8px;
            background: #fff;
            color: #334155;
            font: inherit;
        }

        .weather-current {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 0 12px;
        }

        .weather-temperature {
            color: #079bd3;
            font-size: 62px;
            font-weight: 300;
            letter-spacing: -3px;
            line-height: 1;
        }

        .weather-condition-icon {
            color: #079bd3;
            font-size: 42px;
        }

        .weather-condition-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0 10px;
            border-bottom: 1px solid #e5e7eb;
            color: #334155;
            font-size: 14px;
            font-weight: 650;
        }

        .weather-detail-row {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            border-bottom: 1px solid #e5e7eb;
            color: #64748b;
        }

        .weather-detail-row:last-child {
            border-bottom: 0;
        }

        .weather-detail-row strong {
            color: #334155;
            font-weight: 600;
        }

        .weather-status {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 12px;
        }

        .masthead {
            padding: 25px 0;
            border-bottom: 1px solid var(--line);
        }

        .brand-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .brand {
            position: relative;
            display: inline-block;
            padding-bottom: 5px;
            font-size: 40px;
            font-weight: 900;
            letter-spacing: -2.5px;
            line-height: 1.2;
            color: #20232a;
            animation: brand-pop .8s ease-out both;
        }

            .brand::first-letter {
                color: #20232a;
            }

        .brand-red {
            color: #a51f33;
        }

        .brand::after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 4px;
            border-radius: 5px;
            background: #b91c32;
            transform-origin: left center;
            animation: brand-underline .9s .25s ease-out both;
        }

        @@keyframes brand-pop {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes brand-underline {
            from {
                transform: scaleX(0);
            }

            to {
                transform: scaleX(1);
            }
        }

        .brand-caption {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
        }

        .brand-note {
            color: var(--muted);
            font-size: 13px;
            text-align: right;
        }

        /* THANH ĐIỀU HƯỚNG */

        .navbar {
            background: white;
            border-bottom: 1px solid var(--line);
            position: relative;
            z-index: 2;
        }

        .nav-inner {
            display: flex;
            align-items: center;
            gap: 18px;
            min-height: 53px;
            width: min(1160px, calc(100% - 32px));
            margin: auto;
            flex-wrap: nowrap;
        }

        .nav-link {
            display: inline-flex;
            align-items: center;
            min-height: 53px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 3px solid transparent;
            padding-top: 3px;
            white-space: nowrap;
        }

            .nav-link:hover {
                color: var(--red);
                border-bottom-color: var(--red);
            }

            .nav-link.active {
                color: var(--red);
                border-bottom-color: var(--red);
            }

            .nav-link.active:hover {
                color: var(--red);
                border-bottom-color: var(--red);
            }

        /* TÌM KIẾM */

        .search-form {
            display: flex;
            align-items: center;
            margin-left: auto;
            gap: 7px;
        }

        .search-input {
            width: 180px;
            height: 36px;
            padding: 0 12px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            outline: none;
            font-size: 13px;
            transition: border-color .2s;
        }

            .search-input:focus {
                border-color: var(--red);
            }

        .search-button {
            height: 36px;
            padding: 0 13px;
            background: var(--red);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s;
            white-space: nowrap;
        }

            .search-button:hover {
                background: var(--red-dark);
            }

        .search-reset {
            display: inline-block;
            padding: 0 8px;
            height: 36px;
            line-height: 36px;
            color: var(--red);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: color .2s;
        }

            .search-reset:hover {
                color: var(--red-dark);
            }

        /* TÀI KHOẢN */

        .admin-area {
            margin-left: 0;
            flex-shrink: 0;
        }

        .account-area {
            position: relative;
            margin-left: 4px;
            flex-shrink: 0;
        }

        .user-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: 0;
            border-radius: 50%;
            background: #f1f5f9;
            color: #20232a;
            cursor: pointer;
            transition: .2s ease;
        }

            .user-toggle:hover,
            .account-area.open .user-toggle {
                background: var(--red);
                color: white;
                transform: translateY(-1px);
            }

            .user-toggle svg {
                width: 21px;
                height: 21px;
            }

        .account-menu {
            position: absolute;
            top: calc(100% + 9px);
            right: 0;
            z-index: 20;
            display: none;
            min-width: 170px;
            padding: 8px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: white;
            box-shadow: 0 12px 28px rgba(30, 41, 59, .15);
        }

        .account-area.open .account-menu {
            display: block;
        }

        .account-menu-link {
            display: block;
            padding: 9px 11px;
            border-radius: 6px;
            color: #475569 !important;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
        }

        .account-menu-divider {
            height: 1px;
            margin: 6px 4px;
            background: var(--line);
        }

            .account-menu-link:hover,
            .account-menu-link.favorite-active {
                background: #fff1f2;
                color: var(--red) !important;
            }

        main {
            min-height: 60vh;
        }

        .page-content {
            padding: 32px 0 55px;
        }

        .back-to-top {
            position: fixed;
            right: 16px;
            bottom: 16px;
            z-index: 1000;
            display: flex;
            width: 68px;
            height: 66px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 1px solid #bdbdbd;
            border-radius: 4px;
            background: #fff;
            color: #777;
            cursor: pointer;
            line-height: 1.1;
            transition: color .2s, border-color .2s, box-shadow .2s;
        }

            .back-to-top:hover {
                border-color: var(--red);
                color: var(--red);
                box-shadow: 0 3px 12px rgba(0, 0, 0, .12);
            }

            .back-to-top svg {
                width: 28px;
                height: 28px;
            }

            .back-to-top span {
                font-size: 13px;
            }

        /* FOOTER */

        .site-footer {
            background: #1d2027;
            color: #d8d9de;
            padding: 35px 0 20px;
            margin-top: 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 35px;
        }

        .footer-brand {
            color: white;
            font-size: 23px;
            font-weight: 900;
        }

            .footer-brand span {
                color: #ef6477;
            }

        .footer-text {
            color: #b9bbc4;
            font-size: 13px;
            max-width: 520px;
        }

        .footer-heading {
            color: white;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: 13px;
        }

        .footer-bottom {
            border-top: 1px solid #383b43;
            margin-top: 25px;
            padding-top: 15px;
            color: #a8abb4;
            font-size: 12px;
        }

        /* CỬA SỔ ĐĂNG NHẬP */

        .login-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: rgba(15, 23, 42, .35);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

            .login-overlay.show {
                display: flex;
            }

        .login-modal {
            position: relative;
            width: 100%;
            max-width: 850px;
            display: grid;
            grid-template-columns: .9fr 1.1fr;
            overflow: hidden;
            border-radius: 18px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 20px 60px rgba(0, 0, 0, .2);
            animation: loginAppear .25s ease;
        }

        @@keyframes loginAppear {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .login-close {
            position: absolute;
            z-index: 2;
            right: 15px;
            top: 10px;
            width: 35px;
            height: 35px;
            border: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, .8);
            color: #475569;
            font-size: 25px;
            cursor: pointer;
        }

            .login-close:hover {
                background: #fee2e2;
                color: #b91c1c;
            }

        .login-banner {
            padding: 45px 35px;
            color: white;
            background: linear-gradient(145deg, #991b1b, #450a0a);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-brand {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 55px;
        }

            .login-brand i {
                margin-right: 8px;
            }

        .login-banner h2 {
            font-size: 30px;
            line-height: 1.3;
            margin: 0 0 15px;
        }

        .login-banner p {
            color: rgba(255, 255, 255, .8);
            line-height: 1.7;
            font-size: 14px;
        }

        .login-form-section {
            padding: 55px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-form-section h2 {
                font-size: 28px;
                color: #0f172a;
                margin: 0 0 8px;
            }

            .login-form-section > p {
                color: #64748b;
                font-size: 14px;
                margin: 0 0 28px;
            }

        .login-group {
            margin-bottom: 20px;
        }

            .login-group label {
                display: block;
                margin-bottom: 8px;
                color: #334155;
                font-size: 13px;
                font-weight: 700;
            }

            .login-group input {
                width: 100%;
                height: 48px;
                padding: 0 14px;
                border: 1px solid #cbd5e1;
                border-radius: 9px;
                outline: none;
                background: #f8fafc;
            }

                .login-group input:focus {
                    border-color: #b91c1c;
                    box-shadow: 0 0 0 3px rgba(185, 28, 28, .1);
                }

        .login-submit {
            width: 100%;
            height: 49px;
            border: 0;
            border-radius: 9px;
            background: #b91c1c;
            color: white;
            font-weight: 700;
            cursor: pointer;
            margin-top: 5px;
        }

            .login-submit:hover {
                background: #991b1b;
            }

        .login-error {
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            background: #fef2f2;
            color: #b91c1c;
            font-size: 13px;
        }

        /* RESPONSIVE */

        @@media (max-width: 1100px) {
            .nav-inner {
                gap: 14px;
            }

            .nav-link {
                font-size: 12px;
            }

            .search-input {
                width: 155px;
            }
        }

        @@media (max-width: 900px) {
            .nav-inner {
                gap: 18px;
                flex-wrap: wrap;
                padding-top: 8px;
            }

            .search-form {
                width: 100%;
                margin-left: 0;
                padding-bottom: 12px;
                order: 3;
            }

            .search-input {
                width: 100%;
                flex: 1;
            }

            .account-area {
                margin-left: auto;
            }
        }

        @@media (max-width: 650px) {
            .container {
                width: calc(100% - 24px);
            }

            .masthead {
                padding: 18px 0;
            }

            .brand-row,
            .top-inner {
                align-items: flex-start;
                flex-direction: column;
            }

            .brand {
                font-size: 27px;
            }

            .brand-note {
                display: none;
            }

            .nav-inner {
                gap: 18px;
                padding-top: 5px;
            }

            .nav-link {
                min-height: 42px;
                font-size: 11px;
            }

            .search-form {
                width: 100%;
                margin: 5px 0 12px;
                flex-wrap: wrap;
            }

            .search-input {
                flex: 1;
                width: auto;
                min-width: 0;
            }

            .search-button,
            .search-reset {
                flex: 0 0 auto;
            }

            .footer-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .top-inner {
                flex-direction: column;
                gap: 0;
            }

            .weather-strip-inner { min-height: 38px; }

            .top-inner {
                flex-direction: row;
                align-items: center;
                justify-content: flex-end;
            }

            .weather-summary {
                gap: 7px;
                padding: 5px 0;
                font-size: 13px;
            }

            .weather-summary-date {
                padding-right: 8px;
            }

            .weather-panel {
                right: 50%;
                transform: translateX(50%);
                padding: 16px;
            }

            .login-modal {
                max-width: 420px;
                grid-template-columns: 1fr;
                max-height: 90vh;
                overflow-y: auto;
            }

            .login-banner {
                padding: 25px;
            }

            .login-brand {
                margin-bottom: 20px;
            }

            .login-banner h2 {
                font-size: 24px;
            }

            .login-form-section {
                padding: 30px 25px;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>

<body>
    <!-- THANH THÔNG TIN PHÍA TRÊN -->
    <div class="top-strip">
        <div class="container top-inner">
            <div class="weather-strip" id="weather-strip">
                <div class="weather-strip-inner">
                    <button type="button" class="weather-summary" id="weather-toggle" aria-expanded="false" aria-controls="weather-panel">
                        <span class="weather-summary-date" id="weather-date">Đang tải ngày…</span>
                        <span class="weather-summary-city"><span id="weather-city-summary">Hồ Chí Minh</span><i class="fa-solid fa-chevron-down" style="font-size:10px" aria-hidden="true"></i></span>
                        <span class="weather-summary-temp" id="weather-temp-summary">--°C</span>
                        <i class="weather-summary-icon fa-solid fa-cloud" id="weather-icon-summary" aria-hidden="true"></i>
                    </button>

                    <section class="weather-panel" id="weather-panel" aria-label="Thông tin thời tiết" aria-hidden="true">
                        <select class="weather-city-select" id="weather-city-select" aria-label="Chọn thành phố">
                            <option value="Ho Chi Minh City">Hồ Chí Minh</option>
                            <option value="Da Nang">Đà Nẵng</option>
                            <option value="Hanoi">Hà Nội</option>
                            <option value="Can Tho">Cần Thơ</option>
                            <option value="Hai Phong">Hải Phòng</option>
                            <option value="Nha Trang">Nha Trang</option>
                        </select>
                        <div class="weather-current">
                            <span class="weather-temperature" id="weather-temp">--°</span>
                            <i class="weather-condition-icon fa-solid fa-cloud" id="weather-icon" aria-hidden="true"></i>
                        </div>
                        <div class="weather-condition-row">
                            <span id="weather-date-full">Đang cập nhật…</span>
                            <span id="weather-condition">Thời tiết</span>
                        </div>
                        <div class="weather-detail-row"><span>Nhiệt độ</span><strong id="weather-range">--° - --°</strong></div>
                        <div class="weather-detail-row"><span>Độ ẩm</span><strong id="weather-humidity">--%</strong></div>
                        <p class="weather-status" id="weather-status" role="status" aria-live="polite">Đang tải dữ liệu thời tiết…</p>
                    </section>
                </div>
            </div>
            <span>Cập nhật thông tin mỗi ngày</span>
        </div>
    </div>

    <!-- LOGO -->
    <header class="masthead">
        <div class="container brand-row">
            <div>
                <a class="brand" href="@Url.Action("Index", "Home")">
                    Tin<span class="brand-red">Nhanh</span>
                </a>

                <div class="brand-caption">
                    Thông tin mới · Góc nhìn đa chiều
                </div>
            </div>

            <div class="brand-note">
                Cập nhật kiến thức<br />
                Kết nối thông tin
            </div>
        </div>
    </header>

    <!-- THANH ĐIỀU HƯỚNG -->
    <nav class="navbar">
        <div class="container nav-inner">

            <a class="nav-link @(currentController == "Home" && !isFavoritesPage ? "active" : "")"
               href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            @Html.Action("Navigation", "Categories", new
            {
                activeCategoryId = currentController == "Categories" && currentAction == "Details"
                    ? Convert.ToString(ViewContext.RouteData.Values["id"])
                    : string.Empty
            })

            <!-- TÌM KIẾM -->
            <form action="@Url.Action("Index", "Articles")" 
                  method="get"
                  class="search-form">

                <input type="search"
                       name="searchString"
                       class="search-input"
                       placeholder="Tìm kiếm bài viết..." />

                <button type="submit" class="search-button">
                    Tìm kiếm
                </button>
            </form>

            <!-- TÀI KHOẢN -->
            <div class="account-area" id="account-area">

                <button type="button"
                        class="user-toggle"
                        id="user-toggle"
                        aria-label="Mở menu tài khoản"
                        aria-expanded="false">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">

                        <circle cx="12" cy="8" r="3.5"></circle>
                        <path d="M5 20c.8-3.1 3.2-5 7-5s6.2 1.9 7 5"></path>
                    </svg>
                </button>

                <div class="account-menu" id="account-menu">

                    @if (Session["Admin"] == null && Session["User"] == null)
                    {
                        <a href="@Url.Action("Login", "Account")"
                           class="account-menu-link">
                            Đăng nhập
                        </a>
                        <a href="@Url.Action("Register", "Account")"
                           class="account-menu-link">
                            Đăng ký tài khoản
                        </a>
                        <div class="account-menu-divider"></div>
                    }
                    else
                    {
                        <div style="padding: 8px 14px; font-size: 13px; font-weight: 700; color: #b91c1c;">
                            Xin chào, @(Session["Admin"] ?? Session["UserFullName"] ?? Session["User"])
                            <span style="font-size:11px; color:var(--muted);">(@Session["Role"])</span>
                        </div>
                        if (Session["Admin"] != null)
                        {
                            <a href="@Url.Action("Index", "Admin")"
                               class="account-menu-link">
                                Bảng điều khiển Admin
                            </a>
                        }
                        if (string.Equals(Convert.ToString(Session["Role"]), "Editor", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="@Url.RouteUrl("AdminArticles", new { action = "Index" })"
                               class="account-menu-link">
                                Quản lý bài viết
                            </a>
                        }
                        <a href="@Url.Action("Logout", "Account")"
                           class="account-menu-link">
                            Đăng xuất
                        </a>
                    }

                    <a href="@Url.Action("Index", "Articles")"
                       class="account-menu-link @(isArticlesPage ? "favorite-active" : "")">
                        Tin tức
                    </a>
                    <a href="@Url.Action("Index", "Categories")"
                       class="account-menu-link @(isCategoriesPage ? "favorite-active" : "")">
                        Danh mục
                    </a>
                    <a href="@Url.RouteUrl("PublicAuthor", new { action = "Index" })"
                       class="account-menu-link @(isAuthorsPage ? "favorite-active" : "")">
                        Tác giả
                    </a>

                    <a href="@Url.Action("Favorites", "Articles")"
                       class="account-menu-link @(isFavoritesPage ? "favorite-active" : "")">
                        Bài viết đã lưu
                    </a>

                </div>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG TRANG -->
    <main>
        <div class="container page-content">
            @RenderBody()
        </div>
    </main>

    <!-- CỬA SỔ ĐĂNG NHẬP DÙNG CHUNG -->
    @if (Session["Admin"] == null)
    {
        <div id="loginModal" class="login-overlay">
            <div class="login-modal">

                <button type="button"
                        class="login-close"
                        onclick="closeLogin()">
                    &times;
                </button>

                <div class="login-banner">
                    <div class="login-brand">
                        <i class="fa-solid fa-newspaper"></i>
                        TinNhanh
                    </div>

                    <h2>Chào mừng<br />quay trở lại!</h2>

                    <p>
                        Đăng nhập để quản lý bài viết, tác giả
                        và danh mục tin tức.
                    </p>
                </div>

                <div class="login-form-section">
                    <h2>Đăng nhập</h2>
                    <p>Vui lòng nhập thông tin tài khoản.</p>

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="login-group">
                            <label for="loginUsername">Tên đăng nhập</label>

                            <input type="text"
                                   id="loginUsername"
                                   name="username"
                                   placeholder="Nhập tên đăng nhập"
                                   autocomplete="username"
                                   required />
                        </div>

                        <div class="login-group">
                            <label for="loginPassword">Mật khẩu</label>

                            <input type="password"
                                   id="loginPassword"
                                   name="password"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password"
                                   required />
                        </div>

                        <button type="submit" class="login-submit">
                            ĐĂNG NHẬP
                            <i class="fa-solid fa-arrow-right-to-bracket"
                               style="margin-left:7px;"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">

                <div>
                    <div class="footer-brand">
                        Tin<span>Nhanh</span>
                    </div>

                    <p class="footer-text">
                        TinNhanh là website tổng hợp và chia sẻ tin tức,
                        mang đến nội dung dễ đọc, rõ ràng và thuận tiện cho người dùng.
                    </p>
                </div>

                <div>
                    <div class="footer-heading">LIÊN KẾT</div>

                    <div class="footer-links">
                        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                        <a href="@Url.Action("Index", "Articles")">Tin tức</a>
                        <a href="@Url.Action("Index", "Categories")">Danh mục</a>
                        <a href="@Url.RouteUrl("PublicAuthor", new { action = "Index" })">Tác giả</a>
                    </div>
                </div>

            </div>

            <div class="footer-bottom">
                © @DateTime.Now.Year TinNhanh. Website phục vụ mục đích học tập.
            </div>
        </div>
    </footer>

    <button type="button" class="back-to-top" id="back-to-top" aria-label="Cuộn lên đầu trang">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7"></path>
        </svg>
        <span>TOP</span>
    </button>

    <!-- JAVASCRIPT TÀI KHOẢN -->
    <script>
                var backToTop = document.getElementById('back-to-top');
                if (backToTop) {
                    backToTop.addEventListener('click', function () {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                }

                (function () {
                    var strip = document.getElementById('weather-strip');
                    var toggle = document.getElementById('weather-toggle');
                    var panel = document.getElementById('weather-panel');
                    var citySelect = document.getElementById('weather-city-select');
                    var status = document.getElementById('weather-status');
                    if (!strip || !toggle || !panel || !citySelect || !status) return;

                    var cities = {
                        'Ho Chi Minh City': { name: 'Hồ Chí Minh', latitude: 10.8231, longitude: 106.6297 },
                        'Da Nang': { name: 'Đà Nẵng', latitude: 16.0544, longitude: 108.2022 },
                        'Hanoi': { name: 'Hà Nội', latitude: 21.0278, longitude: 105.8342 },
                        'Can Tho': { name: 'Cần Thơ', latitude: 10.0452, longitude: 105.7469 },
                        'Hai Phong': { name: 'Hải Phòng', latitude: 20.8449, longitude: 106.6881 },
                        'Nha Trang': { name: 'Nha Trang', latitude: 12.2388, longitude: 109.1967 }
                    };

                    var weatherLabels = function (code) {
                        if (code === 0) return { text: 'Trời quang', icon: 'fa-sun' };
                        if (code === 1 || code === 2) return { text: 'Ít mây', icon: 'fa-cloud-sun' };
                        if (code === 3) return { text: 'Nhiều mây', icon: 'fa-cloud' };
                        if (code === 45 || code === 48) return { text: 'Sương mù', icon: 'fa-smog' };
                        if (code >= 51 && code <= 57) return { text: 'Mưa phùn', icon: 'fa-cloud-rain' };
                        if (code >= 61 && code <= 67) return { text: 'Mưa', icon: 'fa-cloud-showers-heavy' };
                        if (code >= 71 && code <= 77) return { text: 'Tuyết', icon: 'fa-snowflake' };
                        if (code >= 80 && code <= 82) return { text: 'Mưa rào', icon: 'fa-cloud-showers-heavy' };
                        if (code >= 85 && code <= 86) return { text: 'Mưa tuyết', icon: 'fa-snowflake' };
                        if (code >= 95) return { text: 'Có dông', icon: 'fa-cloud-bolt' };
                        return { text: 'Chưa rõ', icon: 'fa-cloud' };
                    };

                    var formatDate = function (date, options) {
                        return new Intl.DateTimeFormat('vi-VN', options).format(date);
                    };

                    document.getElementById('weather-date').textContent = formatDate(new Date(), {
                        weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric'
                    });

                    try {
                        var savedCity = localStorage.getItem('newsPortalWeatherCity');
                        if (savedCity && cities[savedCity]) citySelect.value = savedCity;
                    } catch (ignore) { }

                    var loadWeather = function () {
                        var city = cities[citySelect.value];
                        if (!city) return;
                        status.textContent = 'Đang tải dữ liệu thời tiết…';
                        document.getElementById('weather-city-summary').textContent = city.name;

                        var url = 'https://api.open-meteo.com/v1/forecast?latitude=' + city.latitude +
                            '&longitude=' + city.longitude +
                            '&current=temperature_2m,relative_humidity_2m,weather_code' +
                            '&daily=temperature_2m_max,temperature_2m_min,weather_code' +
                            '&timezone=auto&forecast_days=1';

                        fetch(url)
                            .then(function (response) {
                                if (!response.ok) throw new Error('Weather request failed');
                                return response.json();
                            })
                            .then(function (data) {
                                if (!data.current || !data.daily) throw new Error('Weather data unavailable');
                                var current = data.current;
                                var daily = data.daily;
                                var condition = weatherLabels(current.weather_code);
                                var temperature = Math.round(current.temperature_2m);
                                var iconClass = 'fa-solid ' + condition.icon;

                                document.getElementById('weather-temp-summary').textContent = temperature + '°C';
                                document.getElementById('weather-temp').textContent = temperature + '°';
                                document.getElementById('weather-condition').textContent = condition.text;
                                document.getElementById('weather-range').textContent =
                                    Math.round(daily.temperature_2m_min[0]) + '° - ' + Math.round(daily.temperature_2m_max[0]) + '°';
                                document.getElementById('weather-humidity').textContent = Math.round(current.relative_humidity_2m) + '%';
                                document.getElementById('weather-date-full').textContent = formatDate(new Date(daily.time[0] + 'T12:00:00'), {
                                    weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric'
                                });
                                document.getElementById('weather-icon').className = 'weather-condition-icon ' + iconClass;
                                document.getElementById('weather-icon-summary').className = 'weather-summary-icon ' + iconClass;
                                status.textContent = 'Dữ liệu thời tiết trực tiếp từ Open-Meteo.';
                            })
                            .catch(function () {
                                status.textContent = 'Không thể tải thời tiết. Vui lòng kiểm tra kết nối mạng.';
                                document.getElementById('weather-condition').textContent = 'Chưa có dữ liệu';
                            });
                    };

                    toggle.addEventListener('click', function () {
                        var isOpen = strip.classList.toggle('is-open');
                        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                        panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
                    });

                    citySelect.addEventListener('change', function () {
                        try { localStorage.setItem('newsPortalWeatherCity', citySelect.value); } catch (ignore) { }
                        loadWeather();
                    });

                    document.addEventListener('click', function (event) {
                        if (!strip.contains(event.target)) {
                            strip.classList.remove('is-open');
                            toggle.setAttribute('aria-expanded', 'false');
                            panel.setAttribute('aria-hidden', 'true');
                        }
                    });

                    document.addEventListener('keydown', function (event) {
                        if (event.key === 'Escape') {
                            strip.classList.remove('is-open');
                            toggle.setAttribute('aria-expanded', 'false');
                            panel.setAttribute('aria-hidden', 'true');
                        }
                    });

                    loadWeather();
                }());

                (function () {
                    var accountArea = document.getElementById('account-area');
                    var userToggle = document.getElementById('user-toggle');

                    if (!accountArea || !userToggle) return;

                    userToggle.addEventListener('click', function (event) {
                        event.stopPropagation();

                        var isOpen = accountArea.classList.toggle('open');

                        userToggle.setAttribute(
                            'aria-expanded',
                            isOpen ? 'true' : 'false'
                        );
                    });

                    document.addEventListener('click', function (event) {
                        if (!accountArea.contains(event.target)) {
                            accountArea.classList.remove('open');
                            userToggle.setAttribute('aria-expanded', 'false');
                        }
                    });
                }());

                // MỞ CỬA SỔ ĐĂNG NHẬP
                function openLogin() {
                    var modal = document.getElementById("loginModal");

                    if (modal) {
                        var accountArea = document.getElementById("account-area");

                        if (accountArea) {
                            accountArea.classList.remove("open");

                            var toggle = document.getElementById("user-toggle");

                            if (toggle) {
                                toggle.setAttribute("aria-expanded", "false");
                            }
                        }

                        modal.classList.add("show");
                        document.body.style.overflow = "hidden";
                    }
                }

                // ĐÓNG CỬA SỔ ĐĂNG NHẬP
                function closeLogin() {
                    var modal = document.getElementById("loginModal");

                    if (modal) {
                        modal.classList.remove("show");
                        document.body.style.overflow = "";
                    }
                }



                // ĐÓNG KHI NHẤN BÊN NGOÀI HOẶC PHÍM ESC
                document.addEventListener("DOMContentLoaded", function () {
                    var modal = document.getElementById("loginModal");

                    if (modal) {
                        modal.addEventListener("click", function (event) {
                            if (event.target === modal) {
                                closeLogin();
                            }
                        });

                        document.addEventListener("keydown", function (event) {
                            if (event.key === "Escape") {
                                closeLogin();
                            }
                        });
                    }
                });
    </script>

    <style>
        /* ===== CÁCH A: góc vuông hơn trên toàn trang ===== */
        img,
        .card, .article-card, .news-card,
        .article-image, .sr-item img,
        .search-input, .search-button,
        button, .btn, input[type="text"], input[type="password"], textarea, select {
            border-radius: 2px !important;
        }

            /* ===== CÁCH B: ảnh bớt dẹt (tỉ lệ 4:3), cắt gọn không méo ===== */
            .article-image,
            .article-card img, .news-card img, .card img,
            .article-info img, .sr-item img {
                width: 100% !important;
                aspect-ratio: 4 / 3 !important;
                height: auto !important;
                object-fit: cover !important;
            }
    </style>

    @RenderSection("scripts", required: false)
</body>
</html>