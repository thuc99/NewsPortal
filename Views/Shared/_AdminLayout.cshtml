<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Admin TinNhanh</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    @RenderSection("styles", required: false)
    <style>
        :root {
            --red: #b91c32;
            --red-dark: #861b2b;
            --ink: #20232a;
            --muted: #737985;
            --line: #e9e9ed;
            --paper: #fff;
            --soft: #f6f7f9;
            --admin-bg: #f3f5f9;
            --admin-panel: #fff;
            --admin-ink: #172033;
            --admin-muted: #687386;
            --admin-line: #e2e7ef;
            --admin-red: #b91c32;
            --admin-navy: #172033;
        }

        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            background: var(--admin-bg);
            color: var(--admin-ink);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        a { color: inherit; text-decoration: none; }
        a:hover { color: var(--admin-red); }

        .admin-header {
            background: var(--admin-navy);
            color: #fff;
            border-bottom: 4px solid var(--admin-red);
        }

        .admin-header-inner {
            width: min(1320px, calc(100% - 36px));
            min-height: 72px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 19px;
            font-weight: 800;
            white-space: nowrap;
        }

        .admin-brand i { color: #fb7185; }

        .admin-nav {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .admin-nav a {
            padding: 10px 12px;
            border-radius: 7px;
            color: #dce2ed;
            font-size: 13px;
            font-weight: 650;
        }

        .admin-nav a:hover, .admin-nav a.active {
            background: rgba(255,255,255,.1);
            color: #fff;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #dce2ed;
            font-size: 13px;
            white-space: nowrap;
        }

        .admin-user a { color: #fff; font-weight: 700; }

        .admin-main {
            width: min(1320px, calc(100% - 36px));
            margin: 28px auto;
            flex: 1;
        }

        .admin-footer {
            padding: 18px;
            background: var(--admin-navy);
            color: #aab4c5;
            text-align: center;
            font-size: 12px;
        }

        @@media (max-width: 900px) {
            .admin-header-inner { padding: 14px 0; align-items: flex-start; flex-direction: column; }
            .admin-nav { width: 100%; }
            .admin-user { position: absolute; top: 22px; right: 18px; }
        }

        @@media (max-width: 560px) {
            .admin-user { position: static; }
            .admin-header-inner { gap: 10px; }
            .admin-nav a { padding: 8px; }
            .admin-main { width: calc(100% - 24px); margin: 20px auto; }
        }
    </style>
</head>
<body>
    @{ bool isAdmin = Session["Admin"] != null; }
    <header class="admin-header">
        <div class="admin-header-inner">
            <a class="admin-brand" href="@(isAdmin ? Url.RouteUrl("Admin", new { action = "Index" }) : Url.RouteUrl("AdminArticles", new { action = "Index" }))">
                <i class="fa-solid fa-shield-halved"></i> TinNhanh Admin
            </a>
            <nav class="admin-nav">
                <a href="@Url.RouteUrl("AdminArticles", new { action = "Index" })">
                    <i class="fa-solid fa-newspaper"></i> Bài viết
                </a>
                @if (isAdmin)
                {
                    <a href="@Url.RouteUrl("AdminAuthors", new { action = "Index" })">
                        <i class="fa-solid fa-pen-nib"></i> Tác giả
                    </a>
                    <a href="@Url.RouteUrl("AdminCategories", new { action = "Index" })">
                        <i class="fa-solid fa-folder-tree"></i> Danh mục
                    </a>
                    <a href="@Url.RouteUrl("Admin", new { action = "Users" })">
                        <i class="fa-solid fa-users-gear"></i> Tài khoản
                    </a>
                }
            </nav>
            <div class="admin-user">
                <span>@(Session["Admin"] ?? Session["UserFullName"] ?? Session["User"])</span>
                <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
            </div>
        </div>
    </header>

    <main class="admin-main">
        @RenderBody()
    </main>

    <footer class="admin-footer">
        Khu vực quản trị TinNhanh
    </footer>

    @RenderSection("scripts", required: false)
</body>
</html>
