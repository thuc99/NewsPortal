<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Admin TinNhanh</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    @RenderSection("styles", required: false)
    <style>
        :root {
            --red: #b91c32;
            --red-dark: #861b2b;
            --ink: #20232a;
            --muted: #737985;
            --line: #e9e9ed;
            --paper: #fff;
            --soft: #f6f7f9;
            --admin-bg: #f3f5f9;
            --admin-panel: #fff;
            --admin-ink: #172033;
            --admin-muted: #687386;
            --admin-line: #e2e7ef;
            --admin-red: #b91c32;
            --admin-navy: #172033;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            background: var(--admin-bg);
            color: var(--admin-ink);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

            a:hover {
                color: var(--admin-red);
            }

        .admin-header {
            margin: 0;
            padding: 0 24px;
            background: var(--admin-navy);
            color: #fff;
            border-bottom: 3px solid var(--admin-red);
        }

        .admin-header-inner {
            width: 100%;
            min-height: 68px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #fb7185;
            font-size: 19px;
            font-weight: 800;
            white-space: nowrap;
        }

            .admin-brand i {
                color: #fb7185;
                font-size: 19px;
            }

        .admin-brand-label {
            color: #9aa8bc;
            font-size: 13px;
            font-weight: 500;
        }

        .admin-nav {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            flex-wrap: wrap;
        }

            .admin-nav a {
                padding: 10px 12px;
                border-radius: 6px;
                color: #dce2ed;
                font-size: 13px;
                font-weight: 700;
            }

                .admin-nav a:hover, .admin-nav a.active {
                    background: #29364b;
                    color: #fff;
                }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #dce2ed;
            font-size: 13px;
            white-space: nowrap;
        }

        .admin-account-menu {
            position: relative;
            z-index: 1100;
        }

        .admin-account-toggle {
            display: inline-flex;
            width: 30px;
            height: 30px;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 4px;
            background: transparent;
            color: #dce2ed;
            cursor: pointer;
        }

        .admin-account-toggle:hover,
        .admin-account-toggle[aria-expanded="true"] {
            background: #29364b;
            color: #fff;
        }

        .admin-account-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            z-index: 1200;
            display: none;
            min-width: 190px;
            padding: 6px;
            border: 1px solid var(--admin-line);
            border-radius: 6px;
            background: #fff;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .16);
        }

        .admin-account-dropdown.is-open {
            display: block;
        }

        .admin-account-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-radius: 5px;
            color: var(--admin-ink) !important;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .admin-account-dropdown a:hover {
            background: #fef2f2;
            color: var(--admin-red);
        }

            .admin-user > a {
                color: #fff;
                font-weight: 700;
            }

        .admin-user-profile {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .admin-user-name {
            color: #fff;
            font-size: 13px;
            font-weight: 750;
        }

        .admin-user-role {
            color: #9aa8bc;
            font-size: 11px;
        }

        .admin-home-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 13px;
            border-radius: 6px;
            background: #29364b;
            color: #dce2ed !important;
            font-size: 13px;
            font-weight: 700;
            transition: background .2s, color .2s;
        }

            .admin-home-btn:hover {
                background: #35445c;
                color: #fff !important;
            }

        .admin-user-icon {
            color: #dce2ed;
            font-size: 20px;
        }

        .admin-role-tag {
            padding: 3px 8px;
            border-radius: 999px;
            background: rgba(255,255,255,.14);
            color: #f8fafc;
            font-size: 11.5px;
            font-weight: 700;
        }

        .admin-main {
            width: min(1320px, calc(100% - 36px));
            margin: 28px auto;
            flex: 1;
        }

        .admin-main .management-page,
        .admin-main .form-page,
        .admin-main .delete-page {
            width: min(1208px, 100%);
            max-width: 1208px;
            margin: 0 auto 24px;
            color: var(--admin-ink);
        }

        .admin-main .management-header {
            margin-bottom: 18px;
        }

        .admin-main .management-header h2,
        .admin-main .form-page h2 {
            color: var(--admin-ink);
            font-size: 24px;
            font-weight: 750;
        }

        .admin-main .management-card,
        .admin-main .form-card,
        .admin-main .delete-card {
            padding: 20px;
            border: 1px solid var(--admin-line);
            border-radius: 12px;
            background: var(--admin-panel);
            box-shadow: 0 4px 14px rgba(23, 32, 51, .04);
        }

        .admin-main .management-card {
            overflow-x: auto;
        }

        .admin-main .management-table th {
            padding: 11px 12px;
            border-bottom: 1px solid var(--admin-line);
            background: var(--soft);
            color: var(--admin-muted);
            font-size: 11px;
            letter-spacing: .4px;
        }

        .admin-main .management-table td {
            padding: 12px;
            border-bottom: 1px solid var(--admin-line);
        }

        .admin-main .btn-add,
        .admin-main .btn-save,
        .admin-main .btn-delete,
        .admin-main .admin-search button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 14px;
            border: 1px solid var(--admin-red);
            border-radius: 8px;
            background: var(--admin-red);
            color: #fff !important;
            font: inherit;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: background .15s, border-color .15s;
        }

        .admin-main .btn-add:hover,
        .admin-main .btn-save:hover,
        .admin-main .btn-delete:hover,
        .admin-main .admin-search button:hover {
            border-color: var(--red-dark);
            background: var(--red-dark);
            color: #fff !important;
        }

        .admin-main .btn-back,
        .admin-main .admin-search a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 14px;
            border: 1px solid var(--admin-line);
            border-radius: 8px;
            background: #fff;
            color: var(--admin-ink) !important;
            font-size: 13px;
            font-weight: 650;
            text-decoration: none;
            cursor: pointer;
        }

        .admin-main .btn-back:hover,
        .admin-main .admin-search a:hover {
            background: var(--soft);
            color: var(--admin-red) !important;
        }

        .admin-main .action-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 30px;
            padding: 0 10px;
            border: 1px solid var(--admin-line);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
        }

        .admin-main .action-edit {
            border-color: #bfdbfe;
            background: #eff6ff;
            color: #1d4ed8;
        }

        .admin-main .action-delete {
            border-color: #fecaca;
            background: #fef2f2;
            color: var(--admin-red);
        }

        .admin-main .action-link:hover {
            filter: brightness(.97);
        }

        .admin-main .choose-image-btn,
        .admin-main .image-upload .choose-image-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 14px;
            border: 1px solid var(--admin-red);
            border-radius: 8px;
            background: var(--admin-red);
            color: #fff !important;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transform: none;
            box-shadow: none;
        }

        .admin-main .choose-image-btn:hover,
        .admin-main .image-upload .choose-image-btn:hover {
            border-color: var(--red-dark);
            background: var(--red-dark);
            color: #fff !important;
            transform: none;
            box-shadow: none;
        }

        .admin-main .admin-search input,
        .admin-main .field input:not([type="file"]),
        .admin-main .field textarea {
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #fff;
            color: var(--admin-ink);
            font: inherit;
            font-size: 13px;
        }

        .admin-main .field input:not([type="file"]),
        .admin-main .field textarea {
            min-height: 40px;
            padding: 9px 12px;
        }

        .admin-main .field input:focus,
        .admin-main .field textarea:focus,
        .admin-main .admin-search input:focus {
            outline: none;
            border-color: var(--admin-red);
            box-shadow: 0 0 0 3px rgba(185, 28, 50, .1);
        }

        .admin-main .form-actions,
        .admin-main .delete-actions {
            gap: 8px;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--admin-line);
        }

        .admin-footer {
            margin: 0;
            padding: 14px 24px 12px;
            background: var(--admin-navy);
            color: #9aa8bc;
            border-top: 3px solid var(--admin-red);
            font-size: 13px;
        }

        .admin-footer-top,
        .admin-footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .admin-footer-top {
            padding-bottom: 12px;
        }

        .admin-footer-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-footer-logo {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            background: #29364b;
            color: #fb7185;
            font-size: 20px;
        }

        .admin-footer-title {
            color: #f8fafc;
            font-size: 16px;
            font-weight: 800;
        }

        .admin-footer-subtitle {
            margin-top: 5px;
            color: #9aa8bc;
            font-size: 11px;
        }

        .admin-footer-system {
            text-align: right;
            font-size: 13px;
        }

        .admin-footer-system div + div {
            margin-top: 4px;
        }

        .admin-footer-system i {
            color: #22c55e;
            margin-right: 7px;
        }

        .admin-footer-divider {
            height: 1px;
            background: #39465b;
        }

        .admin-footer-bottom {
            padding-top: 9px;
        }

        @@media (max-width: 900px) {
            .admin-header {
                padding: 0 16px;
            }

            .admin-header-inner {
                padding: 12px 0;
                align-items: center;
                flex-direction: column;
            }

            .admin-nav {
                width: 100%;
                justify-content: center;
            }

            .admin-user {
                flex-wrap: wrap;
                justify-content: center;
            }

            .admin-footer { padding: 12px 16px; }
        }

        @@media (max-width: 560px) {
            .admin-header-inner {
                gap: 10px;
            }

            .admin-nav a {
                padding: 8px 10px;
                font-size: 12px;
            }

            .admin-brand {
                font-size: 17px;
            }

            .admin-home-btn {
                padding: 8px 10px;
                font-size: 12px;
            }

            .admin-footer {
                padding: 10px 12px;
            }

            .admin-footer-top,
            .admin-footer-bottom {
                align-items: flex-start;
                flex-direction: column;
            }

            .admin-footer-system {
                text-align: left;
            }

            .admin-footer-logo {
                width: 36px;
                height: 36px;
            }

            .admin-main {
                width: calc(100% - 24px);
                margin: 20px auto;
            }
        }
    </style>
</head>
<body>
    @{
        bool isAdmin = Session["Admin"] != null;
        string currentRole = Convert.ToString(Session["Role"]);
        string roleLabel = isAdmin || string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase)
            ? "Quản trị viên"
            : string.Equals(currentRole, "Editor", StringComparison.OrdinalIgnoreCase)
                ? "Biên tập viên"
                : string.Equals(currentRole, "Author", StringComparison.OrdinalIgnoreCase)
                    ? "Tác giả"
                    : "Độc giả";
        object displayName = Session["UserFullName"] ?? Session["Admin"] ?? Session["User"];
        string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    }
    <header class="admin-header">
        <div class="admin-header-inner">
            <a class="admin-brand" href="@(isAdmin ? Url.RouteUrl("Admin", new { action = "Index" }) : Url.RouteUrl("AdminArticles", new { action = "Index" }))">
                <i class="fa-solid fa-shield-halved"></i> TinNhanh <span class="admin-brand-label">Admin</span>
            </a>
            <nav class="admin-nav">
                <a class="@(currentController == "Articles" ? "active" : "")" href="@Url.RouteUrl("AdminArticles", new { action = "Index" })">
                    <i class="fa-solid fa-newspaper"></i> Bài viết
                </a>
                @if (isAdmin)
                {
                    <a href="@Url.RouteUrl("AdminAuthors", new { action = "Index" })">
                        <i class="fa-solid fa-pen-nib"></i> Tác giả
                    </a>
                    <a href="@Url.RouteUrl("AdminCategories", new { action = "Index" })">
                        <i class="fa-solid fa-folder-tree"></i> Danh mục
                    </a>
                    <a href="@Url.RouteUrl("Admin", new { action = "Users" })">
                        <i class="fa-solid fa-users-gear"></i> Tài khoản
                    </a>
                    <a href="@Url.RouteUrl("Admin", new { action = "Comments" })">
                        <i class="fa-solid fa-comments"></i> Bình luận
                    </a>
                }
            </nav>
            <div class="admin-user">
                <a class="admin-home-btn" href="@Url.Action("Index", "Home")">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Xem trang
                </a>
                <i class="fa-regular fa-circle-user admin-user-icon"></i>
                <span class="admin-user-profile">
                    <span class="admin-user-name">@displayName</span>
                    <span class="admin-user-role">@roleLabel</span>
                </span>
                <div class="admin-account-menu" id="adminAccountMenu">
                    <button type="button" class="admin-account-toggle" id="adminAccountToggle" aria-label="Mở menu tài khoản" aria-expanded="false" aria-controls="adminAccountDropdown">
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                    <div class="admin-account-dropdown" id="adminAccountDropdown">
                        <a href="@Url.Action("Logout", "Account")"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="admin-main">
        @RenderBody()
    </main>

    <footer class="admin-footer">
        <div class="admin-footer-top">
            <div class="admin-footer-brand">
                <span class="admin-footer-logo"><i class="fa-solid fa-shield-halved"></i></span>
                <div>
                    <div class="admin-footer-title">TINNHANH</div>
                    <div class="admin-footer-subtitle">CONTENT MANAGEMENT SYSTEM</div>
                </div>
            </div>
            <div class="admin-footer-system">
                <div><i class="fa-regular fa-circle-check"></i>Hệ thống quản trị</div>
                <div>Phiên bản 1.0</div>
            </div>
        </div>
        <div class="admin-footer-divider"></div>
        <div class="admin-footer-bottom">
            <span>© @DateTime.Now.Year TinNhanh</span>
            <span>NewsPortal Administration</span>
        </div>
    </footer>

    @RenderSection("scripts", required: false)
    <script>
        (function () {
            const toggle = document.getElementById("adminAccountToggle");
            const menu = document.getElementById("adminAccountMenu");
            const dropdown = document.getElementById("adminAccountDropdown");
            if (!toggle || !menu || !dropdown) return;

            function setMenuOpen() {
                var isOpen = toggle?.getAttribute("aria-expanded") !== "true";
                dropdown?.classList.toggle("is-open", isOpen);
                toggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
                toggle?.setAttribute("aria-label", isOpen ? "Đóng menu tài khoản" : "Mở menu tài khoản");
            }

            toggle.addEventListener("click", function () {
                setMenuOpen();
            });

            document.addEventListener("click", function (event) {
                var menu = document.getElementById("adminAccountMenu");
                var dropdown = document.getElementById("adminAccountDropdown");
                var toggle = document.getElementById("adminAccountToggle");
                if (!menu || !dropdown || !toggle) return;
                if (event.target instanceof Node && !menu.contains(event.target)) {
                    dropdown.classList.remove("is-open");
                    toggle.setAttribute("aria-expanded", "false");
                    toggle.setAttribute("aria-label", "Mở menu tài khoản");
                }
            });

            document.addEventListener("keydown", function (event) {
                var dropdown = document.getElementById("adminAccountDropdown");
                var toggle = document.getElementById("adminAccountToggle");
                if (!dropdown || !toggle) return;
                if (event.key === "Escape") {
                    dropdown.classList.remove("is-open");
                    toggle.setAttribute("aria-expanded", "false");
                    toggle.setAttribute("aria-label", "Mở menu tài khoản");
                }
            });
        })();
    </script>
</body>
</html>
