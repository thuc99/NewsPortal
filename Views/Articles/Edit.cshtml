
@model NewsPortal.Models.Article

@{
    ViewBag.Title = "Chỉnh sửa bài viết";
    bool isAdminUser = ViewBag.IsAdminUser == true;
    string rejectionReason = ViewBag.RejectionReason as string ?? "";

    string currentImageSrc = null;

    if (!string.IsNullOrWhiteSpace(Model.Image))
    {
        if (Model.Image.StartsWith("http", System.StringComparison.OrdinalIgnoreCase) ||
            Model.Image.StartsWith("/"))
        {
            currentImageSrc = Model.Image;
        }
        else if (Model.Image.StartsWith("~/"))
        {
            currentImageSrc = Url.Content(Model.Image);
        }
        else
        {
            currentImageSrc = Url.Content("~/Content/Images/" + Model.Image);
        }
    }

    var statusItems = new[]
    {
        new SelectListItem { Value = "Draft", Text = "Draft - Bản nháp" },
        new SelectListItem { Value = "Pending", Text = "Pending - Chờ duyệt" },
        new SelectListItem { Value = "Published", Text = "Published - Đã xuất bản" },
        new SelectListItem { Value = "Rejected", Text = "Rejected - Bị từ chối" },
        new SelectListItem { Value = "Archived", Text = "Archived - Đã lưu trữ" }
    };
}

<style>
    .form-page {
        width: min(850px, calc(100% - 32px));
        max-width: 850px;
        margin: 35px auto;
        padding: 28px 32px;
        box-sizing: border-box;
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
    }

    .form-card {
        background: white;
        padding: 0;
    }

    .form-page h2 {
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
        margin: 0 0 8px;
    }

    .form-sub {
        color: #64748b;
        margin: 0 0 22px;
        font-size: 14px;
    }

    .rejected-banner {
        margin-bottom: 22px;
        padding: 13px 16px;
        border-radius: 9px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13.5px;
        line-height: 1.55;
    }

    .pending-banner {
        margin-bottom: 22px;
        padding: 13px 16px;
        border-radius: 9px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        font-size: 13.5px;
        line-height: 1.55;
    }

    .status-pill {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 700;
    }

    .status-pill-draft {
        background: #fef3c7;
        color: #92400e;
    }

    .status-pill-pending {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-pill-published {
        background: #dcfce7;
        color: #166534;
    }

    .status-pill-rejected {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-pill-archived {
        background: #f1f5f9;
        color: #475569;
    }

    .field {
        margin-bottom: 24px;
    }

        .field label {
            display: block;
            font-weight: 700;
            margin-bottom: 9px;
            color: #334155;
            font-size: 14px;
        }

        .field input:not([type="file"]),
        .field textarea,
        .field select {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #e2e8f0;
            border-radius: 9px;
            box-sizing: border-box;
            font: inherit;
            background: #fff;
            transition: all .25s ease;
        }

            .field input:focus,
            .field textarea:focus,
            .field select:focus {
                outline: none;
                border-color: #dc2626;
                box-shadow: 0 0 0 4px rgba(220,38,38,.08);
            }

        .field textarea {
            min-height: 220px;
            resize: vertical;
            line-height: 1.7;
        }

        .field input[readonly] {
            background: #f8fafc;
            color: #64748b;
        }

    /* CKEditor 5 */
    .ck.ck-editor {
        width: 100%;
    }

    .ck.ck-toolbar {
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 9px 9px 0 0 !important;
        background: #f8fafc !important;
    }

    .ck.ck-editor__main > .ck-editor__editable {
        min-height: 350px;
        padding: 12px 16px;
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 0 0 9px 9px !important;
        font-family: Arial, sans-serif;
        font-size: 15px;
        line-height: 1.7;
    }

        .ck.ck-editor__main > .ck-editor__editable:focus {
            border-color: #dc2626 !important;
            box-shadow: 0 0 0 3px rgba(220,38,38,.08) !important;
        }

    /* Bộ đếm ký tự */
    .title-counter {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        font-size: 12px;
        color: #94a3b8;
    }

        .title-counter .count {
            font-weight: 750;
            color: #64748b;
            font-size: 13px;
        }

    .title-progress {
        width: 100%;
        height: 6px;
        background: #f1f5f9;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 8px;
    }

    .title-progress-bar {
        width: 0;
        height: 100%;
        background: #16a34a;
        border-radius: 20px;
        transition: width .25s ease, background .25s ease;
    }

    .title-warning {
        display: none;
        margin-top: 9px;
        padding: 9px 12px;
        border-radius: 7px;
        background: #fff7ed;
        color: #c2410c;
        font-size: 12px;
        font-weight: 600;
    }

    /* Khu vực chọn ảnh */
    .image-upload {
        width: 100%;
        min-height: 190px;
        padding: 28px 20px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        text-align: center;
        transition: all .25s ease;
    }

        .image-upload:hover {
            border-color: #b91c1c;
            background: #fffafa;
        }

        .image-upload input[type="file"] {
            display: none;
        }

    .choose-image-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 22px;
        margin: 0;
        border: none;
        border-radius: 8px;
        background: #b91c1c;
        color: #fff !important;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all .25s ease;
    }

        .choose-image-btn:hover {
            background: #991b1b;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(185,28,28,.2);
        }

    .upload-icon {
        display: block;
        margin: 0 auto 14px;
        color: #b91c1c;
    }

    .upload-description {
        margin: 12px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .image-preview {
        width: 100%;
        margin-top: 18px;
        text-align: center;
    }

        .image-preview img {
            display: none;
            max-width: 280px;
            max-height: 200px;
            object-fit: contain;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 5px;
            background: #fff;
        }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #e5e7eb;
    }

    .btn-save,
    .btn-draft,
    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 8px;
        text-decoration: none;
        border: 0;
        cursor: pointer;
        font-weight: 700;
        transition: all .25s ease;
    }

    .btn-save {
        background: #b91c1c;
        color: white;
    }

    .btn-draft {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .btn-back {
        background: #f1f5f9;
        color: #334155;
    }

    .btn-save:hover {
        background: #991b1b;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(185,28,28,.2);
    }

    .btn-draft:hover {
        background: #fde68a;
        color: #78350f;
        transform: translateY(-2px);
    }

    .btn-back:hover {
        background: #e2e8f0;
        color: #1e293b;
        text-decoration: none;
        transform: translateY(-2px);
    }

    .text-danger,
    .validation-summary-errors {
        color: #b91c1c;
        font-size: 13px;
    }

    @@media (max-width: 650px) {
        .form-page {
            width: calc(100% - 24px);
            margin-top: 22px;
            padding: 20px 16px;
        }

        .btn-save,
        .btn-draft,
        .btn-back {
            flex: 1 1 160px;
            text-align: center;
        }
    }
</style>

<div class="form-page">
    <div class="form-card">

        <h2>Chỉnh sửa bài viết</h2>

        <p class="form-sub">
            @(isAdminUser
                ? "Cập nhật nội dung và trạng thái kiểm duyệt bài viết."
                : "Chỉnh sửa bài viết của bạn để lưu nháp hoặc gửi Biên tập viên duyệt.")
        </p>

        @if (Model.Status == "Rejected")
        {
            <div class="rejected-banner">
                <strong>Bài viết này đã bị Biên tập viên từ chối (Rejected).</strong>
                @if (!string.IsNullOrWhiteSpace(rejectionReason))
                {
                    <div style="margin-top:6px;">
                        <strong>Lý do từ chối:</strong> @rejectionReason
                    </div>
                }
                <div style="margin-top:6px;">
                    Vui lòng chỉnh sửa lại nội dung rồi bấm
                    <strong>Gửi duyệt lại</strong> để chuyển về hàng đợi chờ Biên tập viên duyệt.
                </div>
            </div>
        }
        else if (!isAdminUser && Model.Status == "Pending")
        {
            <div class="pending-banner">
                <strong>Bài viết đang chờ Biên tập viên duyệt (Pending).</strong>
                Bạn có thể cập nhật nội dung và tiếp tục giữ ở hàng đợi duyệt
                hoặc lưu tạm về bản nháp.
            </div>
        }
        else if (!isAdminUser && (Model.Status == "Published" || Model.Status == "Archived"))
        {
            <div class="pending-banner">
                <strong>Bạn có thể chỉnh sửa bài viết này.</strong>
                Khi gửi nội dung chỉnh sửa, bài sẽ chuyển sang chờ Biên tập viên duyệt;
                chọn lưu bản nháp nếu chưa muốn gửi.
            </div>
        }

    <form id="editArticleForm"
          action="@Url.RouteUrl("AdminArticles", new { action = "Edit" })"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.Image)

        @Html.ValidationSummary(true, "", new
        {
            @class = "validation-summary-errors"
        })

        <!-- Mã bài viết -->
        <div class="field">
            @Html.LabelFor(m => m.Id, "Mã bài viết")

            @Html.TextBoxFor(m => m.Id, new
            {
                @readonly = "readonly"
            })
        </div>

        <!-- Tiêu đề -->
        <div class="field">
            @Html.LabelFor(m => m.Title, "Tiêu đề bài viết")

            @Html.TextBoxFor(m => m.Title, new
            {
                maxlength = "150",
                placeholder = "Nhập tiêu đề bài viết...",
                id = "Title"
            })

            @Html.ValidationMessageFor(m => m.Title, "", new
            {
                @class = "text-danger"
            })

            <div class="title-counter">
                <span>Tiêu đề tối đa 150 ký tự</span>
                <span class="count">0/150</span>
            </div>

            <div class="title-progress">
                <div class="title-progress-bar"></div>
            </div>

            <div class="title-warning"></div>
        </div>
        <!-- Danh mục -->
        <div class="field">
            @Html.LabelFor(m => m.CategoryId, "Danh mục")
            @Html.DropDownListFor(
                m => m.CategoryId,
                (SelectList)ViewBag.CategoryId,
                "Chọn danh mục")
            @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
        </div>


        <!-- Nội dung CKEditor 5 -->
        <div class="field">
            @Html.LabelFor(m => m.Content, "Nội dung bài viết")

            @Html.TextAreaFor(m => m.Content, new
            {
                id = "Content",
                placeholder = "Nhập nội dung bài viết..."
            })

            @Html.ValidationMessageFor(m => m.Content, "", new
            {
                @class = "text-danger"
            })
        </div>

        <!-- Trạng thái -->
        @if (isAdminUser)
        {
            <div class="field">
                @Html.LabelFor(m => m.Status, "Trạng thái bài viết")

                @Html.DropDownListFor(
                         m => m.Status,
                         new SelectList(statusItems, "Value", "Text", Model.Status))
            </div>

            <div class="field" id="rejectionReasonField" style="@(Model.Status == "Rejected" ? "" : "display:none;")">
                <label for="rejectionReason">Lý do từ chối <span style="color:#b91c1c;">*</span></label>
                <textarea id="rejectionReason"
                          name="rejectionReason"
                          maxlength="500"
                          style="min-height:100px;"
                          placeholder="Nhập lý do từ chối để người viết biết cần chỉnh sửa nội dung gì...">@rejectionReason</textarea>
            </div>
        }
        else
        {
            @Html.HiddenFor(m => m.Status)

            <div class="field">
                <label>Trạng thái hiện tại</label>

                <div>
                    @if (Model.Status == "Rejected")
                    {
                        <span class="status-pill status-pill-rejected">
                            Bị từ chối (Rejected)
                        </span>
                    }
                    else if (Model.Status == "Pending")
                    {
                        <span class="status-pill status-pill-pending">
                            Chờ duyệt (Pending)
                        </span>
                    }
                    else
                    {
                        <span class="status-pill status-pill-draft">
                            Bản nháp (Draft)
                        </span>
                    }
                </div>
            </div>
        }

        <!-- Ảnh đại diện -->
        <div class="field">
            <label for="imageFile">Ảnh bài viết</label>

            <div class="image-upload">

                <svg class="upload-icon"
                     xmlns="http://www.w3.org/2000/svg"
                     width="42"
                     height="42"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="m21 15-5-5L5 21" />
                </svg>

                <label for="imageFile" class="choose-image-btn">
                    Chọn ảnh trên máy tính
                </label>

                <input type="file"
                       name="imageFile"
                       id="imageFile"
                       accept=".jpg,.jpeg,.png,.gif,.webp" />

                <p class="upload-description" id="fileName">
                    @(string.IsNullOrWhiteSpace(currentImageSrc)
                            ? "Chưa có ảnh đại diện. Bạn có thể chọn ảnh mới."
                            : "Đang sử dụng ảnh hiện tại. Chọn ảnh mới nếu muốn thay thế.")
                </p>

                <div class="image-preview">
                    <img id="previewImage"
                         src="@(currentImageSrc ?? "")"
                         style="@(string.IsNullOrWhiteSpace(currentImageSrc)
                                ? "display:none;"
                                : "display:inline-block;")"
                         alt="Ảnh xem trước" />
                </div>

                <p class="upload-description">
                    Không bắt buộc chọn ảnh mới. Định dạng JPG, PNG, GIF, WEBP,
                    tối đa 2MB.
                </p>
            </div>
        </div>

        <!-- Nút thao tác -->
        <div class="form-actions">

            @if (isAdminUser)
            {
                <button type="submit" class="btn-save">
                    Lưu thay đổi
                </button>
            }
            else
            {
                <button type="submit"
                        name="submitAction"
                        value="Pending"
                        class="btn-save">
                    @(Model.Status == "Rejected"
                            ? "Gửi duyệt lại"
                            : "Gửi Biên tập viên duyệt")
                </button>

                <button type="submit"
                        name="submitAction"
                        value="Draft"
                        class="btn-draft">
                    Lưu bản nháp
                </button>
            }

            @Html.RouteLink(
                     "Quay lại",
                     "AdminArticles",
                     new { action = "Index" },
                     new { @class = "btn-back" })

        </div>

    </form>
    </div>
</div>

<!-- CKEditor 5 -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const contentTextarea = document.getElementById("Content");
        const form = document.getElementById("editArticleForm");
        const uploadUrl = "@Url.RouteUrl("AdminArticles", new { action = "UploadContentImage" })";
        const tokenInput = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
        const antiForgeryToken = tokenInput && "value" in tokenInput ? String(tokenInput.value) : "";

        // Tạo Upload Adapter dạng factory function
        function createArticleUploadAdapter(loader = Object(null)) {
            let currentXhr = new XMLHttpRequest();

            return {
                upload: function () {
                    return loader.file.then(function (file = new File([], "")) {
                        return new Promise(function (resolve, reject) {
                            const xhr = new XMLHttpRequest();
                            currentXhr = xhr;

                            xhr.open("POST", uploadUrl, true);
                            xhr.responseType = "json";

                            xhr.addEventListener("error", function () {
                                reject("Không thể tải ảnh lên máy chủ.");
                            });
                            xhr.addEventListener("abort", function () {
                                reject("Đã hủy tải ảnh.");
                            });
                            xhr.addEventListener("load", function () {
                                const response = xhr.response;
                                if (xhr.status >= 200 && xhr.status < 300 &&
                                    response && response.uploaded && response.url) {
                                    resolve({ default: response.url });
                                } else {
                                    let errorMsg = "Tải ảnh thất bại. Vui lòng thử lại.";
                                    if (response && response.error) {
                                        errorMsg = typeof response.error === "string"
                                            ? response.error
                                            : (response.error.message || errorMsg);
                                    }
                                    reject(errorMsg);
                                }
                            });

                            const data = new FormData();
                            data.append("upload", file);
                            data.append("__RequestVerificationToken", antiForgeryToken);
                            xhr.send(data);
                        });
                    });
                },
                abort: function () {
                    if (currentXhr) {
                        currentXhr.abort();
                    }
                }
            };
        }

        let articleEditor = Object(null);
        let hasEditor = false;

        // Dùng Reflect.get để không bị lỗi index signature trên window
        const classicEditorGlobal = Reflect.get(window, "ClassicEditor");

        if (contentTextarea instanceof HTMLTextAreaElement && classicEditorGlobal) {
            classicEditorGlobal.create(contentTextarea, {
                toolbar: {
                    items: [
                        "undo", "redo", "|",
                        "heading", "|",
                        "bold", "italic", "|",
                        "bulletedList", "numberedList", "outdent", "indent", "|",
                        "link", "uploadImage", "insertTable", "|",
                        "blockQuote"
                    ],
                    shouldNotGroupWhenFull: true
                },
                image: {
                    toolbar: [
                        "imageTextAlternative",
                        "imageStyle:full",
                        "imageStyle:side"
                    ]
                },
                table: {
                    contentToolbar: ["tableColumn", "tableRow", "mergeTableCells"]
                }
            }).then(function (editor = Object(null)) {
                articleEditor = editor;
                hasEditor = true;

                editor.plugins.get("FileRepository").createUploadAdapter = function (loader = Object(null)) {
                    return createArticleUploadAdapter(loader);
                };

                editor.model.document.on("change:data", function () {
                    contentTextarea.value = editor.getData();
                });
            }).catch(function (error = Object(null)) {
                console.error("Không thể khởi tạo CKEditor 5:", error);
                alert("Không thể tải trình soạn thảo CKEditor 5. Vui lòng kiểm tra kết nối Internet.");
            });
        }

        // Bộ đếm ký tự tiêu đề
        const input = document.getElementById("Title");
        const count = document.querySelector(".title-counter .count");
        const bar = document.querySelector(".title-progress-bar");
        const warning = document.querySelector(".title-warning");

        function updateCounter() {
            if (!(input instanceof HTMLInputElement) ||
                !(count instanceof HTMLElement) ||
                !(bar instanceof HTMLElement) ||
                !(warning instanceof HTMLElement)) {
                return;
            }

            const length = input.value.length;
            const percent = Math.min((length / 150) * 100, 100);
            count.textContent = length + "/150";
            bar.style.width = percent + "%";

            if (length >= 150) {
                bar.style.background = "#dc2626";
                count.style.color = "#dc2626";
                warning.textContent = "Bạn đã đạt giới hạn 150 ký tự.";
                warning.style.display = "block";
            } else if (length >= 135) {
                bar.style.background = "#f59e0b";
                count.style.color = "#d97706";
                warning.textContent = "Bạn sắp đạt giới hạn ký tự.";
                warning.style.display = "block";
            } else {
                bar.style.background = "#16a34a";
                count.style.color = "#64748b";
                warning.style.display = "none";
            }
        }

        if (input instanceof HTMLInputElement) {
            input.addEventListener("input", updateCounter);
            updateCounter();
        }

        // Xem trước ảnh đại diện mới; nếu không chọn ảnh hoặc chọn lỗi thì giữ ảnh hiện tại.
        const imageInput = document.getElementById("imageFile");
        const preview = document.getElementById("previewImage");
        const fileName = document.getElementById("fileName");
        const initialImageSrc = preview instanceof HTMLImageElement ? (preview.getAttribute("src") || "") : "";
        const initialFileText = fileName instanceof HTMLElement ? (fileName.textContent || "") : "";
        let currentImageUrl = "";

        function resetPreviewToInitial() {
            if (!(preview instanceof HTMLImageElement) || !(fileName instanceof HTMLElement)) {
                return;
            }

            if (initialImageSrc) {
                preview.src = initialImageSrc;
                preview.style.display = "inline-block";
            } else {
                preview.src = "";
                preview.style.display = "none";
            }
            fileName.textContent = initialFileText;
            fileName.style.color = "#64748b";
            fileName.style.fontWeight = "400";
        }

        if (imageInput instanceof HTMLInputElement &&
            preview instanceof HTMLImageElement &&
            fileName instanceof HTMLElement) {

            imageInput.addEventListener("change", function () {
                const file = imageInput.files && imageInput.files[0];

                if (currentImageUrl) {
                    URL.revokeObjectURL(currentImageUrl);
                    currentImageUrl = "";
                }

                if (!file) {
                    resetPreviewToInitial();
                    return;
                }

                const allowedTypes = ["image/jpeg", "image/png", "image/gif", "image/webp"];
                if (allowedTypes.indexOf(file.type) === -1) {
                    alert("Định dạng ảnh không hợp lệ. Vui lòng chọn JPG, PNG, GIF hoặc WEBP.");
                    imageInput.value = "";
                    resetPreviewToInitial();
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    alert("Ảnh vượt quá dung lượng 2MB. Vui lòng chọn ảnh khác.");
                    imageInput.value = "";
                    resetPreviewToInitial();
                    return;
                }

                currentImageUrl = URL.createObjectURL(file);
                preview.src = currentImageUrl;
                preview.style.display = "inline-block";
                fileName.textContent = "Đã chọn ảnh mới: " + file.name;
                fileName.style.color = "#b91c1c";
                fileName.style.fontWeight = "700";
            });
        }

        // Hiển thị ô nhập lý do từ chối khi quản trị viên chọn trạng thái Rejected.
        const statusSelect = document.getElementById("Status");
        const rejectionReasonField = document.getElementById("rejectionReasonField");
        const rejectionReasonInput = document.getElementById("rejectionReason");

        function toggleRejectionReasonField() {
            if (!(statusSelect instanceof HTMLSelectElement) || !(rejectionReasonField instanceof HTMLElement)) {
                return;
            }
            const isRejected = statusSelect.value === "Rejected";
            rejectionReasonField.style.display = isRejected ? "block" : "none";
            if (rejectionReasonInput instanceof HTMLTextAreaElement) {
                rejectionReasonInput.required = isRejected;
            }
        }

        if (statusSelect instanceof HTMLSelectElement && rejectionReasonField instanceof HTMLElement) {
            statusSelect.addEventListener("change", toggleRejectionReasonField);
            toggleRejectionReasonField();
        }

        // Đồng bộ nội dung CKEditor và kiểm tra lý do từ chối trước khi gửi form.
        if (form instanceof HTMLFormElement) {
            form.addEventListener("submit", function (e) {
                if (hasEditor && typeof articleEditor.updateSourceElement === "function") {
                    articleEditor.updateSourceElement();
                }

                if (statusSelect instanceof HTMLSelectElement &&
                    statusSelect.value === "Rejected" &&
                    rejectionReasonInput instanceof HTMLTextAreaElement &&
                    !rejectionReasonInput.value.trim()) {
                    e.preventDefault();
                    alert("Vui lòng nhập lý do từ chối để người viết biết cần sửa gì.");
                    rejectionReasonInput.focus();
                    return;
                }
            });
        }
    });
</script>