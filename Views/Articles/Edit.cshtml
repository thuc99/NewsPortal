@model NewsPortal.Models.Article

@{
    ViewBag.Title = "Chỉnh sửa bài viết";
}

<style>
    .form-page { max-width: 760px; margin: 35px auto; padding: 0 18px; }
    .form-card { background: white; border: 1px solid #e2e8f0; border-radius: 13px; padding: 30px; box-shadow: 0 5px 20px rgba(15,23,42,.05); }
    .form-page h2 { font-size: 27px; font-weight: 750; color: #1e293b; margin: 0 0 8px; }
    .form-sub { color: #64748b; margin: 0 0 25px; }
    .field { margin-bottom: 20px; }
    .field label { display: block; font-weight: 600; margin-bottom: 8px; color: #334155; }
    .field input, .field textarea, .field select { width: 100%; padding: 11px 13px; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box; font: inherit; }
    .field textarea { min-height: 220px; resize: vertical; line-height: 1.7; }
    .field input:focus, .field textarea:focus, .field select:focus { outline: none; border-color: #b91c1c; }
    .field input[readonly] { background: #f1f5f9; color: #64748b; }
    .form-actions { display: flex; gap: 10px; margin-top: 25px; }
    .btn-save, .btn-back { padding: 10px 17px; border-radius: 8px; text-decoration: none; border: 0; cursor: pointer; font-weight: 600; }
    .btn-save { background: #b91c1c; color: white; }
    .btn-back { background: #e2e8f0; color: #334155; }
    .text-danger, .validation-summary-errors { color: #b91c1c; font-size: 13px; }
    @@media (max-width: 650px) { .form-page { margin-top: 22px; padding: 0 10px; } .form-card { padding: 20px; } .form-actions { flex-wrap: wrap; } }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>Chỉnh sửa bài viết</h2>
        <p class="form-sub">Cập nhật nội dung và trạng thái bài viết.</p>

        @using (Html.BeginForm("Edit", "Articles", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Image)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="field">
                @Html.LabelFor(m => m.Id, "Mã bài viết")
                @Html.TextBoxFor(m => m.Id, new { @readonly = "readonly" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Title, "Tiêu đề bài viết")
                @Html.TextBoxFor(m => m.Title, new { placeholder = "Nhập tiêu đề bài viết..." })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Content, "Nội dung bài viết")
                @Html.TextAreaFor(m => m.Content, new { placeholder = "Nhập nội dung bài viết..." })
                @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Status, "Trạng thái")
                @Html.DropDownListFor(m => m.Status,
                    new SelectList(new[] { "Draft", "Published" }, Model.Status),
                    "-- Chọn trạng thái --")
            </div>

            <div class="field">
                <label for="imageFile">Ảnh bài viết</label>
                <input type="file" name="imageFile" id="imageFile" accept="image/*" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Lưu thay đổi</button>
                @Html.ActionLink("Quay lại", "Index", "Articles", null, new { @class = "btn-back" })
            </div>
        }
    </div>
</div>
