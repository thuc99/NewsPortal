
@model NewsPortal.Models.Article

@{
    ViewBag.Title = "Xóa bài viết";
}

<style>
    .delete-page {
        width: min(760px, calc(100% - 32px));
        margin: 45px auto;
        box-sizing: border-box;
    }

    .delete-card {
        width: 100%;
        box-sizing: border-box;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 30px 34px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.06);
    }

    .delete-header {
        padding-bottom: 18px;
        margin-bottom: 22px;
        border-bottom: 1px solid #e2e8f0;
    }

    .delete-card h2 {
        margin: 0;
        color: #b91c1c;
        font-size: 27px;
        font-weight: 750;
        line-height: 1.4;
    }

    .delete-subtitle {
        margin: 7px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 9px;
        padding: 16px;
        margin-bottom: 25px;
        line-height: 1.65;
    }

    .delete-warning-icon {
        flex-shrink: 0;
        font-size: 21px;
        margin-top: 1px;
    }

    .delete-warning strong {
        display: block;
        margin-bottom: 3px;
        font-size: 15px;
    }

    .delete-warning p {
        margin: 0;
        font-size: 14px;
    }

    .delete-section-title {
        margin: 0 0 12px;
        color: #334155;
        font-size: 16px;
        font-weight: 700;
    }

    .delete-info-list {
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        overflow: hidden;
    }

    .delete-info {
        display: grid;
        grid-template-columns: 155px minmax(0, 1fr);
        align-items: center;
        gap: 15px;
        min-height: 54px;
        padding: 12px 17px;
        box-sizing: border-box;
        border-bottom: 1px solid #e2e8f0;
        background: #ffffff;
    }

        .delete-info:last-child {
            border-bottom: 0;
        }

        .delete-info:nth-child(even) {
            background: #f8fafc;
        }

    .delete-info-label {
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
    }

    .delete-info-value {
        color: #1e293b;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .delete-status {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 20px;
        background: #dcfce7;
        color: #166534;
        font-size: 12px;
        font-weight: 700;
    }

    .delete-image-section {
        margin-top: 23px;
    }

    .delete-image {
        display: block;
        width: 100%;
        max-height: 300px;
        object-fit: contain;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        padding: 8px;
        box-sizing: border-box;
    }

    .admin-main .delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #e2e8f0;
    }

    .admin-main .btn-delete,
    .admin-main .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 160px;
        min-height: 50px;
        box-sizing: border-box;
        padding: 12px 24px !important;
        border: 1px solid transparent;
        border-radius: 8px !important;
        font-size: 15px !important;
        font-weight: 700;
        line-height: 1.3;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

    .admin-main .btn-delete {
        background: #b91c1c;
        color: #ffffff !important;
    }

        .admin-main .btn-delete:hover {
            background: #991b1b;
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(185, 28, 28, .2);
        }

    .admin-main .btn-back {
        background: #e2e8f0;
        color: #334155 !important;
    }

        .admin-main .btn-back:hover {
            background: #cbd5e1;
            color: #1e293b !important;
            text-decoration: none;
        }

    @@media (max-width: 650px) {
        .delete-page {
            width: calc(100% - 24px);
            margin: 22px auto;
        }

        .delete-card {
            padding: 22px 18px;
        }

            .delete-card h2 {
                font-size: 23px;
            }

        .delete-info {
            grid-template-columns: 110px minmax(0, 1fr);
            gap: 10px;
            padding: 12px;
        }

        .admin-main .delete-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .admin-main .btn-delete,
        .admin-main .btn-back {
            width: 100%;
        }
    }

    @@media (max-width: 380px) {
        .delete-info {
            grid-template-columns: 1fr;
            gap: 5px;
        }
    }
</style>

<div class="delete-page">
    <div class="delete-card">

        <div class="delete-header">
            <h2>Xóa bài viết</h2>
            <p class="delete-subtitle">
                Kiểm tra thông tin trước khi xác nhận xóa bài viết.
            </p>
        </div>

        <div class="delete-warning">
            <div class="delete-warning-icon">
                <i class="glyphicon glyphicon-warning-sign"></i>
            </div>
            <div>
                <strong>Bạn có chắc chắn muốn xóa bài viết này?</strong>
                <p>
                    Hành động này không thể hoàn tác. Vui lòng kiểm tra kỹ
                    thông tin bài viết trước khi tiếp tục.
                </p>
            </div>
        </div>

        <h3 class="delete-section-title">Thông tin bài viết</h3>

        <div class="delete-info-list">

            <div class="delete-info">
                <div class="delete-info-label">Mã bài viết</div>
                <div class="delete-info-value">#@Model.Id</div>
            </div>

            <div class="delete-info">
                <div class="delete-info-label">Tiêu đề</div>
                <div class="delete-info-value">@Model.Title</div>
            </div>

            <div class="delete-info">
                <div class="delete-info-label">Ngày đăng</div>
                <div class="delete-info-value">
                    @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

            <div class="delete-info">
                <div class="delete-info-label">Trạng thái</div>
                <div class="delete-info-value">
                    <span class="delete-status">@Model.Status</span>
                </div>
            </div>

        </div>

        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <div class="delete-image-section">
                <h3 class="delete-section-title">Ảnh đại diện bài viết</h3>

                <img src="@(Model.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                    ? Model.Image
                    : Url.Content("~/Content/Images/" + Model.Image))"
                     class="delete-image"
                     alt="Ảnh bài viết" />
            </div>
        }

        <form action="@Url.RouteUrl("AdminArticles", new { action = "Delete", id = Model.Id })"
              method="post">

            @Html.AntiForgeryToken()

            <div class="delete-actions">
                @Html.RouteLink(
                         "Hủy",
                         "AdminArticles",
                         new { action = "Index" },
                         new { @class = "btn-back" })

                <button type="submit" class="btn-delete">
                    <i class="glyphicon glyphicon-trash"></i>
                    &nbsp; Xác nhận xóa
                </button>
            </div>

        </form>

    </div>
</div>
