@model NewsPortal.Models.Article

@{
    ViewBag.Title = "Xóa bài viết";
}

<style>
    .delete-page { width: min(700px, calc(100% - 32px)); max-width: 700px; margin: 40px auto; padding: 0; }
    .delete-card { background: white; border: 0; border-radius: 0; padding: 0 0 30px; }
    .delete-card h2 { color: #b91c1c; font-size: 26px; font-weight: 750; margin-top: 0; }
    .delete-warning { background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; border-radius: 8px; padding: 14px; margin: 20px 0; }
    .delete-info { padding: 12px 0; border-bottom: 1px solid #e2e8f0; color: #334155; }
    .delete-image { width: 100%; max-height: 260px; object-fit: cover; border-radius: 8px; margin-top: 18px; }
    .delete-actions { display: flex; gap: 10px; margin-top: 25px; }
    .btn-delete, .btn-back { border: 0; padding: 10px 17px; border-radius: 8px; text-decoration: none; cursor: pointer; font-weight: 600; }
    .btn-delete { background: #b91c1c; color: white; }
    .btn-back { background: #e2e8f0; color: #334155; }
    @@media (max-width: 650px) { .delete-page { width: calc(100% - 24px); margin-top: 22px; } .delete-actions { flex-wrap: wrap; } .btn-delete, .btn-back { flex: 1 1 160px; text-align: center; } .delete-image { max-height: 220px; } }
</style>

<div class="delete-page">
    <div class="delete-card">
        <h2>Xóa bài viết</h2>

        <div class="delete-warning">
            Bạn có chắc chắn muốn xóa bài viết này không?<br />
            Hành động này không thể hoàn tác.
        </div>

        <div class="delete-info"><strong>Mã bài viết:</strong> @Model.Id</div>
        <div class="delete-info"><strong>Tiêu đề:</strong> @Model.Title</div>
        <div class="delete-info"><strong>Ngày đăng:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
        <div class="delete-info"><strong>Trạng thái:</strong> @Model.Status</div>

        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="@(Model.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.Image : Url.Content("~/Content/Images/" + Model.Image))"
                 class="delete-image" alt="Ảnh bài viết" />
        }

        <form action="@Url.RouteUrl("AdminArticles", new { action = "Delete", id = Model.Id })" method="post">
            @Html.AntiForgeryToken()
            <div class="delete-actions">
                <button type="submit" class="btn-delete">Xác nhận xóa</button>
                @Html.RouteLink("Hủy", "AdminArticles", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>
