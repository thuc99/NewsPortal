@model IEnumerable<NewsPortal.Models.Article>
@using System
@using System.Linq
@using NewsPortal.Models

@{
    bool canManageArticles = ViewBag.CanManageArticles == true;
    bool isAdminManagement = ViewBag.IsAdminManagement == true;
    bool isAdminUser = ViewBag.IsAdminUser == true;
    string currentStatusFilter = ViewBag.Status as string ?? "";

    string articleIndexUrl = isAdminManagement
        ? Url.RouteUrl("AdminArticles", new { action = "Index" })
        : Url.Action("Index", "Articles");

    ViewBag.Title = canManageArticles ? "Quản lý bài viết" : "Tin tức";

    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    var authors = ViewBag.Authors as IEnumerable<Author> ?? Enumerable.Empty<Author>();
    var currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
    var totalArticles = ViewBag.TotalArticles == null ? 0 : (int)ViewBag.TotalArticles;

    int countAll = ViewBag.CountAll == null ? totalArticles : (int)ViewBag.CountAll;
    int countDraft = ViewBag.CountDraft == null ? 0 : (int)ViewBag.CountDraft;
    int countPending = ViewBag.CountPending == null ? 0 : (int)ViewBag.CountPending;
    int countPublished = ViewBag.CountPublished == null ? 0 : (int)ViewBag.CountPublished;
    int countRejected = ViewBag.CountRejected == null ? 0 : (int)ViewBag.CountRejected;
    int countArchived = ViewBag.CountArchived == null ? 0 : (int)ViewBag.CountArchived;
}

@if (TempData["Success"] != null)
{<div class="alert alert-success">@TempData["Success"]</div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger">@TempData["Error"]</div>}
@if (ViewBag.WarningMessage != null)
{<div class="alert alert-warning">@ViewBag.WarningMessage</div>}

<style>
    .alert {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 20px auto 0;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-danger {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .alert-warning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .management-page {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 35px auto;
        color: #1e293b;
    }

    .admin-articles-page {
        width: min(1208px, calc(100% - 32px));
        max-width: 1208px;
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

        .management-header h2 {
            margin: 0 0 6px;
            font-size: 28px;
            font-weight: 750;
            line-height: 1.3;
        }

    .management-subtitle {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-add {
        display: inline-block;
        padding: 11px 17px;
        border: none;
        border-radius: 8px;
        background: #b91c1c;
        color: white !important;
        text-decoration: none !important;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-add:hover {
            background: #991b1b;
        }

    .btn-admin-dash {
        display: inline-block;
        padding: 11px 15px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #f8fafc;
        color: #1e293b !important;
        text-decoration: none !important;
        font-weight: 600;
    }

        .btn-admin-dash:hover {
            background: #e2e8f0;
        }

    .workflow-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
    }

    .wf-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #334155 !important;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s;
    }

        .wf-tab:hover {
            border-color: #b91c1c;
            color: #b91c1c !important;
        }

        .wf-tab.active {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #fff !important;
        }

    .wf-count {
        display: inline-block;
        padding: 1px 7px;
        border-radius: 999px;
        background: rgba(15, 23, 42, .08);
        font-size: 11.5px;
        font-weight: 700;
    }

    .wf-tab.active .wf-count {
        background: rgba(255, 255, 255, .22);
        color: #fff;
    }

    .filter-toggle {
        border: 0;
        padding: 9px 14px;
        border-radius: 8px;
        background: #e2e8f0;
        color: #334155;
        font-weight: 700;
        cursor: pointer;
    }

        .filter-toggle:hover {
            background: #cbd5e1;
        }

    .filter-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 12px;
    }

    .advanced-filter {
        margin: 12px 0 18px;
        padding: 16px 0;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        background: transparent;
    }

        .advanced-filter.is-hidden {
            display: none;
        }

        .advanced-filter form {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .advanced-filter input,
        .advanced-filter select {
            min-height: 38px;
            min-width: 145px;
            padding: 8px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            background: white;
            font: inherit;
            color: #334155;
        }

            .advanced-filter input[type="search"] {
                flex: 1;
                min-width: 230px;
            }

    .filter-submit,
    .filter-reset {
        display: inline-flex;
        align-items: center;
        min-height: 38px;
        padding: 8px 14px;
        border: 0;
        border-radius: 7px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .filter-submit {
        background: #b91c1c;
        color: white;
    }

    .filter-reset {
        background: #e2e8f0;
        color: #334155 !important;
    }

    .result-count {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    .management-card {
        overflow-x: auto;
        border: 0;
        border-radius: 10px;
        background: #fff;
    }

    .management-table {
        width: 100%;
        border-collapse: collapse;
    }

        .management-table th {
            padding: 16px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            color: #475569;
            font-size: 12px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .management-table td {
            padding: 17px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .management-table tbody tr:hover {
            background: #fafcff;
        }

    .article-image {
        width: 88px;
        height: 62px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }

    .admin-articles-page .management-table {
        table-layout: fixed;
    }

    .admin-articles-page .management-table th:nth-child(1),
    .admin-articles-page .management-table td:nth-child(1) {
        width: 110px;
    }

    .admin-articles-page .management-table th:nth-child(2),
    .admin-articles-page .management-table td:nth-child(2) {
        width: 50%;
    }

    .admin-articles-page .management-table th:nth-child(3),
    .admin-articles-page .management-table td:nth-child(3) {
        width: 110px;
    }

    .admin-articles-page .management-table th:nth-child(4),
    .admin-articles-page .management-table td:nth-child(4) {
        width: 145px;
    }

    .admin-articles-page .management-table th:nth-child(5),
    .admin-articles-page .management-table td:nth-child(5) {
        width: 240px;
        padding-left: 28px;
    }

    .admin-articles-page .article-title {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .public-articles-page .management-table {
        table-layout: fixed;
    }

    .public-articles-page .management-table th:first-child,
    .public-articles-page .management-table td:first-child {
        width: 220px;
    }

    .public-articles-page .article-image {
        display: block;
        width: 190px;
        height: 125px;
        object-fit: cover;
    }

    .article-title {
        min-width: 240px;
        color: #1e293b;
        font-size: 18px;
        font-weight: 750;
        line-height: 1.5;
    }

    .article-title a {
        color: #1e293b;
    }

    .article-title a:hover {
        color: #b91c1c;
    }

    .article-excerpt {
        display: -webkit-box;
        margin: 5px 0 0;
        overflow: hidden;
        color: #64748b;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.6;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .article-date {
        color: #64748b;
        white-space: nowrap;
        font-size: 13px;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-published {
        background: #dcfce7;
        color: #166534;
    }

    .status-draft {
        background: #fef3c7;
        color: #92400e;
    }

    .status-pending {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-rejected {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-archived {
        background: #f1f5f9;
        color: #475569;
    }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    .admin-articles-page .management-table td:nth-child(5) .action-group {
        justify-content: flex-start;
        margin-left: 0;
    }

    .inline-wf-form {
        display: inline;
        margin: 0;
    }

    .action-btn {
        display: inline-block;
        padding: 7px 10px;
        margin: 2px;
        border: 0;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 12.5px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
    }

    .btn-edit {
        background: #fef08a;
        color: #854d0e !important;
    }

    .btn-detail {
        background: #dbeafe;
        color: #1d4ed8 !important;
    }

    .btn-submit-wf {
        background: #dcfce7;
        color: #166534 !important;
    }

    .btn-reject-wf {
        background: #ffedd5;
        color: #c2410c !important;
    }

    .btn-archive-wf {
        background: #e2e8f0;
        color: #334155 !important;
    }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c !important;
    }

    .empty-message {
        padding: 40px !important;
        color: #64748b;
        text-align: center;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 22px 0;
    }

    .pagination-direction {
        min-width: 64px;
        text-align: center;
    }

    .pagination-direction.disabled {
        padding: 7px 11px;
        background: #f8fafc;
        color: #a0a5ae;
    }

        .pagination a {
            padding: 7px 11px;
            border-radius: 6px;
            background: #f1f5f9;
            color: #334155;
            text-decoration: none;
        }

            .pagination a.active {
                background: #b91c1c;
                color: white;
            }

    @@media (max-width: 850px) {
        .management-table {
            min-width: 760px;
        }
    }

    @@media (max-width: 600px) {
        .management-page {
            width: calc(100% - 24px);
            margin-top: 22px;
        }

        .management-header h2 {
            font-size: 25px;
        }

        .btn-add {
            width: 100%;
            text-align: center;
        }

        .advanced-filter form {
            display: grid;
            grid-template-columns: 1fr;
        }

        .advanced-filter input,
        .advanced-filter select,
        .filter-submit,
        .filter-reset {
            width: 100%;
            min-width: 0;
        }

            .advanced-filter input[type="search"] {
                min-width: 0;
            }
    }
</style>

<div class="management-page @(isAdminManagement ? "admin-articles-page" : "public-articles-page")">

    <div class="management-header">
        <div>
            <h2>@(canManageArticles ? (isAdminUser ? "Quản lý & Kiểm duyệt bài viết" : "Bài viết của Phóng viên") : "Tin tức mới nhất")</h2>

            <p class="management-subtitle">
                @(canManageArticles
                    ? (isAdminUser
                        ? "Kiểm duyệt bài chờ duyệt (Pending), xuất bản lên trang chủ, từ chối hoặc lưu trữ bài viết."
                        : "Soạn bài, chỉnh sửa bài viết ở mọi trạng thái; các chỉnh sửa bài đã xuất bản sẽ được gửi Admin duyệt lại.")
                    : "Cập nhật những tin tức mới nhất trên NewsPortal.")
            </p>
        </div>

        @if (canManageArticles)
        {
            <div class="header-actions">
                @if (isAdminUser)
                {
                    <a class="btn-admin-dash" href="@Url.Action("Index", "Admin")">Bảng điều khiển Admin</a>
                }
                <a class="btn-add" href="@Url.RouteUrl("AdminArticles", new { action = "Create", returnUrl = Request.RawUrl + "#article-results" })">+ Thêm bài viết</a>
            </div>
        }
    </div>

    @if (canManageArticles)
    {
        <div class="workflow-tabs">
            <a class="wf-tab @(string.IsNullOrEmpty(currentStatusFilter) ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index" })">
                Tất cả <span class="wf-count">@countAll</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Pending" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Pending" })">
                Chờ duyệt (Pending) <span class="wf-count">@countPending</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Draft" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Draft" })">
                Bản nháp (Draft) <span class="wf-count">@countDraft</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Published" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Published" })">
                Đã xuất bản (Published) <span class="wf-count">@countPublished</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Rejected" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Rejected" })">
                Bị từ chối (Rejected) <span class="wf-count">@countRejected</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Archived" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Archived" })">
                Đã lưu trữ (Archived) <span class="wf-count">@countArchived</span>
            </a>
        </div>
    }

    <div class="filter-toolbar">
        <p class="result-count">
            Tìm thấy <strong>@totalArticles</strong> bài viết
        </p>

        <button type="button" id="filterToggle" class="filter-toggle">
            Bộ lọc nâng cao
        </button>
    </div>

    <div id="advancedFilter" class="advanced-filter is-hidden">
        <form method="get" action="@articleIndexUrl">
            <input type="search"
                   name="searchString"
                   value="@(ViewBag.SearchString ?? "")"
                   placeholder="Tìm tiêu đề, tóm tắt, nội dung..." />

            <select name="categoryId">
                <option value="">Tất cả danh mục</option>

                @foreach (var category in categories)
                {
                    <option value="@category.CategoryID"
                            @(ViewBag.CategoryId != null && ViewBag.CategoryId == category.CategoryID ? "selected" : "")>
                        @category.CategoryName
                    </option>
                }
            </select>

            <select name="authorId">
                <option value="">Tất cả tác giả</option>

                @foreach (var author in authors)
                {
                    <option value="@author.AuthorID"
                            @(ViewBag.AuthorId != null && ViewBag.AuthorId == author.AuthorID ? "selected" : "")>
                        @author.AuthorName
                    </option>
                }
            </select>

            @if (canManageArticles)
            {
                <select name="status">
                    <option value="">Mọi trạng thái</option>
                    <option value="Draft" @(currentStatusFilter == "Draft" ? "selected" : "")>Draft - Bản nháp</option>
                    <option value="Pending" @(currentStatusFilter == "Pending" ? "selected" : "")>Pending - Chờ duyệt</option>
                    <option value="Published" @(currentStatusFilter == "Published" ? "selected" : "")>Published - Đã xuất bản</option>
                    <option value="Rejected" @(currentStatusFilter == "Rejected" ? "selected" : "")>Rejected - Bị từ chối</option>
                    <option value="Archived" @(currentStatusFilter == "Archived" ? "selected" : "")>Archived - Đã lưu trữ</option>
                </select>
            }

            <div style="position: relative; display: inline-block;">
                <span style="position: absolute; top: -8px; left: 10px; background: #fff; padding: 0 5px; font-size: 11px; font-weight: 600; color: #b91c1c; line-height: 1; z-index: 1;">
                    Từ ngày
                </span>
                <input type="date"
                       name="fromDate"
                       value="@(ViewBag.FromDate == null ? "" : ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd"))" />
            </div>

            <div style="position: relative; display: inline-block;">
                <span style="position: absolute; top: -8px; left: 10px; background: #fff; padding: 0 5px; font-size: 11px; font-weight: 600; color: #b91c1c; line-height: 1; z-index: 1;">
                    Đến ngày
                </span>
                <input type="date"
                       name="toDate"
                       value="@(ViewBag.ToDate == null ? "" : ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd"))" />
            </div>

            <button type="submit" class="filter-submit">
                Lọc
            </button>

            <a class="filter-reset" href="@articleIndexUrl">Xóa lọc</a>
        </form>
    </div>

    <div class="management-card" id="article-results">
        <table class="management-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tiêu đề bài viết</th>
                    <th>Ngày đăng</th>

                    @if (canManageArticles)
                    {
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string imgSrc = null;
                        if (!string.IsNullOrWhiteSpace(item.Image))
                        {
                            if (item.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase) || item.Image.StartsWith("/"))
                            {
                                imgSrc = item.Image;
                            }
                            else if (item.Image.StartsWith("~/"))
                            {
                                imgSrc = Url.Content(item.Image);
                            }
                            else
                            {
                                imgSrc = Url.Content("~/Content/Images/" + item.Image);
                            }
                        }

                        string badgeClass = "status-draft";
                        string badgeLabel = "Bản nháp (Draft)";
                        if (item.Status == "Pending")
                        {
                            badgeClass = "status-pending";
                            badgeLabel = "Chờ duyệt (Pending)";
                        }
                        else if (item.Status == "Published")
                        {
                            badgeClass = "status-published";
                            badgeLabel = "Đã xuất bản (Published)";
                        }
                        else if (item.Status == "Rejected")
                        {
                            badgeClass = "status-rejected";
                            badgeLabel = "Bị từ chối (Rejected)";
                        }
                        else if (item.Status == "Archived")
                        {
                            badgeClass = "status-archived";
                            badgeLabel = "Đã lưu trữ (Archived)";
                        }

                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(imgSrc))
                                {
                                    <img src="@imgSrc"
                                         class="article-image"
                                         alt="@item.Title" />
                                }
                                else
                                {
                                    <span>Không có ảnh</span>
                                }
                            </td>

                            <td class="article-title">
                                <a href="@(isAdminManagement ? Url.RouteUrl("AdminArticles", new { action = "Details", id = item.Id }) : Url.Action("View", "Articles", new { id = item.Id }))">@item.Title</a>
                                @if (!string.IsNullOrWhiteSpace(item.PlainSummary))
                                {
                                    <div class="article-excerpt">@item.PlainSummary</div>
                                }
                            </td>

                            <td class="article-date">
                                @item.CreatedDate.ToString("dd/MM/yyyy")
                            </td>

                            @if (canManageArticles)
                            {
                                <td>
                                    <span class="status-badge @badgeClass">
                                        @badgeLabel
                                    </span>
                                </td>
                                <td>
                                    <div class="action-group">
                                        @if (isAdminUser)
                                        {
                                            if (item.Status == "Pending")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Published" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Duyệt đăng</button>
                                                }
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Rejected" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-reject-wf">Từ chối</button>
                                                }
                                            }
                                            else if (item.Status == "Published")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Archived" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-archive-wf">Lưu trữ</button>
                                                }
                                            }
                                            else if (item.Status == "Archived")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Published" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Xuất bản lại</button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Published" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Duyệt đăng</button>
                                                }
                                            }

                                            @Html.RouteLink("Sửa", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                            @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                        }
                                        else
                                        {
                                            if (item.Status == "Draft")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Pending" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Gửi duyệt</button>
                                                }
                                                @Html.RouteLink("Sửa", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                                @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                            }
                                            else if (item.Status == "Rejected")
                                            {
                                                @Html.RouteLink("Sửa & gửi lại", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Pending" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Gửi duyệt lại</button>
                                                }
                                                @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                            }
                                            else if (item.Status == "Pending")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Draft" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-archive-wf">Rút về nháp</button>
                                                }
                                                @Html.RouteLink("Sửa", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                            }
                                            else
                                            {
                                                @Html.RouteLink("Xem bài", "AdminArticles", new { action = "Details", id = item.Id }, new { @class = "action-btn btn-detail" })
                                                @Html.RouteLink("Sửa bài", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                                @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                            }
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(canManageArticles ? 5 : 3)" class="empty-message">
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchString as string)
                                ? "Không tìm thấy bài viết phù hợp."
                                : "Không tìm thấy bài viết nào phù hợp với từ khóa '" + ViewBag.SearchString + "'.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="pagination">
            @if (currentPage > 1)
            {
                <a class="pagination-direction"
                   href="@(isAdminManagement ? Url.RouteUrl("AdminArticles", new { action = "Index", searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage - 1 }) : Url.Action("Index", "Articles", new { searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage - 1 }))#article-results">Trước</a>
            }
            else
            {
                <span class="pagination-direction disabled">Trước</span>
            }

            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <a class="@(pageNumber == currentPage ? "active" : "")"
                   href="@((isAdminManagement ? Url.RouteUrl("AdminArticles", new {
                        action = "Index",
                        searchString = ViewBag.SearchString,
                        categoryId = ViewBag.CategoryId,
                        authorId = ViewBag.AuthorId,
                        status = ViewBag.Status,
                        fromDate = ViewBag.FromDate,
                        toDate = ViewBag.ToDate,
                        page = pageNumber
                    }) : Url.Action("Index", "Articles", new {
                        searchString = ViewBag.SearchString,
                        categoryId = ViewBag.CategoryId,
                        authorId = ViewBag.AuthorId,
                        status = ViewBag.Status,
                        fromDate = ViewBag.FromDate,
                        toDate = ViewBag.ToDate,
                        page = pageNumber
                    })) + "#article-results")">
                    @pageNumber
                </a>
            }

            @if (currentPage < totalPages)
            {
                <a class="pagination-direction"
                   href="@(isAdminManagement ? Url.RouteUrl("AdminArticles", new { action = "Index", searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage + 1 }) : Url.Action("Index", "Articles", new { searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage + 1 }))#article-results">Sau</a>
            }
            else
            {
                <span class="pagination-direction disabled">Sau</span>
            }
        </nav>
    }

</div>

<script>
    (function () {
        var toggle = document.getElementById("filterToggle");
        var filter = document.getElementById("advancedFilter");

        if (toggle && filter) {
            toggle.addEventListener("click", function () {
                if (!toggle || !filter) return;
                filter.classList.toggle("is-hidden");

                toggle.textContent =
                    filter.classList.contains("is-hidden")
                        ? "Bộ lọc nâng cao"
                        : "Ẩn bộ lọc";
            });
        }
    })();
</script>
