@model IEnumerable<NewsPortal.Models.Articles>

@{
    ViewBag.Title = "Quản lý bài viết";
}

<h2>Quản lý bài viết</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="padding:10px; background:#dcfce7; color:#166534; margin-bottom:12px; border-radius:4px;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="padding:10px; background:#fef2f2; color:#991b1b; margin-bottom:12px; border-radius:4px;">@TempData["Error"]</div>
}

<div style="display:flex; gap:16px; margin-bottom:16px; flex-wrap:wrap;">
    <div style="padding:10px 16px; background:#f6f7f9; border:1px solid #e9e9ed; border-radius:4px;">
        Tổng số bài viết: <strong>@ViewBag.TotalCount</strong>
    </div>
    <div style="padding:10px 16px; background:#dcfce7; border:1px solid #bbf7d0; color:#166534; border-radius:4px;">
        Published (Đã xuất bản): <strong>@ViewBag.PublishedCount</strong>
    </div>
    <div style="padding:10px 16px; background:#fef3c7; border:1px solid #fde68a; color:#92400e; border-radius:4px;">
        Draft (Bản nháp): <strong>@ViewBag.DraftCount</strong>
    </div>
</div>

<p>
    @Html.ActionLink("+ Thêm mới bài viết", "Create", null, new { @class = "btn btn-primary" })
</p>

@using (Html.BeginForm("Index", "Articles", FormMethod.Get, new { style = "margin-bottom: 16px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;" }))
{
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm theo tiêu đề hoặc tóm tắt..." class="form-control" style="width:220px; display:inline-block;" />
    @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "-- Tất cả danh mục --", new { @class = "form-control", style = "width:180px; display:inline-block;" })
    @Html.DropDownList("authorId", (SelectList)ViewBag.Authors, "-- Tất cả tác giả --", new { @class = "form-control", style = "width:180px; display:inline-block;" })
    <select name="status" class="form-control" style="width:170px; display:inline-block;">
        <option value="">-- Tất cả trạng thái --</option>
        <option value="Published" @(ViewBag.SelectedStatus == "Published" ? "selected" : "")>Published (Đã xuất bản)</option>
        <option value="Draft" @(ViewBag.SelectedStatus == "Draft" ? "selected" : "")>Draft (Bản nháp)</option>
    </select>
    <button type="submit" class="btn btn-default">Lọc</button>
    @Html.ActionLink("Đặt lại", "Index", null, new { @class = "btn btn-default" })
}

<table class="table table-bordered table-striped" style="width:100%; border-collapse:collapse;">
    <tr>
        <th>#</th>
        <th>Tiêu đề</th>
        <th>Danh mục</th>
        <th>Tác giả</th>
        <th>Trạng thái</th>
        <th>Ngày tạo / Cập nhật</th>
        <th>Thao tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ArticleID</td>
            <td>
                <strong>@item.Title</strong>
                @if (!string.IsNullOrWhiteSpace(item.Summary))
                {
                    <div style="font-size:12px; color:#666;">@item.Summary</div>
                }
            </td>
            <td>@(item.Categories != null ? item.Categories.CategoryName : "—")</td>
            <td>@(item.Authors != null ? item.Authors.AuthorName : "—")</td>
            <td>
                @if (item.Status == "Published")
                {
                    <span style="padding:3px 8px; background:#dcfce7; color:#166534; border-radius:4px; font-weight:bold; font-size:12px;">Published</span>
                }
                else
                {
                    <span style="padding:3px 8px; background:#fef3c7; color:#92400e; border-radius:4px; font-weight:bold; font-size:12px;">Draft</span>
                }
            </td>
            <td style="font-size:12px;">
                <div>Tạo: @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                @if (item.UpdatedDate.HasValue)
                {
                    <div style="color:#666;">Sửa: @item.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
            </td>
            <td>
                @using (Html.BeginForm("ToggleStatus", "Articles", new { id = item.ArticleID }, FormMethod.Post, new { style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-default" style="cursor:pointer;">
                        @(item.Status == "Published" ? "Chuyển sang Draft" : "Xuất bản (Publish)")
                    </button>
                }
                | @Html.ActionLink("Sửa", "Edit", new { id = item.ArticleID })
                | @Html.ActionLink("Chi tiết", "Details", new { id = item.ArticleID })
                | @Html.ActionLink("Xóa", "Delete", new { id = item.ArticleID })
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr>
            <td colspan="7" style="text-align:center; padding:20px; color:#666;">Không có bài viết nào.</td>
        </tr>
    }
</table>
