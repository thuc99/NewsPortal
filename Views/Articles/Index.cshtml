@model IEnumerable<NewsPortal.Models.Article>
@using System
@using System.Linq
@using NewsPortal.Models

@{
    bool canManageArticles = ViewBag.CanManageArticles == true;
    bool isAdminManagement = ViewBag.IsAdminManagement == true;
    bool isAdminUser = ViewBag.IsAdminUser == true;
    bool canReviewArticles = ViewBag.CanReviewArticles == true || isAdminUser;
    bool isAuthorOnly = ViewBag.IsAuthorOnly == true;
    var rejectionReasons = ViewBag.RejectionReasons as System.Collections.Generic.Dictionary<int, string>
        ?? new System.Collections.Generic.Dictionary<int, string>();
    string currentStatusFilter = ViewBag.Status as string ?? "";

    string articleIndexUrl = isAdminManagement
        ? Url.RouteUrl("AdminArticles", new { action = "Index" })
        : Url.Action("Index", "Articles");

    ViewBag.Title = canManageArticles ? "Quản lý bài viết" : "Tin tức";

    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    var authors = ViewBag.Authors as IEnumerable<Author> ?? Enumerable.Empty<Author>();
    var currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
    var totalArticles = ViewBag.TotalArticles == null ? 0 : (int)ViewBag.TotalArticles;

    int countAll = ViewBag.CountAll == null ? totalArticles : (int)ViewBag.CountAll;
    int countDraft = ViewBag.CountDraft == null ? 0 : (int)ViewBag.CountDraft;
    int countPending = ViewBag.CountPending == null ? 0 : (int)ViewBag.CountPending;
    int countPublished = ViewBag.CountPublished == null ? 0 : (int)ViewBag.CountPublished;
    int countRejected = ViewBag.CountRejected == null ? 0 : (int)ViewBag.CountRejected;
    int countArchived = ViewBag.CountArchived == null ? 0 : (int)ViewBag.CountArchived;
}

<style>
    .alert {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 20px auto 0;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-danger {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .alert-warning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .management-page {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 35px auto;
        color: #1e293b;
    }

    .admin-articles-page {
        width: 100%;
        max-width: none;
        margin: 0 auto;
    }

    .admin-articles-page .alert {
        width: 100%;
        max-width: none;
        margin: 0 0 16px;
        box-sizing: border-box;
    }

    .admin-page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 22px;
    }

        .admin-page-heading > div > a {
            color: #b91c32;
            font-size: 13px;
            font-weight: 700;
        }

        .admin-page-heading h2 {
            margin: 6px 0 0;
            color: #172033;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.2;
        }

    .admin-list-panel.is-admin {
        padding: 22px;
        border: 1px solid #e9e9ed;
        border-radius: 12px;
        background: #fff;
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

        .management-header h2 {
            margin: 0 0 6px;
            font-size: 28px;
            font-weight: 750;
            line-height: 1.3;
        }

    .management-subtitle {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 40px;
        padding: 0 18px;
        border: 1px solid #b91c32;
        border-radius: 8px !important;
        background: #b91c32;
        color: #fff !important;
        text-decoration: none !important;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
    }

        .btn-add:hover {
            background: #991b2b;
            box-shadow: 0 3px 8px rgba(185, 28, 50, .2);
            transform: translateY(-1px);
        }

    .btn-admin-dash {
        display: inline-block;
        padding: 11px 15px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #f8fafc;
        color: #1e293b !important;
        text-decoration: none !important;
        font-weight: 600;
    }

        .btn-admin-dash:hover {
            background: #e2e8f0;
        }

    .workflow-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
    }

    .wf-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #334155 !important;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s;
    }

        .wf-tab:hover {
            border-color: #b91c1c;
            color: #b91c1c !important;
        }

        .wf-tab.active {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #fff !important;
        }

    .wf-count {
        display: inline-block;
        padding: 1px 7px;
        border-radius: 999px;
        background: rgba(15, 23, 42, .08);
        font-size: 11.5px;
        font-weight: 700;
    }

    .wf-tab.active .wf-count {
        background: rgba(255, 255, 255, .22);
        color: #fff;
    }

    .filter-toggle {
        border: 0;
        padding: 9px 14px;
        border-radius: 8px;
        background: #e2e8f0;
        color: #334155;
        font-weight: 700;
        cursor: pointer;
    }

        .filter-toggle:hover {
            background: #cbd5e1;
        }

    .filter-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 12px;
    }

    .advanced-filter {
        margin: 12px 0 18px;
        padding: 16px 0;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        background: transparent;
    }

        .advanced-filter.is-hidden {
            display: none;
        }

        .advanced-filter form {
            display: grid;
            grid-template-columns: minmax(230px, 2fr) minmax(145px, 1.05fr) minmax(145px, 1.3fr) repeat(2, minmax(170px, 1fr)) auto;
            align-items: center;
            gap: 9px;
        }

        .advanced-filter form > input,
        .advanced-filter form > select,
        .advanced-filter form > div:not(.filter-actions) {
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
        }

        .advanced-filter input,
        .advanced-filter select {
            min-height: 38px;
            min-width: 0;
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            background: white;
            font: inherit;
            color: #334155;
        }

            .advanced-filter input[type="search"] {
                min-width: 0;
            }

    .filter-submit,
    .filter-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 8px 18px;
        border: 0;
        border-radius: 7px;
        box-sizing: border-box;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .filter-submit {
        min-width: 84px;
        background: #b91c1c;
        color: white;
    }

    .filter-actions {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 9px;
        flex: 0 0 auto;
        white-space: nowrap;
    }

    .admin-articles-page .advanced-filter input,
    .admin-articles-page .advanced-filter select,
    .admin-articles-page .filter-submit,
    .admin-articles-page .filter-reset {
        min-height: 40px;
    }

    .admin-articles-page .filter-actions .filter-reset {
        flex: 0 0 auto;
        width: auto !important;
        min-width: 0 !important;
        min-height: 40px !important;
        height: 40px !important;
        padding: 8px 12px !important;
        font-size: 14px !important;
        padding-right: 12px !important;
        padding-left: 12px !important;
    }

    .admin-articles-page .filter-actions .filter-submit {
        width: auto !important;
        min-width: 84px !important;
        min-height: 40px !important;
        height: 40px !important;
        padding: 8px 18px !important;
        font-size: 14px !important;
    }

    .admin-articles-page .advanced-filter form.admin-advanced-filter {
        grid-template-columns: minmax(190px, 1.8fr) repeat(3, minmax(120px, 1fr)) repeat(2, minmax(150px, 1fr)) auto;
    }

    .admin-articles-page .advanced-filter.is-hidden {
        display: none;
    }

    .filter-reset {
        min-width: 0;
        padding-right: 12px;
        padding-left: 12px;
        background: #e2e8f0;
        color: #334155 !important;
    }

    .result-count {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    .management-card {
        overflow-x: auto;
        border: 0;
        border-radius: 10px;
        background: #fff;
    }

    .admin-list-panel.is-admin .management-card {
        border-radius: 0;
    }

    .management-table {
        width: 100%;
        border-collapse: collapse;
    }

        .management-table th {
            padding: 16px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            color: #475569;
            font-size: 12px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .management-table td {
            padding: 17px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .management-table tbody tr:hover {
            background: #fafcff;
        }

    .article-image {
        width: 88px;
        height: 62px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }

    .admin-articles-page .management-table {
        table-layout: fixed;
    }

    .admin-articles-page .management-table th:nth-child(1),
    .admin-articles-page .management-table td:nth-child(1) {
        width: 110px;
    }

    .admin-articles-page .management-table th:nth-child(2),
    .admin-articles-page .management-table td:nth-child(2) {
        width: 50%;
    }

    .admin-articles-page .management-table th:nth-child(3),
    .admin-articles-page .management-table td:nth-child(3) {
        width: 110px;
    }

    .admin-articles-page .management-table th:nth-child(4),
    .admin-articles-page .management-table td:nth-child(4) {
        width: 145px;
    }

    .admin-articles-page .management-table th:nth-child(5),
    .admin-articles-page .management-table td:nth-child(5) {
        width: 240px;
        padding-left: 28px;
    }

    .admin-articles-page .article-title {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .public-articles-page .management-table {
        table-layout: fixed;
    }

    .public-articles-page .management-table th:first-child,
    .public-articles-page .management-table td:first-child {
        width: 220px;
    }

    .public-articles-page .article-image {
        display: block;
        width: 190px;
        height: 125px;
        object-fit: cover;
    }

    .article-title {
        min-width: 240px;
        color: #1e293b;
        font-size: 18px;
        font-weight: 750;
        line-height: 1.5;
    }

    .article-title a {
        color: #1e293b;
    }

    .article-title a:hover {
        color: #b91c1c;
    }

    .article-excerpt {
        display: -webkit-box;
        margin: 5px 0 0;
        overflow: hidden;
        color: #64748b;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.6;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .article-date {
        color: #64748b;
        white-space: nowrap;
        font-size: 13px;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-published {
        background: #dcfce7;
        color: #166534;
    }

    .status-draft {
        background: #fef3c7;
        color: #92400e;
    }

    .status-pending {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-rejected {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-archived {
        background: #f1f5f9;
        color: #475569;
    }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    .admin-articles-page .management-table td:nth-child(5) .action-group {
        justify-content: flex-start;
        margin-left: 0;
    }

    .inline-wf-form {
        display: inline;
        margin: 0;
    }

    .action-btn {
        display: inline-block;
        padding: 7px 10px;
        margin: 2px;
        border: 0;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 12.5px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
    }

    .btn-edit {
        background: #fef08a;
        color: #854d0e !important;
    }

    .btn-detail {
        background: #dbeafe;
        color: #1d4ed8 !important;
    }

    .btn-submit-wf {
        background: #dcfce7;
        color: #166534 !important;
    }

    .btn-reject-wf {
        background: #ffedd5;
        color: #c2410c !important;
    }

    .btn-archive-wf {
        background: #e2e8f0;
        color: #334155 !important;
    }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c !important;
    }

    .empty-message {
        padding: 40px !important;
        color: #64748b;
        text-align: center;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 22px 0;
    }

    .pagination-direction {
        min-width: 64px;
        text-align: center;
    }

    .pagination-direction.disabled {
        padding: 7px 11px;
        background: #f8fafc;
        color: #a0a5ae;
    }

        .pagination a {
            padding: 7px 11px;
            border-radius: 6px;
            background: #f1f5f9;
            color: #334155;
            text-decoration: none;
        }

            .pagination a.active {
                background: #b91c1c;
                color: white;
            }

    @@media (max-width: 850px) {
        .management-table {
            min-width: 760px;
        }
    }

    @@media (max-width: 600px) {
        .management-page {
            width: calc(100% - 24px);
            margin-top: 22px;
        }

        .admin-list-panel.is-admin {
            padding: 14px;
        }

        .management-header h2 {
            font-size: 25px;
        }

        .btn-add {
            width: 100%;
            text-align: center;
        }

        .advanced-filter form {
            display: grid;
            grid-template-columns: 1fr;
        }

        .advanced-filter input,
        .advanced-filter select,
        .filter-submit,
        .filter-reset {
            width: 100%;
            min-width: 0;
        }

        .filter-actions {
            width: 100%;
        }

        .filter-actions .filter-submit,
        .filter-actions .filter-reset {
            width: 50%;
            min-width: 0;
        }

        .admin-articles-page .filter-actions .filter-reset {
            width: auto !important;
        }

            .advanced-filter input[type="search"] {
                min-width: 0;
            }
    }
</style>

<div class="management-page @(isAdminManagement ? "admin-articles-page" : "public-articles-page")">

    @if (TempData["Success"] != null)
    {<div class="alert alert-success">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}
    @if (ViewBag.WarningMessage != null)
    {<div class="alert alert-warning">@ViewBag.WarningMessage</div>}

    @if (isAdminManagement)
    {
        <div class="admin-page-heading">
            <div>
                @if (isAdminUser)
                {
                    <a href="@Url.Action("Index", "Admin")">&larr; Quay lại Bảng điều khiển Admin</a>
                }
                <h2>Quản lý &amp; Kiểm duyệt bài viết</h2>
            </div>
            @if (canManageArticles)
            {
                <a class="btn-add" href="@Url.RouteUrl("AdminArticles", new { action = "Create", returnUrl = Request.RawUrl + "#article-results" })">+ Thêm bài viết</a>
            }
        </div>
    }
    else
    {
        <div class="management-header">
            <div>
                <h2>@(canManageArticles ? (canReviewArticles ? "Quản lý & Kiểm duyệt bài viết" : "Bài viết của Tác giả") : "Tin tức mới nhất")</h2>

                <p class="management-subtitle">
                    @(canManageArticles
                        ? (canReviewArticles
                            ? "Kiểm duyệt bài chờ duyệt (Pending), xuất bản lên trang chủ, từ chối kèm lý do hoặc lưu trữ bài viết."
                            : "Quản lý các bài viết của bạn: lưu bản nháp (Draft), gửi duyệt (Pending) hoặc chỉnh sửa bài bị trả lại.")
                        : "Cập nhật những tin tức mới nhất trên NewsPortal.")
                </p>
            </div>

            @if (canManageArticles)
            {
                <div class="header-actions">
                    @if (isAdminUser)
                    {
                        <a class="btn-admin-dash" href="@Url.Action("Index", "Admin")">Bảng điều khiển Admin</a>
                    }
                    <a class="btn-add" href="@Url.RouteUrl("AdminArticles", new { action = "Create", returnUrl = Request.RawUrl + "#article-results" })">+ Thêm bài viết</a>
                </div>
            }
        </div>
    }

    @if (canManageArticles)
    {
        <div class="workflow-tabs">
            <a class="wf-tab @(string.IsNullOrEmpty(currentStatusFilter) ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index" })">
                Tất cả <span class="wf-count">@countAll</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Pending" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Pending" })">
                Chờ duyệt (Pending) <span class="wf-count">@countPending</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Draft" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Draft" })">
                Bản nháp (Draft) <span class="wf-count">@countDraft</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Published" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Published" })">
                Đã xuất bản (Published) <span class="wf-count">@countPublished</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Rejected" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Rejected" })">
                Bị từ chối (Rejected) <span class="wf-count">@countRejected</span>
            </a>
            <a class="wf-tab @(currentStatusFilter == "Archived" ? "active" : "")"
               href="@Url.RouteUrl("AdminArticles", new { action = "Index", status = "Archived" })">
                Đã lưu trữ (Archived) <span class="wf-count">@countArchived</span>
            </a>
        </div>
    }

    <div class="filter-toolbar">
        <p class="result-count">
            Tìm thấy <strong>@totalArticles</strong> bài viết
        </p>

        <button type="button" id="filterToggle" class="filter-toggle">Bộ lọc nâng cao</button>
    </div>

    <div id="advancedFilter" class="advanced-filter is-hidden">
        <form method="get" action="@articleIndexUrl" class="@(canManageArticles ? "admin-advanced-filter" : "")">
            <input type="search"
                   name="searchString"
                   value="@(ViewBag.SearchString ?? "")"
                   placeholder="Tìm tiêu đề, tóm tắt, nội dung..." />

            <select name="categoryId">
                <option value="">Tất cả danh mục</option>

                @foreach (var category in categories)
                {
                    <option value="@category.CategoryID"
                            @(ViewBag.CategoryId != null && ViewBag.CategoryId == category.CategoryID ? "selected" : "")>
                        @category.CategoryName
                    </option>
                }
            </select>

            @if (!isAuthorOnly)
            {
                <select name="authorId">
                    <option value="">Tất cả tác giả</option>

                    @foreach (var author in authors)
                    {
                        <option value="@author.AuthorID"
                                @(ViewBag.AuthorId != null && ViewBag.AuthorId == author.AuthorID ? "selected" : "")>
                            @author.AuthorName
                        </option>
                    }
                </select>
            }

            @if (canManageArticles)
            {
                <select name="status">
                    <option value="">Mọi trạng thái</option>
                    <option value="Draft" @(currentStatusFilter == "Draft" ? "selected" : "")>Draft - Bản nháp</option>
                    <option value="Pending" @(currentStatusFilter == "Pending" ? "selected" : "")>Pending - Chờ duyệt</option>
                    <option value="Published" @(currentStatusFilter == "Published" ? "selected" : "")>Published - Đã xuất bản</option>
                    <option value="Rejected" @(currentStatusFilter == "Rejected" ? "selected" : "")>Rejected - Bị từ chối</option>
                    <option value="Archived" @(currentStatusFilter == "Archived" ? "selected" : "")>Archived - Đã lưu trữ</option>
                </select>
            }

            <div style="position: relative; display: inline-block;">
                <span style="position: absolute; top: -12px; left: 10px; font-size: 11px; font-weight: 600; color: #b91c1c; line-height: 1;">
                    Từ ngày
                </span>
                <input type="date"
                       name="fromDate"
                       value="@(ViewBag.FromDate == null ? "" : ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd"))" />
            </div>

            <div style="position: relative; display: inline-block;">
                <span style="position: absolute; top: -12px; left: 10px; font-size: 11px; font-weight: 600; color: #b91c1c; line-height: 1;">
                    Đến ngày
                </span>
                <input type="date"
                       name="toDate"
                       value="@(ViewBag.ToDate == null ? "" : ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd"))" />
            </div>

            <div class="filter-actions">
                <button type="submit" class="filter-submit">Lọc</button>
                <a class="filter-reset" href="@articleIndexUrl">Xóa</a>
            </div>
        </form>
    </div>

    <div class="admin-list-panel @(isAdminManagement ? "is-admin" : "")">
    <div class="management-card" id="article-results">
        <table class="management-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tiêu đề bài viết</th>
                    <th>Ngày đăng</th>

                    @if (canManageArticles)
                    {
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string imgSrc = null;
                        if (!string.IsNullOrWhiteSpace(item.Image))
                        {
                            if (item.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase) || item.Image.StartsWith("/"))
                            {
                                imgSrc = item.Image;
                            }
                            else if (item.Image.StartsWith("~/"))
                            {
                                imgSrc = Url.Content(item.Image);
                            }
                            else
                            {
                                imgSrc = Url.Content("~/Content/Images/" + item.Image);
                            }
                        }

                        string badgeClass = "status-draft";
                        string badgeLabel = "Bản nháp (Draft)";
                        if (item.Status == "Pending")
                        {
                            badgeClass = "status-pending";
                            badgeLabel = "Chờ duyệt (Pending)";
                        }
                        else if (item.Status == "Published")
                        {
                            badgeClass = "status-published";
                            badgeLabel = "Đã xuất bản (Published)";
                        }
                        else if (item.Status == "Rejected")
                        {
                            badgeClass = "status-rejected";
                            badgeLabel = "Bị từ chối (Rejected)";
                        }
                        else if (item.Status == "Archived")
                        {
                            badgeClass = "status-archived";
                            badgeLabel = "Đã lưu trữ (Archived)";
                        }

                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(imgSrc))
                                {
                                    <img src="@imgSrc"
                                         class="article-image"
                                         alt="@item.Title" />
                                }
                                else
                                {
                                    <span>Không có ảnh</span>
                                }
                            </td>

                            <td class="article-title">
                                <a href="@(isAdminManagement ? Url.RouteUrl("AdminArticles", new { action = "Details", id = item.Id }) : Url.Action("View", "Articles", new { id = item.Id }))">@item.Title</a>
                                <div style="font-size:12px; color:#64748b; font-weight:500; margin-top:4px;">
                                    @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                    {
                                        <span style="color:#b91c1c; font-weight:700;">@item.CategoryName</span>
                                        <text> &bull; </text>
                                    }
                                    <span>Tác giả: <strong>@(string.IsNullOrWhiteSpace(item.AuthorName) ? "Chưa rõ" : item.AuthorName)</strong></span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.PlainSummary))
                                {
                                    <div class="article-excerpt">@item.PlainSummary</div>
                                }
                                @if (canManageArticles && item.Status == "Rejected" && rejectionReasons.ContainsKey(item.Id))
                                {
                                    <div style="margin-top:6px; padding:6px 10px; border-radius:6px; background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; font-size:12.5px; font-weight:500;">
                                        <strong>Lý do từ chối:</strong> @rejectionReasons[item.Id]
                                    </div>
                                }
                            </td>

                            <td class="article-date">
                                @item.CreatedDate.ToString("dd/MM/yyyy")
                            </td>

                            @if (canManageArticles)
                            {
                                <td>
                                    <span class="status-badge @badgeClass">
                                        @badgeLabel
                                    </span>
                                </td>
                                <td>
                                    <div class="action-group">
                                        @if (canReviewArticles)
                                        {
                                            if (item.Status == "Pending")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Published" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Duyệt đăng</button>
                                                }
                                                <button type="button"
                                                        class="action-btn btn-reject-wf js-open-wf-reject"
                                                        data-article-id="@item.Id"
                                                        data-article-title="@item.Title">
                                                    Từ chối
                                                </button>
                                            }
                                            else if (item.Status == "Published")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Archived" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-archive-wf">Lưu trữ</button>
                                                }
                                            }
                                            else if (item.Status == "Archived")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Published" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Xuất bản lại</button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Published" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Duyệt đăng</button>
                                                }
                                            }

                                            @Html.RouteLink("Sửa", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                            @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                        }
                                        else
                                        {
                                            if (item.Status == "Draft")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Pending" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Gửi duyệt</button>
                                                }
                                                @Html.RouteLink("Sửa", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                                @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                            }
                                            else if (item.Status == "Rejected")
                                            {
                                                @Html.RouteLink("Sửa & gửi lại", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Pending" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-submit-wf">Gửi duyệt lại</button>
                                                }
                                                @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                            }
                                            else if (item.Status == "Pending")
                                            {
                                                using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post, new { @class = "inline-wf-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="newStatus" value="Draft" />
                                                    <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                                                    <button type="submit" class="action-btn btn-archive-wf">Rút về nháp</button>
                                                }
                                                @Html.RouteLink("Sửa", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                            }
                                            else
                                            {
                                                @Html.RouteLink("Xem bài", "AdminArticles", new { action = "Details", id = item.Id }, new { @class = "action-btn btn-detail" })
                                                @Html.RouteLink("Sửa & gửi duyệt lại", "AdminArticles", new { action = "Edit", id = item.Id }, new { @class = "action-btn btn-edit" })
                                                if (item.Status != "Published")
                                                {
                                                    @Html.RouteLink("Xóa", "AdminArticles", new { action = "Delete", id = item.Id }, new { @class = "action-btn btn-delete" })
                                                }
                                            }
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(canManageArticles ? 5 : 3)" class="empty-message">
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchString as string)
                                ? "Không tìm thấy bài viết phù hợp."
                                : "Không tìm thấy bài viết nào phù hợp với từ khóa '" + ViewBag.SearchString + "'.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="pagination">
            @if (currentPage > 1)
            {
                <a class="pagination-direction"
                   href="@(isAdminManagement ? Url.RouteUrl("AdminArticles", new { action = "Index", searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage - 1 }) : Url.Action("Index", "Articles", new { searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage - 1 }))#article-results">Trước</a>
            }
            else
            {
                <span class="pagination-direction disabled">Trước</span>
            }

            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <a class="@(pageNumber == currentPage ? "active" : "")"
                   href="@((isAdminManagement ? Url.RouteUrl("AdminArticles", new {
                        action = "Index",
                        searchString = ViewBag.SearchString,
                        categoryId = ViewBag.CategoryId,
                        authorId = ViewBag.AuthorId,
                        status = ViewBag.Status,
                        fromDate = ViewBag.FromDate,
                        toDate = ViewBag.ToDate,
                        page = pageNumber
                    }) : Url.Action("Index", "Articles", new {
                        searchString = ViewBag.SearchString,
                        categoryId = ViewBag.CategoryId,
                        authorId = ViewBag.AuthorId,
                        status = ViewBag.Status,
                        fromDate = ViewBag.FromDate,
                        toDate = ViewBag.ToDate,
                        page = pageNumber
                    })) + "#article-results")">
                    @pageNumber
                </a>
            }

            @if (currentPage < totalPages)
            {
                <a class="pagination-direction"
                   href="@(isAdminManagement ? Url.RouteUrl("AdminArticles", new { action = "Index", searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage + 1 }) : Url.Action("Index", "Articles", new { searchString = ViewBag.SearchString, categoryId = ViewBag.CategoryId, authorId = ViewBag.AuthorId, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage + 1 }))#article-results">Sau</a>
            }
            else
            {
                <span class="pagination-direction disabled">Sau</span>
            }
        </nav>
    }

    </div>

</div>

@if (canReviewArticles)
{
    <div id="wfRejectModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(15,23,42,.55); align-items:center; justify-content:center; padding:16px;">
        <div style="width:min(500px, 100%); background:#fff; border-radius:12px; padding:22px 24px; box-shadow:0 18px 40px rgba(0,0,0,.22);">
            <h3 style="margin:0 0 6px; font-size:19px; color:#b91c1c;">Từ chối bài viết</h3>
            <p id="wfRejectTitle" style="margin:0 0 14px; font-size:13.5px; color:#475569; font-weight:600;"></p>
            @using (Html.BeginForm("ChangeWorkflowStatus", "Articles", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="wfRejectArticleId" value="" />
                <input type="hidden" name="newStatus" value="Rejected" />
                <input type="hidden" name="returnStatus" value="@currentStatusFilter" />
                <label for="wfRejectReasonInput" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px; color:#1e293b;">
                    Lý do từ chối <span style="color:#b91c1c;">*</span>
                </label>
                <textarea id="wfRejectReasonInput"
                          name="rejectionReason"
                          required
                          maxlength="500"
                          rows="4"
                          style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:8px; font:inherit; font-size:14px; box-sizing:border-box;"
                          placeholder="Nhập lý do cụ thể để tác giả chỉnh sửa và gửi duyệt lại..."></textarea>
                <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:16px;">
                    <button type="button" id="wfRejectCancel" class="action-btn btn-archive-wf" style="padding:8px 16px;">Hủy</button>
                    <button type="submit" class="action-btn btn-reject-wf" style="padding:8px 16px;">Xác nhận từ chối</button>
                </div>
            }
        </div>
    </div>
}

<script>
    (function () {
        var toggle = document.getElementById("filterToggle");
        var filter = document.getElementById("advancedFilter");

        if (toggle && filter) {
            toggle.addEventListener("click", function () {
                if (!toggle || !filter) return;
                filter.classList.toggle("is-hidden");

                toggle.textContent =
                    filter.classList.contains("is-hidden")
                        ? "Bộ lọc nâng cao"
                        : "Ẩn bộ lọc";
            });
        }

        var modal = document.getElementById("wfRejectModal");
        var idInput = document.getElementById("wfRejectArticleId");
        var titleEl = document.getElementById("wfRejectTitle");
        var reasonInput = document.getElementById("wfRejectReasonInput");
        var cancelBtn = document.getElementById("wfRejectCancel");

        function closeRejectModal() {
            if (!modal) return;
            modal.style.display = "none";
            if (reasonInput) reasonInput.value = "";
        }

        var rejectBtns = document.querySelectorAll(".js-open-wf-reject");
        for (var i = 0; i < rejectBtns.length; i++) {
            rejectBtns[i].addEventListener("click", function () {
                if (!modal || !idInput) return;
                idInput.value = this.getAttribute("data-article-id") || "";
                if (titleEl) titleEl.textContent = "Bài viết: " + (this.getAttribute("data-article-title") || "");
                modal.style.display = "flex";
                if (reasonInput) reasonInput.focus();
            });
        }

        if (cancelBtn) {
            cancelBtn.addEventListener("click", closeRejectModal);
        }
        if (modal) {
            modal.addEventListener("click", function (ev) {
                if (ev.target === modal) closeRejectModal();
            });
        }
    })();
</script>

