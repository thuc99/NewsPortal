@model NewsPortal.Models.Article
@using NewsPortal.Models
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Chi tiết bài viết";
    var comments = ViewBag.Comments as IEnumerable<Comments> ?? new List<Comments>();
}

<style>
    body {
        background: #ffffff;
        font-family: Arial, sans-serif;
    }

    .detail-container {
        width: min(1100px, calc(100% - 48px));
        max-width: 1100px;
        box-sizing: border-box;
        overflow: hidden;
        margin: 35px auto 55px;
        padding: 24px 0;
        background: #fff;
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .detail-header {
        text-align: left;
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e2e8f0;
    }

    .detail-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-top: 12px;
    }

    .detail-date {
        color: #64748b;
        font-size: 14px;
        white-space: nowrap;
    }

    .article-tools {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin: 0;
        min-width: 0;
    }

    .article-stat {
        padding: 0;
        background: transparent;
        color: #64748b;
        font-size: 13px;
        white-space: nowrap;
    }

        .article-stat strong {
            color: #f59e0b;
        }

    .favorite-form {
        margin: 0;
    }

    .favorite-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 36px;
        padding: 0 12px;
        height: 36px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #fff;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        transition: .2s ease;
    }

        .favorite-button:hover {
            border-color: #b91c32;
            background: #fff1f2;
            color: #b91c32;
            transform: translateY(-1px);
        }

        .favorite-button i {
            font-size: 15px;
        }

    .rating-card {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 16px;
        padding: 0;
        border: 0;
        background: transparent;
    }

    .rating-summary {
        display: none;
    }

    .rating-feedback {
        display: block;
        flex-basis: 100%;
        order: 3;
        width: 100%;
        margin: 4px 0 0;
        text-align: right;
    }

    .rating-title {
        margin: 0;
        color: #475569;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
    }

    .rating-stars {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        align-items: center;
        gap: 2px;
        margin: 0;
        order: 2;
    }

        .rating-stars input {
            display: none !important;
        }

        .rating-stars label {
            display: inline-block !important;
            color: #cbd5e1 !important;
            font-size: 30px;
            line-height: 1;
            cursor: pointer;
            transition: color .15s ease, transform .15s ease;
        }

            .rating-stars label:hover,
            .rating-stars label:hover ~ label,
            .rating-stars input:checked + label,
            .rating-stars input:checked ~ label {
                color: #fbbf24 !important;
            }

            .rating-stars label:hover {
                transform: scale(1.12);
            }

    .detail-image {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
        max-height: 430px;
        object-fit: cover;
        box-sizing: border-box;
        overflow: hidden;
        border-radius: 12px;
        margin: 0 auto 25px;
    }

    .detail-content {
        color: #334155;
        font-size: 16px;
        line-height: 1.8;
        overflow-wrap: anywhere;
        word-break: normal;
    }

        .detail-content p {
            margin: 0 0 16px;
        }

        .detail-content h1,
        .detail-content h2,
        .detail-content h3,
        .detail-content h4 {
            color: #1e293b;
            font-weight: 700;
            line-height: 1.4;
            margin: 24px 0 12px;
        }

        .detail-content ul,
        .detail-content ol {
            padding-left: 28px;
            margin: 12px 0 18px;
        }

        .detail-content li {
            margin-bottom: 6px;
        }

        .detail-content img {
            display: block;
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin-left: auto;
            margin-right: auto;
        }

        .detail-content figure.image {
            display: table;
            float: none !important;
            max-width: 100%;
            margin: 20px auto;
            text-align: center;
        }

        .detail-content table {
            width: 100%;
            max-width: 100%;
            border-collapse: collapse;
            margin: 18px 0;
        }

        .detail-content th,
        .detail-content td {
            border: 1px solid #cbd5e1;
            padding: 9px 12px;
            text-align: left;
        }

        .detail-content th {
            background: #f1f5f9;
            font-weight: 700;
        }

        .detail-content blockquote {
            margin: 18px 0;
            padding: 12px 18px;
            border-left: 4px solid #b91c1c;
            background: #f8fafc;
            color: #475569;
        }

        .detail-content a {
            color: #b91c1c;
            text-decoration: underline;
        }

        .detail-content pre,
        .detail-content code {
            max-width: 100%;
            overflow-x: auto;
            white-space: pre-wrap;
        }

    .rating-submit {
        padding: 7px 12px;
        border-radius: 7px;
        font-size: 13px;
    }

    .btn-detail {
        padding: 10px 18px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        color: white;
        display: inline-block;
    }

    .btn-edit {
        background: #2563eb;
    }

    .btn-back {
        background: #64748b;
    }

    .view-actions {
        display: flex;
        gap: 10px;
        margin: 20px 0 25px;
    }

    .btn-edit-article {
        background: #b91c1c;
        color: white;
    }

    .view-actions .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

    .btn-detail:hover {
        opacity: 0.85;
        color: white;
        text-decoration: none;
    }

    .comments-card {
        max-width: 900px;
        margin: 30px auto 0;
        padding: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
    }

    .comments-title {
        color: #1e293b;
        margin: 0 0 14px;
        font-size: 20px;
    }

    .comment-form {
        display: grid;
        gap: 8px;
        margin-bottom: 18px;
    }

    .comment-input,
    .comment-textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 8px 11px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font: inherit;
        font-size: 14px;
    }

    .comment-textarea {
        min-height: 82px;
        resize: vertical;
    }

    .comment-submit {
        justify-self: start;
        border: 0;
        border-radius: 6px;
        padding: 8px 13px;
        background: #b91c1c;
        color: white;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .comment-item {
        padding: 14px 0;
        border-top: 1px solid #e2e8f0;
    }

    .comment-author {
        color: #1e293b;
        font-weight: 700;
    }

    .comment-date {
        color: #94a3b8;
        font-size: 12px;
        margin-left: 8px;
    }

    .comment-content {
        color: #475569;
        margin: 6px 0 0;
        white-space: pre-line;
        line-height: 1.65;
        overflow-wrap: anywhere;
    }

    .comments-empty {
        margin: 0;
        padding: 16px;
        border-radius: 8px;
        background: #f8fafc;
        color: #64748b;
        text-align: center;
    }

    .article-author {
        margin-top: 8px;
        color: #64748b;
        font-size: 14px;
    }

        .article-author a {
            color: #b91c1c;
            font-weight: 700;
            text-decoration: none;
        }

            .article-author a:hover {
                text-decoration: underline;
            }

    .comment-message {
        padding: 10px 12px;
        margin-bottom: 12px;
        border-radius: 8px;
    }

    .comment-success {
        color: #166534;
        background: #dcfce7;
    }

    .comment-error {
        color: #991b1b;
        background: #fee2e2;
    }

    .recommendations-card {
        margin-top: 38px;
        padding-top: 26px;
        border-top: 2px solid #e2e8f0;
    }

    .recommendations-title {
        margin: 0 0 18px;
        color: #1e293b;
        font-size: 21px;
    }

    .recommendations-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .recommendation-item {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        background: #fff;
        transition: .2s ease;
    }

        .recommendation-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(30, 41, 59, .08);
        }

    .recommendation-image {
        display: block;
        height: 110px;
        background: #f8fafc;
    }

        .recommendation-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .recommendation-body {
        padding: 12px;
    }

        .recommendation-body h4 {
            margin: 0;
            color: #1e293b;
            font-size: 15px;
            line-height: 1.4;
        }

    .recommendation-excerpt {
        display: -webkit-box;
        overflow: hidden;
        margin: 7px 0 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .recommendation-date {
        display: block;
        margin-top: 8px;
        color: #94a3b8;
        font-size: 11px;
    }

    @@media (max-width: 650px) {
        .detail-container {
            margin-top: 22px;
            width: calc(100% - 32px);
            padding: 18px 0 35px;
        }

        .detail-meta,
        .rating-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .article-tools,
        .rating-card {
            justify-content: flex-start;
            width: 100%;
        }

        .rating-card {
            gap: 8px;
        }

        .rating-summary,
        .rating-feedback {
            text-align: left;
        }

        .rating-stars label {
            font-size: 28px;
        }

        .rating-feedback {
            text-align: left;
        }

        .recommendations-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 420px) {
        .recommendations-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="detail-container">

    <div class="detail-header">
        <h2>@Model.Title</h2>
        @if (ViewBag.AuthorId != null && !string.IsNullOrWhiteSpace(ViewBag.AuthorName as string))
        {
            <div class="article-author">
                Tác giả:
                <a href="@Url.RouteUrl("PublicAuthor", new { action = "Index", id = ViewBag.AuthorId })">@ViewBag.AuthorName</a>
            </div>
        }



        <div class="detail-meta">
            <div class="detail-date">
                <i class="glyphicon glyphicon-calendar"></i>
                Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </div>

            <div style="margin-left:auto; display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
                @if (ViewBag.CanComment == true || ViewBag.CanManageArticles == true)
                {
                    <div class="article-tools">
                        <span class="article-stat article-views">
                            <span aria-hidden="true">👁</span>
                            @Model.ViewCount lượt xem
                        </span>
                        <span class="article-stat">
                            <strong>★ @(((double)ViewBag.AverageRating).ToString("0.0"))/5</strong>
                            <span>(@ViewBag.RatingCount lượt đánh giá)</span>
                        </span>
                    </div>
                }

                @if (ViewBag.IsAdminManagement != true && ViewBag.CanComment == true)
                {
                    bool isSaved = ViewBag.IsSavedArticle != null && (bool)ViewBag.IsSavedArticle;
                    using (Html.BeginForm("ToggleFavorite", "Articles", FormMethod.Post, new { style = "display:inline-block; margin:0;" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="articleId" value="@Model.Id" />
                        <button type="submit" style="padding:5px 14px; border-radius:6px; border:1px solid #b91c1c; background:@(isSaved ? "#b91c1c" : "#fff"); color:@(isSaved ? "#fff" : "#b91c1c"); font-weight:700; cursor:pointer;">
                            <i class="fa-@(isSaved ? "solid" : "regular") fa-bookmark"></i> @(isSaved ? "Đã lưu tin" : "Lưu tin")
                        </button>
                    }
                }
            </div>

        </div>
    </div>

    <div class="detail-content">
        @{
            var sanitizer = new Ganss.Xss.HtmlSanitizer();
            var safeContent = sanitizer.Sanitize(Model.Content ?? string.Empty);
        }

        @Html.Raw(safeContent)
    </div>

    @if (ViewBag.IsAdminManagement == true && ViewBag.CanEditArticle == true)
    {
        <div class="view-actions">
            @Html.RouteLink("Sửa bài", "AdminArticles",
                new { action = "Edit", id = Model.Id },
                new { @class = "btn-detail btn-back" })
        </div>
    }

    @if (ViewBag.IsAdminManagement == true)
    {
        <div class="view-actions">
            @Html.RouteLink("Quay lại danh sách", "AdminArticles",
                new { action = "Index" },
                new { @class = "btn-detail btn-back" })
        </div>
    }

    <section class="comments-card">
        <h3 class="comments-title">Bình luận (@comments.Count())</h3>

        @if (ViewBag.CanComment == true)
        {
            if (TempData["CommentSuccess"] != null)
            {
                <div class="comment-message comment-success">@TempData["CommentSuccess"]</div>
            }

            if (TempData["CommentError"] != null)
            {
                <div class="comment-message comment-error">@TempData["CommentError"]</div>
            }

            using (Html.BeginForm("AddComment", "Articles", FormMethod.Post, new { @class = "comment-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("articleId", Model.Id)

                string loggedInName = Convert.ToString(Session["UserFullName"]);
                if (string.IsNullOrWhiteSpace(loggedInName) && (Session["User"] != null || Session["Admin"] != null))
                {
                    string uname = Convert.ToString(Session["User"] ?? Session["Admin"]);
                    using (var _db = new NewsPortal.Models.NewsPortalDBEntities())
                    {
                        var _u = _db.Users.FirstOrDefault(x => x.Username == uname);
                        loggedInName = (_u != null && !string.IsNullOrWhiteSpace(_u.FullName)) ? _u.FullName : uname;
                        Session["UserFullName"] = loggedInName;
                    }
                }

                if (!string.IsNullOrWhiteSpace(loggedInName))
                {
                    <input type="text" name="commenterName" class="comment-input"
                           value="@loggedInName" readonly
                           style="background-color:#f3f4f6; color:#1f2937; font-weight:600; cursor:not-allowed;" />
                }
                else
                {
                    <input type="text" name="commenterName" class="comment-input"
                           maxlength="100" placeholder="Tên của bạn" required />
                }

                <textarea name="content" class="comment-textarea"
                          maxlength="1000" placeholder="Viết bình luận..." required></textarea>

                <button type="submit" class="comment-submit">Gửi bình luận</button>
            }
        }
        else
        {
            <p class="comments-readonly">Khu vực bình luận chỉ được gửi tại trang đọc bài viết.</p>
        }

        @if (comments.Any())
        {
            foreach (var comment in comments)
            {

                string cmtAvatar = (comment.Users != null && !string.IsNullOrWhiteSpace(comment.Users.AvatarUrl))
                    ? comment.Users.AvatarUrl
                    : null;
                string cmtInitial = !string.IsNullOrWhiteSpace(comment.CommenterName)
                    ? comment.CommenterName.Trim().Substring(0, 1).ToUpper()
                    : "U";

                <div class="comment-item" style="display:flex; align-items:flex-start; gap:12px;">
                    <div style="width:38px; height:38px; border-radius:50%; overflow:hidden; background:#b91c1c; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:15px; flex-shrink:0; margin-top:2px;">
                        @if (cmtAvatar != null)
                        {
                            <img src="@Url.Content(cmtAvatar)" alt="@comment.CommenterName" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />
                        }
                        else
                        {
                            <span>@cmtInitial</span>
                        }
                    </div>
                    <div style="flex:1; min-width:0;">
                        <span class="comment-author">@comment.CommenterName</span>
                        <span class="comment-date">@comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                        <p class="comment-content">@comment.Content</p>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="comments-empty">Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ ý kiến.</p>
        }
    </section>

    @if (ViewBag.CanComment == true)
    {
        <div class="rating-card">
            <h3 class="rating-title">Đánh giá bài viết</h3>

            @if (TempData["RatingSuccess"] != null)
            {
                <div class="comment-message comment-success">@TempData["RatingSuccess"]</div>
            }
            @if (TempData["RatingError"] != null)
            {
                <div class="comment-message comment-error">@TempData["RatingError"]</div>
            }

            @using (Html.BeginForm("Rate", "Articles", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("articleId", Model.Id)
                <div class="rating-stars" role="radiogroup" aria-label="Chọn số sao đánh giá">
                    @for (var star = 5; star >= 1; star--)
                    {
                        <input id="rating-@star" type="radio" name="rating" value="@star" required />
                        <label for="rating-@star" title="@star sao">★</label>
                    }
                </div>
                <button type="submit" class="rating-submit">Gửi đánh giá</button>
            }
        </div>
    }

    @{ var recommendedArticles = ViewBag.RecommendedArticles as IEnumerable<Articles> ?? new List<Articles>(); }
    @if (ViewBag.CanComment == true && recommendedArticles.Any())
    {
        <section class="recommendations-card">
            <h3 class="recommendations-title">Đề xuất dành cho bạn</h3>
            <div class="recommendations-grid">
                @foreach (var recommendation in recommendedArticles)
                {
                    var recommendationExcerpt = GetPlainSummary(recommendation.Content, 120);

                    <article class="recommendation-item">
                        <a class="recommendation-image" href="@Url.Action("View", "Articles", new { id = recommendation.ArticleID })">
                            @if (!string.IsNullOrWhiteSpace(recommendation.ImageUrl))
                            {
                                <img src="@recommendation.ImageUrl" alt="@recommendation.Title" />
                            }
                        </a>
                        <div class="recommendation-body">
                            <h4><a href="@Url.Action("View", "Articles", new { id = recommendation.ArticleID })">@recommendation.Title</a></h4>
                            @if (!string.IsNullOrWhiteSpace(recommendationExcerpt))
                            {
                                <p class="recommendation-excerpt">@recommendationExcerpt</p>
                            }
                            <span class="recommendation-date">@recommendation.CreatedDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
@using System.Text.RegularExpressions
@using System.Net

@functions {
    public string GetPlainSummary(string htmlContent, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(htmlContent))
            return "";

        // 1. Xóa toàn bộ thẻ HTML (<p>, <strong>, <div>, ...)
        string plainText = Regex.Replace(htmlContent, "<.*?>", " ");

        // 2. Giải mã các ký tự HTML entity (&nbsp;, &gt;, &amp;, ...)
        plainText = WebUtility.HtmlDecode(plainText);

        // 3. Gộp nhiều khoảng trắng/xuống dòng thừa thành 1 dấu cách
        plainText = Regex.Replace(plainText, @"\s+", " ").Trim();

        // 4. Cắt ngắn theo độ dài mong muốn
        if (plainText.Length > maxLength)
        {
            return plainText.Substring(0, maxLength).TrimEnd() + "...";
        }

        return plainText;
    }
}
