
@model NewsPortal.Models.Article

@{
    ViewBag.Title = "Thêm bài viết";
}

<style>
    body {
        background: #ffffff;
        font-family: Arial, sans-serif;
    }

    .create-container {
        width: min(850px, calc(100% - 32px));
        max-width: 850px;
        margin: 35px auto;
        padding: 28px 0;
        background: #fff;
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .create-header {
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

        .create-header h2 {
            color: #1e293b;
            font-size: 28px;
            font-weight: bold;
            margin: 0 0 8px;
        }

        .create-header p {
            color: #64748b;
            margin: 0;
        }

    .form-label {
        display: block;
        color: #334155;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control-custom {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
        margin-bottom: 20px;
    }

        .form-control-custom:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
        }

    textarea.form-control-custom {
        resize: vertical;
        min-height: 180px;
    }

    .image-preview {
        margin-top: 12px;
        margin-bottom: 20px;
    }

        .image-preview img {
            max-width: 220px;
            max-height: 160px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            display: none;
        }

    .create-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .btn-create {
        border: none;
        padding: 11px 22px;
        border-radius: 7px;
        font-weight: 600;
        cursor: pointer;
        color: white;
        text-decoration: none;
    }

    .btn-save {
        background: #2563eb;
    }

    .btn-back {
        background: #64748b;
    }

    .btn-create:hover {
        opacity: 0.85;
        color: white;
        text-decoration: none;
    }

    .text-danger {
        color: #dc2626;
        margin-top: -15px;
        margin-bottom: 15px;
        display: block;
    }

    @@media (max-width: 650px) {
        .create-container {
            width: calc(100% - 24px);
            margin: 22px auto;
            padding: 18px 0 30px;
        }

        .create-header h2 {
            font-size: 24px;
        }

        .btn-create {
            flex: 1 1 180px;
            text-align: center;
        }
    }
</style>

<div class="create-container">

    <div class="create-header">
        <h2>Thêm bài viết mới</h2>
        <p>Điền thông tin bên dưới để tạo bài viết mới.</p>
    </div>

    <form action="@Url.RouteUrl("AdminArticles", new { action = "Create" })" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <label class="form-label">Tiêu đề bài viết</label>
        @Html.TextBoxFor(model => model.Title,
            new { @class = "form-control-custom", placeholder = "Nhập tiêu đề bài viết..." })
        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })

        <label class="form-label">Nội dung bài viết</label>
        @Html.TextAreaFor(model => model.Content,
            new { @class = "form-control-custom", rows = 8, placeholder = "Nhập nội dung bài viết..." })
        @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })

        <label class="form-label">Hình ảnh bài viết</label>
        <input type="file" name="imageFile" id="imageFile"
               class="form-control-custom" accept="image/*" />

        <div class="image-preview">
            <img id="previewImage" alt="Ảnh xem trước" />
        </div>

        <div class="create-actions">
            <button type="submit" class="btn-create btn-save">
                <i class="glyphicon glyphicon-plus"></i>
                Thêm bài viết
            </button>

            @Html.ActionLink("Quay lại danh sách", "Index", null,
                new { @class = "btn-create btn-back" })
        </div>
    </form>
</div>

<script>
    document.getElementById("imageFile").addEventListener("change", function (event) {
        var file = event.target.files[0];
        var preview = document.getElementById("previewImage");

        if (file && file.type.startsWith("image/")) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = "block";
        } else {
            preview.removeAttribute("src");
            preview.style.display = "none";
        }
    });
</script>
