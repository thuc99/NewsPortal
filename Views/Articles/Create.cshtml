
@model NewsPortal.Models.Article


@{
    ViewBag.Title = "Thêm bài viết";
    bool isAdminUser = ViewBag.IsAdminUser == true;
}

<style>
    body {
        background: #fff;
        font-family: Arial, sans-serif;
    }

    .create-container {
        width: min(850px, calc(100% - 32px));
        margin: 35px auto;
        padding: 28px 32px;
        box-sizing: border-box;
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
    }

    .create-header {
        margin-bottom: 22px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

        .create-header h2 {
            color: #1e293b;
            font-size: 28px;
            font-weight: 750;
            margin: 0 0 8px;
        }

        .create-header p {
            color: #64748b;
            margin: 0;
            font-size: 14px;
        }

    .workflow-notice {
        margin-bottom: 24px;
        padding: 12px 16px;
        border-radius: 9px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        font-size: 13.5px;
        line-height: 1.55;
    }

    .form-group-custom {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        color: #334155;
        font-weight: 700;
        margin-bottom: 9px;
        font-size: 14px;
    }

    .form-control-custom {
        width: 100%;
        padding: 12px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
        background: #fff;
        transition: all .25s ease;
    }

        .form-control-custom:focus {
            border-color: #dc2626;
            box-shadow: 0 0 0 4px rgba(220,38,38,.08);
        }

    textarea.form-control-custom {
        resize: vertical;
        min-height: 180px;
        line-height: 1.7;
    }

    .title-counter {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        font-size: 12px;
        color: #94a3b8;
    }

        .title-counter .count {
            font-weight: 750;
            color: #64748b;
            font-size: 13px;
        }

    .title-progress {
        width: 100%;
        height: 6px;
        background: #f1f5f9;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 8px;
    }

    .title-progress-bar {
        width: 0;
        height: 100%;
        background: #16a34a;
        border-radius: 20px;
        transition: width .25s ease, background .25s ease;
    }

    .title-warning {
        display: none;
        margin-top: 9px;
        padding: 9px 12px;
        border-radius: 7px;
        background: #fff7ed;
        color: #c2410c;
        font-size: 12px;
        font-weight: 600;
    }

    /* TinyMCE */
    .tox-tinymce {
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 9px !important;
        overflow: hidden;
    }

    .tox .tox-toolbar,
    .tox .tox-toolbar__primary {
        background: #f8fafc !important;
    }

    .tox .tox-edit-area::before {
        border: none !important;
    }

    /* Khu vực chọn ảnh */
    .image-upload {
        width: 100%;
        min-height: 190px;
        padding: 28px 20px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        text-align: center;
        transition: all .25s ease;
    }

        .image-upload:hover {
            border-color: #b91c1c;
            background: #fffafa;
        }

        .image-upload input[type="file"] {
            display: none;
        }

    .choose-image-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 22px;
        margin: 0;
        border: none;
        border-radius: 8px;
        background: #b91c1c;
        color: #fff !important;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all .25s ease;
    }

        .choose-image-btn:hover {
            background: #991b1b;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(185,28,28,.2);
        }

    .upload-icon {
        display: block;
        margin: 0 auto 14px;
        color: #b91c1c;
    }

    .upload-description {
        margin: 12px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .image-preview {
        width: 100%;
        margin-top: 18px;
        text-align: center;
    }

        .image-preview img {
            display: none;
            max-width: 280px;
            max-height: 200px;
            object-fit: contain;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 5px;
            background: #fff;
        }

    .create-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 22px;
        border-top: 1px solid #e5e7eb;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: none;
        padding: 11px 22px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: all .25s ease;
    }

    .btn-save {
        background: #b91c1c;
        color: white;
    }

    .btn-pending {
        background: #1d4ed8;
        color: white;
    }

    .btn-draft {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .btn-back {
        background: #f1f5f9;
        color: #334155;
    }

    .btn-save:hover {
        background: #991b1b;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(185,28,28,.2);
    }

    .btn-pending:hover {
        background: #1e40af;
        color: white;
        transform: translateY(-2px);
    }

    .btn-draft:hover {
        background: #fde68a;
        color: #78350f;
        transform: translateY(-2px);
    }

    .btn-back:hover {
        background: #e2e8f0;
        color: #1e293b;
        text-decoration: none;
        transform: translateY(-2px);
    }

    .text-danger {
        color: #dc2626;
        font-size: 13px;
        margin-top: 7px;
        display: block;
    }

    @@media (max-width: 650px) {
        .create-container {
            width: calc(100% - 24px);
            margin: 22px auto;
            padding: 20px 16px;
        }

        .create-header h2 {
            font-size: 24px;
        }

        .btn-create {
            flex: 1 1 160px;
        }
    }
</style>

<div class="create-container">

    <div class="create-header">
        <h2>@(isAdminUser ? "Thêm bài viết mới" : "Soạn bài viết mới")</h2>
        <p>
            Điền thông tin bên dưới để
            @(isAdminUser ? "tạo và xuất bản bài viết." : "lưu nháp hoặc gửi Admin phê duyệt.")
        </p>
    </div>

    @if (!isAdminUser)
    {
        <div class="workflow-notice">
            <strong>Quy trình duyệt bài:</strong>
            Phóng viên có thể <strong>Lưu bản nháp (Draft)</strong>
            để chỉnh sửa tiếp hoặc bấm <strong>Gửi Admin duyệt (Pending)</strong>.
            Bài viết sẽ tự động đăng lên trang chủ ngay khi được Admin chấp nhận.
        </div>
    }

    @using (Html.BeginRouteForm("AdminArticles", new { action = "Create" }, FormMethod.Post,
        new { id = "createArticleForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new
        {
            @class = "text-danger"
        })

        <!-- Danh mục -->
        <div class="form-group-custom">
            <label class="form-label" for="CategoryId">Danh mục</label>
            @Html.DropDownListFor(
                m => m.CategoryId,
                (SelectList)ViewBag.CategoryId,
                "Chọn danh mục",
                new { @class = "form-control-custom" })
            @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
        </div>

        <!-- Tiêu đề -->
        <div class="form-group-custom">
            <label class="form-label" for="Title">
                Tiêu đề bài viết
            </label>

            @Html.TextBoxFor(m => m.Title, new
            {
                @class = "form-control-custom",
                maxlength = "150",
                placeholder = "Nhập tiêu đề bài viết...",
                id = "Title"
            })

            @Html.ValidationMessageFor(m => m.Title, "", new
            {
                @class = "text-danger"
            })

            <div class="title-counter">
                <span>Tiêu đề tối đa 150 ký tự</span>
                <span class="count">0/150</span>
            </div>

            <div class="title-progress">
                <div class="title-progress-bar"></div>
            </div>

            <div class="title-warning"></div>
        </div>

        <!-- Nội dung TinyMCE -->
        <div class="form-group-custom">
            <label class="form-label" for="Content">
                Nội dung bài viết
            </label>

            @Html.TextAreaFor(m => m.Content, new
            {
                @class = "form-control-custom",
                rows = 15,
                id = "Content",
                placeholder = "Bắt đầu soạn nội dung bài viết..."
            })

            @Html.ValidationMessageFor(m => m.Content, "", new
            {
                @class = "text-danger"
            })
        </div>

        <!-- Ảnh đại diện -->
        <div class="form-group-custom">
            <label class="form-label" for="imageFile">
                Hình ảnh đại diện bài viết <span style="color:#dc2626;">*</span>
            </label>

            <div class="image-upload">

                <svg class="upload-icon"
                     xmlns="http://www.w3.org/2000/svg"
                     width="42"
                     height="42"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="m21 15-5-5L5 21" />
                </svg>

                <label for="imageFile" class="choose-image-btn">
                    Chọn ảnh trên máy tính
                </label>

                <input type="file"
                       name="imageFile"
                       id="imageFile"
                       accept=".jpg,.jpeg,.png,.gif,.webp" />

                <p class="upload-description" id="fileName">
                    Chọn ảnh JPG, PNG, GIF hoặc WEBP (tối đa 2MB), hoặc nhập URL bên dưới.
                </p>

                <div class="image-preview">
                    <img id="previewImage" alt="Ảnh xem trước" />
                </div>

                @Html.ValidationMessage("imageFile", "", new
                {
                    @class = "text-danger"
                })
            </div>
        </div>

        <div class="form-group-custom">
            <label class="form-label" for="ImageUrl">Hoặc nhập đường dẫn ảnh (URL)</label>
            @Html.EditorFor(model => model.ImageUrl, new
            {
                htmlAttributes = new
                {
                    @class = "form-control-custom",
                    placeholder = "https://...",
                    type = "url"
                }
            })
            @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-danger" })
        </div>

        <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "about:blank" : Url.Content(Model.ImageUrl))"
             alt="@Model.Title"
             class="img-fluid rounded mb-3"
             style="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "display:none;" : "")" />

        <!-- Nút thao tác -->
        <div class="create-actions">

            @if (isAdminUser)
            {
                <button type="submit"
                        name="submitAction"
                        value="Published"
                        class="btn-create btn-save">
                    <i class="glyphicon glyphicon-ok"></i>
                    Xuất bản ngay
                </button>

                <button type="submit"
                        name="submitAction"
                        value="Pending"
                        class="btn-create btn-pending">
                    Lưu chờ duyệt (Pending)
                </button>

                <button type="submit"
                        name="submitAction"
                        value="Draft"
                        class="btn-create btn-draft">
                    Lưu bản nháp (Draft)
                </button>
            }
            else
            {
                <button type="submit"
                        name="submitAction"
                        value="Pending"
                        class="btn-create btn-save">
                    <i class="glyphicon glyphicon-send"></i>
                    Gửi Admin duyệt
                </button>

                <button type="submit"
                        name="submitAction"
                        value="Draft"
                        class="btn-create btn-draft">
                    Lưu bản nháp
                </button>
            }

            @Html.RouteLink(
                     "Quay lại danh sách",
                     "AdminArticles",
                     new { action = "Index" },
                     new { @class = "btn-create btn-back" })

        </div>
    }
</div>

<!-- TinyMCE -->
<script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js"></script>

