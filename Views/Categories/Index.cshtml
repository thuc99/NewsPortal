
@model IEnumerable<NewsPortal.Models.Category>

@{
    ViewBag.Title = "Danh mục";
    bool isAdminManagement = ViewBag.IsAdminManagement == true;
}

<style>
    .management-page {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 35px auto;
        padding: 0;
        color: #1e293b;
    }

    .admin-category-page {
        width: min(1208px, 100%);
        max-width: 1208px;
        margin: 0 auto;
    }

    .admin-page-back {
        display: inline-block;
        margin-bottom: 6px;
        color: #b91c32;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .admin-page-back:hover {
        color: #861b2b;
        text-decoration: underline;
    }

    .admin-list-title {
        margin: 0 0 14px;
        color: #172033;
        font-size: 19px;
        font-weight: 750;
    }

    .admin-list-title i {
        margin-right: 5px;
        color: #b91c32;
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .management-header h2 {
            font-size: 28px;
            font-weight: 750;
            line-height: 1.3;
            margin: 0 0 6px;
        }

    .management-subtitle {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .management-card {
        background: #fff;
        border: 1px solid #e2e7ef;
        border-radius: 12px;
        overflow-x: auto;
        box-shadow: 0 4px 14px rgba(23, 32, 51, .04);
    }

    .management-table {
        width: 100%;
        border-collapse: collapse;
    }

        .management-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 11px 12px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        .management-table td {
            padding: 12px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .management-table tr:last-child td {
            border-bottom: none;
        }

        .management-table tbody tr:hover {
            background: #fafcff;
        }

    .category-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        margin-right: 10px;
        border-radius: 10px;
        background: #fee2e2;
        color: #b91c1c;
        font-weight: bold;
    }

    .btn-add {
        display: inline-block;
        background: #b91c1c;
        color: white !important;
        padding: 11px 17px;
        border-radius: 8px;
        text-decoration: none !important;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #991b1b;
        }

    .admin-search {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 18px;
        width: fit-content;
        max-width: 100%;
    }

    .admin-search input {
        flex: 1 1 560px;
        width: 560px;
        max-width: 100%;
        min-width: 0;
        height: 40px;
        padding: 0 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font: inherit;
    }

    .admin-search button,
    .admin-search a {
        min-height: 38px;
        flex: 0 0 auto;
        justify-content: center;
        white-space: nowrap;
    }

    .admin-search button,
    .admin-search a {
        display: inline-flex;
        align-items: center;
        padding: 0 12px;
        border: 0;
        border-radius: 8px;
        background: #e2e8f0;
        color: #334155;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .action-link {
        display: inline-block;
        padding: 7px 10px;
        margin: 2px;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
    }

    .action-edit {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .action-delete {
        color: #b91c1c;
        background: #fee2e2;
    }

    .empty-message {
        text-align: center;
        padding: 35px !important;
        color: #64748b;
    }

    @@media (max-width: 650px) {
        .management-page {
            width: calc(100% - 24px);
            padding: 0;
            margin-top: 22px;
        }

        .management-table th,
        .management-table td {
            padding: 11px 9px;
        }

        .management-table {
            min-width: 500px;
            font-size: 13px;
        }

        .management-header h2 {
            font-size: 25px;
        }

        .btn-add {
            width: 100%;
            text-align: center;
        }

        .admin-search {
            flex-wrap: wrap;
        }

        .admin-search input {
            flex-basis: 100%;
            width: 100%;
        }
    }
</style>

<div class="management-page @(isAdminManagement ? "admin-category-page" : "")">
    @if (isAdminManagement)
    {
        <a class="admin-page-back" href="@Url.Action("Index", "Admin")">&larr; Quay lại Bảng điều khiển Admin</a>
    }

    <div class="management-header">
        <div>
            <h2>@(isAdminManagement ? "Quản lý Danh mục" : "Danh Mục")</h2>
            <p class="management-subtitle">
                Chuyên mục tin tức trên NewsPortal.
            </p>
        </div>

        @if (isAdminManagement)
        {
            @Html.RouteLink("+ Thêm danh mục", "AdminCategories", new { action = "Create" }, new { @class = "btn-add" })
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="padding: 14px 18px; margin-bottom: 18px; border-radius: 10px; background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; font-weight: 600;">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div style="padding: 14px 18px; margin-bottom: 18px; border-radius: 10px; background: #fee2e2; border: 1px solid #fecaca; color: #b91c1c; font-weight: 600;">
            @TempData["Error"]
        </div>
    }

    <div class="management-card">
    @if (isAdminManagement)
    {
        <h3 class="admin-list-title"><i class="fa-solid fa-folder-tree"></i> Danh sách danh mục</h3>
        <form method="get" action="@Url.RouteUrl("AdminCategories", new { action = "Index" })" class="admin-search">
            <input type="search" name="search" value="@(ViewBag.Search ?? "")" placeholder="Tìm theo tên hoặc mô tả danh mục..." />
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm</button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a href="@Url.RouteUrl("AdminCategories", new { action = "Index" })">Xóa</a>
            }
        </form>
    }

        <table class="management-table">
            <thead>
                <tr>
                    <th>Danh mục</th>
                    <th>Mô tả</th>

                    @if (isAdminManagement)
                    {
                        <th style="width: 180px;">Thao tác</th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="category-icon">
                                    @(string.IsNullOrWhiteSpace(item.CategoryName)
                                        ? "?"
                                        : item.CategoryName.Trim().Substring(0, 1).ToUpper())
                                </span>

                                <strong><a href="@(isAdminManagement ? Url.RouteUrl("AdminCategories", new { action = "Details", id = item.CategoryID }) : Url.Action("Details", "Categories", new { id = item.CategoryID }))" class="name-link">@item.CategoryName</a></strong>
                            </td>

                            <td>
                                @item.Description
                            </td>

                            @if (isAdminManagement)
                            {
                                <td>
                                    @Html.RouteLink("Sửa", "AdminCategories", new { action = "Edit", id = item.CategoryID }, new { @class = "action-link action-edit" })

                                    @Html.RouteLink("Xóa", "AdminCategories", new { action = "Delete", id = item.CategoryID }, new { @class = "action-link action-delete" })
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isAdminManagement ? 3 : 2)" class="empty-message">
                            Chưa có danh mục nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
