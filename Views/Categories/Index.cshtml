
@model IEnumerable<NewsPortal.Models.Category>

@{
    ViewBag.Title = "Danh mục";
    bool isAdmin = Session["Admin"] != null;
}

<style>
    .management-page {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 35px auto;
        padding: 0;
        color: #1e293b;
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .management-header h2 {
            font-size: 28px;
            font-weight: 750;
            line-height: 1.3;
            margin: 0 0 6px;
        }

    .management-subtitle {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .management-card {
        background: #fff;
        border: 0;
        border-radius: 0;
        overflow-x: auto;
        box-shadow: none;
    }

    .management-table {
        width: 100%;
        border-collapse: collapse;
    }

        .management-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 16px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        .management-table td {
            padding: 17px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .management-table tr:last-child td {
            border-bottom: none;
        }

        .management-table tbody tr:hover {
            background: #fafcff;
        }

    .category-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        margin-right: 10px;
        border-radius: 10px;
        background: #fee2e2;
        color: #b91c1c;
        font-weight: bold;
    }

    .btn-add {
        display: inline-block;
        background: #b91c1c;
        color: white !important;
        padding: 11px 17px;
        border-radius: 8px;
        text-decoration: none !important;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #991b1b;
        }

    .action-link {
        display: inline-block;
        padding: 7px 10px;
        margin: 2px;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
    }

    .action-edit {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .action-delete {
        color: #b91c1c;
        background: #fee2e2;
    }

    .empty-message {
        text-align: center;
        padding: 35px !important;
        color: #64748b;
    }

    @@media (max-width: 650px) {
        .management-page {
            width: calc(100% - 24px);
            padding: 0;
            margin-top: 22px;
        }

        .management-table th,
        .management-table td {
            padding: 11px 9px;
        }

        .management-table {
            min-width: 500px;
            font-size: 13px;
        }

        .management-header h2 {
            font-size: 25px;
        }

        .btn-add {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="management-page">

    <div class="management-header">
        <div>
            <h2> Danh Mục</h2>
            <p class="management-subtitle">
                 Chuyên mục tin tức trên NewsPortal.
            </p>
        </div>

        @if (isAdmin)
        {
            <div>
                @Html.ActionLink(
                         "+ Thêm danh mục",
                         "Create",
                         "Categories",
                         null,
                         new { @class = "btn-add" }
                     )
            </div>
        }
    </div>

    <div class="management-card">
        <table class="management-table">
            <thead>
                <tr>
                    <th>Danh mục</th>
                    <th>Mô tả</th>

                    @if (isAdmin)
                    {
                        <th style="width: 180px;">Thao tác</th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="category-icon">
                                    @(string.IsNullOrWhiteSpace(item.CategoryName)
                                        ? "?"
                                        : item.CategoryName.Trim().Substring(0, 1).ToUpper())
                                </span>

                                <strong>@item.CategoryName</strong>
                            </td>

                            <td>
                                @item.Description
                            </td>

                            @if (isAdmin)
                            {
                                <td>
                                    @Html.ActionLink(
                                             "Sửa",
                                             "Edit",
                                             new { id = item.CategoryID },
                                             new { @class = "action-link action-edit" }
                                         )

                                    @Html.ActionLink(
                                             "Xóa",
                                             "Delete",
                                             new { id = item.CategoryID },
                                             new { @class = "action-link action-delete" }
                                         )
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isAdmin ? 3 : 2)" class="empty-message">
                            Chưa có danh mục nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
