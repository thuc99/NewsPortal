@model IEnumerable<NewsPortal.Models.Category>
@{ ViewBag.Title = "Quản lý danh mục"; }

<h2>Quản lý danh mục</h2>

@if (TempData["Success"] != null)
{<div class="alert alert-success">@TempData["Success"]</div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger">@TempData["Error"]</div>}

<p>@Html.ActionLink("+ Thêm danh mục", "Create", null, new { @class = "btn btn-primary" })</p>

@using (Html.BeginForm("Index", "Categories", FormMethod.Get))
{
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên..." class="form-control" style="width:250px; display:inline-block" />
    <button type="submit" class="btn btn-default">Tìm</button>
}
<br />

<table class="table table-striped">
    <tr><th>#</th><th>Tên danh mục</th><th></th></tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CategoryID</td>
            <td>@item.CategoryName</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID })
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="3" class="text-center text-muted">Không có danh mục nào.</td></tr>
    }
</table>
