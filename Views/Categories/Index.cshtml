
@model IEnumerable<NewsPortal.Models.Category>

@{
    ViewBag.Title = "Danh mục";
    bool isAdminManagement = ViewBag.IsAdminManagement == true;
    bool isAdminUser = Session["Admin"] != null || string.Equals(System.Convert.ToString(Session["Role"]), "Admin", System.StringComparison.OrdinalIgnoreCase);
    int currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
    string searchQuery = ViewBag.Search as string ?? "";
}

<style>
    .management-page {
        width: min(1150px, calc(100% - 32px));
        max-width: 1150px;
        margin: 35px auto;
        padding: 0;
        color: #1e293b;
    }

    .admin-category-page {
        width: 100%;
        max-width: none;
        margin: 0 auto;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 22px 0;
    }

    .pagination-direction {
        min-width: 64px;
        text-align: center;
    }

    .pagination-direction.disabled {
        padding: 7px 11px;
        background: #f8fafc;
        color: #a0a5ae;
    }

    .pagination a {
        padding: 7px 11px;
        border-radius: 6px;
        background: #f1f5f9;
        color: #334155;
        text-decoration: none;
    }

    .pagination a.active {
        background: #b91c1c;
        color: #fff;
    }

    .admin-page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 22px;
    }

        .admin-page-heading > div > a {
            color: #b91c32;
            font-size: 13px;
            font-weight: 700;
        }

        .admin-page-heading h2 {
            margin: 6px 0 0;
            color: #172033;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.2;
        }

    .admin-list-panel.is-admin {
        padding: 22px;
        border: 1px solid #e9e9ed;
        border-radius: 12px;
        background: #fff;
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .management-header h2 {
            font-size: 28px;
            font-weight: 750;
            line-height: 1.3;
            margin: 0 0 6px;
        }

    .management-subtitle {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .management-card {
        background: #fff;
        border: 0;
        border-radius: 0;
        overflow-x: auto;
        box-shadow: none;
    }

    .admin-category-page .management-card {
        background: transparent;
    }

    .management-table {
        width: 100%;
        border-collapse: collapse;
    }

        .management-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 16px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        .management-table td {
            padding: 17px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .management-table tr:last-child td {
            border-bottom: none;
        }

        .management-table tbody tr:hover {
            background: #fafcff;
        }

    .category-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        margin-right: 10px;
        border-radius: 10px;
        background: #fee2e2;
        color: #b91c1c;
        font-weight: bold;
    }

    .btn-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 16px;
        border: 1px solid #b91c32;
        border-radius: 8px;
        background: #b91c32;
        color: #fff !important;
        text-decoration: none !important;
        font-weight: 700;
        transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
    }

        .btn-add:hover {
            background: #991b2b;
            box-shadow: 0 3px 8px rgba(185, 28, 50, .2);
            transform: translateY(-1px);
        }

    .admin-search {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 18px;
        max-width: 620px;
    }

    .admin-search input {
        flex: 1 1 320px;
        width: 320px;
        max-width: 100%;
        min-width: 0;
        height: 40px;
        padding: 0 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font: inherit;
    }

    .admin-search button,
    .admin-search a {
        height: 40px;
        flex: 0 0 auto;
        justify-content: center;
        white-space: nowrap;
    }

    .admin-search button,
    .admin-search a {
        display: inline-flex;
        align-items: center;
        padding: 0 14px;
        border: 1px solid #d5dce7;
        border-radius: 8px;
        background: #f8fafc;
        color: #334155;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background .18s ease, border-color .18s ease, color .18s ease;
    }

    .admin-search button:hover,
    .admin-search a:hover {
        border-color: #b91c32;
        background: #fff1f2;
        color: #b91c32;
    }

    .admin-category-page .admin-search button {
        min-width: 95px;
        border-color: #b91c32;
        background: #b91c32;
        color: #fff;
    }

    .admin-category-page .admin-search button:hover {
        border-color: #991b2b;
        background: #991b2b;
        color: #fff;
    }

    .admin-category-page .management-table th {
        padding: 11px 10px;
    }

    .admin-category-page .management-table td {
        padding: 12px 10px;
    }

    .action-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 0 11px;
        margin: 2px;
        border: 1px solid transparent;
        border-radius: 7px;
        text-decoration: none !important;
        font-size: 12.5px;
        font-weight: 700;
        transition: background .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .action-edit {
        color: #1d4ed8 !important;
        border-color: #dbeafe;
        background: #eff6ff;
    }

    .action-edit:hover {
        border-color: #bfdbfe;
        background: #dbeafe;
        box-shadow: 0 2px 5px rgba(37, 99, 235, .12);
        transform: translateY(-1px);
    }

    .action-delete {
        color: #b91c32 !important;
        border-color: #fecdd3;
        background: #fff1f2;
    }

    .action-delete:hover {
        border-color: #fda4af;
        background: #ffe4e6;
        box-shadow: 0 2px 5px rgba(185, 28, 50, .12);
        transform: translateY(-1px);
    }

    .empty-message {
        text-align: center;
        padding: 35px !important;
        color: #64748b;
    }

    @@media (max-width: 650px) {
        .management-page {
            width: calc(100% - 24px);
            padding: 0;
            margin-top: 22px;
        }

        .admin-category-page .admin-list-panel {
            padding: 14px;
        }

        .management-table th,
        .management-table td {
            padding: 11px 9px;
        }

        .management-table {
            min-width: 500px;
            font-size: 13px;
        }

        .management-header h2 {
            font-size: 25px;
        }

        .btn-add {
            width: 100%;
            text-align: center;
        }

        .admin-search {
            flex-wrap: wrap;
        }

        .admin-search input {
            flex-basis: 100%;
            width: 100%;
        }
    }
</style>

<div class="management-page @(isAdminManagement ? "admin-category-page" : "")">
    @if (isAdminManagement)
    {
        <div class="admin-page-heading">
            <div>
                @if (isAdminUser)
                {
                    <a href="@Url.Action("Index", "Admin")">&larr; Quay lại Bảng điều khiển Admin</a>
                }
                <h2>Quản lý Danh mục</h2>
            </div>
            @Html.RouteLink("+ Thêm danh mục", "AdminCategories", new { action = "Create" }, new { @class = "btn-add" })
        </div>
    }
    else
    {
        <div class="management-header">
            <div>
                <h2>Danh mục</h2>
                <p class="management-subtitle">Chuyên mục tin tức trên NewsPortal.</p>
            </div>
        </div>
    }

    <div class="admin-list-panel @(isAdminManagement ? "is-admin" : "")">

    @if (TempData["Success"] != null)
    {
        <div style="padding: 14px 18px; margin-bottom: 18px; border-radius: 10px; background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; font-weight: 600;">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div style="padding: 14px 18px; margin-bottom: 18px; border-radius: 10px; background: #fee2e2; border: 1px solid #fecaca; color: #b91c1c; font-weight: 600;">
            @TempData["Error"]
        </div>
    }

    @if (isAdminManagement)
    {
        <form method="get" action="@Url.RouteUrl("AdminCategories", new { action = "Index" })" class="admin-search">
            <input type="search" name="search" value="@(ViewBag.Search ?? "")" placeholder="Tìm theo tên hoặc mô tả danh mục..." />
            <button type="submit">Tìm kiếm</button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a href="@Url.RouteUrl("AdminCategories", new { action = "Index" })">Xóa</a>
            }
        </form>
    }

    <div class="management-card">
        <table class="management-table">
            <thead>
                <tr>
                    <th>Danh mục</th>
                    <th>Mô tả</th>

                    @if (isAdminManagement)
                    {
                        <th style="width: 180px;">Thao tác</th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="category-icon">
                                    @(string.IsNullOrWhiteSpace(item.CategoryName)
                                        ? "?"
                                        : item.CategoryName.Trim().Substring(0, 1).ToUpper())
                                </span>

                                <strong><a href="@(isAdminManagement ? Url.RouteUrl("AdminCategories", new { action = "Details", id = item.CategoryID }) : Url.Action("Details", "Categories", new { id = item.CategoryID }))" class="name-link">@item.CategoryName</a></strong>
                            </td>

                            <td>
                                @item.Description
                            </td>

                            @if (isAdminManagement)
                            {
                                <td>
                                    @Html.RouteLink("Sửa", "AdminCategories", new { action = "Edit", id = item.CategoryID }, new { @class = "action-link action-edit" })

                                    @Html.RouteLink("Xóa", "AdminCategories", new { action = "Delete", id = item.CategoryID }, new { @class = "action-link action-delete" })
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isAdminManagement ? 3 : 2)" class="empty-message">
                            Chưa có danh mục nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (isAdminManagement && totalPages > 1)
    {
        <nav class="pagination" aria-label="Phân trang danh mục">
            @if (currentPage > 1)
            {
                <a class="pagination-direction" href="@(Url.RouteUrl("AdminCategories", new { action = "Index", search = searchQuery, page = currentPage - 1 }))">Trước</a>
            }
            else
            {
                <span class="pagination-direction disabled">Trước</span>
            }
            @for (int pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <a class="@(pageNumber == currentPage ? "active" : "")" href="@Url.RouteUrl("AdminCategories", new { action = "Index", search = searchQuery, page = pageNumber })">@pageNumber</a>
            }
            @if (currentPage < totalPages)
            {
                <a class="pagination-direction" href="@(Url.RouteUrl("AdminCategories", new { action = "Index", search = searchQuery, page = currentPage + 1 }))">Sau</a>
            }
            else
            {
                <span class="pagination-direction disabled">Sau</span>
            }
        </nav>
    }
    </div>

</div>
