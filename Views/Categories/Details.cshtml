@model NewsPortal.Models.Category
@{ ViewBag.Title = "Chi tiết danh mục"; }
<style>
.admin-page{max-width:1150px;margin:18px auto;padding:8px 10px 30px;color:#243247}.admin-head{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:22px}.admin-head h2{font-size:28px;font-weight:750;margin:0 0 7px;color:#1b2f46}.admin-sub{margin:0;color:#718096}.admin-card{background:#fff;border:1px solid #e2e8f0;border-radius:13px;overflow:hidden;box-shadow:0 5px 20px rgba(15,23,42,.05)}.admin-card-pad{padding:25px}.admin-table{width:100%;border-collapse:collapse}.admin-table th{background:#f6f8fb;color:#526176;text-transform:uppercase;letter-spacing:.4px;font-size:12px;padding:15px;text-align:left;border-bottom:1px solid #e2e8f0}.admin-table td{padding:15px;border-bottom:1px solid #edf1f6;vertical-align:middle}.admin-table tbody tr:hover{background:#fafcff}.admin-table tr:last-child td{border-bottom:0}.admin-btn{display:inline-block;border:0;border-radius:7px;padding:10px 15px;font-weight:600;text-decoration:none!important;cursor:pointer;margin:2px}.admin-primary{background:#b91c1c;color:#fff!important}.admin-primary:hover{background:#991b1b}.admin-neutral{background:#e8eef5;color:#334155!important}.admin-edit{background:#dbeafe;color:#1d4ed8!important}.admin-delete{background:#fee2e2;color:#b91c1c!important}.admin-detail{background:#d1fae5;color:#047857!important}.admin-form label{display:block;font-weight:650;margin:15px 0 7px;color:#334155}.admin-form .form-control{width:100%;max-width:100%;height:auto;min-height:42px;padding:10px 12px;border:1px solid #cbd5e1;border-radius:7px;box-shadow:none}.admin-form textarea.form-control{min-height:150px;resize:vertical}.admin-form .form-control:focus{border-color:#729fe7;box-shadow:0 0 0 3px rgba(37,99,235,.1)}.admin-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:23px}.admin-alert{padding:12px 15px;border-radius:8px;margin:12px 0}.admin-empty{text-align:center;color:#718096;padding:30px!important}.admin-avatar{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:#fee2e2;color:#b91c1c;font-weight:800;margin-right:9px}.admin-search{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 18px}.admin-search .form-control{width:290px;max-width:100%;height:40px}.admin-image{width:100px;height:70px;object-fit:cover;border-radius:7px;background:#edf2f7}.admin-info{display:grid;grid-template-columns:180px 1fr;gap:0}.admin-info dt,.admin-info dd{padding:13px 15px;margin:0;border-bottom:1px solid #edf1f6;overflow-wrap:anywhere}.admin-info dt{color:#64748b;background:#f8fafc}.admin-info dd{font-weight:500}.validation-summary-errors,.field-validation-error{color:#b91c1c}.field-validation-valid{display:none}.admin-confirm{padding:22px;border-radius:10px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;margin:12px 0}@@media(max-width:650px){.admin-page{padding:0;margin-top:10px}.admin-head h2{font-size:24px}.admin-card{overflow-x:auto}.admin-table{min-width:620px}.admin-card-pad{padding:17px}.admin-info{grid-template-columns:1fr}.admin-info dt{border-bottom:0;padding-bottom:4px}.admin-info dd{padding-top:4px}}
</style>
<div class="admin-page"><div class="admin-head"><div><h2>Chi tiết danh mục</h2><p class="admin-sub">Thông tin và số lượng bài viết thuộc chuyên mục.</p></div></div><div class="admin-card admin-card-pad"><dl class="admin-info"><dt>Mã danh mục</dt><dd>@Model.CategoryID</dd><dt>Tên danh mục</dt><dd><strong>@Model.CategoryName</strong></dd><dt>Mô tả</dt><dd>@(String.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả" : Model.Description)</dd><dt>Số bài viết</dt><dd>@(Model.Articles == null ? 0 : Model.Articles.Count)</dd></dl><div class="admin-actions">@Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.CategoryID }, new { @class = "admin-btn admin-primary" }) @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "admin-btn admin-neutral" })</div></div></div>
