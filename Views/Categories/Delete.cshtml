
@model NewsPortal.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
}

<style>
    .delete-page {
        width: min(820px, 100%);
        margin: 0 auto;
    }

    .delete-card {
        background: var(--admin-panel);
        border: 1px solid var(--admin-line);
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 8px 24px rgba(23, 32, 51, .06);
    }

        .delete-card h2 {
            color: var(--admin-red);
            font-size: 24px;
            font-weight: 750;
            margin: 0 0 18px;
        }

    .delete-warning {
        background: #fff8ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 10px;
        padding: 14px 16px;
        margin: 0 0 22px;
    }

    .delete-info {
        padding: 12px 0;
        border-bottom: 1px solid var(--admin-line);
    }

    .delete-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-delete, .btn-back {
        border: 0;
        padding: 10px 17px;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-delete {
        background: var(--admin-red);
        color: white;
        transition: background .2s, transform .2s;
    }

    .btn-delete:hover {
        background: var(--red-dark);
        transform: translateY(-1px);
    }

    .btn-back {
        background: var(--soft);
        color: var(--admin-ink);
    }

    .btn-back:hover {
        background: var(--admin-line);
    }

    @@media (max-width: 650px) {
        .delete-page { width: 100%; }
        .delete-card { padding: 22px 18px; }
        .delete-actions { flex-wrap: wrap; }
        .btn-delete, .btn-back { flex: 1 1 160px; text-align: center; }
    }
</style>

<div class="delete-page">
    <div class="delete-card">
        <h2>Xóa danh mục</h2>

        <div class="delete-warning">
            Bạn có chắc chắn muốn xóa danh mục này không?
            Nếu danh mục vẫn còn bài viết, hệ thống sẽ từ chối thao tác.
        </div>

        <div class="delete-info">
            <strong>Mã danh mục:</strong> @Model.CategoryID
        </div>
        <div class="delete-info">
            <strong>Tên danh mục:</strong> @Model.CategoryName
        </div>
        <div class="delete-info">
            <strong>Mô tả:</strong> @Model.Description
        </div>
        <div class="delete-info">
            <strong>Số bài viết:</strong> @ViewBag.ArticleCount
        </div>

        <form action="@Url.RouteUrl("AdminCategories", new { action = "Delete", id = Model.CategoryID })" method="post">
            @Html.AntiForgeryToken()

            <div class="delete-actions">
                <button type="submit" class="btn-delete">Xác nhận xóa</button>
                @Html.RouteLink("Hủy", "AdminCategories", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>
