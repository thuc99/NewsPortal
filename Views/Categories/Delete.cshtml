
@model NewsPortal.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
}

<style>
    .delete-page {
        width: min(700px, calc(100% - 32px));
        max-width: 700px;
        margin: 40px auto;
        padding: 0;
    }

    .delete-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 30px 34px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
    }

        .delete-card h2 {
            color: #b91c1c;
            font-size: 26px;
            font-weight: 750;
            margin: 0 0 8px;
        }

    .delete-warning {
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        padding: 14px;
        margin: 20px 0;
    }

    .delete-info {
        padding: 12px 0;
        border-bottom: 1px solid #e2e8f0;
        color: #334155;
        line-height: 1.5;
    }

    .delete-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 25px;
    }

    .btn-delete, .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 160px;
        min-height: 50px;
        box-sizing: border-box;
        border: 0;
        padding: 12px 24px !important;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        font-size: 15px !important;
        font-weight: 700;
        line-height: 1.3;
        white-space: normal;
        transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .btn-delete {
        background: #b91c1c;
        color: white;
    }

    .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

        .btn-delete:hover {
            background: #991b1b;
            box-shadow: 0 3px 8px rgba(185, 28, 28, .2);
            transform: translateY(-1px);
        }

        .btn-back:hover {
            background: #cbd5e1;
        }

    @@media (max-width: 650px) {
        .delete-page { width: calc(100% - 24px); margin-top: 22px; }
        .delete-actions { flex-wrap: wrap; }
        .btn-delete, .btn-back { flex: 1 1 180px; text-align: center; }
        .delete-card { padding: 22px 18px; }
    }
</style>

<div class="delete-page">
    <div class="delete-card">
        <h2>Xóa danh mục</h2>

        <div class="delete-warning">
            Bạn có chắc chắn muốn xóa danh mục này không?
            Nếu danh mục vẫn còn bài viết, hệ thống sẽ từ chối thao tác.
        </div>

        <div class="delete-info">
            <strong>Mã danh mục:</strong> @Model.CategoryID
        </div>
        <div class="delete-info">
            <strong>Tên danh mục:</strong> @Model.CategoryName
        </div>
        <div class="delete-info">
            <strong>Mô tả:</strong> @Model.Description
        </div>
        <div class="delete-info">
            <strong>Số bài viết:</strong> @ViewBag.ArticleCount
        </div>

        <form action="@Url.RouteUrl("AdminCategories", new { action = "Delete", id = Model.CategoryID })" method="post">
            @Html.AntiForgeryToken()

            <div class="delete-actions">
                <button type="submit" class="btn-delete">Xác nhận xóa</button>
                @Html.RouteLink("Hủy", "AdminCategories", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>
