
@model NewsPortal.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
}

<style>
    .form-page {
        width: min(860px, 100%);
        margin: 0 auto;
    }

    .form-card {
        background: var(--admin-panel);
        border: 1px solid var(--admin-line);
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 8px 24px rgba(23, 32, 51, .06);
    }

    .form-page h2 {
        font-size: 24px;
        font-weight: 750;
        color: var(--admin-ink);
        margin: 0 0 6px;
    }

    .form-sub {
        color: var(--admin-muted);
        margin: 0 0 24px;
    }

    .field {
        margin-bottom: 20px;
    }

        .field label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--admin-ink);
        }

        .field input, .field textarea {
            width: 100%;
            padding: 11px 13px;
            border: 1px solid var(--admin-line);
            border-radius: 8px;
            box-sizing: border-box;
        }

            .field input:focus, .field textarea:focus {
                outline: none;
                border-color: var(--admin-red);
                box-shadow: 0 0 0 3px rgba(185, 28, 50, .1);
            }

            .field input[readonly] {
                background: var(--soft);
                color: var(--admin-muted);
            }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn-save, .btn-back {
        padding: 10px 17px;
        border-radius: 8px;
        text-decoration: none;
        border: 0;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-save {
        background: var(--admin-red);
        color: white;
        transition: background .2s, transform .2s;
    }

    .btn-save:hover {
        background: var(--red-dark);
        transform: translateY(-1px);
    }

    .btn-back {
        background: var(--soft);
        color: var(--admin-ink);
    }

    .btn-back:hover {
        background: var(--admin-line);
    }

    .text-danger, .validation-summary-errors {
        color: var(--admin-red);
        font-size: 13px;
    }

    @@media (max-width: 650px) {
        .form-page { width: 100%; }
        .form-card { padding: 22px 18px; }
        .form-actions { flex-wrap: wrap; }
        .btn-save, .btn-back { flex: 1 1 160px; text-align: center; }
    }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>Chỉnh sửa danh mục</h2>
        <p class="form-sub">Cập nhật thông tin chuyên mục.</p>

        <form action="@Url.RouteUrl("AdminCategories", new { action = "Edit" })" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CategoryID)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="field">
                @Html.LabelFor(m => m.CategoryID, "Mã danh mục")
                @Html.TextBoxFor(m => m.CategoryID, new { @readonly = "readonly" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.CategoryName, "Tên danh mục")
                @Html.TextBoxFor(m => m.CategoryName, new
                {
                    placeholder = "Nhập tên danh mục..."
                })
                @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Description, "Mô tả")
                @Html.TextAreaFor(m => m.Description, 4, 50, new
                {
                    placeholder = "Nhập mô tả cho danh mục..."
                })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Lưu thay đổi</button>
                @Html.RouteLink("Quay lại", "AdminCategories", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>
