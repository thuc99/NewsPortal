
@model NewsPortal.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
}

<style>
    .form-page {
        width: min(850px, calc(100% - 32px));
        max-width: 850px;
        margin: 35px auto;
        padding: 0;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 32px 36px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
    }

    .form-page h2 {
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
        margin: 0 0 8px;
    }

    .form-sub {
        color: #64748b;
        margin-bottom: 25px;
    }

    .field {
        margin-bottom: 20px;
    }

        .field label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }

    .field input, .field textarea {
        width: 100%;
        min-height: 44px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .field input:focus, .field textarea:focus {
        outline: none;
        border-color: #b91c1c;
        box-shadow: 0 0 0 3px rgba(185, 28, 28, .1);
    }

            .field input[readonly] {
                background: #f1f5f9;
                color: #64748b;
            }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 25px;
    }

    .btn-save, .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 150px;
        min-height: 48px;
        box-sizing: border-box;
        padding: 12px 24px !important;
        border-radius: 8px;
        text-decoration: none;
        border: 0;
        cursor: pointer;
        font-size: 15px !important;
        font-weight: 700;
        line-height: 1.3;
        white-space: normal;
        transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .btn-save {
        background: #b91c1c;
        color: white;
    }

    .btn-back {
        background: #e2e8f0;
        color: #334155;
    }

        .btn-save:hover {
            background: #991b1b;
            box-shadow: 0 3px 8px rgba(185, 28, 28, .2);
            transform: translateY(-1px);
        }

        .btn-back:hover {
            background: #cbd5e1;
        }

    .text-danger, .validation-summary-errors {
        color: #b91c1c;
        font-size: 13px;
    }

    @@media (max-width: 650px) {
        .form-page { width: calc(100% - 24px); margin-top: 22px; }
        .form-card { padding: 24px 18px; }
        .form-actions { flex-wrap: wrap; }
        .btn-save, .btn-back { flex: 1 1 180px; text-align: center; }
    }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>Chỉnh sửa danh mục</h2>
        <p class="form-sub">Cập nhật thông tin chuyên mục.</p>

        <form action="@Url.RouteUrl("AdminCategories", new { action = "Edit" })" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CategoryID)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="field">
                @Html.LabelFor(m => m.CategoryID, "Mã danh mục")
                @Html.TextBoxFor(m => m.CategoryID, new { @readonly = "readonly" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.CategoryName, "Tên danh mục")
                @Html.TextBoxFor(m => m.CategoryName, new
                {
                    placeholder = "Nhập tên danh mục..."
                })
                @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "text-danger" })
            </div>

            <div class="field">
                @Html.LabelFor(m => m.Description, "Mô tả")
                @Html.TextAreaFor(m => m.Description, 4, 50, new
                {
                    placeholder = "Nhập mô tả cho danh mục..."
                })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Lưu thay đổi</button>
                @Html.RouteLink("Quay lại", "AdminCategories", new { action = "Index" }, new { @class = "btn-back" })
            </div>
        </form>
    </div>
</div>
